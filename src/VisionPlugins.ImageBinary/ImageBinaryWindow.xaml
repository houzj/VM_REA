<Window x:Class="VisionPlugins.ImageBinary.ImageBinaryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1180" Height="760" MinWidth="860" MinHeight="500" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#F2F3F5" Foreground="#4E5054" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="TabItem"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="border" Background="#E4E5E7" BorderBrush="#B5B7BA" BorderThickness="0,0,1,1"><ContentPresenter Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="border" Property="Background" Value="#F2F3F5"/><Setter TargetName="border" Property="BorderBrush" Value="#E76900"/><Setter TargetName="border" Property="BorderThickness" Value="0,0,0,2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#F2F3F5"/></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="Foreground" Value="#4E5054"/></Style>
 </Window.Resources>
 <Border BorderBrush="#FD4F41" BorderThickness="0,1,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="#262626" MouseLeftButtonDown="DragTitle"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock x:Name="Caption" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/><Button Grid.Column="1" Content="—" Foreground="#CCC" Background="Transparent" BorderThickness="0" Click="Minimize"/><Button Grid.Column="2" Content="□" Foreground="#CCC" Background="Transparent" BorderThickness="0" Click="Maximize"/><Button Grid.Column="3" Content="×" Foreground="#CCC" Background="Transparent" BorderThickness="0" Click="CloseWindow"/></Grid>
  <ContentControl x:Name="Body" Grid.Row="1"/>
 </Grid></Border>
</Window>
