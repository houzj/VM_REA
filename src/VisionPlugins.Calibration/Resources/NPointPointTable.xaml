<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="BaseImage_ButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <ContentPresenter Name="cp" Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="cp" Property="ContentPresenter.Content" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
      <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
        <Setter Property="Margin" Value="14,20,4,10" />
        <Setter Property="DataGrid.AutoGenerateColumns" Value="False" />
        <Setter Property="DataGrid.ColumnHeaderHeight" Value="30" />
        <Setter Property="DataGrid.RowHeight" Value="30" />
        <Setter Property="DataGrid.MinColumnWidth" Value="20" />
        <Setter Property="DataGrid.MaxColumnWidth" Value="150" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="#A6A6A6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#848484" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#D5D5D5" />
        <Setter Property="DataGrid.VerticalGridLinesBrush" Value="#D5D5D5" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="Vertical" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.IsReadOnly" Value="False" />
        <Setter Property="DataGrid.SelectionUnit" Value="FullRow" />
        <Setter Property="DataGrid.CanUserAddRows" Value="False" />
        <Setter Property="DataGrid.CanUserSortColumns" Value="False" />
        <Setter Property="DataGrid.CanUserResizeRows" Value="False" />
        <Setter Property="DataGrid.CanUserResizeColumns" Value="True" />
        <Setter Property="DataGrid.ClipboardCopyMode" Value="None" />
        <Setter Property="DataGrid.CanUserReorderColumns" Value="False" />
        <Setter Property="DataGrid.RowBackground" Value="#EBEBEB" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#E0E0E0" />
        <Setter Property="ItemsControl.AlternationCount" Value="2" />
        <Setter Property="DataGrid.ColumnHeaderStyle">
          <Setter.Value>
            <Style TargetType="{x:Type DataGridColumnHeader}">
              <Setter Property="Background" Value="#A6A6A6" />
              <Setter Property="Height" Value="{Binding Path=ColumnHeaderHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="Foreground" Value="#515151" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                      <Border Name="BackgroundBorder" BorderThickness="0,0,1,1" Background="{TemplateBinding Control.Background}" BorderBrush="{Binding Path=HorizontalGridLinesBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}" />
                      <ContentPresenter Margin="11.2,0" Grid.Column="0" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
                      <Thumb Name="PART_LeftHeaderGripper" Grid.Column="0" HorizontalAlignment="Left" Opacity="0" Cursor="Hand" />
                      <Thumb Name="PART_RightHeaderGripper" Grid.Column="0" HorizontalAlignment="Right" Opacity="0" Cursor="Hand" />
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="DataGrid.CellStyle">
          <Setter.Value>
            <Style TargetType="{x:Type DataGridCell}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <TextBlock Background="#00FFFFFF" TextAlignment="Center" VerticalAlignment="Center">
                      <ContentPresenter />
                    </TextBlock>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="DataGridCell.IsSelected" Value="True">
                  <Setter Property="Foreground" Value="#515151" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGrid}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88*" />
                  <ColumnDefinition Width="12*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter" Margin="1,1,0,0" Grid.Row="0" Grid.Column="0" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                <ItemsPresenter Grid.Row="1" Grid.Column="0" Margin="1,0,0,0" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                <Border BorderThickness="1" BorderBrush="#A6A6A6" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" />
                <ItemsControl Name="deletItem" ItemsSource="{TemplateBinding ItemsControl.ItemsSource}" Grid.Column="1" Grid.Row="1" Margin="2,0,0,3">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource BaseImage_ButtonStyle}" Height="{Binding RowHeight, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Command="{Binding DeleteCommand}">
                        <Image Stretch="None" Source="/VisionPlugins.Calibration;component/Resources/NPoint_delete_normal.png" />
                        <FrameworkElement.Tag>
                          <Image Stretch="None" Source="/VisionPlugins.Calibration;component/Resources/NPoint_delete_click.png" />
                        </FrameworkElement.Tag>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Value="4" Binding="{Binding Items.Count, ElementName=deletItem}">
                  <Setter TargetName="deletItem" Property="Visibility" Value="Hidden" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
</ResourceDictionary>