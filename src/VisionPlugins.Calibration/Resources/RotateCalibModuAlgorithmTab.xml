<?xml version="1.0" encoding="utf-8"?>
<AlgorithmTabRoot>
  <Tabs>
    <Tab Name="Tab_Basic Params">
      <Categorys>
        <GroupLinkItem Name="ImageSourceGroup">
          <LinkName>ImageSourceGroup</LinkName>
        </GroupLinkItem>
        <Category Name="Fit Point" CanTriggerRun="TRUE">
          <Items>
            <RadioSelecter Name="InputWay">
              <Description>Input Mode</Description>
              <DisplayName>Input Mode</DisplayName>
              <CurValue>0</CurValue>
              <DefaultValue>0</DefaultValue>
              <EnumEntrys>
                <EnumEntry>
                  <DisplayName>RunParam_By Point</DisplayName>
                  <Value>0x0</Value>
                </EnumEntry>
                <EnumEntry>
                  <DisplayName>RunParam_By Coordinate</DisplayName>
                  <Value>0x1</Value>
                </EnumEntry>
              </EnumEntrys>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Value>0</Value>
                  <Setters>
                    <Setter>
                      <TargetName>ImagePoints</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>ImagePoints</TargetName>
                      <OperationName>DoInitOperaion</OperationName>
                    </Setter>
                  </Setters>
                </Trigger>
                <Trigger>
                  <Property>CurValue</Property>
                  <Value>1</Value>
                  <Setters>
                    <Setter>
                      <TargetName>ImagePointXs</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>ImagePointYs</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>ImagePointXs</TargetName>
                      <OperationName>DoInitOperaion</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>ImagePointYs</TargetName>
                      <OperationName>DoInitOperaion</OperationName>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
            </RadioSelecter>
            <ButtonSelecter Name="ImagePoints">
              <Description>Image Point</Description>
              <DisplayName>Image Point</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>False</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontCombinationTreeOperation</OperationName>
                <OperationParams>POINT</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetCombinationSourceOperation</OperationName>
                      <OperationParams>Image Point</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedCombinationOperation</OperationName>
                  <OperationParams>Image Point</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
            <ButtonSelecter Name="ImagePointXs">
              <Description>ImagePointX</Description>
              <DisplayName>ImagePointX</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>False</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>float</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>ImagePointX</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>ImagePointX</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
            <ButtonSelecter Name="ImagePointYs">
              <Description>ImagePointY</Description>
              <DisplayName>ImagePointY</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>False</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>float</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>ImagePointY</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>ImagePointY</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
            <ButtonSelecter Name="WorldRotateAngles">
              <Description>Physical rotation angle</Description>
              <DisplayName>Physical rotation angle</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>True</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>float</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>WorldRotateAngle</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>WorldRotateAngle</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
            <ButtonSelecter Name="RotNums">
              <Description>RotNum</Description>
              <DisplayName>RotNum</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>True</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>int</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>RotNum</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>RotNum</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
          </Items>
        </Category>
        <Category Name="Tab_Align File" CanTriggerRun="TRUE">
          <Items>
            <Boolean Name="RevOutputFlag" NameSpace="Standard">
              <CurValue>False</CurValue>
              <DefaultValue>False</DefaultValue>
              <Description>RevOutputFlag</Description>
              <DisplayName>RevOutputFlag</DisplayName>
              <Visibility>Beginner</Visibility>
              <AccessMode>RW</AccessMode>
            </Boolean>
            <OpenFileForCalibDialog Name="FilePath">
              <Description>Load Calib File Path</Description>
              <DisplayName>Load Calibration File</DisplayName>
              <AccessMode>RW</AccessMode>
              <CurValue />
              <DefaultValue />
              <FileOption>
                <IsMultiselect>false</IsMultiselect>
                <FilterName>.xml|*.xml;*.iwcal</FilterName>
              </FileOption>
            </OpenFileForCalibDialog>
            <ButtonSelecter Name="RefreshSignal">
              <Description>Refresh Signal</Description>
              <DisplayName>Refresh Signal</DisplayName>
              <AccessMode>O</AccessMode>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>int</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>RefreshSignal</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>RefreshSignal</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
          </Items>
        </Category>
      </Categorys>
    </Tab>
    <Tab Name="ResultShow">
      <Categorys>
        <GroupLinkItem Name="TextDisplayGroup">
          <LinkName>TextDisplayGroup</LinkName>
        </GroupLinkItem>
      </Categorys>
    </Tab>
  </Tabs>
  <BottomExcuteButtonsLeft>
    <Button_ResetAlgoParams Name="Button_ResetAlgoParams">
      <AccessMode>O</AccessMode>
    </Button_ResetAlgoParams>
  </BottomExcuteButtonsLeft>
  <BottomExcuteButtons>
    <GroupLinkItem Name="BottomCommandGroup">
      <LinkName>BottomCommandGroup</LinkName>
    </GroupLinkItem>
  </BottomExcuteButtons>
</AlgorithmTabRoot>