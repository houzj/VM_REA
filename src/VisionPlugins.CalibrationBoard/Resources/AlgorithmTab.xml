        <Category Name="Tab_Run Params" CanTriggerRun = "TRUE">
          <Items>
            <Enumeration Name="HomoFreedom">
              <Description>Degree of Freedom</Description>
              <DisplayName>RunParam_DOF</DisplayName>
              <AccessMode>RW</AccessMode>
              <AlgorithmIndex>0x0001</AlgorithmIndex>
              <CurValue>0x2</CurValue>
              <DefaultValue>0x1</DefaultValue>
              <EnumEntrys>
                <EnumEntry Name="Perspective">
                  <Description>Projective Transformation</Description>
                  <DisplayName>RunParam_Scale、Rotation、Aspect Ratio、Tilt、Translation and Transmission</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x1</Value>
                </EnumEntry>
                <EnumEntry Name="Affine">
                  <Description>Affine Transformation</Description>
                  <DisplayName>RunParam_Scale、Rotation、Aspect Ratio、Tilt and Translation</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x2</Value>
                </EnumEntry>
                <EnumEntry Name="Similarity">
                  <Description>Affine Transformation</Description>
                  <DisplayName>RunParam_Scale、Rotation and Translation</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x3</Value>
                </EnumEntry>
              </EnumEntrys>
            </Enumeration>
            <Integer Name="GrayContrast" IsAbandon="True">
              <Description>黑白模块灰度对比度最小值</Description>
              <DisplayName>RunParam_Grayscale Contrast</DisplayName>
              <AccessMode>O</AccessMode>
              <AlgorithmIndex>0x204</AlgorithmIndex>
              <CurValue>15</CurValue>
              <DefaultValue>15</DefaultValue>
              <MinValue>1</MinValue>
              <MaxValue>255</MaxValue>
              <IncValue>1</IncValue>
              <SubscribeVisible>False</SubscribeVisible>
			  <CustomVisible>False</CustomVisible>
            </Integer>
            <Enumeration Name="FilterStatus">
              <Description>Median Filtering State</Description>
              <DisplayName>Median Filtering State</DisplayName>
              <AccessMode>RW</AccessMode>
              <AlgorithmIndex>0x0206</AlgorithmIndex>
              <CurValue>0x1</CurValue>
              <DefaultValue>0x1</DefaultValue>
              <EnumEntrys>
                <EnumEntry Name="FilterStateTure">
                  <Description>Execution Filtering</Description>
                  <DisplayName>Execution Filtering</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x1</Value>
                </EnumEntry>
                <EnumEntry Name="FilterStateFalse">
                  <Description>No Filter</Description>
                  <DisplayName>No Filter</DisplayName>
                  <Value>0x2</Value>
                  <IsImplemented>0x1</IsImplemented>
                </EnumEntry>
              </EnumEntrys>
            </Enumeration>
            <Enumeration Name="SubpixelWinAuto" IsAbandon="True">
              <Description>亚像素窗口大小</Description>
              <DisplayName>RunParam_Sub-pixel window</DisplayName>
              <AccessMode>O</AccessMode>
              <AlgorithmIndex>0x0205</AlgorithmIndex>
              <CurValue>0x1</CurValue>
              <DefaultValue>0x1</DefaultValue>
              <CustomVisible>False</CustomVisible>
              <Triggers>
                <MultiTrigger>
                  <Conditions>
                    <Condition>
                      <Property>CurValue</Property>
                      <Value>2</Value>
                    </Condition>
                    <Condition>
                      <Property>CustomVisible</Property>
                      <Value>True</Value>
                    </Condition>
                  </Conditions>
                  <Setters>
                    <Setter>
                      <TargetName>SubPixelWindowSize</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                  </Setters>
                </MultiTrigger>
              </Triggers>
              <EnumEntrys>
                <EnumEntry Name="SubpixelWinSizeAuto">
                  <Description>FitSize</Description>
                  <DisplayName>FitSize</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x1</Value>
                </EnumEntry>
                <EnumEntry Name="SubpixelWinSizeUser">
                  <Description>Set</Description>
                  <DisplayName>Set</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x2</Value>
                </EnumEntry>
              </EnumEntrys>
            </Enumeration>
            <Integer Name="SubPixelWindowSize" IsAbandon="True">
              <Description>亚像素窗口大小设置值</Description>
              <DisplayName>设置窗口大小</DisplayName>
              <AccessMode>O</AccessMode>
              <AlgorithmIndex>0x0205</AlgorithmIndex>
              <CurValue>30</CurValue>
              <CustomVisible>False</CustomVisible>
              <DefaultValue>30</DefaultValue>
              <MinValue>3</MinValue>
              <MaxValue>150</MaxValue>
              <IncValue>1</IncValue>
              <SubscribeVisible>False</SubscribeVisible>
            </Integer>
            <Integer Name="Circularity">
              <Description>Mark Points Roundness</Description>
              <DisplayName>RunParam_Dot Circularity</DisplayName>
              <AccessMode>RW</AccessMode>
              <AlgorithmIndex>0x0301</AlgorithmIndex>
              <CurValue>50</CurValue>
              <DefaultValue>50</DefaultValue>
              <MinValue>20</MinValue>
              <MaxValue>100</MaxValue>
              <IncValue>1</IncValue>
              <SubscribeVisible>False</SubscribeVisible>
            </Integer>
            <IntegerBettween Name="EdgeThresh">
              <Description>RunParam_Edge Threshold</Description>
              <DisplayName>RunParam_Edge Threshold</DisplayName>
              <AccessMode>RW</AccessMode>
              <AlgorithmIndex>0x0001</AlgorithmIndex>
              <DefaultValue>20</DefaultValue>
              <MinValue>0x00</MinValue>
              <MaxValue>0xFF</MaxValue>
              <IncValue>0x1</IncValue>
              <SubscribeVisible>False</SubscribeVisible>
              <Integers>
                <Integer Name="EdgeThreshLow">
                  <Description>Sub Pixel Edge Lower Threshold</Description>
                  <DisplayName>Edge Low Threshold</DisplayName>
                  <AccessMode>RW</AccessMode>
                  <AlgorithmIndex>0x0302</AlgorithmIndex>
                  <CurValue>20</CurValue>
                  <DefaultValue>20</DefaultValue>
                  <MinValue>0x00</MinValue>
                  <MaxValue>0xFF</MaxValue>
                  <IncValue>0x1</IncValue>
                </Integer>
                <Integer Name="EdgeThreshHigh">
                  <Description>Sub Pixel Edge Upper Threshold</Description>
                  <DisplayName>Edge High Threshold</DisplayName>
                  <AccessMode>RW</AccessMode>
                  <AlgorithmIndex>0x0303</AlgorithmIndex>
                  <CurValue>40</CurValue>
                  <DefaultValue>40</DefaultValue>
                  <MinValue>0x00</MinValue>
                  <MaxValue>0xFF</MaxValue>
                  <IncValue>0x1</IncValue>
                </Integer>
              </Integers>
            </IntegerBettween>
            <Enumeration Name="CircleBoardCircleMode">
              <Description>圆点标定板圆点类型</Description>
              <DisplayName>圆点类型</DisplayName>
              <AccessMode>RW</AccessMode>
              <AlgorithmIndex>000C</AlgorithmIndex>
              <CurValue>0x1</CurValue>
              <DefaultValue>0x1</DefaultValue>
              <EnumEntrys>
                <EnumEntry Name="CircleModeBlack">
                  <Description>白底黑圆</Description>
                  <DisplayName>白底黑圆</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x1</Value>
                </EnumEntry>
                <EnumEntry Name="CircleModeWhite">
                  <Description>黑底白圆</Description>
                  <DisplayName>黑底白圆</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x2</Value>
                </EnumEntry>
              </EnumEntrys>
            </Enumeration>
            <Expand>
              <CurValue>False</CurValue>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Value>True</Value>
                  <Setters>
                    <Setter>
                      <TargetName>CalibBoardWeightFun</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
            </Expand>
            <!--高级参数-->
            <Enumeration Name="CalibBoardWeightFun">
              <Description>Weighting Function</Description>
              <DisplayName>Weighting Function</DisplayName>
              <AccessMode>RW</AccessMode>
              <AlgorithmIndex>0x0002</AlgorithmIndex>
              <CurValue>2</CurValue>
              <DefaultValue>2</DefaultValue>
              <CustomVisible>False</CustomVisible>
              <Triggers>
                <MultiTrigger>
                  <Conditions>
                    <Condition>
                      <Property>CurValue</Property>
                      <Value>2</Value>
                    </Condition>
                    <Condition>
                      <Property>CustomVisible</Property>
                      <Value>True</Value>
                    </Condition>
                  </Conditions>
                  <Setters>
                    <Setter>
                      <TargetName>WeightFactor</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                  </Setters>
                </MultiTrigger>
                <MultiTrigger>
                  <Conditions>
                    <Condition>
                      <Property>CurValue</Property>
                      <Value>3</Value>
                    </Condition>
                    <Condition>
                      <Property>CustomVisible</Property>
                      <Value>True</Value>
                    </Condition>
                  </Conditions>
                  <Setters>
                    <Setter>
                      <TargetName>WeightFactor</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                  </Setters>
                </MultiTrigger>
              </Triggers>
              <EnumEntrys>
                <EnumEntry Name="LeastSqure">
                  <Description>Least Squares</Description>
                  <DisplayName>Least Squares</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x1</Value>
                </EnumEntry>
                <EnumEntry Name="Huber">
                  <Description>Huber</Description>
                  <DisplayName>Huber</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x2</Value>
                </EnumEntry>
                <EnumEntry Name="Tukey">
                  <Description>Tukey</Description>
                  <DisplayName>Tukey</DisplayName>
                  <IsImplemented>0x1</IsImplemented>
                  <Value>0x3</Value>
                </EnumEntry>
              </EnumEntrys>
            </Enumeration>
            <Integer Name="WeightFactor">
              <Description>Weighting Function Clipping Factor Coefficient</Description>
              <DisplayName>RunParam_Weighting Coefficient</DisplayName>
              <AccessMode>Rw</AccessMode>
              <AlgorithmIndex>0x0003</AlgorithmIndex>
              <CurValue>20</CurValue>
              <DefaultValue>20</DefaultValue>
              <MinValue>1</MinValue>
              <MaxValue>200</MaxValue>
              <IncValue>1</IncValue>
              <CustomVisible>False</CustomVisible>
              <SubscribeVisible>False</SubscribeVisible>
            </Integer>
            <Integer Name="DistThreshold">
              <Description>Dis Thre</Description>
              <DisplayName>Dis Thre</DisplayName>
              <AccessMode>Rw</AccessMode>
              <AlgorithmIndex>0x0004</AlgorithmIndex>
              <CurValue>30</CurValue>
              <DefaultValue>30</DefaultValue>
              <MinValue>1</MinValue>
              <MaxValue>100</MaxValue>
              <IncValue>1</IncValue>
              <CustomVisible>False</CustomVisible>
            </Integer>
            <Integer Name="SampleRatio">
              <Description>Sampling Rate</Description>
              <DisplayName>Sampling Rate</DisplayName>
              <AccessMode>Rw</AccessMode>
              <AlgorithmIndex>0x0005</AlgorithmIndex>
              <CurValue>60</CurValue>
              <DefaultValue>60</DefaultValue>
              <MinValue>1</MinValue>
              <MaxValue>100</MaxValue>
              <IncValue>1</IncValue>
              <CustomVisible>False</CustomVisible>
            </Integer>
