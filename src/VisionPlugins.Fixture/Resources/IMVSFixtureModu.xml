<?xml version="1.0" encoding="utf-8"?>
<ParamRoot>
  <Categorys>
    <Category Name="Base">
      <Items>
        <String Name="ServerRepAddress">
          <CurValue>tcp://127.0.0.1:5555</CurValue>
        </String>
        <String Name="ModuleName">
          <CurValue>IMVSFixtureModu</CurValue>
        </String>
        <Bool Name="IsLoalModule">
          <CurValue>0</CurValue>
        </Bool>
        <Integer Name="ModuleViewMode">
          <CurValue>1</CurValue>
        </Integer>
        <String Name="ModuleDisplayName">
          <CurValue>IMVSFixtureModu</CurValue>
        </String>
        <String Name="ModuleHelp">
          <CurValue>Reserve</CurValue>
        </String>
        <String Name="IsSaveTabXml">
          <CurValue>False</CurValue>
        </String>
      </Items>
    </Category>
    <Category Name="Input">
      <Items>
        <Combination Name="Origin" Style="POINT" AutoSubscribeName="Match Point">
          <Filters>
            <Filter Name="InPointX" ValueType="float" IsForce="true"></Filter>
            <Filter Name="InPointY" ValueType="float" IsForce="true"></Filter>
          </Filters>
        </Combination>
        <Filter Name="InAngle" ValueType="float" IsForce="true"></Filter>
        <Filter Name="MatchScaleX" ValueType="float" IsForce="false" IsPrefer="True"></Filter>
        <Filter Name="MatchScaleY" ValueType="float" IsForce="false" IsPrefer="True"></Filter>
      </Items>
    </Category>
    <Category Name="Output">
      <Items>
        <Filter Name="ModuRunTime" ValueType="float" IsForce="true" IsArray="false"></Filter>
        <Filter Name="ModuStatus" ValueType="int" IsForce="true" IsArray="false"></Filter>
        <Combination Name="Position Correction Info" Style="FIXTURE" IsPrefer="true">
          <Filters>
            <Combination Name="Fixtured Point" Style="POINT">
              <Filters>
                <Filter Name="FixtureInitPointX" ValueType="float" IsForce="false" IsArray="false"></Filter>
                <Filter Name="FixtureInitPointY" ValueType="float" IsForce="false" IsArray="false"></Filter>
              </Filters>
            </Combination>
            <Filter Name="FixtureInitAngle" ValueType="float" IsForce="false" IsArray="false"></Filter>
            <Filter Name="FixtureInitScaleX" ValueType="float" IsForce="false" IsArray="false"></Filter>
            <Filter Name="FixtureInitScaleY" ValueType="float" IsForce="false" IsArray="false"></Filter>
            <Combination Name="Unfixtured Point" Style="POINT">
              <Filters>
                <Filter Name="FixtureRunPointX" ValueType="float" IsForce="false" IsArray="false"></Filter>
                <Filter Name="FixtureRunPointY" ValueType="float" IsForce="false" IsArray="false"></Filter>
              </Filters>
            </Combination>
            <Filter Name="FixtureRunAngle" ValueType="float" IsForce="false" IsArray="false"></Filter>
            <Filter Name="FixtureRunScaleX" ValueType="float" IsForce="false" IsArray="false"></Filter>
            <Filter Name="FixtureRunScaleY" ValueType="float" IsForce="false" IsArray="false"></Filter>
          </Filters>
        </Combination>
      </Items>
    </Category>
    <Category Name="TransmitInfo"></Category>
  </Categorys>
</ParamRoot>