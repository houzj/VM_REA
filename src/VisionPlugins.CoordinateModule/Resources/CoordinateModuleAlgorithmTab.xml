<?xml version="1.0" encoding="utf-8"?>
<AlgorithmTabRoot>
  <Tabs>
    <Tab Name="Tab_Basic Params">
      <Categorys>
	  <GroupLinkItem Name="ImageSourceGroup">
          <LinkName>ImageSourceGroup</LinkName>
        </GroupLinkItem>
        <Category Name="RunParam_Draw" CanTriggerRun = "TRUE">
          <Items>
		    <RadioSelecterEx2 Name="CordinateCreate">
				<Description>坐标系创建</Description>
				<DisplayName>坐标系创建</DisplayName>
				<AccessMode>RW</AccessMode>
				<CurValue>0</CurValue>
				<DefaultValue>0</DefaultValue>
				<EnumEntrys>
					<EnumEntry Name="Draw">
						<DisplayName>RunParam_Draw</DisplayName>
						<Value>0x0</Value>
					</EnumEntry>
					<EnumEntry Name="Subscribe">
						<DisplayName>RunParam_Subscribe</DisplayName>
						<Value>0x1</Value>
					</EnumEntry>
				</EnumEntrys>
				<Triggers>
					<Trigger>
						<Property>CurValue</Property>
						<Setters>
							<Setter>
								<OperationName>RoiDisplayOperation</OperationName>
							</Setter>							
						</Setters>
					</Trigger>
					<MultiTrigger>
						<Conditions>
							<Condition>
								<Property>CurValue</Property>
								<Value>0</Value>
							</Condition>
							<Condition>
								<Property>CustomVisible</Property>
								<Value>True</Value>
							</Condition>
						</Conditions>
						<Setters>
							<Setter>
								<TargetName>RoiType</TargetName>
								<OperationName>VisibleOperation</OperationName>
							</Setter>							
						</Setters>
					</MultiTrigger>					
					<MultiTrigger>
						<Conditions>
							<Condition>
								<Property>CurValue</Property>
								<Value>1</Value>
							</Condition>
							<Condition>
								<Property>CustomVisible</Property>
								<Value>True</Value>
							</Condition>
						</Conditions>
						<Setters>
							<Setter>
								<TargetName>InputWay</TargetName>
								<OperationName>VisibleOperation</OperationName>
							</Setter>
						</Setters>
					</MultiTrigger>
				</Triggers>
			</RadioSelecterEx2>
		    <ROISelecter Name="RoiType">
              <Description>RunParam_Draw</Description>
              <DisplayName>RunParam_Draw</DisplayName>
              <AccessMode>RW</AccessMode>
              <CustomVisible>False</CustomVisible>
              <FullScreenEnable>False</FullScreenEnable>
              <SelectType>Single</SelectType>
              <ROISelection>Coordinate</ROISelection> <!-- Point-->
            </ROISelecter>		  
            <RadioSelecterEx3 Name="InputWay">
              <Description>Input Mode</Description>
              <DisplayName>Input Mode</DisplayName>
			  <AccessMode>RW</AccessMode>
              <CurValue>0</CurValue>
              <DefaultValue>0</DefaultValue>
			  <CustomVisible>False</CustomVisible>
              <EnumEntrys>
                <EnumEntry Name="ByPoint">
                  <DisplayName>RunParam_By Point</DisplayName>
                  <Value>0x0</Value>
                </EnumEntry>
                <EnumEntry Name="ByCoordinate">
                  <DisplayName>RunParam_By Coordinate</DisplayName>
                  <Value>0x1</Value>
                </EnumEntry>
				<EnumEntry Name="ByMatrix">
                  <DisplayName>RunParam_By Matrix</DisplayName>
                  <Value>0x2</Value>
                </EnumEntry>
              </EnumEntrys>
              <Triggers>
			    <MultiTrigger>
					<Conditions>
						<Condition>
							<Property>CurValue</Property>
								<Value>0</Value>
							</Condition>
							<Condition>
								<Property>CustomVisible</Property>
								<Value>True</Value>
							</Condition>		
					</Conditions>
						<Setters>
							<Setter>
                                <TargetName>SrcInputPoints</TargetName>
                                <OperationName>VisibleOperation</OperationName>
                            </Setter>
							<Setter>
                                <TargetName>SrcInputAngle</TargetName>
                                <OperationName>VisibleOperation</OperationName>
                            </Setter>
                            <Setter>
                                <TargetName>SrcInputPoints</TargetName>
                                <OperationName>DoInitOperaion</OperationName>
                            </Setter>
							<Setter>
                                <TargetName>SrcInputAngle</TargetName>
                                <OperationName>DoInitOperaion</OperationName>
                            </Setter>
						</Setters>	
				</MultiTrigger>	
                <MultiTrigger>
				  <Conditions>
						<Condition>
							<Property>CurValue</Property>
							<Value>1</Value>
						</Condition>
						<Condition>
							<Property>CustomVisible</Property>
							<Value>True</Value>
						</Condition>		
				  </Conditions>
                  <Setters>
                    <Setter>
                      <TargetName>SrcInputPointsX</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>SrcInputPointsY</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
					<Setter>
                      <TargetName>SrcInputAngle</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>SrcInputPointsX</TargetName>
                      <OperationName>DoInitOperaion</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>SrcInputPointsY</TargetName>
                      <OperationName>DoInitOperaion</OperationName>
                    </Setter>
					<Setter>
                      <TargetName>SrcInputAngle</TargetName>
                      <OperationName>DoInitOperaion</OperationName>
                    </Setter>
                  </Setters>
                </MultiTrigger>			
				<MultiTrigger>
				  <Conditions>
						<Condition>
							<Property>CurValue</Property>
							<Value>2</Value>
						</Condition>
						<Condition>
							<Property>CustomVisible</Property>
							<Value>True</Value>
						</Condition>		
				  </Conditions>
                  <Setters>
                    <Setter>
                      <TargetName>SrcInputMatrix</TargetName>
                      <OperationName>VisibleOperation</OperationName>
                    </Setter>
                    <Setter>
                      <TargetName>SrcInputMatrix</TargetName>
                      <OperationName>DoInitOperaion</OperationName>
                    </Setter>
                  </Setters>
                </MultiTrigger>				
              </Triggers>
            </RadioSelecterEx3>
            <ButtonSelecter Name="SrcInputPoints">
              <Description>Point</Description>
              <DisplayName>Point</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>False</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontCombinationTreeOperation</OperationName>
                <OperationParams>POINT</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetCombinationSourceOperation</OperationName>
                      <OperationParams>Src Input Point</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedCombinationOperation</OperationName>
                  <OperationParams>Src Input Point</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
            <ButtonSelecter Name="SrcInputPointsX">
              <Description>PointX</Description>
              <DisplayName>PointX</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>False</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>float</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>SrcPointX</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>SrcPointX</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
            <ButtonSelecter Name="SrcInputPointsY">
              <Description>pointy</Description>
              <DisplayName>pointy</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>False</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>float</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>SrcPointY</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>SrcPointY</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
			<ButtonSelecter Name="SrcInputAngle">
              <Description>Angle</Description>
              <DisplayName>Angle</DisplayName>
              <AccessMode>O</AccessMode>
              <CustomVisible>False</CustomVisible>
              <DropOpenSetter>
                <TargetName>EnumEntrys</TargetName>
                <OperationName>GetFrontFilterTreeOperation</OperationName>
                <OperationParams>float</OperationParams>
              </DropOpenSetter>
              <Triggers>
                <Trigger>
                  <Property>CurValue</Property>
                  <Setters>
                    <Setter>
                      <OperationName>SetFilterSourceOperation</OperationName>
                      <OperationParams>SrcAngle</OperationParams>
                    </Setter>
                  </Setters>
                </Trigger>
              </Triggers>
              <Initers>
                <Setter>
                  <TargetName>CurValue</TargetName>
                  <OperationName>GetSelectedFilterOperation</OperationName>
                  <OperationParams>SrcAngle</OperationParams>
                </Setter>
              </Initers>
            </ButtonSelecter>
			<ButtonSelecter Name="SrcInputMatrix">
				<Description>Matrix</Description>
				<DisplayName>Matrix</DisplayName>
				<AccessMode>O</AccessMode>
				<CustomVisible>False</CustomVisible>
				<DropOpenSetter>
					<TargetName>EnumEntrys</TargetName>
					<OperationName>GetFrontFilterTreeOperation</OperationName>
					<OperationParams>float</OperationParams>
				</DropOpenSetter>
				<Triggers>
					<Trigger>
						<Property>CurValue</Property>
						<Setters>
							<Setter>
								<OperationName>SetFilterSourceOperation</OperationName>
								<OperationParams>CalibMatrix</OperationParams>
							</Setter>
						</Setters>
					</Trigger>
				</Triggers>
				<Initers>
					<Setter>
						<TargetName>CurValue</TargetName>
						<OperationName>GetSelectedFilterOperation</OperationName>
						<OperationParams>CalibMatrix</OperationParams>
					</Setter>
				</Initers>
			</ButtonSelecter>
          </Items>
        </Category>
      </Categorys>
    </Tab>
  </Tabs>
  <BottomExcuteButtonsLeft>
    <Button_ResetAlgoParams Name="Button_ResetAlgoParams">
      <AccessMode>O</AccessMode>
    </Button_ResetAlgoParams>
  </BottomExcuteButtonsLeft>
  <BottomExcuteButtons>
    <GroupLinkItem Name="BottomCommandGroup">
      <LinkName>BottomCommandGroup</LinkName>
    </GroupLinkItem>
  </BottomExcuteButtons>
</AlgorithmTabRoot>