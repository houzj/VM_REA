<Window x:Class="VisionPlugins.ImageSource.ImageSourceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="420" Height="500" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F2F3F5" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/Theme.xaml"/><ResourceDictionary Source="Resources/RecScrollBarStyle.xaml"/><ResourceDictionary Source="Resources/ListViewComboBoxStyle.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="Switch" TargetType="ToggleButton"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="32"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Image x:Name="shape" Stretch="None" Source="Resources/swith_off.png"/><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="shape" Property="Source" Value="Resources/swith_on.png"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource ListViewComboBoxStyle}"><Setter Property="Height" Value="29"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#62676C"/><Setter Property="BorderBrush" Value="#C8C4C1"/><Setter Property="Padding" Value="0"/></Style>
 </ResourceDictionary></Window.Resources>
 <Border BorderBrush="#F34A35" BorderThickness="0,1,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Background="#242424" MouseLeftButtonDown="DragTitle"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Caption" Foreground="White" FontWeight="Bold"/><TextBlock Text="ⓘ" Foreground="#FF8200" Margin="16,0,0,0"/></StackPanel><Button Grid.Column="1" Content="×" Foreground="#BDBDBD" Background="Transparent" BorderThickness="0" FontSize="23" Click="CloseWindow"/></Grid>
 <ScrollViewer Style="{StaticResource RecScrollViewer}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Rows" Margin="32,18,17,14"/></ScrollViewer>
 </Grid></Border>
</Window>
