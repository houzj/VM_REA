<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="BaseImageConfig_ButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Image Name="icon" Stretch="None" Source="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/add_normal.png" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/add_click.png" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/add_click.png" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/ic_add_disable.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
<Style x:Key="BaseImageConfig_DeleteButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Image Name="icon" Stretch="None" Source="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/ic_清空图片_normal.png" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/ic_清空图片_click.png" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/ic_清空图片_click.png" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="icon" Property="Image.Source" Value="pack://application:,,,/VisionPlugins.ImageSource;component/Resources/ic_清空图片_disable.png" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
