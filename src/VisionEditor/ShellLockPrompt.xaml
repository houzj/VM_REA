<Window x:Class="VisionEditor.ShellLockPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示信息" Width="350" Height="200" ResizeMode="NoResize"
        Background="#3B3D40" Foreground="#D0D0D0" FontFamily="Microsoft YaHei"
        FontSize="12" WindowStartupLocation="CenterOwner">
  <Grid Background="#3B3D40">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <TextBlock Text="锁定工作区后，不能编辑流程和模块。是否继续？"
               Margin="30,3,30,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <Border Grid.Row="1" Background="#E4E5E7">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="SkipPrompt" Content="不再显示" Foreground="#303234" Margin="10,0,0,0" Height="26" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ConfirmLock" Content="是" Width="60" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" Click="ConfirmClick"/>
          <Button x:Name="CancelLock" Content="否" Width="60" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" Click="CancelClick"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
