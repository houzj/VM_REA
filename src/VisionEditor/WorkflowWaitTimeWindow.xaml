<Window x:Class="VisionEditor.WorkflowWaitTimeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:source="clr-namespace:VisionPlugins.ImageSource;assembly=VisionPlugins.ImageSource" Width="370" Height="200" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="流程超时设置" Background="#F2F3F5" FontFamily="Microsoft YaHei">
  <!-- Original TimeOutSet.xaml: 370x200, 122px label, 182px slider, 32px footer. -->
  <Border BorderBrush="#161617" BorderThickness="1"><DockPanel>
    <Grid DockPanel.Dock="Top" Height="30" Background="#282A30" MouseLeftButtonDown="DragTitle"><TextBlock Text="流程超时设置" Foreground="#E4E4E4" VerticalAlignment="Center" Margin="10,0"/><Button Content="×" HorizontalAlignment="Right" Width="30" Click="Cancel" Background="Transparent" Foreground="White" BorderThickness="0"/></Grid>
    <Grid DockPanel.Dock="Bottom" Height="32" Background="#E4E4E7"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="确定" Width="66" Height="24" Margin="0,0,14,0" IsDefault="True" Click="Apply"/><Button Content="取消" Width="66" Height="24" Margin="0,0,14,0" IsCancel="True" Click="Cancel"/></StackPanel></Grid>
    <Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="32" Margin="0,0,0,20"><Label Content="流程等待超时(ms)" Width="122" FontSize="14" Margin="26,0,0,0" Foreground="#666666"/><source:WpfNumericControl x:Name="WaitTime" Width="182" FontSize="14" Margin="12,0,0,0"/></StackPanel><TextBlock x:Name="Error" Foreground="DarkRed" VerticalAlignment="Bottom" Margin="26,0,0,3"/></Grid>
  </DockPanel></Border>
</Window>
