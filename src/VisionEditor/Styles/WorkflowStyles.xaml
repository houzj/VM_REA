<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VisionEditor">
<!-- ProcedureConfigControl.TopTabItemStyle; backend-dependent presenters are populated by WorkflowTabs. -->
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkflowDrawings.xaml"/></ResourceDictionary.MergedDictionaries>
<SolidColorBrush x:Key="Col_ProcessBar_Background" Color="#3B3E40"/>
<SolidColorBrush x:Key="Col_ProcessBar_Foreground" Color="#D9D9D9"/>
<SolidColorBrush x:Key="Col_ProcessBar_BorderBrush" Color="#303234"/>
<SolidColorBrush x:Key="Col_ProcessBar_Selected_Background" Color="#46474A"/>
<local:WorkflowExpandIconConverter x:Key="WorkflowExpandIcon"/>
<Style x:Key="WorkflowTabItem" TargetType="TabItem">
 <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource Col_ProcessBar_Foreground}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
  <Grid><Border x:Name="bd" HorizontalAlignment="Center" VerticalAlignment="Center" Height="40" Background="{StaticResource Col_ProcessBar_Background}" BorderThickness="0,0,1,1" BorderBrush="{StaticResource Col_ProcessBar_BorderBrush}"><ContentPresenter ContentSource="Header" SnapsToDevicePixels="True"/></Border></Grid>
  <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Col_ProcessBar_Selected_Background}"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Cursor" Value="Hand"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<!-- Header-only projection of TabControlStyle. The retained independent canvas lives in the following grid row. -->
<Style x:Key="WorkflowTabControl" TargetType="TabControl">
 <Setter Property="Background" Value="{StaticResource Col_ProcessBar_Background}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Local" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="WorkflowImageButton" TargetType="local:WorkflowImageButton">
 <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:WorkflowImageButton"><Image x:Name="con" Stretch="None" Source="{TemplateBinding NormalSource}"/><ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="con" Property="Source" Value="{Binding HoverSource,RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
 <Trigger Property="IsPressed" Value="True"><Setter TargetName="con" Property="Source" Value="{Binding PressedSource,RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
 <Trigger Property="IsEnabled" Value="False"><Setter TargetName="con" Property="Source" Value="{Binding DisabledSource,RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<!-- DiagramGroupListUI.TreeViewItemStyle1: 156x30 label, hidden leaf expander space, hover underline. -->
<Style x:Key="WorkflowTreeItem" TargetType="TreeViewItem">
 <Setter Property="IsExpanded" Value="True"/><Setter Property="Foreground" Value="#BEBEBE"/><Setter Property="Padding" Value="1,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><StackPanel>
 <Grid x:Name="Back" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Width="12" Height="12"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Image Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding IsChecked,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource WorkflowExpandIcon}}"/></ControlTemplate></ToggleButton.Template></ToggleButton>
 <Border Width="156" Height="30" Grid.Column="1" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/></Border>
 <Rectangle x:Name="line" Grid.ColumnSpan="2" Height="1" Fill="#FF7900" VerticalAlignment="Bottom" Visibility="Hidden"/></Grid>
 <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0"/>
 </StackPanel><ControlTemplate.Triggers>
 <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
 <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
 <Trigger SourceName="Back" Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="#26F2F4F6"/><Setter TargetName="line" Property="Visibility" Value="Visible"/><Setter TargetName="PART_Header" Property="TextBlock.Foreground" Value="#FCFCFA"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<ControlTemplate x:Key="WorkflowNgSwitch" TargetType="ToggleButton"><Image x:Name="Icon" Source="{DynamicResource WorkflowNgOff}" Stretch="Fill"/><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Icon" Property="Source" Value="{DynamicResource WorkflowNgOn}"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
<ControlTemplate x:Key="WorkflowNgMenuItem" TargetType="MenuItem"><Border x:Name="Background" Background="{TemplateBinding Background}" MinWidth="156" BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding BorderBrush}" Height="30"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0" VerticalAlignment="Center"><TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"/><ContentPresenter Content="{TemplateBinding Icon}"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Background" Property="Background" Value="#494949"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</ResourceDictionary>
