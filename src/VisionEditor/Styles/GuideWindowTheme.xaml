<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    方案中心主题色。键名与取值均取自原厂主题字典：
    - analysis/decompiled/Apps.ColorFun/colorstyle1.xaml（引导页窗体配色组，第 264-290 行）
    - analysis/decompiled/Apps.ColorFun/colorstyle.xaml（通用文字色，第 42/54/125/126/127 行）
    colorstyle1 为深色主题，与用户提供的原厂截图一致。
  -->
  <SolidColorBrush x:Key="Col_Theme" Color="#E76900" />
  <SolidColorBrush x:Key="Col_Theme_Click" Color="#A0E76900" />
  <SolidColorBrush x:Key="Col_Theme_Mouse" Color="#80E76900" />
  <SolidColorBrush x:Key="Col_Window_TopFill" Color="#FD4F41" />
  <SolidColorBrush x:Key="Col_SubForm_BorderBrush" Color="#323232" />

  <LinearGradientBrush x:Key="Col_GuideWindow_Background" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#1D1D1D" Offset="0" />
    <GradientStop Color="#252525" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Col_GuideWindow_Title_Background" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#131313" Offset="0" />
    <GradientStop Color="#1D1D1D" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Col_GuideWindow_Background_BorderBrush" Color="#404040" />
  <SolidColorBrush x:Key="Col_GuideWindow_Background_Line" Color="#171717" />
  <SolidColorBrush x:Key="Col_GuideWindow_CenterLine" Color="#FF1A1A1A" />
  <SolidColorBrush x:Key="Col_GuideWindow_RightLine" Color="#4D4D4D" />
  <SolidColorBrush x:Key="Col_GuideWindow_Spliter" Color="#4D4D4D" />
  <SolidColorBrush x:Key="Col_GuideWindow_Bottom_Background" Color="#323232" />
  <SolidColorBrush x:Key="Col_GuideWindow_ListView_Foreground" Color="#A6A6A6" />
  <SolidColorBrush x:Key="Col_GuideWindow_ListView_Selected_Foreground" Color="#E6E6E6" />

  <SolidColorBrush x:Key="NormalTextBlockColor" Color="#D1D1D1" />
  <SolidColorBrush x:Key="GuideTextBlockFg" Color="#B8B8B8" />
  <SolidColorBrush x:Key="ToggleButtonFg" Color="#6A6A69" />
  <SolidColorBrush x:Key="ButtonForground" Color="#F2F2F2" />
  <SolidColorBrush x:Key="TextBlockFg" Color="#5C5C5C" />

  <!--
    内容区对角虚线纹理。几何字符串逐字取自原厂 GuideWindow.xaml 第 140-144 行，
    平铺单元 6x6、绝对单位，填充色为 Col_GuideWindow_Background_Line。
  -->
  <DrawingBrush x:Key="GuideDiagonalBrush" Stretch="Fill" TileMode="Tile"
                Viewport="0,0,6,6" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{DynamicResource Col_GuideWindow_Background_Line}"
                       Geometry="M0,2 L1,2 L1,3 L0,3 M1,1 L2,1 L2,2 L1,2 M2,0 L3,0 L3,1 L2,1 M3,5 L4,5 L4,6 L3,6 M4,4 L5,4 L5,5 L4,5 M5,3 L6,3 L6,4 L5,4" />
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
