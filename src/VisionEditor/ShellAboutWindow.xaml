<Window x:Class="VisionEditor.ShellAboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Height="440" Width="400" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F2F3F5" Foreground="#333333" FontFamily="Microsoft YaHei">
  <Grid>
    <Border Background="White" BorderBrush="#D0CCC9" BorderThickness="1"
            CornerRadius="2" Width="350" Margin="20,20,20,20">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Image x:Name="AboutLogo" Width="140" Height="60" HorizontalAlignment="Center"
                 Margin="20" Stretch="Uniform"/>
          <Grid Margin="20,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="版本信息"/>
            <TextBlock x:Name="VersionText" Grid.Column="1" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
