<Window x:Class="VisionEditor.ShellAboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Height="440" Width="400" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F2F3F5" Foreground="#333333" FontFamily="Microsoft YaHei">
  <Grid Background="#F2F3F5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="#D0CCC9" BorderThickness="1"
            CornerRadius="2" Width="350" Margin="20,20,20,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Image x:Name="AboutLogo" Width="140" Height="60" HorizontalAlignment="Center"
                 Margin="20" Stretch="Fill"/>
          <ListBox x:Name="VersionInfoList" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                   IsHitTestVisible="False" Focusable="False">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
