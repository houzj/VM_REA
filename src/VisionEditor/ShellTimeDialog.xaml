<Window x:Class="VisionEditor.ShellTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="耗时查看" Width="370" Height="420" MinWidth="370" MinHeight="260"
        Background="#3B3D40" Foreground="#D0D0D0" FontFamily="Microsoft YaHei"
        FontSize="13" WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="流程耗时" FontWeight="Bold"/>
      <TextBlock x:Name="FlowTimeValue" Margin="5,0,0,0" FontWeight="Bold"/>
      <TextBlock Text=" ms" FontWeight="Bold"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="18,0,18,13">
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="#303234">
        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="模块名称" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBlock Grid.Column="1" Text="工具耗时" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBlock Grid.Column="2" Text="算法耗时" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
      </Grid>
      <ListView x:Name="TimingList" Grid.Row="1" Background="Transparent" Foreground="#D0D0D0" BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListView.ItemTemplate><DataTemplate><Grid Height="34" Background="#383A3C">
          <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding ModuleTime}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding AlgorithmTime}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Window>
