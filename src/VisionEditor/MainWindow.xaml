<Window x:Class="VisionEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionEditor"
        Title="VisionMaster" WindowStyle="None" Width="1366" Height="768"
        MinWidth="800" MinHeight="600" FontFamily="Microsoft YaHei" FontSize="13"
        Background="#3B3D40" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None"
                  UseAeroCaptionButtons="False" CaptionHeight="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/VmScrollbars.xaml"/><ResourceDictionary Source="Styles/ToolboxStyles.xaml"/><ResourceDictionary Source="Styles/WorkflowStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <local:SelectedIndexVisibilityConverter x:Key="IndexToVisibilityConverter"/>
    <Style x:Key="VmTabs" TargetType="TabControl">
      <Setter Property="Background" Value="#3B3D40"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel Grid.Row="0" Background="#3B3D40" IsItemsHost="True"/><Border Grid.Row="1" Background="#3B3D40" BorderBrush="#2D2F31" BorderThickness="1,0,0,0"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#C6C6C6"/><Setter Property="Padding" Value="18,0"/><Setter Property="Height" Value="40"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Bd" Background="#37393B" BorderBrush="#292B2D" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#5A5C5E"/><Setter TargetName="Bd" Property="BorderBrush" Value="#F07800"/><Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#484A4C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlatButton" TargetType="Button"><Setter Property="Foreground" Value="#D0D0D0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#454749"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#292B2D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#D0D0D0"/><Setter Property="Background" Value="#343638"/><Setter Property="BorderBrush" Value="#57595B"/><Setter Property="Padding" Value="6,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#FF7900"/><Setter TargetName="bd" Property="Background" Value="#414345"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#26282A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#C6C6C6"/><Setter Property="Background" Value="#292B2D"/><Setter Property="BorderBrush" Value="#55585A"/><Setter Property="Height" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/><ContentPresenter Margin="8,0,28,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><ToggleButton x:Name="DropButton" Width="26" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><TextBlock Text="▾" Foreground="#C6C6C6" VerticalAlignment="Center" HorizontalAlignment="Center"/></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#292B2D" BorderBrush="#55585A" BorderThickness="1"><ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#3B3D40"/><Setter Property="Foreground" Value="#C6C6C6"/><Setter Property="BorderBrush" Value="#2B2D2F"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Height" Value="38"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Background" Value="#3B3D40"/><Setter Property="Foreground" Value="#C6C6C6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#3B3D40"/><Setter Property="Foreground" Value="#C6C6C6"/></Style>
    <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#3C3C3C" Geometry="M0,0 H12 V12 H0 Z"/><GeometryDrawing Brush="#292B2D" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z"/></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
  </ResourceDictionary></Window.Resources>
  <DockPanel x:Name="WindowContent">
    <Grid x:Name="ShellHeader" DockPanel.Dock="Top" Height="81" Background="#1F1F1F" MouseLeftButtonDown="HeaderMouseDown">
      <Border Height="2" VerticalAlignment="Top" Background="#F1492C"/>
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
        <Image x:Name="Logo" Grid.Column="0" Width="126" Height="53" HorizontalAlignment="Left" Margin="22,14,0,0" VerticalAlignment="Top"/>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="45"/></Grid.RowDefinitions>
          <DockPanel><Menu x:Name="MenuHost" Background="Transparent" Foreground="#C0C0C0" VerticalAlignment="Stretch"/><TextBlock x:Name="SolutionTitle" Foreground="#C0C0C0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/></DockPanel>
          <StackPanel Grid.Row="1" x:Name="ToolBar" Orientation="Horizontal" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="45"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SolutionPathButton" Style="{StaticResource FlatButton}" Background="Transparent" BorderThickness="0" Margin="0,0,12,0" ToolTip="路径：" Loaded="SolutionPathButtonLoaded" ToolTipOpening="SolutionPathTooltipOpening" Click="RevealSolutionPath"><TextBlock x:Name="WindowProjectName" Text="test" Foreground="#C0C0C0" VerticalAlignment="Center"/></Button><Button Style="{StaticResource FlatButton}" Content="◒" Width="28"/><Button Style="{StaticResource FlatButton}" Content="−" Width="34" Click="MinimizeWindow"/><Button Style="{StaticResource FlatButton}" Content="□" Width="34" Click="MaximizeWindow"/><Button Style="{StaticResource FlatButton}" Content="×" Width="34" Click="CloseWindow"/></StackPanel>
          <TextBlock Grid.Row="1" Text="▣ 运行模式" Foreground="#C0C0C0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"/>
        </Grid>
      </Grid>
    </Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="53"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="ToolRail" Grid.Column="0" Grid.RowSpan="2" Background="#222325"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Rail" Background="#222325"/></ScrollViewer><Button x:Name="ToggleToolboxButton" Grid.Row="1" ToolTip="展开工具箱" Height="22" Cursor="Hand" Click="ToggleToolboxClick"><Button.Template><ControlTemplate TargetType="Button"><Grid Background="Black"><Image x:Name="ToolboxFoldImage" HorizontalAlignment="Right" Stretch="None" Source="{DynamicResource ToolboxExpandNormal}" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform ScaleX="1"/></Image.RenderTransform></Image></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolboxFoldImage" Property="Source" Value="{DynamicResource ToolboxExpandHover}"/></Trigger><Trigger Property="Tag" Value="expanded"><Setter TargetName="ToolboxFoldImage" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="-1"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></Grid>
      <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1.0000001*" MinWidth="400"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition x:Name="WorkflowHeaderRow" Height="40"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Background="#3B3E40" SizeChanged="ProcedureBarSizeChanged">
              <local:WorkflowImageButton x:Name="WorkflowViewButton" DockPanel.Dock="Left" Width="36" Height="36" Margin="4,0" ToolTip="全部流程" Click="WorkflowViewClick" Style="{StaticResource WorkflowImageButton}"/>
              <StackPanel x:Name="WorkflowActionsRight" DockPanel.Dock="Right" Orientation="Horizontal" Width="64" HorizontalAlignment="Right">
                <local:WorkflowImageButton x:Name="PinnedAddProcedureButton" Style="{StaticResource WorkflowImageButton}" Width="32" Visibility="Collapsed" ToolTip="添加流程" Click="AddProcedureClick"/>
                <local:WorkflowImageButton x:Name="ProcedureListButton" Style="{StaticResource WorkflowImageButton}" Width="32" ToolTip="流程列表" Click="ProcedureListClick"/>
              </StackPanel>
              <ScrollViewer x:Name="ProcedureTabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><TabControl x:Name="ProcedureTabs" Style="{StaticResource WorkflowTabControl}" ItemContainerStyle="{StaticResource WorkflowTabItem}" SelectionChanged="WorkflowSelectionChanged"/><local:WorkflowImageButton x:Name="AddProcedureButton" Style="{StaticResource WorkflowImageButton}" Width="32" Margin="4,0,0,0" ToolTip="添加流程" Click="AddProcedureClick"/></StackPanel></ScrollViewer>
            </DockPanel>
            <Grid x:Name="CanvasHost" Grid.Row="1" ClipToBounds="True" Background="#494D50">
  <Border x:Name="CanvasViewport" ClipToBounds="True" Background="#494D50"><ScrollViewer x:Name="CanvasScrollViewer" Style="{StaticResource RecScrollViewer}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Focusable="False"><Grid x:Name="GraphSurface" RenderTransformOrigin="0.5,0.5"><Grid Background="#46474A" HorizontalAlignment="Left" VerticalAlignment="Top"><Canvas x:Name="GraphLayer" Width="5000" Height="5000" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid></Grid></ScrollViewer></Border>
  <TextBlock x:Name="Breadcrumb" Foreground="#A9ADB0" FontSize="15" Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
  <Grid x:Name="MiniMapPanel" Width="187" Height="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,11" Background="Transparent"><Canvas x:Name="MiniMapCanvas" Width="187" Height="150" Background="Transparent" MouseLeftButtonDown="MiniMapDown" MouseMove="MiniMapMove" MouseLeftButtonUp="MiniMapUp" PreviewMouseWheel="MiniMapWheel"><Rectangle x:Name="MiniMapPreview" Width="187" Height="150" Stroke="Black" IsHitTestVisible="False"/><Rectangle x:Name="MiniMapViewport" Stroke="#FA6212" Fill="Transparent" StrokeThickness="2" IsHitTestVisible="False"/></Canvas></Grid>
  <Button x:Name="MiniMapToggle" Width="22" Height="22" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,11" ToolTip="收起/展开小地图" Click="MiniMapToggleClick" Style="{StaticResource FlatButton}"/>
  <Grid x:Name="EmptyWorkflowPanel" Visibility="Collapsed" Background="#3B3E40"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image x:Name="EmptyWorkflowImage" Stretch="None" HorizontalAlignment="Center"/><TextBlock Text="暂无流程配置，请添加流程" FontSize="16" Foreground="#4C4C4C" Margin="0,-40,0,16" HorizontalAlignment="Center"/><Button x:Name="EmptyAddWorkflowButton" Width="170" Height="42" Margin="0,8,0,0" Click="AddProcedureClick"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" BorderThickness="1" BorderBrush="#1F0E01" Background="#525356" CornerRadius="2"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF7900"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal"><Image x:Name="EmptyAddImage" Stretch="None" Margin="5,0,0,0" VerticalAlignment="Center"/><Border Width="140" VerticalAlignment="Center"><TextBlock Text="添加流程" FontSize="16" Foreground="#D9D9D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Button></StackPanel></Grid>
</Grid>
          </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#2B2D2F"/>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="5"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Background="#3B3D40"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition x:Name="ImageSourceHeaderRow" Height="0"/><RowDefinition x:Name="ImageSourceItemsRow" Height="0"/></Grid.RowDefinitions><TabControl x:Name="DisplayTabs" Style="{StaticResource VmTabs}" Grid.Row="0" Background="#3B3D40" Foreground="#C5C5C5" SelectionChanged="DisplayTabsChanged"><TabItem Header="图像"/><TabItem Header="模块结果"/></TabControl><DockPanel Grid.Row="1" Background="#323436"><ComboBox x:Name="ImageSelector" Width="190" Margin="10,3" SelectionChanged="ImageSelectorChanged"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource FlatButton}" Content="◫" ToolTip="分屏" IsEnabled="False"/><Button Style="{StaticResource FlatButton}" Content="⊞" ToolTip="布局" IsEnabled="False"/><Button Style="{StaticResource FlatButton}" Content="＋" ToolTip="放大" Click="ZoomPreviewIn"/><Button Style="{StaticResource FlatButton}" Content="－" ToolTip="缩小" Click="ZoomPreviewOut"/><Button Style="{StaticResource FlatButton}" Content="1:1" ToolTip="原始比例" Click="ResetPreviewZoom"/></StackPanel></DockPanel><Border x:Name="ImagePreviewPane" Grid.Row="2" Background="{StaticResource Checkerboard}" Margin="2"><Grid><Image x:Name="Preview" Stretch="Uniform"/><TextBlock x:Name="PreviewImageName" Foreground="#D9D9D9" FontFamily="Microsoft YaHei" FontSize="12" Height="22" MaxWidth="120" Margin="5,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" IsHitTestVisible="False"/><TextBlock x:Name="EmptyImage" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><DataGrid x:Name="ModuleResultsGrid" Grid.Row="2" Visibility="Collapsed" BorderThickness="0" Background="#3B3D40" Foreground="#CCC" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="输出名称" Binding="{Binding Port}" Width="160"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
            <Grid Grid.Row="3" Background="#2C2C2C"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="图像源" Foreground="#B8B8B8" FontWeight="Bold"/><TextBlock x:Name="ImageCountText" Text=" (0/0)" Foreground="#B8B8B8" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="自动切换" Foreground="#B8B8B8" VerticalAlignment="Center"/><CheckBox x:Name="AutoSwitch" IsChecked="True" Margin="8,0" VerticalAlignment="Center" Checked="AutoSwitchChanged" Unchecked="AutoSwitchChanged"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"><ComboBox x:Name="ImageRunMode" Width="112" Height="30" Margin="3,2" SelectedIndex="0" SelectionChanged="ImageRunModeChanged"><ComboBoxItem Content="运行全部"/><ComboBoxItem Content="运行选中"/></ComboBox><Button x:Name="AddImageButton" Width="34" Height="34" Margin="2" ToolTip="添加图像" Click="AddImages" Loaded="InitializeImageSourceButtons"/><Button x:Name="AddFolderButton" Width="34" Height="34" Margin="2" ToolTip="添加图像目录" Click="AddImageFolder"/><Button x:Name="RemoveImageButton" Width="34" Height="34" Margin="2" ToolTip="清空图像" Click="ClearImages"/></StackPanel></Grid>
            <ListBox x:Name="ImageList" Grid.Row="4" Tag="{Binding SelectedIndex,ElementName=ImageRunMode}" Background="#2C2C2C" BorderThickness="0" Foreground="#CCC" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="ImageListSelectionChanged"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="74" Height="66" Margin="2,6" Background="#111" BorderBrush="#555" BorderThickness="1"><Grid MouseLeftButtonDown="ImageItemMouseDown"><Image Source="{Binding Preview}" Stretch="UniformToFill"/><TextBlock Text="{Binding Name}" Foreground="#DDD" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Background="#99000000" Padding="2"/><CheckBox IsChecked="{Binding IsMarked,Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" IsHitTestVisible="False" Focusable="False" Visibility="{Binding Tag,RelativeSource={RelativeSource AncestorType=ListBox},Converter={StaticResource IndexToVisibilityConverter}}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
          <GridSplitter Grid.Row="1" Height="5" VerticalAlignment="Stretch" Background="#2B2D2F"/>
          <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions><TabControl x:Name="BottomTabs" Style="{StaticResource VmTabs}" Grid.Row="0" Background="#3B3D40" Foreground="#CCC"><TabItem Header="历史结果"/><TabItem Header="帮助"/></TabControl><DataGrid x:Name="HistoryGrid" BorderThickness="0" Grid.Row="1" Background="#3B3D40" Foreground="#CCC" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="执行序号" Binding="{Binding Seq}" Width="86"/><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="150"/><DataGridTextColumn Header="模块数据" Binding="{Binding Data}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
        </Grid>
      </Grid>
      <Grid x:Name="WindowStatusBar" Grid.Row="1" Grid.Column="1" Background="#303234"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0"><Image x:Name="StatusIcon" Width="20" Height="20" Stretch="None" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Foreground="#C0C0C0" Margin="8,0,12,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ShowTimeButton" Style="{StaticResource FlatButton}" ToolTip="查看流程耗时明细" Click="ShowTimeClick" Padding="0"><StackPanel Orientation="Horizontal"><TextBlock Text="流程" Foreground="#C0C0C0"/><TextBlock x:Name="ProcessTimeText" Text="0.00" Foreground="#C0C0C0" Margin="5,0,0,0"/><TextBlock Text="ms" Foreground="#C0C0C0"/></StackPanel></Button><Rectangle Width="1" Height="19" Fill="#666" Margin="18,0"/><TextBlock Text="模块" Foreground="#C0C0C0"/><TextBlock x:Name="ModuleTimeText" Text="0.00" Foreground="#C0C0C0" Margin="5,0,0,0"/><TextBlock Text="ms" Foreground="#C0C0C0"/><Rectangle Width="1" Height="19" Fill="#666" Margin="18,0"/><TextBlock Text="算法" Foreground="#C0C0C0"/><TextBlock x:Name="AlgorithmTimeText" Text="0.00" Foreground="#C0C0C0" Margin="5,0,0,0"/><TextBlock Text="ms" Foreground="#C0C0C0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,12,0"><Slider x:Name="ZoomSlider" Width="80" Minimum="0.1" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="1" VerticalAlignment="Center"/><Image x:Name="ZoomIcon" Width="16" Height="16" Margin="2,0,0,0"/><Button x:Name="ResetCanvasZoomButton" Style="{StaticResource FlatButton}" Width="48" Padding="0" Margin="2,0,8,0" Cursor="Hand" ToolTip="恢复 100% 缩放" Click="ResetCanvasZoomClick"><TextBlock x:Name="ZoomValue" Text="100%" Foreground="#C0C0C0" VerticalAlignment="Center"/></Button><TextBlock Text="V4.4.0 Build20250516" Foreground="#C0C0C0" VerticalAlignment="Center"/></StackPanel></Grid>
      </Grid>
  </DockPanel>
</Window>
