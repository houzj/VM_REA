<Window x:Class="VisionEditor.WorkflowLocalVariablesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="997" Height="683" Title="局部变量" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#F2F3F5" FontFamily="Microsoft YaHei" FontSize="14" ShowInTaskbar="False">
 <WindowChrome.WindowChrome><WindowChrome GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False" CaptionHeight="0"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkflowWindowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="#161617" BorderThickness="1"><DockPanel>
  <Grid DockPanel.Dock="Top" Height="30" Background="#282A30" MouseLeftButtonDown="DragTitle"><TextBlock Text="局部变量" Foreground="#E4E4E4" Margin="10,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/><Button Content="×" Width="30" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
  <Grid DockPanel.Dock="Bottom" Height="32" Background="#E4E5E7"><TextBlock x:Name="Error" Foreground="DarkRed" VerticalAlignment="Center" Margin="12,0" FontSize="12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="‹" Click="Previous"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center"/><Button Content="›" Click="Next"/><ComboBox x:Name="PageSize" Width="64" Height="26" Margin="3" SelectionChanged="PageSizeChanged"><ComboBoxItem Content="12" IsSelected="True"/><ComboBoxItem Content="24"/><ComboBoxItem Content="48"/></ComboBox></StackPanel></Grid>
  <Grid Margin="15,10,15,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="TopButton" Content="⇈" ToolTip="置顶" Width="28" Click="MoveTop"/><Button x:Name="UpButton" Content="↑" ToolTip="上移" Width="28" Click="MoveUp"/><Button x:Name="DownButton" Content="↓" ToolTip="下移" Width="28" Click="MoveDown"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="添加变量" Width="94" Height="32" Click="AddVariable"/><Button Content="导入" Width="50" IsEnabled="False" ToolTip="原生 .gvar 格式尚未接入"/><Button Content="导出" Width="50" IsEnabled="False" ToolTip="原生 .gvar 格式尚未接入"/><TextBox x:Name="Search" Width="190" Margin="10,0,0,0" ToolTip="搜索变量名称" TextChanged="SearchChanged"/></StackPanel></DockPanel>
   <DockPanel Grid.Row="1" Margin="0,12,0,0" Background="#FAFAFC"><Button DockPanel.Dock="Right" Content="＋" Width="32" Click="AddGroup"/><TabControl x:Name="GroupTabs" Style="{StaticResource ConfigurationTabs}" SelectionChanged="GroupChanged"/></DockPanel>
   <DataGrid x:Name="Variables" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="None" BorderThickness="0" Background="#FCFCFC" SelectionMode="Single" SelectionChanged="SelectionChanged"/>
  </Grid>
 </DockPanel></Border>
</Window>
