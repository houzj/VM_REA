<Window x:Class="VisionEditor.WorkflowLocalVariablesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="997" Height="683" Title="局部变量" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#F2F3F5" FontFamily="Microsoft YaHei" FontSize="14" ShowInTaskbar="False">
 <WindowChrome.WindowChrome><WindowChrome GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False" CaptionHeight="0"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkflowWindowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="#161617" BorderThickness="1"><DockPanel>
  <Grid DockPanel.Dock="Top" Height="30" Background="#282A30" MouseLeftButtonDown="DragTitle"><TextBlock Text="局部变量" Foreground="#E4E4E4" Margin="10,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/><Button Content="×" Width="30" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
  <Grid DockPanel.Dock="Bottom" Height="32" Background="#E4E5E7"><TextBlock x:Name="Error" Foreground="DarkRed" VerticalAlignment="Center" Margin="12,0" FontSize="12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox x:Name="PageSize" Width="66" Height="26" Margin="3" SelectionChanged="PageSizeChanged"><ComboBoxItem Content="12 条/页" IsSelected="True"/><ComboBoxItem Content="24 条/页"/><ComboBoxItem Content="48 条/页"/></ComboBox><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="6,0"/><TextBlock Text="跳至" VerticalAlignment="Center"/><TextBox x:Name="PageNumber" Width="46" Height="23" Margin="4,0" VerticalContentAlignment="Center"/><TextBlock Text="页" VerticalAlignment="Center"/><Button Content="跳转" Width="48" Margin="6,0,12,0" Click="GoPage"/></StackPanel></Grid>
  <Grid Margin="15,10,15,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="TopButton" Content="⇈" ToolTip="置顶" Width="28" Click="MoveTop"/><Button x:Name="UpButton" Content="↑" ToolTip="上移" Width="28" Click="MoveUp"/><Button x:Name="DownButton" Content="↓" ToolTip="下移" Width="28" Click="MoveDown"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="＋ 添加变量" Width="88" Height="32" Click="AddVariable"/><Button Content="导入" Width="50" IsEnabled="False" ToolTip="原生变量导入格式尚未接入"/><Button Content="导出" Width="50" IsEnabled="False" ToolTip="原生变量导出格式尚未接入"/><Grid Width="190" Margin="10,0,0,0"><TextBox x:Name="Search" ToolTip="搜索变量名称" TextChanged="SearchChanged"/><TextBlock Text="请输入变量名称" Foreground="#999999" Margin="5,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel></DockPanel>
   <DockPanel Grid.Row="1" Margin="0,12,0,0" Background="#FAFAFC"><Button DockPanel.Dock="Right" Content="＋" Width="32" Click="AddGroup"/><TabControl x:Name="GroupTabs" Style="{StaticResource ConfigurationTabs}" SelectionChanged="GroupChanged"/></DockPanel>
   <DataGrid x:Name="Variables" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="None" BorderThickness="0" Background="#FCFCFC" SelectionMode="Single" SelectionChanged="SelectionChanged"/>
  </Grid>
 </DockPanel></Border>
</Window>
