<Window x:Class="VisionEditor.StartupGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionEditor"
        Width="800" Height="546" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#1D1D1D" FontFamily="Microsoft YaHei"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <!--
    几何、模板与触发器逐项对应原厂
    D:/MyWork/SunEyeVision_V2-param-window-datatree/docs/07-工具逆向/decompiled/HostShell/Main/VisionMaster.AppMainWindow/GuideWindow.xaml
    配色取自 analysis/decompiled/Apps.ColorFun/colorstyle1.xaml 与 colorstyle.xaml。
  -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/GuideWindowTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- 原厂 GuideButton 样式与模板（GuideWindow.xaml 第 25-50 行） -->
      <Style x:Key="GuideCardStyle" TargetType="local:GuideCard">
        <Setter Property="Width" Value="188" />
        <Setter Property="Height" Value="130" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource NormalTextBlockColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="local:GuideCard">
              <Grid>
                <Image Name="CardImage" Source="{TemplateBinding BackImage}" Stretch="Fill" SnapsToDevicePixels="True" />
                <ContentPresenter Margin="16,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                <TextBlock Name="CardHelp" Margin="16,0,0,16" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                           FontSize="11" FontWeight="Normal" Foreground="{DynamicResource GuideTextBlockFg}"
                           Text="{TemplateBinding HelpContent}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                  <Setter TargetName="CardHelp" Property="Foreground" Value="{DynamicResource ButtonForground}" />
                  <Setter TargetName="CardImage" Property="Source"
                          Value="{Binding BackImageClick, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 原厂 ToggleButton 样式：18x18 勾选框图标 + 文字（GuideWindow.xaml 第 94-110 行） -->
      <Style x:Key="GuideDoNotShowStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonFg}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <StackPanel Orientation="Horizontal" Background="#00FFFFFF" VerticalAlignment="Top">
                <Image Name="BoxImage" Source="{DynamicResource Img_CheckOff}" Stretch="None"
                       VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="Hand" />
                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="BoxImage" Property="Source" Value="{DynamicResource Img_CheckOn}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 原厂 WinCloseBtnStyle 的独立等价实现：32x32，悬停红底白叉 -->
      <Style x:Key="GuideCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Name="Chrome" Background="{TemplateBinding Background}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="12">
                  <Path Name="Cross" Data="M0,0 L12,12 M12,0 L0,12" Stroke="#C6C6C6" StrokeThickness="1.4" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#E81123" />
                  <Setter TargetName="Cross" Property="Stroke" Value="#FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 原厂 GridViewColumnHeader / ListViewItem（GuideWindow.xaml 第 51-93 行） -->
      <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Col_GuideWindow_ListView_Foreground}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Grid>
                <Border Background="{TemplateBinding Background}">
                  <ContentPresenter Content="{TemplateBinding ContentControl.Content}"
                                    ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                    VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                    RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="3,0,0,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border Background="{TemplateBinding Control.Background}" Margin="0,8,0,0" Height="31"
                      BorderThickness="{TemplateBinding Border.BorderThickness}" SnapsToDevicePixels="True">
                <GridViewRowPresenter VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 底部菜单：原厂 areaGuideLine 的 Menu + IconMenuItem（GuideWindow.xaml 第 193-216 行） -->
      <Style x:Key="GuideFooterMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Menu">
              <Border Background="{TemplateBinding Background}">
                <ItemsPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="GuideFooterItemStyle" TargetType="local:GuideIconMenuItem">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Col_GuideWindow_ListView_Foreground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="local:GuideIconMenuItem">
              <Border Background="#00FFFFFF" Padding="0">
                <StackPanel Orientation="Horizontal">
                  <Image Name="ItemIcon" Source="{TemplateBinding NormalIcon}" Stretch="None" VerticalAlignment="Center" />
                  <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" ContentSource="Header"
                                    RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Col_Theme}" />
                  <Setter TargetName="ItemIcon" Property="Source"
                          Value="{Binding HoverIcon, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Col_Theme}" />
                  <Setter TargetName="ItemIcon" Property="Source"
                          Value="{Binding ClickIcon, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 原厂 sp2：1x40 竖分隔线，左右留白 25/35 -->
      <Style x:Key="GuideFooterSeparatorStyle" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="25,0,35,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Grid Height="40" Width="1">
                <Rectangle VerticalAlignment="Center" HorizontalAlignment="Center"
                           Fill="{DynamicResource Col_GuideWindow_Spliter}" StrokeThickness="0" Width="1" Height="40" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 列头打开按钮：32x32 图标，悬停/点击换图 -->
      <Style x:Key="GuideOpenIconStyle" TargetType="local:GuideIconMenuItem">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="30,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="local:GuideIconMenuItem">
              <Border Background="#00FFFFFF">
                <Image Name="OpenIcon" Source="{TemplateBinding NormalIcon}" Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="OpenIcon" Property="Source"
                          Value="{Binding HoverIcon, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="OpenIcon" Property="Source"
                          Value="{Binding ClickIcon, RelativeSource={RelativeSource TemplatedParent}}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <!--
      内容层与 1px 边框层分离：原厂的 1px 边框走 BaseWindow chrome，不占布局；
      若把 BorderThickness 直接加在内容层上会吃掉 2px，导致卡片区只剩 280 而裁掉第二行。
    -->
    <Border x:Name="GuideSurface" BorderThickness="0" CornerRadius="4" ClipToBounds="True"
            Background="{DynamicResource Col_GuideWindow_Background}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="130" />
        <RowDefinition />
        <RowDefinition Height="78" />
      </Grid.RowDefinitions>

      <!-- 标题栏 130px：顶部 2px 红条 + logo + 版本号 + 不再显示 + 关闭 -->
      <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Col_GuideWindow_Title_Background}"
              MouseLeftButtonDown="TitleBarMouseDown">
        <Grid>
          <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource Col_Window_TopFill}" />
          <Image x:Name="GuideLogo" Width="100" Height="48" Margin="20,9,20,9"
                 HorizontalAlignment="Left" VerticalAlignment="Top" />
          <TextBlock x:Name="VersionText" Text="V4.4.0" Margin="138,37,0,0" HorizontalAlignment="Left"
                     VerticalAlignment="Top" FontStyle="Italic" Foreground="{DynamicResource TextBlockFg}" />
          <ToggleButton x:Name="HideGuide" Style="{StaticResource GuideDoNotShowStyle}" Content="不再显示"
                        Margin="0,0,45,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Checked="HideGuideChecked" Unchecked="HideGuideUnchecked">
            <ToggleButton.RenderTransform>
              <TranslateTransform Y="10" />
            </ToggleButton.RenderTransform>
          </ToggleButton>
          <Button x:Name="GuideCloseButton" Style="{StaticResource GuideCloseButtonStyle}"
                  Margin="0,4,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseClick">
            <Button.RenderTransform>
              <TranslateTransform Y="4" />
            </Button.RenderTransform>
          </Button>
        </Grid>
      </Border>

      <!-- 内容区：对角纹理底 + 底部横向分隔线 -->
      <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Col_GuideWindow_CenterLine}">
        <Border.Background>
          <StaticResource ResourceKey="GuideDiagonalBrush" />
        </Border.Background>
        <Grid>
          <!-- 卡片区块：宽 412、左 55、下 56，高 282，右侧 1px 竖线 -->
          <Border x:Name="CardBlock" Width="412" Margin="55,0,0,56" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" BorderThickness="0,0,1,0"
                  BorderBrush="{DynamicResource Col_GuideWindow_RightLine}">
            <WrapPanel Width="412" HorizontalAlignment="Left" VerticalAlignment="Top">
              <local:GuideCard x:Name="GeneralCard" Style="{StaticResource GuideCardStyle}"
                               Margin="0,0,22,22" ToolBoxType="General"
                               BackImage="{DynamicResource Img_CardGeneral}"
                               BackImageClick="{DynamicResource Img_CardGeneralClick}"
                               HelpContent="建立普通空白方案" Click="GuideCardClick">
                <TextBlock Text="通用方案" Margin="0,10,0,0" />
              </local:GuideCard>
              <local:GuideCard x:Name="PositionCard" Style="{StaticResource GuideCardStyle}"
                               Margin="0,0,0,22" ToolBoxType="Position"
                               BackImage="{DynamicResource Img_CardPosition}"
                               BackImageClick="{DynamicResource Img_CardPositionClick}"
                               HelpContent="通过定位、测量工具进行设计" Click="GuideCardClick">
                <TextBlock Text="定位测量" Margin="0,10,0,0" />
              </local:GuideCard>
              <local:GuideCard x:Name="DefectCard" Style="{StaticResource GuideCardStyle}"
                               Margin="0,0,22,0" ToolBoxType="Defect"
                               BackImage="{DynamicResource Img_CardDefect}"
                               BackImageClick="{DynamicResource Img_CardDefectClick}"
                               HelpContent="借助检测工具查找工件缺陷" Click="GuideCardClick">
                <TextBlock Text="缺陷检测" Margin="0,10,0,0" />
              </local:GuideCard>
              <local:GuideCard x:Name="RecognitionCard" Style="{StaticResource GuideCardStyle}"
                               ToolBoxType="Recognition"
                               BackImage="{DynamicResource Img_CardRecognition}"
                               BackImageClick="{DynamicResource Img_CardRecognitionClick}"
                               HelpContent="通过识别工具进行方案设计" Click="GuideCardClick">
                <TextBlock Text="用于识别" Margin="0,10,0,0" />
              </local:GuideCard>
            </WrapPanel>
          </Border>

          <!-- 最近打开方案：宽 225、右 58、下 56，高度锚定卡片区块 -->
          <ListView x:Name="RecentList" Width="225" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,58,56" Background="#00FFFFFF" BorderThickness="0"
                    Height="{Binding ActualHeight, ElementName=CardBlock}"
                    ItemsSource="{Binding RecentlySolutions, RelativeSource={RelativeSource AncestorType=Window}}"
                    MouseDoubleClick="RecentDoubleClick"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="最近打开方案" Width="140">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Name="NameText" Text="{Binding Name}" ToolTip="{Binding Path}"
                                 Margin="-5,0,0,0" FontSize="16" VerticalAlignment="Center"
                                 HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Col_GuideWindow_ListView_Foreground}" />
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                          <Setter TargetName="NameText" Property="Foreground"
                                  Value="{DynamicResource Col_GuideWindow_ListView_Selected_Foreground}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="80">
                  <GridViewColumn.Header>
                    <local:GuideIconMenuItem x:Name="OpenFileButton" Style="{StaticResource GuideOpenIconStyle}"
                                             NormalIcon="{DynamicResource Img_OpenNormal}"
                                             HoverIcon="{DynamicResource Img_OpenClick}"
                                             ClickIcon="{DynamicResource Img_OpenClick}"
                                             Click="OpenFileClick" />
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Age}" FontSize="14" VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 Foreground="{DynamicResource Col_GuideWindow_ListView_Foreground}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>

          <!-- 标题与列表之间的橙色竖标记 -->
          <Rectangle Height="20" Width="2" Fill="{DynamicResource Col_Theme}" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Margin="0,6,290,0" />
        </Grid>
      </Border>

      <!-- 底栏 78px：三个图标入口 + 1x40 竖分隔线 -->
      <Border Grid.Row="2" Background="{DynamicResource Col_GuideWindow_Bottom_Background}"
              BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Col_GuideWindow_CenterLine}">
        <Menu x:Name="GuideFooter" Style="{StaticResource GuideFooterMenuStyle}"
              VerticalAlignment="Center" HorizontalAlignment="Left" Margin="35,0,0,0">
          <local:GuideIconMenuItem x:Name="FooterItem1" Style="{StaticResource GuideFooterItemStyle}"
                                   Header="学习使用VISIONMASTER" Click="LocalHelpClick"
                                   NormalIcon="{DynamicResource Img_Ic1Normal}"
                                   HoverIcon="{DynamicResource Img_Ic1Click}"
                                   ClickIcon="{DynamicResource Img_Ic1Click}" />
          <Separator Style="{StaticResource GuideFooterSeparatorStyle}" />
          <local:GuideIconMenuItem x:Name="FooterItem2" Style="{StaticResource GuideFooterItemStyle}"
                                   Header="查看示例方案" Click="OpenDemoClick"
                                   NormalIcon="{DynamicResource Img_Ic2Normal}"
                                   HoverIcon="{DynamicResource Img_Ic2Click}"
                                   ClickIcon="{DynamicResource Img_Ic2Click}" />
          <Separator Style="{StaticResource GuideFooterSeparatorStyle}" />
          <local:GuideIconMenuItem x:Name="FooterItem3" Style="{StaticResource GuideFooterItemStyle}"
                                   Header="获取更多支持和帮助" Click="OnlineHelpClick"
                                   NormalIcon="{DynamicResource Img_Ic3Normal}"
                                   HoverIcon="{DynamicResource Img_Ic3Click}"
                                   ClickIcon="{DynamicResource Img_Ic3Click}" />
        </Menu>
      </Border>
    </Grid>
    </Border>
    <!-- 1px 外框，对应原厂 BorderBrush 为 Col_GuideWindow_Background_BorderBrush、圆角 4 -->
    <Border x:Name="GuideShell" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"
            BorderBrush="{DynamicResource Col_GuideWindow_Background_BorderBrush}" />
  </Grid>
</Window>
