<Window x:Class="VisionEditor.RunModeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行策略" Width="560" Height="250" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F2F3F5" Foreground="#4C4C4C" FontFamily="Microsoft YaHei" FontSize="14">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Height="44" Background="#E4E5E7" Padding="8,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="CancelButton" Content="取消" Width="72" Height="28" Margin="0,0,8,0" Click="CancelClick"/>
        <Button x:Name="ApplyButton" Content="确定" Width="72" Height="28" Click="ApplyClick"/>
      </StackPanel>
    </Border>
    <Grid Margin="20,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="运行模式" VerticalAlignment="Center"/>
      <ComboBox x:Name="ModeSelector" Grid.Column="1" Width="182" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                SelectionChanged="ModeSelectionChanged">
        <ComboBoxItem Content="普通模式"/><ComboBoxItem Content="诊断模式"/>
      </ComboBox>
      <TextBlock x:Name="ModeDescription" Grid.Column="1" Grid.Row="1" Foreground="#808080" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4,0,0"/>
    </Grid>
  </DockPanel>
</Window>
