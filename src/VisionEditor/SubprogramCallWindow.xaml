<Window x:Class="VisionEditor.SubprogramCallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1100" Height="680" Title="Group" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#F2F3F5" FontFamily="Microsoft YaHei" FontSize="14" ShowInTaskbar="False">
 <WindowChrome.WindowChrome><WindowChrome GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False" CaptionHeight="0"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkflowWindowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="#161617" BorderThickness="1"><DockPanel>
  <Grid DockPanel.Dock="Top" Height="30" Background="#282A30" MouseLeftButtonDown="DragTitle"><TextBlock x:Name="Heading" Foreground="#E4E4E4" Margin="10,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/><Button Content="×" Width="30" HorizontalAlignment="Right" Click="CloseClick"/></Grid>
  <Grid DockPanel.Dock="Bottom" Height="32" Background="#E4E5E7"><TextBlock x:Name="Error" Foreground="DarkRed" Margin="14,0" VerticalAlignment="Center" FontSize="12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="进入Group" Click="EnterClick"/><Button x:Name="Repeat" Content="连续运行" Click="RepeatClick"/><Button x:Name="Stop" Content="停止运行" Click="StopClick" IsEnabled="False"/><Button x:Name="RunOnce" Content="单次运行" Click="RunClick"/><Button Content="确定" Width="66" Margin="3,0,12,0" Click="CloseClick"/></StackPanel></Grid>
  <Border Margin="14,12" BorderBrush="#E0DFDE" BorderThickness="1" Background="#FCFCFC"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel><StackPanel x:Name="TargetSelectionPanel" DockPanel.Dock="Top" Margin="18,6,2,10"><TextBlock Text="调用流程（独立适配）" Foreground="#666666"/><ComboBox x:Name="Targets" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TargetChanged"/><Button Content="更新接口" Click="UpdateClick" HorizontalAlignment="Right"/></StackPanel><TabControl x:Name="ConfigurationTabs" Style="{StaticResource ConfigurationTabs}" SelectionChanged="TabChanged"><TabItem Header="输入设置"/><TabItem Header="输出设置"/><TabItem Header="运行参数"/><TabItem Header="显示设置"/><TabItem Header="循环设置"/></TabControl></DockPanel>
   <Border Grid.Column="1" BorderBrush="#E0DFDE" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="188"/></Grid.RowDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="图像" Foreground="#666666" Margin="14,0" VerticalAlignment="Center"/><Border Grid.Row="1" Margin="10" Background="#E4E4E4"><Grid><Image x:Name="Preview" Stretch="Uniform"/><Canvas x:Name="DisplayOverlay" ClipToBounds="True" IsHitTestVisible="False"/></Grid></Border></Grid><TabControl Grid.Row="1" Style="{StaticResource ConfigurationTabs}"><TabItem Header="输出结果"><DataGrid x:Name="Results" Margin="18,8" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" Background="#FCFCFC"><DataGrid.Columns><DataGridTextColumn Header="参数名称" Binding="{Binding 名称}" Width="*"/><DataGridTextColumn Header="当前结果" Binding="{Binding 值}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl></Grid></Border>
  </Grid></Border>
 </DockPanel></Border>
</Window>
