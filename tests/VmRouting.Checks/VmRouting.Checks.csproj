<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <OriginalDecompiledRoot Condition="'$(OriginalDecompiledRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../../analysis/decompiled')">$(MSBuildThisFileDirectory)../../analysis/decompiled</OriginalDecompiledRoot>
    <OriginalDecompiledRoot Condition="'$(OriginalDecompiledRoot)' == ''">$(MSBuildThisFileDirectory)../../../../analysis/decompiled</OriginalDecompiledRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VisionEditor.Core/VisionEditor.Core.csproj" />
    <Compile Include="$(OriginalDecompiledRoot)/VMControls.WPF/VMControls.WPF.Base.Astar/*.cs" Link="Oracle/%(Filename)%(Extension)" />
    <Compile Include="$(OriginalDecompiledRoot)/VMControls.WPF/VMControls.WPF.Base/ConnectorOrientation.cs" Link="Oracle/ConnectorOrientation.cs" />
  </ItemGroup>
</Project>
