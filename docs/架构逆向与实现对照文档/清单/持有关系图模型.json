          "excerpt": "   try{foreach(var binding in p.Configuration.Subscriptions.Where(b=>b.NodeId==id)){PortValue value;if(!binding.IsParameter&&d.Inputs.Single(port=>port.Name==binding.Target) is {} deferred&&(deferred.SupportsDeferredNumericRead||deferred.SupportsDeferredIntegerRead||deferred.SupportsDeferredTextRead)){numericIndices.Add(binding.Target,binding.Source.ArrayIndex);try{value=workflow.Resolve(binding.Source with{ArrayIndex=null});}catch(InvalidDataException)when(workflow.CanDeferNumericRead(binding.Source)){continue;}}else value=workflow.Resolve(binding.Source);if(binding.IsParameter)parameters[binding.Target]=WorkflowSubscriptions.Parameter(d.Parameters.Single(p=>p.Name==binding.Target),value);else nodeInputs[binding.Target]=value;}}catch(Exception ex)when(ex is InvalidDataException or OverflowException){Record(NodeRunStatus.Failed,code:\"SubscriptionUnavailable\",message:ex.Message);continue;}",
