        {
          "path": "src/VisionFramework/ModuleExecutionScope.Parameters.cs",
          "member": "Applied parameter cache",
          "sha256": "ec53ae0a59eff823eaf5f7db488fb9db11f8e33d9763fc9a817704f6d99275e3",
          "start": 9,
          "end": 11,
          "excerpt": " public void RememberExecutionParameters(string module,string node,IReadOnlyDictionary<string,JsonElement> seed,IReadOnlyDictionary<string,JsonElement> applied){var state=Parameters(module,node);lock(state.Gate){state.Seed=seed.ToDictionary(p=>p.Key,p=>p.Value.Clone());state.Values=applied.ToDictionary(p=>p.Key,p=>p.Value.Clone());}}\n public IReadOnlyDictionary<string,JsonElement>? ReadEffectiveParameters(string module,string node,IReadOnlyDictionary<string,JsonElement> current){var state=Parameters(module,node);lock(state.Gate){if(state.Values is null)return null;var result=state.Values.ToDictionary(p=>p.Key,p=>p.Value.Clone());foreach(var pair in current)if(state.Seed is null||!state.Seed.TryGetValue(pair.Key,out var old)||old.GetRawText()!=pair.Value.GetRawText())result[pair.Key]=pair.Value.Clone();return result;}}\n public void RememberConfigurationParameters(string module,string node,IReadOnlyDictionary<string,JsonElement> before,IReadOnlyDictionary<string,JsonElement> after,bool reset=false){var state=Parameters(module,node);lock(state.Gate){if(state.Values is null&&!reset)return;state.Seed??=before.ToDictionary(p=>p.Key,p=>p.Value.Clone());state.Values??=new();foreach(var pair in after)if(reset||!before.TryGetValue(pair.Key,out var old)||old.GetRawText()!=pair.Value.GetRawText()){state.Seed[pair.Key]=pair.Value.Clone();state.Values[pair.Key]=pair.Value.Clone();}}}",
          "evidenceType": "current-source",
          "binaryIdentity": "Current independent implementation, not an original runtime layout."
        }
