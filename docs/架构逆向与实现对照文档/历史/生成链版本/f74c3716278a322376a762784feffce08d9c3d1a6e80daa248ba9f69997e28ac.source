'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict');
const site=path.resolve(__dirname,'../../../docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p)),sha=b=>crypto.createHash('sha256').update(b).digest('hex'),esc=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('"','&quot;');
const source='清单/条目/5e6e2ba36bf733a10743.json',raw=read(source),record=JSON.parse(raw),fact=record.original.find(x=>x.id==='execution-storage:Q03');assert(fact&&fact.refs.length);
const nodes=[['compare','setter：新值与旧值比较',450,30],['return','相同：直接返回',90,160],['branch','不同：判断新值',450,160],['start','true：SDK 开始连续脚本',250,290],['stop','false：SDK 停止脚本',650,290],['reset','按流程 ID 重置／加入状态字典',250,420],['clear','清空流程停止状态字典',650,420],['field','成功后：写连续运行字段',450,550],['flags','逐流程 IsGlobalRuning = value',450,680],['notify','通知三个属性',450,810]];
const edges=[['compare','return','同值'],['compare','branch','不同值'],['branch','start','true'],['branch','stop','false'],['start','reset','SDK 返回'],['stop','clear','SDK 返回'],['reset','field',''],['clear','field',''],['field','flags',''],['flags','notify','']].map(([from,to,condition])=>({from,to,condition,factId:fact.id,classification:fact.classification}));
const model={title:'原版全局脚本连续运行 setter：分支与状态提交顺序',source,sourceSha256:sha(raw),factId:fact.id,nodes,edges,fact,unjoined:'此图仅表示这一个 setter 的已证内部顺序；不连接到具体原生回调实例。SDK抛异常发生在字段写入前；native状态与通知异常恢复未知。',browserVerified:false};
const index=new Map(nodes.map(n=>[n[0],n]));
const svg='<svg role="img" aria-label="原版全局脚本连续运行的同值、开始、停止及成功提交分支" viewBox="0 0 900 910"><defs><marker id="state-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10Z" fill="#92d3ff"/></marker></defs>'+edges.map(e=>{const a=index.get(e.from),b=index.get(e.to);return '<g data-state-edge="'+e.from+'-'+e.to+'"><line x1="'+a[2]+'" y1="'+(a[3]+56)+'" x2="'+b[2]+'" y2="'+b[3]+'" stroke="#92d3ff" marker-end="url(#state-arrow)"/><text x="'+((a[2]+b[2])/2+8)+'" y="'+((a[3]+b[3])/2+25)+'" fill="currentColor" font-size="15">'+esc(e.condition)+'</text></g>';}).join('')+nodes.map(([id,label,x,y])=>'<g data-state-node="'+id+'"><rect x="'+(x-175)+'" y="'+y+'" width="350" height="56" rx="8" fill="#132538" stroke="#92d3ff"/><text x="'+x+'" y="'+(y+34)+'" text-anchor="middle" fill="currentColor" font-size="16">'+esc(label)+'</text></g>').join('')+'</svg>';
const refs=fact.refs.map(r=>'<li>'+esc(r.path)+' · '+esc(r.member)+' · SHA256 '+esc(r.sha256)+' · '+r.start+'–'+r.end+'</li>').join('');
const body='<section><h2>'+model.title+'</h2><p class="site-notice">事实级别：source-confirmed（已捕获源码记录），不是原机运行验证。蓝色实线只表示本 setter 的分支和顺序。图中文字和边均由本页机器模型生成。</p><p>'+esc(model.unjoined)+'</p><div class="relation-scroll">'+svg+'</div><h3>源码依据与完整正文</h3><ul>'+refs+'</ul><p>'+esc(fact.behavior)+'</p><p><a href="stop.html#'+fact.id+'">返回原执行对照条目与完整证据</a> · <a href="../清单/停止状态图模型.json">图、来源和未知的机器模型</a></p><h3>未知与失败边界</h3><ul>'+fact.unknowns.map(x=>'<li>'+esc(x)+'</li>').join('')+'</ul></section>';
const file='执行/全局脚本连续状态.html',parent='执行/stop.html';let html=read(parent).toString().replace(/<main id="main-content" class="site-main">[\s\S]*?<\/main>/,'<main id="main-content" class="site-main">'+body.replace('<svg role=','<svg class="relation-svg" role=')+'</main>').replace(/<title>[\s\S]*?<\/title>/,'<title>'+model.title+'</title>');
const manifest=JSON.parse(read('清单/构建清单.json'));
function write(p,s){const b=Buffer.from(s);fs.writeFileSync(path.join(site,p),b);const row={path:p,sha256:sha(b),bytes:b.length},i=manifest.outputs.findIndex(x=>x.path===p);if(i<0)manifest.outputs.push(row);else manifest.outputs[i]=row;}
write(file,html);write('清单/停止状态图模型.json',JSON.stringify(model,null,2)+'\n');
let parentHtml=read(parent).toString();if(!parentHtml.includes('data-stop-state-link'))parentHtml=parentHtml.replace('<main id="main-content" class="site-main">','$&<p class="site-notice" data-stop-state-link><a href="全局脚本连续状态.html">查看全局脚本连续运行：分支与状态提交顺序图 →</a></p>');write(parent,parentHtml);
if(!manifest.pages.some(p=>p.path===file))manifest.pages.push({path:file,title:model.title,kind:'state-diagram'});manifest.counts.pages=manifest.pages.length;
fs.writeFileSync(path.join(site,'清单/构建清单.json'),JSON.stringify(manifest,null,2)+'\n');console.log(JSON.stringify({page:file,nodes:nodes.length,edges:edges.length,sourceFact:fact.id,browserVerified:false}));
