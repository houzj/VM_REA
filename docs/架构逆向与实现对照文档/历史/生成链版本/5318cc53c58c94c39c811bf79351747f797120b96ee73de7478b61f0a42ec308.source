'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict');const site=path.resolve(__dirname,'../../../docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p),'utf8'),sha=s=>crypto.createHash('sha256').update(s).digest('hex'),m=JSON.parse(read('清单/长图分块.json'));let relations=0,parts=0;
for(const p of m.pages){assert.equal(sha(read(p.snapshot)),p.sourceSha256);const html=read(p.page),actual=[...html.matchAll(/<g class="(?:source-confirmed|independent-implementation|unknown)">[\s\S]*?<\/g>/g)].map(m=>sha(m[0].replace(/url\(#arr(?:-part-\d+)?\)/g,'url(#arr)'))),expected=p.figures.flatMap(f=>f.relationPayloadSha256);assert.deepEqual(actual,expected,'Relation payload/order changed '+p.page);for(const svg of html.matchAll(/<svg class="relation-svg"[^>]*viewBox="0 0 890 (\d+)"/g))assert(Number(svg[1])<=850);relations+=actual.length;parts+=p.figures.reduce((n,f)=>n+f.parts,0);}
const result={passed:true,pages:m.pages.length,relations,parts,scope:'Exact normalized relationship markup/order and bounded SVG height; not visual printing acceptance',browserVerified:false};fs.writeFileSync(path.join(site,'清单/长图分块检查.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));
