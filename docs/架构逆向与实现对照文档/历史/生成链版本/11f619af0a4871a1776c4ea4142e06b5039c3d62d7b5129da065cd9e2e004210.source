'use strict';
// File/route/VM substitute checks only. This is deliberately not a browser QA claim.
const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict'),vm=require('vm');
const root=path.resolve(__dirname,'../../..'),site=path.join(root,'docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p)),json=p=>JSON.parse(read(p)),sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const manifest=json('清单/构建清单.json'),baseline=json('清单/拆分前基线.json'),routes=json('清单/旧路由映射.json'),proof=json('清单/证据保留.json'),relations=json('清单/关系投影.json');
assert.equal(manifest.productModified,false);assert.equal(manifest.implementationCredit,0);assert.equal(manifest.oldRootEntryReplaced,false);
let bytes=0;for(const f of manifest.outputs){const b=read(f.path);assert.equal(sha(b),f.sha256,'generated file changed '+f.path);assert.equal(b.length,f.bytes);bytes+=b.length;}
for(const f of baseline.inputs)assert.equal(sha(read(f.snapshot)),f.sha256,'input version not preserved '+f.path);
assert.equal(sha(read('历史/源快照/framework-architecture.html.source.txt')),baseline.sourceMainSha256);
assert.equal(baseline.entries,25);assert.equal(baseline.tools,162);assert.equal(baseline.sourcePages,baseline.inputs.filter(f=>f.path.startsWith('docs/architecture-recovery/')&&f.path.endsWith('.html')).length);assert.equal(baseline.sourcePages,manifest.counts.importedPages);assert.equal(manifest.pages.filter(p=>p.path.startsWith('工具/')&&p.path!=='工具/index.html').length,162);
const pageMap=new Map(manifest.pages.map(p=>[p.path,p])),htmlCache=new Map(),html=p=>{if(!htmlCache.has(p))htmlCache.set(p,read(p).toString());return htmlCache.get(p);};
for(const e of proof.evidence){assert(pageMap.has(e.path));const source=html(e.path),p=/<div id="content">([\s\S]*?)<\/div><h2>返回引用位置/.exec(source);assert(p,'evidence payload missing '+e.path);assert.equal(sha(Buffer.from(p[1])),e.key,'evidence payload changed '+e.path);for(const back of e.backlinks)assert(pageMap.has(back),'lost backlink '+back);}
for(const o of proof.occurrences){assert(proof.evidence.some(e=>e.key===o.key));assert(html(o.page).includes('data-evidence-key="'+o.key+'"'));}
// Every original static <pre> must remain byte-identical in a standalone proof.
const preserved=new Set(proof.evidence.map(e=>e.key));let staticPreBlocks=0;for(const f of baseline.inputs.filter(f=>f.path.endsWith('.html'))){const source=read(f.snapshot).toString().replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi,'');for(const p of source.matchAll(/<pre\b[^>]*>[\s\S]*?<\/pre>/gi)){assert(preserved.has(sha(Buffer.from(p[0]))),'lost original pre block '+f.path);staticPreBlocks++;}}
let internalLinks=0,externalReferences=0;const missing=[],existenceCache=new Map();const exists=p=>{if(!existenceCache.has(p))existenceCache.set(p,fs.existsSync(p));return existenceCache.get(p);};
for(const p of manifest.pages){const source=html(p.path);assert(source.includes('lang="zh-CN"'));assert(source.includes('跳到正文'));assert(source.includes('公共资源/site.css'));assert(source.includes('公共资源/site.js'));for(const m of source.matchAll(/\b(?:href|src)=["']([^"'<>]+)["']/gi)){const value=m[1].replaceAll('&amp;','&');if(/^(?:https?:|data:|file:|mailto:|javascript:)/i.test(value)||value.startsWith('#'))continue;const clean=value.split(/[?#]/)[0];if(!clean)continue;let dest;try{dest=path.resolve(site,path.dirname(p.path),decodeURIComponent(clean));}catch{missing.push({page:p.path,href:value,reason:'bad URL encoding'});continue;}if(dest.startsWith(site+path.sep)){internalLinks++;if(!exists(dest))missing.push({page:p.path,href:value,reason:'internal target absent'});}else externalReferences++;}}
let routeCount=0;for(const [old,dest]of Object.entries(routes)){const p=dest.split('#')[0];assert(pageMap.has(p),'route target absent '+old);routeCount++;}
assert.equal(routes['framework-architecture.html#entry/tabcontinuous'],'入口/tabcontinuous.html');assert(!html('入口/tabcontinuous.html').includes('<iframe'));
const common=new vm.Script(read('公共资源/site.js').toString(),{filename:'site.js'});new vm.Script(read('公共资源/routes.js').toString(),{filename:'routes.js'});
function simulate(key,query=''){let replaced=null;const old=key.split('#')[0],hash=key.includes('#')?'#'+key.split('#').slice(1).join('#'):'';const where=new URL('file:///'+path.join(site,'index.html').replaceAll('\\','/'));where.search='?legacy='+encodeURIComponent(old)+(query?'&'+query:'');where.hash=hash;const context={window:{DOC_ROUTES:routes},document:{documentElement:{dataset:{sitePrefix:'',routeHost:'true',pageKind:'topic'}},getElementById:()=>null,querySelector:()=>null,querySelectorAll:()=>[]},location:{href:where.href,search:where.search,hash:where.hash,replace:u=>replaced=u},URL,URLSearchParams,CSS:{escape:s=>s},history:{pushState(){}},addEventListener(){}};common.runInNewContext(context,{timeout:1000});return replaced;}
for(const key of Object.keys(routes)){const replaced=simulate(key);assert(replaced,'route was not redirected '+key);const actual=new URL(replaced),dest=routes[key];assert.equal(decodeURIComponent(actual.pathname).split('架构逆向与实现对照文档/')[1],dest.split('#')[0]);assert.equal(decodeURIComponent(actual.hash),dest.includes('#')?'#'+dest.split('#').slice(1).join('#'):'');}
const query=simulate('framework-architecture.html#entry/tabcontinuous','project=SunEyeVision.Plugin.SDK&scope=original');assert.equal(new URL(query).searchParams.get('project'),'SunEyeVision.Plugin.SDK');assert.equal(new URL(query).searchParams.get('scope'),'original');
const legacyIndex=html('index.html');assert(Buffer.byteLength(legacyIndex)<150000,'home still embeds giant source models');assert(!legacyIndex.includes('const model='));assert(legacyIndex.includes('data-tool-category'));assert(legacyIndex.includes('data-scene="results"'));
for(const r of relations){assert(pageMap.has(r.page));assert(html(r.page).includes('aria-label="'+String(r.id+' '+r.from+' 到 '+r.to).replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;')+'"'));}
const report={passed:missing.length===0,scope:'Standalone document split: immutable input versions, exact pre retention, local paths and actual common router in a VM DOM substitute',counts:{generatedFiles:manifest.outputs.length,pages:manifest.pages.length,evidencePages:proof.evidence.length,evidenceOccurrences:proof.occurrences.length,staticPreBlocks,oldRoutes:routeCount,routeReplayCases:routeCount,relationshipEdges:relations.length,internalLinks,externalReferences,generatedBytes:bytes},missingLinks:missing,homeBytes:Buffer.byteLength(legacyIndex),oldRootEntryReplaced:false,productModified:false,implementationCredit:0,browserRendered:false,viewportScreenshots:false,printVisuallyVerified:false,keyboardBrowserVerified:false,historyBrowserVerified:false,limitations:manifest.unknowns,sourceDrift:manifest.sourceDrift||[]};
fs.writeFileSync(path.join(site,'清单/静态与路由检查.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({...report,missingLinks:missing.slice(0,12)}));if(missing.length)process.exitCode=1;
