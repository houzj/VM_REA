'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict');const site=path.resolve(__dirname,'../../../docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p),'utf8'),sha=s=>crypto.createHash('sha256').update(s).digest('hex'),m=JSON.parse(read('清单/Group逐轮图模型.json')),frozen=read('历史/分页输入-group-data-pipeline.source'),page=read('数据/Group逐轮保留与退役.html');assert.equal(sha(JSON.stringify(m.sourceRows)),m.sourceRowsSha256);for(const r of m.sourceRows){assert(frozen.includes(r.html));assert(page.includes(r.html));}let relations=0;for(const lane of m.lanes){for(const id of lane.factIds)assert(frozen.includes('id="'+id+'"'));for(let i=0;i<lane.pairs.length;i++){assert(page.includes('data-group-relation="'+lane.id+'-'+i+'"'));relations++;}}assert(page.includes(m.originalUnknown));assert(page.includes(m.moduleBoundary));const report={passed:true,sourceRows:m.sourceRows.length,relations,classification:m.classification,scope:'Frozen stage rows, source anchors, relation/model correspondence and explicit native unknowns; not browser or runtime acceptance',browserVerified:false};fs.writeFileSync(path.join(site,'清单/Group逐轮图检查.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));
