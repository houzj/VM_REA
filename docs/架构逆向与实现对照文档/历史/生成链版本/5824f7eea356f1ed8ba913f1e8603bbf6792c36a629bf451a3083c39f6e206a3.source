'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict');const site=path.resolve(__dirname,'../../../docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p),'utf8'),sha=s=>crypto.createHash('sha256').update(s).digest('hex'),esc=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('"','&quot;'),parent='数据/group-data-pipeline.html',source=read(parent),rows=[...source.matchAll(/<tr data-group-stage="([^"]+)"[^>]*>[\s\S]*?<\/tr>/g)].map(m=>({id:m[1],html:m[0]}));assert.equal(rows.length,5);
const lanes=[{id:'retain',title:'当前成功轮：保留与复制边界',factIds:['CG07','CG08'],pairs:[['成功轮 PortValue 片段','结束时 JoinArray：复制数组','先保留片段，结束再合并'],['GrayImage 列表被替换','仅移除列表中的图像引用','不表示像素 free']]},{id:'retire',title:'当前退役：Group租约与根作用域分别退出',factIds:['CG09','CG10'],pairs:[['Group 本次执行结束','退出本轮租约','不是关闭所有其它会话'],['root scope 关闭','等待全部租约 → 清 state／Dispose','全部租约退出才继续']] }];
const model={parent,sourceRows:rows,sourceRowsSha256:sha(JSON.stringify(rows)),lanes,classification:'independent-implementation',originalUnknown:'原版节点delete与shared条件退役已有OG07；结果最后读者未闭合。不能将当前租约合同画成原版Owner或native最终释放。',moduleBoundary:'module.Dispose 不清 session；此图不把模块结束、Group租约退出、root scope关闭合成同一个动作。',browserVerified:false};
function svg(l){return '<div class="relation-scroll"><svg class="relation-svg" viewBox="0 0 1000 280" role="img" aria-label="'+l.title+'"><defs><marker id="group-'+l.id+'" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10Z" fill="#76d9bb"/></marker></defs>'+l.pairs.map(([a,b,label],i)=>{const y=15+i*130;return '<g data-group-relation="'+l.id+'-'+i+'"><rect x="15" y="'+y+'" width="320" height="70" rx="8" fill="#132538" stroke="#76d9bb"/><text x="30" y="'+(y+42)+'" fill="currentColor" font-size="16">'+esc(a)+'</text><line x1="340" y1="'+(y+35)+'" x2="590" y2="'+(y+35)+'" stroke="#76d9bb" marker-end="url(#group-'+l.id+')"/><text x="465" y="'+(y+99)+'" text-anchor="middle" fill="currentColor" font-size="14">'+esc(label)+'</text><rect x="600" y="'+y+'" width="385" height="70" rx="8" fill="#132538" stroke="#76d9bb"/><text x="615" y="'+(y+42)+'" fill="currentColor" font-size="15">'+esc(b)+'</text></g>';}).join('')+'</svg></div>';}
const body='<h2>Group逐轮数据与退役：保留、复制和等待分别看</h2><p class="site-notice">绿色关系属于当前独立实现。每行表示所列事实自己的数据/退役边界，行序不推导同一对象或线程。原版事实和未知在下方完整阶段表与回链中保留。</p>'+lanes.map(l=>'<section><h3>'+l.title+'</h3><p>来源：'+l.factIds.map(id=>'<a href="group-data-pipeline.html#'+id+'">'+id+'</a>').join(' / ')+'</p>'+svg(l)+'</section>').join('')+'<p>'+model.moduleBoundary+'</p><p class="site-notice">原版未知：'+model.originalUnknown+'</p><h3>五阶段原表：原版／当前证据与差异</h3><div class="source-content"><table><thead><tr><th>问题／阶段</th><th>原版已证与未知</th><th>当前独立实现</th></tr></thead><tbody>'+rows.map(r=>r.html).join('')+'</tbody></table></div><p><a href="group-data-pipeline.html">返回完整Group专题</a> · <a href="../清单/Group逐轮图模型.json">图模型与原阶段表</a></p>';
const file='数据/Group逐轮保留与退役.html',manifest=JSON.parse(read('清单/构建清单.json'));function write(p,s){fs.writeFileSync(path.join(site,p),s);const b=Buffer.from(s),row={path:p,sha256:sha(b),bytes:b.length},i=manifest.outputs.findIndex(x=>x.path===p);if(i<0)manifest.outputs.push(row);else manifest.outputs[i]=row;}
write(file,source.replace(/<main id="main-content" class="site-main">[\s\S]*?<\/main>/,'<main id="main-content" class="site-main">'+body+'</main>').replace(/<title>[\s\S]*?<\/title>/,'<title>Group逐轮保留与退役</title>'));write('清单/Group逐轮图模型.json',JSON.stringify(model,null,2)+'\n');let html=source;if(!html.includes('data-group-flow-link'))html=html.replace('<main id="main-content" class="site-main">','$&<p class="site-notice" data-group-flow-link><a href="Group逐轮保留与退役.html">Group：成功轮保留、数组复制和作用域退役图 →</a></p>');write(parent,html);if(!manifest.pages.some(p=>p.path===file))manifest.pages.push({path:file,title:'Group逐轮保留与退役',kind:'group-data-diagram'});manifest.counts.pages=manifest.pages.length;fs.writeFileSync(path.join(site,'清单/构建清单.json'),JSON.stringify(manifest,null,2)+'\n');console.log(JSON.stringify({page:file,sourceRows:rows.length,relations:4,browserVerified:false}));
