'use strict';
const fs=require('fs'),path=require('path'),crypto=require('crypto'),assert=require('assert/strict');const root=path.resolve(__dirname,'../../..'),site=path.join(root,'docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p)),json=p=>JSON.parse(read(p)),sha=b=>crypto.createHash('sha256').update(b).digest('hex'),esc=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('"','&quot;'),walk=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(dir,e.name)):[path.join(dir,e.name)]),relative=p=>path.relative(site,p).replaceAll('\\','/');
const manifest=json('清单/构建清单.json'),baseline=json('清单/拆分前基线.json'),progress=json('清单/目标验收.json'),repair=json('清单/路由定位修复.json'),drift=json('清单/当前来源漂移.json');
if(process.argv.includes('--seal')){const checks=json('清单/静态与路由检查.json');assert(checks.passed);assert.equal(progress.documentProgress.percentage,75);for(const row of manifest.outputs)assert.equal(sha(read(row.path)),row.sha256,'Post-check file drift '+row.path);const report={id:'DOC-SPLIT-20261022-01',status:'static-delivery-ready-browser-unverified',documentProgress:progress.documentProgress,counts:checks.counts,homeBytes:checks.homeBytes,manifestSha256:sha(read('清单/构建清单.json')),staticCheckSha256:sha(read('清单/静态与路由检查.json')),sourceMainSha256:baseline.sourceMainSha256,currentSourceDrift:drift.changed,unknownRegistrations:repair.unknown.length,scriptIdentity:json('清单/生成链身份.json'),files:walk(site).filter(p=>relative(p)!=='清单/最终交付清单.json').map(p=>({path:relative(p),bytes:fs.statSync(p).size,sha256:sha(fs.readFileSync(p))})),sourceSelfReview:'passed-with-declared-finite-limits',mainAdopted:false,mainValidated:false,independentReviewClosed:false,browserVerified:false,complete:false,implementationCredit:0,nextOwner:'文档角色在获准的浏览器访问条件下完成实际验收；用户/主对话维护者决定根入口接入；独立审核角色按本编号复核。'};fs.writeFileSync(path.join(site,'清单/最终交付清单.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({id:report.id,status:report.status,pages:checks.counts.pages,inventoryFiles:report.files.length,progress:75,complete:false}));process.exit(0);}
function write(p,s){fs.mkdirSync(path.dirname(path.join(site,p)),{recursive:true});fs.writeFileSync(path.join(site,p),s);}
const identities=fs.readdirSync(__dirname).filter(n=>/\.(cjs|js|css|md)$/.test(n)).map(name=>{const bytes=fs.readFileSync(path.join(__dirname,name)),hash=sha(bytes),snapshot='历史/生成链版本/'+hash+'.source';write(snapshot,bytes);return{path:'tests/ArchitectureRecovery/DocumentSplit/'+name,sha256:hash,bytes:bytes.length,snapshot};});write('清单/生成链身份.json',JSON.stringify(identities,null,2)+'\n');
const handoff={id:'DOC-SPLIT-20261022-01',state:'prepared',producer:'document-split / 01a16169-2c2b-7001-8dda-7bc623dd98bf',consumers:['user-selected main document maintainer','independent reviewer'],version:{sourceMain:baseline.sourceMain,sourceMainSha256:baseline.sourceMainSha256,scriptIdentity:'生成链身份.json'},scope:'独立文档目录与专用脚本；不修改产品、原生成链、原根入口或其它工作树',compatibility:{map:'旧路由映射.json',oldRootModified:false,example:'framework-architecture.html#entry/tabcontinuous -> 架构逆向与实现对照文档/index.html#entry/tabcontinuous -> 入口/tabcontinuous.html',suggestedRootForwarder:"location.replace('架构逆向与实现对照文档/index.html'+location.search+location.hash)",precondition:'主维护者先核对当前来源漂移并选择采用版本；本片段仅为待审方案，未写入旧入口。保留旧入口原文件及SHA供回退。',rollback:'根入口维护者恢复其自行保留的原文件；独立目录不影响原生成链。'},validation:{sourceSelfReview:'static/VM checks passed; final inventory seal pending',mainAdopted:false,mainValidated:false,independentReviewClosed:false,browserVerified:false},unknowns:['41条已登记模板/图标标记片段无法定位确切业务正文，已逐条明确说明。','390/768/桌面、打印、实际键盘、前进后退、刷新及离线浏览器运行未验；先前file://策略拒绝，按用户约束不使用localhost或替代浏览器绕过。','909输入清单中原主页面发生漂移；保留捕获基线，不自动纳入主对话新证据。'],nextOwner:'文档角色完成实际浏览器验收；主维护者按用户选择接入；审核角色读取本目录材料复核。',productImplementationCredit:0};write('清单/兼容交接.json',JSON.stringify(handoff,null,2)+'\n');
const file='清单/最终交付.html',body='<h2>交付与验收：75%（3/4批）</h2><p class="site-notice">拆分、证据保留、关系表达与静态／VM兼容检查已交付。实际浏览器验收未通过，目标未完成。</p><ul><li>'+manifest.counts.pages+'个正文页面；25个界面入口、162个工具条目；75个场景页；919个调用边全文页。</li><li>7056条旧路由有静态目标；41条未解析登记明确保留未知，不计语义兼容。</li><li>原主页面SHA '+baseline.sourceMainSha256+'；当前漂移见下方记录。未修改原入口。</li><li>390/768/桌面、打印、键盘、历史、刷新、离线实际浏览器验收均未通过。</li></ul><p><a href="最终交付清单.json">最终文件／检查SHA</a> · <a href="生成链身份.json">生成链与冻结版本</a> · <a href="逐要求审计.json">七项要求逐项审计</a> · <a href="当前来源漂移.json">当前来源漂移</a></p><h3>兼容接入方案（待主维护者采用）</h3><p>主维护者核对来源漂移并选择版本后，可在自己维护的根入口加入兼容转发；本任务未修改该入口。</p><pre>'+esc(handoff.compatibility.suggestedRootForwarder)+'</pre><p>查询和hash原样转入本目录路由宿主。示例：#entry/tabcontinuous 将定位到单项入口。原文件与SHA由主维护者保留以便回退；通知、接收、自审、采用、主程序验证、独立复核分别记录。</p><p><a href="兼容交接.json">交接编号 DOC-SPLIT-20261022-01：版本、消费者、兼容、未知与下一责任人</a></p><h3>未验与限制</h3><ul>'+handoff.unknowns.map(s=>'<li>'+esc(s)+'</li>').join('')+'</ul><p><a href="../index.html">返回首页</a></p>';
if(!fs.existsSync(path.join(site,'清单/最终交付清单.json')))write('清单/最终交付清单.json',JSON.stringify({status:'pending-seal',complete:false,browserVerified:false,meaning:'完整静态检查通过后由 --seal 替换；占位不代表验收通过。'},null,2)+'\n');
const shell=read('清单/交付与兼容.html').toString().replace(/<main id="main-content" class="site-main">[\s\S]*?<\/main>/,'<main id="main-content" class="site-main">'+body+'</main>').replace(/<title>[\s\S]*?<\/title>/,'<title>最终交付与兼容验收</title>');write(file,shell);if(!manifest.pages.some(p=>p.path===file))manifest.pages.push({path:file,title:'最终交付与兼容验收',kind:'delivery'});manifest.counts.pages=manifest.pages.length;
for(const p of ['index.html','framework-architecture.html','清单/交付与兼容.html']){let html=read(p).toString();if(!html.includes('data-final-delivery-link'))html=html.replace('<main id="main-content" class="site-main">','$&<p class="site-notice" data-final-delivery-link><a href="'+(p.startsWith('清单/')?'':'清单/')+'最终交付.html">当前最终交付清单、来源漂移、兼容接入方案与实际未验项 →</a></p>');write(p,html);}
manifest.sourceDrift=drift.changed;manifest.unknowns=handoff.unknowns;manifest.outputs=walk(site).filter(p=>!['清单/构建清单.json','清单/静态与路由检查.json','清单/最终交付清单.json'].includes(relative(p))).map(p=>{const b=fs.readFileSync(p);return{path:relative(p),sha256:sha(b),bytes:b.length};});write('清单/构建清单.json',JSON.stringify(manifest,null,2)+'\n');console.log(JSON.stringify({phase:'prepared',pages:manifest.pages.length,files:manifest.outputs.length,scriptVersions:identities.length,oldRootModified:false,browserVerified:false}));
