const fs=require('fs'),path=require('path'),crypto=require('crypto');const site=path.resolve(__dirname,'../../../docs/架构逆向与实现对照文档'),page='专题/execution-reference.resources/system-architecture-bb84eb2d4c97cca38a9ffd9ddd03166600175301a46ab5f34b592cc44eaf20d4.html',html=fs.readFileSync(path.join(site,page),'utf8'),model=JSON.parse(/<script id="full-project-graph-data" type="application\/json">([\s\S]*?)<\/script>/.exec(html)[1]);console.log(JSON.stringify({keys:Object.keys(model),nodes:model.nodes.length,edges:model.edges.length,sampleNodes:model.nodes.slice(0,2),sampleEdges:model.edges.slice(0,2)}));
const assert=require('assert/strict'),nodes=new Map(model.nodes.map(n=>[n.id,n]));for(const n of nodes.values())assert(n.file&&/^[a-f0-9]{64}$/i.test(n.sha256));
for(const e of model.edges){assert(nodes.has(e.from)&&nodes.has(e.to));const from=nodes.get(e.from),to=nodes.get(e.to);assert(from.references.some(r=>r.file===to.file&&r.declaration===e.declaration),'Edge lacks exact ProjectReference '+e.from+' -> '+e.to);}
const script='公共资源/脚本/e41fc4b2cbd4e47b0983085e5d12d73ceaa6862e3e91c1a97c2f7ce7c6262f77.js',code=fs.readFileSync(path.join(site,script),'utf8');assert(code.includes('data-from="${E(e.from)}" data-to="${E(e.to)}"'));assert(code.includes('marker-end="url(#full-arrow)"'));
const sha=s=>crypto.createHash('sha256').update(s).digest('hex');const report={passed:true,page,pageSha256:sha(html),modelSha256:sha(JSON.stringify(model)),script,scriptSha256:sha(code),program:'SunEyeVision_V2 captured current-source project declarations; independent implementation',nodes:model.nodes.length,edges:model.edges.length,direction:'referencing project -> directly referenced project',exactDeclarationsMatched:true,classification:'independent-implementation',scope:model.scope,meaning:model.meaning,evidenceLimit:model.evidenceLimit,originalProgramDependencies:'Not established by this self-developed project model',nativeBoundary:'NuGet/assembly declarations do not establish native runtime calls, ABI or ownership',browserVerified:false,runtimeExecuted:false};fs.writeFileSync(path.join(site,'清单/工程依赖图检查.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({passed:true,nodes:report.nodes,edges:report.edges,exactDeclarationsMatched:true,browserVerified:false}));
