const fs=require('fs'),path=require('path');const file=path.resolve(__dirname,'../../../docs/架构逆向与实现对照文档/数据/group-data-pipeline.html'),html=fs.readFileSync(file,'utf8');console.log(JSON.stringify([...html.matchAll(/<tr data-group-stage="([^"]+)"[^>]*>([\s\S]*?)<\/tr>/g)].map(m=>({id:m[1],cells:[...m[2].matchAll(/<t[dh][^>]*>([\s\S]*?)<\/t[dh]>/g)].map(c=>c[1].replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim())}))));
