'use strict';
// HOME-NAV-COMPACT-01 / CORE: finite navigation follow-up, no topic regeneration.
const fs=require('fs'),path=require('path'),crypto=require('crypto'),vm=require('vm'),assert=require('assert/strict'),home=require('./home.cjs');
const root=path.resolve(__dirname,'../../..'),site=path.join(root,'docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p)),sha=b=>crypto.createHash('sha256').update(b).digest('hex'),manifest=JSON.parse(read('清单/构建清单.json'));
const targets=[{path:'主题/全景架构.html',label:'整体架构',content:['再向下看五层主链','原版 VisionMaster：从主窗口到 SDK','架构节点：原版、当前及未知'],limit:'Captured partial original/current architecture comparison, not full parity.'},{path:'数据/index.html',label:'数据与数据流',content:['已证的数据传递、缓存与释放关系','parameter-pipeline.html','group-data-pipeline.html'],selection:'Prefer this thematic type/flow/lifecycle index over the 1.68MB entry/data.html entry-fact collection.'},{path:'主题/执行与状态.html',label:'执行链',content:['启动','停止','后台回流'],limit:'Selected execution chains and stated unknowns retained.'}];
for(const t of targets){const source=read(t.path).toString();for(const token of t.content)assert(source.includes(token),'Target scope mismatch '+t.path+' '+token);t.sha256=sha(Buffer.from(source));}
const auditNames=['清单/最终交付清单.json','清单/静态与路由检查.json','清单/目标验收.json','清单/HOME-NAV-COMPACT-01.json','清单/旧路由映射.json'],auditBefore=new Map(auditNames.map(p=>[p,sha(read(p))]));
const before=['index.html','framework-architecture.html','公共资源/home.css'].map(p=>({path:p,sha256:sha(read(p))}));
function write(p,value){const b=Buffer.from(value);fs.writeFileSync(path.join(site,p),b);const row={path:p,bytes:b.length,sha256:sha(b)},i=manifest.outputs.findIndex(f=>f.path===p);if(i<0)manifest.outputs.push(row);else manifest.outputs[i]=row;}
const snapshot='历史/HOME-NAV-COMPACT-01-CORE首页输入.source';if(!fs.existsSync(path.join(site,snapshot)))write(snapshot,read('index.html'));
const data=home.collect(manifest,read('工具/index.html').toString()),output=home.render(data);for(const p of ['index.html','framework-architecture.html'])write(p,output);write('公共资源/home.css',fs.readFileSync(path.join(__dirname,'home.css')));
const nav=/<nav id="main" class="home-core-entries"[\s\S]*?<\/nav>/.exec(output);assert(nav);assert.equal([...nav[0].matchAll(/<a\b/g)].length,3);assert(output.indexOf(nav[0])<output.indexOf('class="site-scene-tabs"'));assert(output.indexOf(nav[0])<output.indexOf('class="home-map"'));assert(output.includes('id="main-content"'));assert(output.includes('按功能找：界面地图'));assert(!output.includes('交付清单与验收状态'));for(const t of targets)assert(nav[0].includes('href="'+t.path+'"'));
let links=0;for(const p of ['index.html','framework-architecture.html'])for(const m of read(p).toString().matchAll(/\b(?:href|src)="([^"]+)"/g)){const url=m[1];if(url.startsWith('#')||/^[a-z]+:/i.test(url))continue;assert(fs.existsSync(path.resolve(site,decodeURIComponent(url.split(/[?#]/)[0]))),'Missing home link '+url);links++;}
// Reuse prior navigation/generator checks with ALL writes intercepted; old reports stay unchanged.
const fakeFs={...fs,writeFileSync(){},mkdirSync(){}},source=fs.readFileSync(path.join(__dirname,'verify-home.cjs'),'utf8');let regressionSummary;
vm.runInNewContext(source,{require:n=>n==='fs'?fakeFs:n==='./home.cjs'?home:require(n),__dirname,console:{log:s=>regressionSummary=JSON.parse(s)},Buffer,URL,URLSearchParams},{timeout:15000});assert(regressionSummary&&regressionSummary.routeCases===7056);
for(const t of targets)assert.equal(sha(read(t.path)),t.sha256,'Topic body modified');for(const [p,h]of auditBefore)assert.equal(sha(read(p)),h,'Prior audit modified');
const sources=['home.cjs','home.css','home-core-entry.cjs'].map(n=>{const b=fs.readFileSync(path.join(__dirname,n)),h=sha(b),s='历史/HOME-NAV-COMPACT-01-CORE生成链-'+h+'.source';write(s,b);return{path:'tests/ArchitectureRecovery/DocumentSplit/'+n,sha256:h,snapshot:s};});
const report={id:'HOME-NAV-COMPACT-01-CORE',state:'implemented-static-vm-checked-browser-pending',owner:'01a16169-2c2b-7001-8dda-7bc623dd98bf',before,targets,sources,homeBytes:Buffer.byteLength(output),coreLinks:3,priority:'three topic entries before functional map',anchors:{main:true,mainContent:true},linksChecked:links,missingTargets:0,regressionSummary,topicBodiesUnchanged:true,priorAuditsUnchanged:auditNames,goalResumed:false,productModified:false,browserVerified:false,viewportStatus:'Actual desktop/mobile rendering remains unverified under the existing browser access restriction; the added row is designed at about 54px plus 10px margin, not measured.',documentGoalProgress:{completed:3,total:4,percentage:75},nextOwner:'Coordinating documentation role reads this record and checks layout; no cross-chat redispatch.'};write('清单/HOME-NAV-COMPACT-01-CORE.json',JSON.stringify(report,null,2)+'\n');fs.writeFileSync(path.join(site,'清单/构建清单.json'),JSON.stringify(manifest,null,2)+'\n');console.log(JSON.stringify({id:report.id,coreLinks:3,homeBytes:report.homeBytes,linksChecked:links,routeCases:regressionSummary.routeCases,topicBodiesUnchanged:true,priorAuditsUnchanged:true,browserVerified:false}));
