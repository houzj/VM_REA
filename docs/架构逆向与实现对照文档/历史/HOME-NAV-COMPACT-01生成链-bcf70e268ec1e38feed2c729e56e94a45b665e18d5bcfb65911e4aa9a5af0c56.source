'use strict';
// Bounded HOME-NAV-COMPACT-01 update; never invokes the full document builder.
const fs=require('fs'),path=require('path'),crypto=require('crypto'),home=require('./home.cjs');
const root=path.resolve(__dirname,'../../..'),site=path.join(root,'docs/架构逆向与实现对照文档'),read=p=>fs.readFileSync(path.join(site,p)),sha=b=>crypto.createHash('sha256').update(b).digest('hex');
function apply(){const manifest=JSON.parse(read('清单/构建清单.json')),original=read('index.html'),before=[],changed=[];
 const files=['index.html','framework-architecture.html','公共资源/home.css','公共资源/site.js','清单/首页维护.html'];for(const p of files)if(fs.existsSync(path.join(site,p)))before.push({path:p,sha256:sha(read(p))});
 function write(p,value){const b=Buffer.from(value);fs.writeFileSync(path.join(site,p),b);const row={path:p,sha256:sha(b),bytes:b.length},i=manifest.outputs.findIndex(x=>x.path===p);if(i<0)manifest.outputs.push(row);else manifest.outputs[i]=row;changed.push(row);}
 const snapshot='历史/HOME-NAV-COMPACT-01首页输入.source';if(!fs.existsSync(path.join(site,snapshot)))write(snapshot,original);
 const scriptSnapshot='历史/HOME-NAV-COMPACT-01公共脚本输入.source';if(!fs.existsSync(path.join(site,scriptSnapshot)))write(scriptSnapshot,read('公共资源/site.js'));
 const data=home.collect(manifest,read('工具/index.html').toString());if(data.entries.length!==25)throw Error('Expected captured 25 UI entries');
 const maintenance='清单/首页维护.html';if(!fs.existsSync(path.join(site,maintenance))||original.toString().includes('<section id="document-delivery"'))write(maintenance,home.maintenance(original.toString()));
 let maintenanceHtml=read(maintenance).toString();if(!maintenanceHtml.includes('data-home-version-note')){maintenanceHtml=maintenanceHtml.replace('<section id="document-delivery"','<p class="site-notice" data-home-version-note>本页集中保存维护与版本记录；交付数字须结合对应版本。旧审计不因首页布局调整而重新验收。</p><section id="document-delivery"');write(maintenance,maintenanceHtml);}
 const output=home.render(data);for(const p of ['index.html','framework-architecture.html'])write(p,output);write('公共资源/home.css',fs.readFileSync(path.join(__dirname,'home.css')));write('公共资源/site.js',fs.readFileSync(path.join(__dirname,'site.js')));
 if(!manifest.pages.some(p=>p.path===maintenance))manifest.pages.push({path:maintenance,title:'首页维护、验收与交付',kind:'maintenance'});manifest.counts.pages=manifest.pages.length;
 const receipt='清单/HOME-NAV-COMPACT-01.json';if(!fs.existsSync(path.join(site,receipt)))fs.writeFileSync(path.join(site,receipt),JSON.stringify({id:'HOME-NAV-COMPACT-01',state:'implementation-prepared-validation-pending',browserVerified:false,complete:false},null,2)+'\n');
 const record={id:'HOME-NAV-COMPACT-01',owner:'01a16169-2c2b-7001-8dda-7bc623dd98bf',ownershipEvidence:'COLLAB-PROTOCOL-20261022-V1.receipt.json retains the two allowed write roots; no formal return recorded, and finite task explicitly reassigned to current writer',before,changed,sourceSnapshot:snapshot,entries:data.entries.length,categories:data.categories.length,goalResumed:false,productModified:false,auditConclusionsModified:false,oldRouteMapSha256:sha(read('清单/旧路由映射.json'))};
 fs.writeFileSync(path.join(__dirname,'HOME-NAV-COMPACT-01.changes.json'),JSON.stringify(record,null,2)+'\n');manifest.incrementalUpdates=[...(manifest.incrementalUpdates||[]),{kind:'HOME-NAV-COMPACT-01',scope:files,sourceEvidenceRescanned:false,implementationCredit:0}];fs.writeFileSync(path.join(site,'清单/构建清单.json'),JSON.stringify(manifest,null,2)+'\n');return record;
}
if(require.main===module)console.log(JSON.stringify(apply()));module.exports={apply};
