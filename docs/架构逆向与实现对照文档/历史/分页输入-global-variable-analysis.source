cc7596a967b86a3d13c526.html#content">查看完整原文／记录 ↗ <small>652d159b8bdc</small></a></details><details><summary>ModuleFrame!FUN_1800f5f40 @ 0x1800f5f40 · 1–82</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800f5f40.c</p><p>SHA256 305662b1fd8acab7ca7f5294155331ff864d14cf04a3a4ee16edba0fa02d5db6 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="f5001c1250f277e9711c3141c09a86a56195f9c81997be495da352ae661972fd" href="../../证据/f5001c1250f277e9711c3141c09a86a56195f9c81997be495da352ae661972fd.html#content">查看完整原文／记录 ↗ <small>f5001c1250f2</small></a></details><details><summary>ModuleFrame!FUN_1800f5f40 @ 0x1800f5f40 · 1–94</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800f5f40.asm.txt</p><p>SHA256 340241f8120d7dd619f207c7a6715b2ab8bcddac1b1436336933854f7bab6473 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="96f4ffcb2f7268ab64b4291c973a3edbb07c8fb3ccf916474a5f694963384402" href="../../证据/96f4ffcb2f7268ab64b4291c973a3edbb07c8fb3ccf916474a5f694963384402.html#content">查看完整原文／记录 ↗ <small>96f4ffcb2f72</small></a></details></details><details data-global-execution-fact="GEX06" id="GEX06"><summary>GEX06 · 原版 · 锁状态与变更通知：不是停止代次门</summary><p>先前 VZ07 已确认 0x9a140 的真实 _Mtx_lock/unlock 和状态分支。本轮取得解锁调用的 0x9a300：仅列表计数 >0 时构造记录（+4 字段为 0x407），经全局函数指针按原汇编所示调用点发送类型 7 回调；随后 0x69c0 对列表中每个对象调用虚表 +0x30 并清零计数。清的是这份变更列表，不是删除全局变量，也没有据此建立“停止后所有旧结果都被拒绝”的证据。</p><p class="dd-gap">回调 +0x407 的最终业务枚举名称、全局指针的实际接收者及虚槽 +0x30 对象语义未运行确认。</p><details><summary>ModuleFrame!FUN_18009a300 @ 0x18009a300 · 1–104</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/18009a300.c</p><p>SHA256 f679954045485d99194bc305593d4ba3c3978275e0aff387c16c4b6a1b92b31c · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="7011c30ecf31320cda16486ed65447e4c597035dd11774caa7a2b0ec7b5625ec" href="../../证据/7011c30ecf31320cda16486ed65447e4c597035dd11774caa7a2b0ec7b5625ec.html#content">查看完整原文／记录 ↗ <small>7011c30ecf31</small></a></details><details><summary>ModuleFrame!FUN_18009a300 @ 0x18009a300 · 1–126</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/18009a300.asm.txt</p><p>SHA256 55c882f6b9d6cee3de87177d3b6536a1b0f4e2efbeff5fe5d2fd3f2f09a75773 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="93306b8bb1da6f185f67ca55405b5173045c3257002d3511ffe58cfc4db5c1c7" href="../../证据/93306b8bb1da6f185f67ca55405b5173045c3257002d3511ffe58cfc4db5c1c7.html#content">查看完整原文／记录 ↗ <small>93306b8bb1da</small></a></details><details><summary>ModuleFrame!FUN_1800069c0 @ 0x1800069c0 · 1–22</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800069c0.c</p><p>SHA256 ebec95cd43b99eb06842e56aea70755fe51be0f9b71c2bbb0a47a0aa3bfd52d9 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="bdfc4aed741098ac544100b1fda4edc2eb8330ed42ac5f1ce7f5a6853860531c" href="../../证据/bdfc4aed741098ac544100b1fda4edc2eb8330ed42ac5f1ce7f5a6853860531c.html#content">查看完整原文／记录 ↗ <small>bdfc4aed7410</small></a></details><details><summary>ModuleFrame!FUN_1800069c0 @ 0x1800069c0 · 1–27</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800069c0.asm.txt</p><p>SHA256 f58474bcc2d6af06b5558c119631505cbb1b23d48437f852396df9f4c347e46d · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="8b102e178be6cecc663aaf15b4ab63557610a021a94eef1580c0b6ab2835a263" href="../../证据/8b102e178be6cecc663aaf15b4ab63557610a021a94eef1580c0b6ab2835a263.html#content">查看完整原文／记录 ↗ <small>8b102e178be6</small></a></details><details><summary>ModuleFrame!FUN_18009a000 @ 0x18009a000 · 1–61</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/18009a000.c</p><p>SHA256 a37c5c1cb4d8e80c78527718229458fe65d0cc4e8c92775e3e05fc09d268b589 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="dee337830b2858ffd4e18bbd42accbda302b505e82511f26566eb4fa9dd2dac6" href="../../证据/dee337830b2858ffd4e18bbd42accbda302b505e82511f26566eb4fa9dd2dac6.html#content">查看完整原文／记录 ↗ <small>dee337830b28</small></a></details><details><summary>ModuleFrame!FUN_18009a000 @ 0x18009a000 · 1–90</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/18009a000.asm.txt</p><p>SHA256 830dfb25a1e34d24348d47b177256c8ab5b30fee03cd9c6ef3a0b584e5a98343 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="c211a5ffe93134df4883f8e021e3124a595860d1cb7b6c90d98231fb2346e31a" href="../../证据/c211a5ffe93134df4883f8e021e3124a595860d1cb7b6c90d98231fb2346e31a.html#content">查看完整原文／记录 ↗ <small>c211a5ffe931</small></a></details></details><details data-global-execution-fact="GEX07" id="GEX07"><summary>GEX07 · 原版 · VmIO 执行计数检查属于结果读取，不是全局变量批次协议</summary><p>VmIO.GetValue 在请求计数既非 uint.MaxValue、又不等于自身或 RelateIO.ExecuteCount，且来源不是 VmConstantIO 时，把 Value 清空并返回 null。get_Value 的关联输入可直接读 RelateIO.Value；其他分支在根流程计数与当前 IO 不一致且非 isSetCallBack 时调用 RefreshResult。这个托管 UI/结果合同不能代替原生算法订阅，更不能将 A 流程计数 N 自动视为 B 流程计数 N 的同一产品。</p><p class="dd-gap">原件 CIL 对应 GetValue=0x0600052f、get_Value=0x0600051e；来源相等分支与 uint.MaxValue 绕过必须保留。</p><details><summary>VmIO.GetValue · 975–1014</summary><p>analysis/decompiled/VM.Core/VM.Core/VmIO.cs</p><p>SHA256 15e1832243422b6bfa2714f300b796d54c365950573639eb1039c5df58e99cb0 · local-decompiled-source · not revalidated in this slice</p><a class="site-evidence-link" data-evidence-key="1ac396a7e4ba289fb7808e4af277102a6db3d27092659325322e7c82d3066264" href="../../证据/1ac396a7e4ba289fb7808e4af277102a6db3d27092659325322e7c82d3066264.html#content">查看完整原文／记录 ↗ <small>1ac396a7e4ba</small></a></details><details><summary>VmIO.Value · 330–367</summary><p>analysis/decompiled/VM.Core/VM.Core/VmIO.cs</p><p>SHA256 15e1832243422b6bfa2714f300b796d54c365950573639eb1039c5df58e99cb0 · local-decompiled-source · not revalidated in this slice</p><a class="site-evidence-link" data-evidence-key="563db53a58c357eff1afe9290f56102aea54f10da3bdd2807d2e2dfc8a09f63a" href="../../证据/563db53a58c357eff1afe9290f56102aea54f10da3bdd2807d2e2dfc8a09f63a.html#content">查看完整原文／记录 ↗ <small>563db53a58c3</small></a></details></details><details data-global-execution-fact="GEX08" id="GEX08"><summary>GEX08 · 原版 · 连续与停止：托管等待 + 选定原生事件等待路径</summary><p>VmProcedure.ContinuousRunEnable=true 先调 ContinousRunStart；false 先调 RefreshUIStopExecute，即使旧标志已为 false 也先进入 SDK。RefreshUIStopExecute 在 Task.Run 内调 StopExecute，只有正常返回才写完成位；外层 SyncWaitor.Wait 等待该位。StopExecute 调 IMVS_StopExecute_V30(handle,processID,3)。另已独立恢复 ModuleFrame.VM_M_StopRunProcedure→0x43cb0→0xdd030：选定普通流程分支发事件、写 +0x7c=0，调 0xda1c0 等 +0x88 句柄，普通分支 3000ms、另一参数分支无限；超时返回 0xe0000300。0xda1c0 的 WaitForSingleObject 调用点参数与返回分支另存汇编。SDK 导出到此 ModuleFrame 停止导出的桥未在本轮证实，因此两链不以同名合并。</p><p class="dd-gap">等待哪个工作线程、何时置完成事件、是否同时排空 SDK/UI 回调队列尚未闭合；返回成功不能扩称所有读者释放、全部迟到写入不可达。</p><details><summary>VmProcedure.ContinuousRunEnable · 176–204</summary><p>analysis/decompiled/VM.Core/VM.Core/VmProcedure.cs</p><p>SHA256 fdde074d17c50c37f8d0bfe097cf20f904cdb4b59d4ac39612fc023c3f0b69da · local-decompiled-source · not revalidated in this slice</p><a class="site-evidence-link" data-evidence-key="7598ffe85779b29f0c049dba6d1428689107702798eebc8c5ce777ee075f9f7d" href="../../证据/7598ffe85779b29f0c049dba6d1428689107702798eebc8c5ce777ee075f9f7d.html#content">查看完整原文／记录 ↗ <small>7598ffe85779</small></a></details><details><summary>ProcessManager stop and wait · 400–427</summary><p>analysis/decompiled/VM.PlatformSDKCS.Audit/VM.PlatformSDKCS/ProcessManager.cs</p><p>SHA256 06fee7c7b5387fea086abe5073be5dd2606ad121d9bc64b0ab9335bace100414 · local-decompiled-source · not revalidated in this slice</p><a class="site-evidence-link" data-evidence-key="667ea6c590f90273ed26db6101cef16c945f563ec0ca62b21145b3822ef03d6a" href="../../证据/667ea6c590f90273ed26db6101cef16c945f563ec0ca62b21145b3822ef03d6a.html#content">查看完整原文／记录 ↗ <small>667ea6c590f9</small></a></details><details><summary>ModuleFrame!VM_M_StopRunProcedure @ 0x18013c250 · 1–51</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/18013c250.c</p><p>SHA256 c98cd96d86cbe5586d0d09807941c8818843545ab84410465e4e439fdac1ab25 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="12807fec7019bc3be593d9f1cd9b80bbdbe236eda3f890573277ef098a92e28c" href="../../证据/12807fec7019bc3be593d9f1cd9b80bbdbe236eda3f890573277ef098a92e28c.html#content">查看完整原文／记录 ↗ <small>12807fec7019</small></a></details><details><summary>ModuleFrame!VM_M_StopRunProcedure @ 0x18013c250 · 1–63</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/18013c250.asm.txt</p><p>SHA256 da4255d14b6e643a56e9c89e9567a28a171e05b63e19482feec72a245920c052 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="e07c5bd7d929f325f1e7d38daf9005560552e695f67a29059ef405fde6255486" href="../../证据/e07c5bd7d929f325f1e7d38daf9005560552e695f67a29059ef405fde6255486.html#content">查看完整原文／记录 ↗ <small>e07c5bd7d929</small></a></details><details><summary>ModuleFrame!FUN_180043cb0 @ 0x180043cb0 · 1–152</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/180043cb0.c</p><p>SHA256 33a5b8199d08d7a3af1964cf9eac1b29a007f45fd3101b34163365aa330d4e28 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="b3cb92517e5921f3064db52468da37eb9e5a86ef6776c44c58a5283183d18092" href="../../证据/b3cb92517e5921f3064db52468da37eb9e5a86ef6776c44c58a5283183d18092.html#content">查看完整原文／记录 ↗ <small>b3cb92517e59</small></a></details><details><summary>ModuleFrame!FUN_180043cb0 @ 0x180043cb0 · 1–185</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/180043cb0.asm.txt</p><p>SHA256 a24fe10db8c1ae3cb63ba57317820baacd26da2e903367d3f7d496e8d69dc487 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="923f1eb6a94e3f44059b1bb94ac434c3aef2b3477bac5ba3d45ee562fc0683d9" href="../../证据/923f1eb6a94e3f44059b1bb94ac434c3aef2b3477bac5ba3d45ee562fc0683d9.html#content">查看完整原文／记录 ↗ <small>923f1eb6a94e</small></a></details><details><summary>ModuleFrame!FUN_1800dd030 @ 0x1800dd030 · 1–59</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800dd030.c</p><p>SHA256 fff78292d3a71d976d8b5d56980714533fa18876c0df6fecb636cfc75bcf6ffe · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="2b2e75276edf69cd1ab9823945a0d367df4a3ee89bb42d883fa70852731c1658" href="../../证据/2b2e75276edf69cd1ab9823945a0d367df4a3ee89bb42d883fa70852731c1658.html#content">查看完整原文／记录 ↗ <small>2b2e75276edf</small></a></details><details><summary>ModuleFrame!FUN_1800dd030 @ 0x1800dd030 · 1–111</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800dd030.asm.txt</p><p>SHA256 d5a19b5df3c384f4e7fe4b3ee99c0ba3c6d39921983fa8a0b69b1b72fa25ca98 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="f4e95f21e50bf98c4018dbbbce0eee372e6bb4c7509055cb584ad28543eda0f1" href="../../证据/f4e95f21e50bf98c4018dbbbce0eee372e6bb4c7509055cb584ad28543eda0f1.html#content">查看完整原文／记录 ↗ <small>f4e95f21e50b</small></a></details><details><summary>ModuleFrame!FUN_1800da1c0 @ 0x1800da1c0 · 1–34</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800da1c0.c</p><p>SHA256 be06be0d0f6e63c6d2a805173ecf6fb8981c80408c5f9e01c8db5ad4490da124 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="0b0741860f5dcef8f09e57b63838a76b2d9a1f5236efa32e7a538de5f6df30ba" href="../../证据/0b0741860f5dcef8f09e57b63838a76b2d9a1f5236efa32e7a538de5f6df30ba.html#content">查看完整原文／记录 ↗ <small>0b0741860f5d</small></a></details><details><summary>ModuleFrame!FUN_1800da1c0 @ 0x1800da1c0 · 1–48</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/1800da1c0.asm.txt</p><p>SHA256 22f376cab47789fd0d3517d88a59914ab46a0e0f6534d0b8939e6165852167cb · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="76348573d263a93fb800f977a6f4c26a1664469aff340f53a2b06c4329c56342" href="../../证据/76348573d263a93fb800f977a6f4c26a1664469aff340f53a2b06c4329c56342.html#content">查看完整原文／记录 ↗ <small>76348573d263</small></a></details></details><details data-global-execution-fact="GEX09" id="GEX09"><summary>GEX09 · 原版 · 迟到托管结果：入口没有按停止代次直接拒收</summary><p>原件 CIL 与反编译体同时确认：MModuleManager_OnModuleResultCallBack 按 result.nModuleID 在 instance.AllModules 找模块；存在则进入 SetValue（Group 另有循环分支）。SetValue 对不同 ExecuteCount 的分支清旧 IO，再将 module.executeCount 直接赋为收到的计数并写入值。它检查“不相等”，不是“新计数必须大于旧计数”。源码路径推演：模块仍存在、当前计数 6、收到计数 5 时，该不同分支本身不会拒绝 5。此为静态条件推演，未执行原版回调实验，也不能证明原生停止上游必定仍会投递。</p><p class="dd-gap">已删模块会因查找失败返回；SDK 已停止后是否还投递已排队结果需实际队列/事件生产端证据。托管结果镜像与原生全局存储不是同一写入点。</p><details><summary>Module result callback ingress · 4191–4224</summary><p>analysis/decompiled/VM.Core/VM.Core/VmSolution.cs</p><p>SHA256 c141e2c53913b233b768782d6757fae5997ecaf638b35db2ddf98f5ef951a13e · local-decompiled-source · not revalidated in this slice</p><a class="site-evidence-link" data-evidence-key="fcb8fe9f2e3f86f976057af7dc43e5ee82ebb3d48d251bd9fa862833bed87524" href="../../证据/fcb8fe9f2e3f86f976057af7dc43e5ee82ebb3d48d251bd9fa862833bed87524.html#content">查看完整原文／记录 ↗ <small>fcb8fe9f2e3f</small></a></details><details><summary>VmSolution.SetValue · 4239–4293</summary><p>analysis/decompiled/VM.Core/VM.Core/VmSolution.cs</p><p>SHA256 c141e2c53913b233b768782d6757fae5997ecaf638b35db2ddf98f5ef951a13e · local-decompiled-source · not revalidated in this slice</p><a class="site-evidence-link" data-evidence-key="0568dcb411a1e2deef32f6aba0523df1e2fb69f7cb99c8ce0314c9b6996aa1ad" href="../../证据/0568dcb411a1e2deef32f6aba0523df1e2fb69f7cb99c8ce0314c9b6996aa1ad.html#content">查看完整原文／记录 ↗ <small>0568dcb411a1</small></a></details></details><details data-global-execution-fact="GEX10" id="GEX10"><summary>GEX10 · 自研 SunEye · 普通参数读取：本轮冻结的 __GlobalVars__ 合成结果</summary><p>WorkflowRunRequest 复制字典容器；WorkflowExecutionEngine 为 RootContext 再建一份字典。每个算法节点执行前，ExecuteAlgorithmNode 从当前 Context.GlobalVariables 构造 GenericToolResults 并放到 __GlobalVars__。AlgorithmNode 把 NodeResults 与 GlobalVariables 交 ToolExecutor；普通参数路径由 ResolveRuntimeParameters→RuntimeParameterSnapshotResolver→ParameterResolver.ResolveDynamic→OutputVariableResolver 消费该合成结果。WorkflowContext.SetNodeResult 只写节点结果表，本身不回填 GlobalVariables。由这些已引用路径可知：建立同流程前置依赖，不能替代普通 __GlobalVars__ 参数的本轮值刷新；此处不宣称所有专用输入都存在同一问题。</p><p class="dd-gap">同流程 __GlobalVars__ 生产消费需要独立执行探针；本次是源码差异定位，不将其写成已运行重现的故障。</p><details><summary>WorkflowRunRequest · 33–39</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/WorkflowRunRequest.cs</p><p>SHA256 9f97a64dd147f5fcd5fefebde422ad390df0aa8fec6f722cf8c105d8143b4ec2 · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="a1f2502b87c68f1d936d348c913256981fa08ba6ad42e3ed5123f732833f4915" href="../../证据/a1f2502b87c68f1d936d348c913256981fa08ba6ad42e3ed5123f732833f4915.html#content">查看完整原文／记录 ↗ <small>a1f2502b87c6</small></a></details><details><summary>RootContext globals · 742–749</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/WorkflowExecutionEngine.cs</p><p>SHA256 4afdc12717c26f142cdc325d4ebac68a4d32f7cf31f1e5d137552c32419b07db · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="4e0df4fbe45bd52d0d0b3e833ceae1fb9134238d0974b7560fc6166e91e10400" href="../../证据/4e0df4fbe45bd52d0d0b3e833ceae1fb9134238d0974b7560fc6166e91e10400.html#content">查看完整原文／记录 ↗ <small>4e0df4fbe45b</small></a></details><details><summary>ExecuteAlgorithmNode · 1115–1140</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/WorkflowExecutionEngine.cs</p><p>SHA256 4afdc12717c26f142cdc325d4ebac68a4d32f7cf31f1e5d137552c32419b07db · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="4f026eac5e5f1c83468ec41a6d1bcf4de1fea77c55e094c0893b8790c23ac122" href="../../证据/4f026eac5e5f1c83468ec41a6d1bcf4de1fea77c55e094c0893b8790c23ac122.html#content">查看完整原文／记录 ↗ <small>4f026eac5e5f</small></a></details><details><summary>AlgorithmNode.ExecuteAsync · 96–118</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/AlgorithmNode.cs</p><p>SHA256 deb8b8ab4068db0aa4f3188adccc84267b0c54707b3c0ec1ac12fe7c55186177 · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="43a78a2021d6d5b985be0a4b4e2b1b93d67b09dd91055f682b5c8bf0bfb8f9f5" href="../../证据/43a78a2021d6d5b985be0a4b4e2b1b93d67b09dd91055f682b5c8bf0bfb8f9f5.html#content">查看完整原文／记录 ↗ <small>43a78a2021d6</small></a></details><details><summary>ToolExecutor.ResolveRuntimeParameters · 461–534</summary><p>D:/MyWork/SunEyeVision_V2/src/Plugin.SDK/Core/ToolExecutor.cs</p><p>SHA256 0229fd6ea68af49b5aefe58187f0036a5987fc69c15f1486cc73113dce6531e2 · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="2fe41fcfe022468e14e44fcf8eee05406df397ee373e45a621a585f460bd2eee" href="../../证据/2fe41fcfe022468e14e44fcf8eee05406df397ee373e45a621a585f460bd2eee.html#content">查看完整原文／记录 ↗ <small>2fe41fcfe022</small></a></details><details><summary>ParameterResolver.ResolveDynamic · 186–252</summary><p>D:/MyWork/SunEyeVision_V2/src/Plugin.SDK/Execution/Parameters/ParameterResolver.cs</p><p>SHA256 7ca4f480e58b2a502d3df455c797f6a0a3cbfc15d4a31ec753e4258322b488c4 · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="7e6b0a1a82688b94d6eb699b5b92e1504d54ddb9794a7024b1f598b1292bed01" href="../../证据/7e6b0a1a82688b94d6eb699b5b92e1504d54ddb9794a7024b1f598b1292bed01.html#content">查看完整原文／记录 ↗ <small>7e6b0a1a8268</small></a></details><details><summary>WorkflowContext.SetNodeResult · 585–592</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/WorkflowContext.cs</p><p>SHA256 1d78dd1155596da902696d7f8ac114b6e67b51d5ae07f940f07409fa8f4896d8 · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="f0f0c5ce8143625f85cbbf59c0c11e7e6cc8527099d9b598ebb965e91d47baf5" href="../../证据/f0f0c5ce8143625f85cbbf59c0c11e7e6cc8527099d9b598ebb965e91d47baf5.html#content">查看完整原文／记录 ↗ <small>f0f0c5ce8143</small></a></details></details><details data-global-execution-fact="GEX11" id="GEX11"><summary>GEX11 · 自研 SunEye · 接收变量是另一条路径，不能与普通参数混为一谈</summary><p>RuntimeVariableReceiveService.ReadVariables 对有生产者的变量优先检查传入 nodeResults 且生产流程匹配，成功时用 OutputVariableResolver 读生产结果；否则有 runtimeValues 就按变量名读它；再否则交 inner.ReadVariables。随后检查非 null、Normalize 和类型。当前引用的引擎 ConvertNodesForExecution 构造 wrapper 时传 null runtimeValues 且没有 nodeResults 参数；方案批次管理器还在外层包 runtimeGlobals。因此应逐入口说明当前来源，不能因为该服务有 nodeResults 分支就声称引擎已向它注入所有本轮节点结果。</p><p class="dd-gap">服务能力、调用者传参和实际消费者路径分别成立；接收工具具体输入／通信接收的完整操作验证仍独立。</p><details><summary>RuntimeVariableReceiveService.ReadVariables · 20–51</summary><p>D:/MyWork/SunEyeVision_V2/src/Plugin.SDK/Models/Communication/RuntimeVariableReceiveService.cs</p><p>SHA256 d3aa479ce9949ad1c875974ee9c70ebfc462e46cefc14d635a7ceed2f307a13f · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="535a5a1a630496d25501ac291c20e38461b0c432973b81844747cd3a7a95a3d0" href="../../证据/535a5a1a630496d25501ac291c20e38461b0c432973b81844747cd3a7a95a3d0.html#content">查看完整原文／记录 ↗ <small>535a5a1a6304</small></a></details><details><summary>execution input wrapper · 886–890</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/WorkflowExecutionEngine.cs</p><p>SHA256 4afdc12717c26f142cdc325d4ebac68a4d32f7cf31f1e5d137552c32419b07db · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="cfa8288b8f74ba6f9e834a5b97c9e16ffc7680acac3dc727ca6903fb5e92e4a0" href="../../证据/cfa8288b8f74ba6f9e834a5b97c9e16ffc7680acac3dc727ca6903fb5e92e4a0.html#content">查看完整原文／记录 ↗ <small>cfa8288b8f74</small></a></details><details><summary>solution override wrapper · 690–694</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="2fc2b6a47408721bb42fd1a6234564bfe6f25f1014a5057d4d789d3fd57b7703" href="../../证据/2fc2b6a47408721bb42fd1a6234564bfe6f25f1014a5057d4d789d3fd57b7703.html#content">查看完整原文／记录 ↗ <small>2fc2b6a47408</small></a></details></details><details data-global-execution-fact="GEX12" id="GEX12"><summary>GEX12 · 自研 SunEye · 跨流程方案批次确有生产→发布→消费链</summary><p>RunSolutionAsync 只把无生产绑定且有效的变量初值放进 runtimeGlobals，按生产／消费者依赖选就绪流程，每次 await 一条后 ApplyProducedGlobalValues。发布先移除该生产者旧值，节点成功且 Result.IsSuccess 才解析写入；失败不以设计初值补洞。整个流程失败仍可能发布其中成功节点的值。后继流程收到的是前面流程完成后形成的批次字典快照，设计期 GlobalVariables.Value 不被该方法写回。</p><p class="dd-gap">这种批次私有顺序保证没有自动覆盖独立后台循环或全部单次 Task.WhenAll 入口；BatchId 字段本身尚非已实现合同。</p><details><summary>RunSolutionAsync · 421–502</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="bfc104d6ea3c97edec9edf9670d9f66c8860b4a638c91c2b2614028e3382327b" href="../../证据/bfc104d6ea3c97edec9edf9670d9f66c8860b4a638c91c2b2614028e3382327b.html#content">查看完整原文／记录 ↗ <small>bfc104d6ea3c</small></a></details><details><summary>BuildWorkflowPredecessors / ApplyProducedGlobalValues · 1026–1101</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="4fa7969d2eca1356a9173d8cde5660b7d5683a070d16ef0df5bf57a22faa526a" href="../../证据/4fa7969d2eca1356a9173d8cde5660b7d5683a070d16ef0df5bf57a22faa526a.html#content">查看完整原文／记录 ↗ <small>4fa7969d2eca</small></a></details></details><details data-global-execution-fact="GEX13" id="GEX13"><summary>GEX13 · 自研 SunEye · 全部单次／全部连续分别有独立入口</summary><p>StartAllWorkflowsRun 通过 workflows.Select(RunSingleAsync) 后 Task.WhenAll；StartAllContinuousRun 则逐个 StartContinuousRun。两者均不是 RunSolutionAsync 的生产依赖批次循环。默认 ExecuteWorkflowInternal 从 globalVariablesOverride ?? _globalVariables 构造请求，SetGlobalVariables 仅保存传入字典引用。持续轮次创建新请求并复制容器，但“复制那一刻的种子字典”不等于已完成跨流程生产者输出发布。</p><p class="dd-gap">没有据此断言其他项目路径永不更新 _globalVariables；已证的是这两入口不走引用的方案批次发布顺序。</p><details><summary>StartAllWorkflowsRun · 408–417</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="3fc59c3b84406ec6fa3a3dd7e80cdb83455f8d1069cd3f9a1192b709015e119d" href="../../证据/3fc59c3b84406ec6fa3a3dd7e80cdb83455f8d1069cd3f9a1192b709015e119d.html#content">查看完整原文／记录 ↗ <small>3fc59c3b8440</small></a></details><details><summary>StartAllContinuousRun · 505–517</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="8eb8f4b4b50b9185b15beefa83d136aac7662b20117d209224728362f8f3c6db" href="../../证据/8eb8f4b4b50b9185b15beefa83d136aac7662b20117d209224728362f8f3c6db.html#content">查看完整原文／记录 ↗ <small>8eb8f4b4b50b</small></a></details><details><summary>run request globals · 826–845</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="e559c63162a60a9dba7a74b216d925d31bb0d2df272745e2d3b9f2502fde385d" href="../../证据/e559c63162a60a9dba7a74b216d925d31bb0d2df272745e2d3b9f2502fde385d.html#content">查看完整原文／记录 ↗ <small>e559c63162a6</small></a></details><details><summary>SetGlobalVariables · 162–166</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="2be800dad782c234cfda304d52e7ca4a253f496f14fc48589c7867cfced61c3e" href="../../证据/2be800dad782c234cfda304d52e7ca4a253f496f14fc48589c7867cfced61c3e.html#content">查看完整原文／记录 ↗ <small>2be800dad782</small></a></details></details><details data-global-execution-fact="GEX14" id="GEX14"><summary>GEX14 · 自研 SunEye · 停止与切方案已有阻止新运行、取消和等待机制</summary><p>BeginSolutionTransition 在锁内设 _transitionBlocked；TryAcquireExecution 在该位为 true 时拒绝新运行。StopAndWaitAsync 在锁内抓取连续、方案和通信 CTS，离锁后 Cancel，再等 IsAnyRunning=false，超时抛异常。MainWindowViewModel.PrepareSolutionTransitionAsync 持过渡租约并等待 30 秒；失败释放租约并保留原方案。连续任务 finally 清理相机 feed、移除任务／CTS、ReleaseExecution。故不能只以 StopAllContinuousRun 的 Cancel 推断自研项目完全没有排空机制。</p><p class="dd-gap">这是等待执行租约结束，未据此证明所有已投递 UI 消息都排空；普通 UI Post 路径与通信专属 token 门要分开。</p><details><summary>transition and drain · 50–90</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="3814fb6c0338fb9f94d98737b863e24d3666c4e58282708f8eb978661d83a6ee" href="../../证据/3814fb6c0338fb9f94d98737b863e24d3666c4e58282708f8eb978661d83a6ee.html#content">查看完整原文／记录 ↗ <small>3814fb6c0338</small></a></details><details><summary>TryAcquireExecution · 552–561</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="bff7450f9017ffb022519e0b239d96dd11d5abc083afaaf6f5a2ab20382fdd7d" href="../../证据/bff7450f9017ffb022519e0b239d96dd11d5abc083afaaf6f5a2ab20382fdd7d.html#content">查看完整原文／记录 ↗ <small>bff7450f9017</small></a></details><details><summary>continuous final cleanup · 342–369</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="4e1dc5aa1787d2f6c13585da5063031b02f19e407dc498f15fb218791d907ebc" href="../../证据/4e1dc5aa1787d2f6c13585da5063031b02f19e407dc498f15fb218791d907ebc.html#content">查看完整原文／记录 ↗ <small>4e1dc5aa1787</small></a></details><details><summary>PrepareSolutionTransitionAsync · 5574–5629</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Shell/Windows/MainWindowViewModel.cs</p><p>SHA256 cca7efe4016cf5def050413689d3c246a5e94e5162687dafe3dd314348530dc5 · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="808d2967d2399de77ca17268d53f02b66bfcf03c7a723570936e8788d7a8abd3" href="../../证据/808d2967d2399de77ca17268d53f02b66bfcf03c7a723570936e8788d7a8abd3.html#content">查看完整原文／记录 ↗ <small>808d2967d239</small></a></details></details><details data-global-execution-fact="GEX15" id="GEX15"><summary>GEX15 · 自研 SunEye · 外层等待不等于所有子任务已退出：finally未等待running任务</summary><p>就绪队列每轮检查取消，正常完成的节点写 Context.SetNodeResult；但该方法 finally 仅 foreach running 并 Dispose 资源租约，没有 await 剩余任务。外层 ExecuteWorkflowCore 捕获 OperationCanceledException 后返回取消结果，管理器因此可能结束本流程租约。静态条件路径：至少两个节点已启动，一个完成后返回循环，取消在下次循环检查被抛出，另一个尚未完成时进入上述 finally。于是 StopAndWaitAsync 等待的外层租约结束，不能单独证明所有工具子任务均已退出；这一选定私有队列路径现已通过合成工具运行重现，详见 GEX25；完整管理器、切方案和 UI 写回尚未运行验证。管理器 ExecuteWorkflowInternal 在 await 后更新展示快照；InvokeOnUI/InvokeOnUIAsync 的显式取消门取决于通信操作的 AsyncLocal token，不能推广成全局 SolutionEpoch 校验。</p><p class="dd-gap">执行租约排空与 UI 队列／全局值发布代次校验是不同保证；本次未观察切方案后实际出现 UI 污染，不能把源码风险直接当已复现缺陷。</p><details><summary>ready queue completion · 290–405</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/WorkflowExecutionEngine.cs</p><p>SHA256 4afdc12717c26f142cdc325d4ebac68a4d32f7cf31f1e5d137552c32419b07db · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="1e942ff32ba685456c33cfa5ed3f26caef8930fa09ef3031b47e575bc80613e4" href="../../证据/1e942ff32ba685456c33cfa5ed3f26caef8930fa09ef3031b47e575bc80613e4.html#content">查看完整原文／记录 ↗ <small>1e942ff32ba6</small></a></details><details><summary>outer cancellation and cleanup · 767–787</summary><p>D:/MyWork/SunEyeVision_V2/src/Workflow/WorkflowExecutionEngine.cs</p><p>SHA256 4afdc12717c26f142cdc325d4ebac68a4d32f7cf31f1e5d137552c32419b07db · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="56d90dac527b81f9520f85b5b1aa3832e4505c9e09cda57aac6ccaf9aade6366" href="../../证据/56d90dac527b81f9520f85b5b1aa3832e4505c9e09cda57aac6ccaf9aade6366.html#content">查看完整原文／记录 ↗ <small>56d90dac527b</small></a></details><details><summary>execution completion · 841–859</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="7319db3462ad84504319a6f32e635c0dac49a2becff3f66adb330305ca7c28fa" href="../../证据/7319db3462ad84504319a6f32e635c0dac49a2becff3f66adb330305ca7c28fa.html#content">查看完整原文／记录 ↗ <small>7319db3462ad</small></a></details><details><summary>UI dispatch token · 1428–1446</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="966785e09d5b59803f263d435f49dc501d63921947894bb796c9e409fb4f8e95" href="../../证据/966785e09d5b59803f263d435f49dc501d63921947894bb796c9e409fb4f8e95.html#content">查看完整原文／记录 ↗ <small>966785e09d5b</small></a></details><details><summary>UI async dispatch · 1441–1475</summary><p>D:/MyWork/SunEyeVision_V2/src/UI/Services/Workflow/WorkflowExecutionManager.cs</p><p>SHA256 e46b941605407be55cd60fd66d9749bb0d8f595d513f82a718b5ac026a9274ae · captured-SunEye-source · source snapshot only; not VM original and not a compiled-product identity</p><a class="site-evidence-link" data-evidence-key="5a3370b581a0e62051755db50f85e126224ab9504b960bc897bdd0cac959ebd5" href="../../证据/5a3370b581a0e62051755db50f85e126224ab9504b960bc897bdd0cac959ebd5.html#content">查看完整原文／记录 ↗ <small>5a3370b581a0</small></a></details></details><details data-global-execution-fact="GEX16" id="GEX16"><summary>GEX16 · 原版 · 先区分存储，再谈“读哪一轮”</summary><p>0x8e6c0 在参数为 0 的分支返回 key=0 的流程输出存储；0x8e910 返回静态全局存储 0x1802b2b50，两者不是同一个容器。但生产绑定的整数写入 0x98630 明确在全局门内调用 0xcae00(0x1802b2b50,变量模块ID)，再交 0xf47f0→0xf3ee0 更新具名值。消费者 0xbb4d0 通过 0xbcd20 识别选定来源后，优先读取同一个静态全局存储。因此该链靠绑定处理把流程输出的值写到全局记录，不要求两个容器共享记录。前一轮“还需共享记录才能连上”的疑问已由目的写入体和消费者分支消除；剩余重点是读写发生的先后及消费者是否被调度约束。</p><p class="dd-gap">0x8e6c0 的非零上下文分支仍单列；本结论限于所取整数绑定与消费者分支，未推广到所有模式。</p><details><summary>frame!FUN_18008e6c0 @ 0x18008e6c0 · 1–132</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/18008e6c0.c</p><p>SHA256 ebfe4ddd1d55a2e4cbc0ab197e7b7fc6c5c57fa87e73f81070b98d0daa504ab3 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="2f1f013c84e8b79da6fe3f87304a54b36e2e6b40ea77c35bacf5d2575245cba8" href="../../证据/2f1f013c84e8b79da6fe3f87304a54b36e2e6b40ea77c35bacf5d2575245cba8.html#content">查看完整原文／记录 ↗ <small>2f1f013c84e8</small></a></details><details><summary>frame!FUN_18008e6c0 @ 0x18008e6c0 · 1–158</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/18008e6c0.asm.txt</p><p>SHA256 ac9da1ea9d32afb825773374915e0c77ab78f9555ac4dac60fedc1b45010f2a4 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="7d4c3005694734e9ab9a41cf884931570b376a31482763ac72ab37ae462a32b4" href="../../证据/7d4c3005694734e9ab9a41cf884931570b376a31482763ac72ab37ae462a32b4.html#content">查看完整原文／记录 ↗ <small>7d4c30056947</small></a></details><details><summary>frame!FUN_18008e910 @ 0x18008e910 · 1–15</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/18008e910.c</p><p>SHA256 7a54021b21197822aea4e6f04809c209fb4f63d7131d2bcb55a68d0fa5ade324 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="ff4f6fa3575145cb4214112385328d421c5212d1178cb2737e6afe8f8b0942c5" href="../../证据/ff4f6fa3575145cb4214112385328d421c5212d1178cb2737e6afe8f8b0942c5.html#content">查看完整原文／记录 ↗ <small>ff4f6fa35751</small></a></details><details><summary>frame!FUN_18008e910 @ 0x18008e910 · 1–21</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/18008e910.asm.txt</p><p>SHA256 2fb2e0e642d54e6ff7bd38b259b6ee3062d85a9403d44962b73ac712bbeddaa2 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="c700f324c603932af4210335159adbd39397251cfcc2830a18d7551cf49d3af3" href="../../证据/c700f324c603932af4210335159adbd39397251cfcc2830a18d7551cf49d3af3.html#content">查看完整原文／记录 ↗ <small>c700f324c603</small></a></details><details><summary>frame!FUN_1800cae00 @ 0x1800cae00 · 1–29</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-store-route/1800cae00.c</p><p>SHA256 00c2847c2f8098ad10f3f8097e6981c9878df5d189d7c6b9a25acdba837fd776 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="78c88518f8a05b482cd27e3522380390dbde5388b35b778389c3a26f0d335c34" href="../../证据/78c88518f8a05b482cd27e3522380390dbde5388b35b778389c3a26f0d335c34.html#content">查看完整原文／记录 ↗ <small>78c88518f8a0</small></a></details><details><summary>frame!FUN_1800cae00 @ 0x1800cae00 · 1–29</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-store-route/1800cae00.asm.txt</p><p>SHA256 3fd04b7b90778bb7f322937af1c6962b617218d3ef595d50c62695c9f09b4e66 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="9725227a98973f1967660b6799195e07b33e1c5530b933d3451ffb023858f1c8" href="../../证据/9725227a98973f1967660b6799195e07b33e1c5530b933d3451ffb023858f1c8.html#content">查看完整原文／记录 ↗ <small>9725227a9897</small></a></details><details><summary>frame!FUN_1800c8f10 @ 0x1800c8f10 · 1–48</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-store-route/1800c8f10.c</p><p>SHA256 52f94c6e551b5d32b9adef5b14d17ebc543559b5a17772bb999f6342ff9cdc53 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="5279509fe61f700e74d79a45e4ef8375f3508420235b6ccfb2561e4c7f365807" href="../../证据/5279509fe61f700e74d79a45e4ef8375f3508420235b6ccfb2561e4c7f365807.html#content">查看完整原文／记录 ↗ <small>5279509fe61f</small></a></details><details><summary>frame!FUN_1800c8f10 @ 0x1800c8f10 · 1–58</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-store-route/1800c8f10.asm.txt</p><p>SHA256 453136ff97c677429a04195f929a385ed7c265584209c142024ffcf27243545f · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="d22f38229f1ee20b000b4599ad329e3c95058c6d1f737a0b290c24bbd96817dc" href="../../证据/d22f38229f1ee20b000b4599ad329e3c95058c6d1f737a0b290c24bbd96817dc.html#content">查看完整原文／记录 ↗ <small>d22f38229f1e</small></a></details><details><summary>ModuleFrame!FUN_180098630 @ 0x180098630 · 1–80</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/180098630.c</p><p>SHA256 eb4b7029a0172a983a02ad4e11d08d9450ed55bf89fdd6d59cb55d420dda7f84 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="9fb66d67b28280be50a2779efa0f357ad0c9a57f2026f3767f0cd0a6af181037" href="../../证据/9fb66d67b28280be50a2779efa0f357ad0c9a57f2026f3767f0cd0a6af181037.html#content">查看完整原文／记录 ↗ <small>9fb66d67b282</small></a></details><details><summary>ModuleFrame!FUN_180098630 @ 0x180098630 · 1–109</summary><p>docs/architecture-recovery/global-variable-execution.resources/native/180098630.asm.txt</p><p>SHA256 f69db98e461e04e5e6c0f091ee86f1a1c455dc0c7422d8046857f50565ca7d21 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="0cd091a278dca7957eb718fa12433cb675ab68fd0c366dc17b4a49b2f650841e" href="../../证据/0cd091a278dca7957eb718fa12433cb675ab68fd0c366dc17b4a49b2f650841e.html#content">查看完整原文／记录 ↗ <small>0cd091a278dc</small></a></details></details><details data-global-execution-fact="GEX17" id="GEX17"><summary>GEX17 · 原版 · 停止等待事件先置位，尾部通知和收尾回调随后执行</summary><p>0xde620 用 CreateEventW(NULL, TRUE, TRUE, NULL) 创建 +0x80 与 +0x88。0xdcc80 在启动前 ResetEvent(+0x80/+0x88/+0x90)，再提交工作入口 0xdd330。0xdd330 离开循环后先 SetEvent(+0x88)，随后置 +0xe9=0、处理单次状态通知、清连续标志、调用 0xde180(...,3,...)，再调用 +0x1c8 的可选函数对象，最后置 +0x1d0=1 并 SetEvent(+0x98)。0xde180 在已恢复的分支中读取流程 ID +0x50 和执行计数 +0xe0，并经全局函数指针发送类型 6 的状态回调。因此 0xdd030 等待 +0x88 成功，只能证明到达该置位点，不能证明其后的状态通知和收尾函数已经结束。</p><p class="dd-gap">这是同一函数内的静态先后顺序，不是原机已经复现迟到写回。+0x1c8 回调具体目标、托管投递队列的排空，以及最后一次全局写入与此处的关联仍待证；+0x98 也不能未经调用方核查就当产品停止屏障。</p><details><summary>frame!FUN_1800de620 @ 0x1800de620 · 1–67</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800de620.c</p><p>SHA256 740465a96c9e3b21df0aaf8c5974bcb1ef37a84f6c2db0a57c7f65dd5ef2ca1a · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="f1631514e322839ea0707b5941af9180ab9bce44bb49966ed3aa7d43ae827743" href="../../证据/f1631514e322839ea0707b5941af9180ab9bce44bb49966ed3aa7d43ae827743.html#content">查看完整原文／记录 ↗ <small>f1631514e322</small></a></details><details><summary>frame!FUN_1800de620 @ 0x1800de620 · 1–81</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800de620.asm.txt</p><p>SHA256 d0df56d07a2d694ef0879d8095b67db77b8c7d85c2211ad4db02ef5c2a1328b9 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="867c388a7177a4f7688351ea5f8915fe47337dc063ebecc70f85ed6c204158ff" href="../../证据/867c388a7177a4f7688351ea5f8915fe47337dc063ebecc70f85ed6c204158ff.html#content">查看完整原文／记录 ↗ <small>867c388a7177</small></a></details><details><summary>frame!FUN_1800dcc80 @ 0x1800dcc80 · 1–187</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800dcc80.c</p><p>SHA256 18943f972c004a499dde527362bec2550345c567170c6400e00f5fa8d0c195ae · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="c060d762267d670a67504fc0ce24c51036df0c51bc2a09b33eed18e844230a17" href="../../证据/c060d762267d670a67504fc0ce24c51036df0c51bc2a09b33eed18e844230a17.html#content">查看完整原文／记录 ↗ <small>c060d762267d</small></a></details><details><summary>frame!FUN_1800dcc80 @ 0x1800dcc80 · 1–235</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800dcc80.asm.txt</p><p>SHA256 3c0cbc5195be49752af5e73fb8293ccf1ab548b2bdf93c29c2fcb76c44abafc3 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="b2fd9e7e384780591d60f295ce785030c348e58c5eb239160687248a6517f716" href="../../证据/b2fd9e7e384780591d60f295ce785030c348e58c5eb239160687248a6517f716.html#content">查看完整原文／记录 ↗ <small>b2fd9e7e3847</small></a></details><details><summary>frame!FUN_1800dd330 @ 0x1800dd330 · 1–446</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800dd330.c</p><p>SHA256 290c0483196e2d928b95ca2c98df89353d391531be97a7796d3ff001bf8f979e · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="c7771f6f281b778a3e5fab20436aff7243bb49da1c0069dc5361e5ec32a12d12" href="../../证据/c7771f6f281b778a3e5fab20436aff7243bb49da1c0069dc5361e5ec32a12d12.html#content">查看完整原文／记录 ↗ <small>c7771f6f281b</small></a></details><details><summary>frame!FUN_1800dd330 @ 0x1800dd330 · 1–615</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800dd330.asm.txt</p><p>SHA256 46f97ca2bae439225babdd07db39f6446bd626fd054f804d1d697b70e8793939 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="db17ca245863aba8d856b4a1b4cc047be834761e56d2570daddcf0ce42ddca6e" href="../../证据/db17ca245863aba8d856b4a1b4cc047be834761e56d2570daddcf0ce42ddca6e.html#content">查看完整原文／记录 ↗ <small>db17ca245863</small></a></details><details><summary>frame!FUN_1800de180 @ 0x1800de180 · 1–183</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/1800de180.c</p><p>SHA256 17e84c8d5f60dcc7b1056a5c30bac53bd0026bc17772d514ece12c9c416bed47 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="36dbd694af5632ebcf6cce8ecfb1d33373d1b54959b98dd937def0db50e82821" href="../../证据/36dbd694af5632ebcf6cce8ecfb1d33373d1b54959b98dd937def0db50e82821.html#content">查看完整原文／记录 ↗ <small>36dbd694af56</small></a></details><details><summary>frame!FUN_1800de180 @ 0x1800de180 · 1–246</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/1800de180.asm.txt</p><p>SHA256 c96f2a11d94cb663b566ee8b2b2762968cbcd637ffbbdd63443e57920e6941c3 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="85eaf8cbfd7a33fa063c92e89364115dbedcd0fb67608642d4eab301e2baed9d" href="../../证据/85eaf8cbfd7a33fa063c92e89364115dbedcd0fb67608642d4eab301e2baed9d.html#content">查看完整原文／记录 ↗ <small>85eaf8cbfd7a</small></a></details></details><details data-global-execution-fact="GEX18" id="GEX18"><summary>GEX18 · 原版 · 连续运行计数属于所选流程记录，不能拿相等数字配跨流程批次</summary><p>0xdd330 在所选轮次准备路径取得流程模块记录，对该记录 +0xe4 做原子递增，并把递增后的数值复制到当前执行对象 +0xe0；随后发运行状态、准备报告变量并调用所持函数对象执行本轮工作。该计数的更新点位于本轮工作之前。原体显示的是当前流程记录和执行对象，未出现为所有流程分配同一批次号的共同协调器。与托管 VmIO.ExecuteCount 的比较规则合看时，必须分别说明本流程执行计数、结果镜像计数及方案批次身份，不能因 A、B 都显示数字 5 就认定是同一批数据。</p><p class="dd-gap">仍需追 +0xc8 函数对象的具体目标和上层跨流程等待，才能判断消费者此时读取哪个生产者版本；本条不证明所有执行模式使用相同计数。</p><details><summary>frame!FUN_1800dd330 @ 0x1800dd330 · 1–446</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800dd330.c</p><p>SHA256 290c0483196e2d928b95ca2c98df89353d391531be97a7796d3ff001bf8f979e · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="c7771f6f281b778a3e5fab20436aff7243bb49da1c0069dc5361e5ec32a12d12" href="../../证据/c7771f6f281b778a3e5fab20436aff7243bb49da1c0069dc5361e5ec32a12d12.html#content">查看完整原文／记录 ↗ <small>c7771f6f281b</small></a></details><details><summary>frame!FUN_1800dd330 @ 0x1800dd330 · 1–615</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-stop-producer/1800dd330.asm.txt</p><p>SHA256 46f97ca2bae439225babdd07db39f6446bd626fd054f804d1d697b70e8793939 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="db17ca245863aba8d856b4a1b4cc047be834761e56d2570daddcf0ce42ddca6e" href="../../证据/db17ca245863aba8d856b4a1b4cc047be834761e56d2570daddcf0ce42ddca6e.html#content">查看完整原文／记录 ↗ <small>db17ca245863</small></a></details><details><summary>frame!FUN_1800de180 @ 0x1800de180 · 1–183</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/1800de180.c</p><p>SHA256 17e84c8d5f60dcc7b1056a5c30bac53bd0026bc17772d514ece12c9c416bed47 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="36dbd694af5632ebcf6cce8ecfb1d33373d1b54959b98dd937def0db50e82821" href="../../证据/36dbd694af5632ebcf6cce8ecfb1d33373d1b54959b98dd937def0db50e82821.html#content">查看完整原文／记录 ↗ <small>36dbd694af56</small></a></details><details><summary>frame!FUN_1800de180 @ 0x1800de180 · 1–246</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/1800de180.asm.txt</p><p>SHA256 c96f2a11d94cb663b566ee8b2b2762968cbcd637ffbbdd63443e57920e6941c3 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="85eaf8cbfd7a33fa063c92e89364115dbedcd0fb67608642d4eab301e2baed9d" href="../../证据/85eaf8cbfd7a33fa063c92e89364115dbedcd0fb67608642d4eab301e2baed9d.html#content">查看完整原文／记录 ↗ <small>85eaf8cbfd7a</small></a></details></details><details data-global-execution-fact="GEX19" id="GEX19"><summary>GEX19 · 原版 · 索引助手必须按汇编恢复返回值，不能照抄 void 伪码</summary><p>0x99be0 的伪代码显示 void，但汇编在描述种类 0 分支执行 XOR EAX,EAX，种类 1 返回入口 R8D，种类 2 返回 [RDX+4]。种类 3 则以描述中的模块 ID 和名称从 0x8e6c0(0) 选定存储查记录，再走具名值解析；失败分支还保留各自错误路径。尾部保留 EAX 返回，不能把这三个提前返回分支当成“没有返回值”，也不能把种类 1 的索引来源误写为被调用者凭空生成。0xf74b0 还包含缺名时构造记录并插入的路径，因而不能把任意调用都概括为纯只读查询。</p><p class="dd-gap">种类 1 的入口 R8D 含义须与各调用点核对；种类 3 以及各类型读写器的容量、数组缺项和失败语义仍需细化。</p><details><summary>frame!FUN_180099be0 @ 0x180099be0 · 1–310</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/180099be0.c</p><p>SHA256 5137642706789cc18e31455ea0a581aa6e9de2d705b2d53e25968f55cb931c5e · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="f3f1fea1d96640b73ca852285491f594fc2cc8905e14f4b8c0174166272bee4c" href="../../证据/f3f1fea1d96640b73ca852285491f594fc2cc8905e14f4b8c0174166272bee4c.html#content">查看完整原文／记录 ↗ <small>f3f1fea1d966</small></a></details><details><summary>frame!FUN_180099be0 @ 0x180099be0 · 1–307</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-read-stop/180099be0.asm.txt</p><p>SHA256 2e788e248d1c5681fcd6903d4b0a02c93554ffb6d0ae293ec2c7e1adeb59674a · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="e6b6d384c21f78c6aac7601fefd4802a7978a425289710f58361462129471ab5" href="../../证据/e6b6d384c21f78c6aac7601fefd4802a7978a425289710f58361462129471ab5.html#content">查看完整原文／记录 ↗ <small>e6b6d384c21f</small></a></details><details><summary>frame!FUN_1800f74b0 @ 0x1800f74b0 · 1–83</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-store-route/1800f74b0.c</p><p>SHA256 e86e5690fc2a0fa659022043a5c4f6a275cf6e3e2c3852ffea7845d8acf83a14 · offline-ghidra-pseudocode · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="b53389812e543922a2400197aaf3837a65ba4e290daa43745678e37376c60cae" href="../../证据/b53389812e543922a2400197aaf3837a65ba4e290daa43745678e37376c60cae.html#content">查看完整原文／记录 ↗ <small>b53389812e54</small></a></details><details><summary>frame!FUN_1800f74b0 @ 0x1800f74b0 · 1–104</summary><p>docs/architecture-recovery/global-variable-followup.resources/frame-store-route/1800f74b0.asm.txt</p><p>SHA256 d7603bd7be911b90a7591d54cc01af63e62aaf83be4cf5676578b7fa7a82b7d5 · offline-ghidra-assembly · 45c57bc46f72fd1f9e0b3a6f9183ff974d14590cfd05ecf4e9fa97a4ff95ae9b</p><a class="site-evidence-link" data-evidence-key="ae6f607543bd8722b2a9a75f4739d44a05e225cf53b7ae05cbd84de9d51cb3b9" href="../../证据/ae6f607543bd8722b2a9a75f4739d44a05e225cf53b7ae05cbd84de9d51cb3b9.html#content">查看完整原文／记录 ↗ <small>ae6f607543bd</small></a></details></details><details data-global-execution-fact="GEX20" id="GEX20"><summary>GEX20 · 原版 · SDK 已追到实际命令构造；服务端接收仍保留身份边界</summary><p>原 SDK 的 IMVS_StopExecute_V30 经 0x647920 到 0x6702f0，构造 0x408 命令并交 0x6c00d0；IMVS_ContinousRunStart_V30 经 0x647820 到 0x670170，构造 0x407 命令。IMVS_BindGlobalVarParam 经 0x64abd0 到 0x695890，先交 0x680b40 序列化，再组装包含 0x417 和 0xc09 的发送内容。候选 PlatformManager.dll 的 PF_M_MsgDeal 经 0x6a0250 到 0x602df0；后者的大型反编译文本提示 0x408 去 0x619670，0x417 等命令去 0x62b200。该大型函数已列出的汇编范围未覆盖这些 switch 碎片，所以这两条分派目前仅是明确检索线索，不能冒称原字节已验证的跨 DLL 调用边。0x619670 内还出现对象 +0x218 的动态调用，最终 ModuleFrame 接收者尚未确定。</p><p class="dd-gap">尚未运行核对实际加载副本、PF_M_MsgDeal 指针身份与 ModuleFrame 实例；大型 switch 案例还需独立反汇编覆盖，不能仅用 case 伪码补边。</p><details><summary>sdk!IMVS_StopExecute_V30 @ 0x180647920 · 1–58</summary><p>docs/architecture-recovery/global-variable-followup.resources/sdk-bind-stop/180647920.c</p><p>SHA256 afaa4fa2f06428fb7638bbd1b5bf34eec15fb7339aefac6dfbdb1b1c7c349553 · offline-ghidra-pseudocode · b62d7e15588ccda6671228aebc11fec3e27aca878f0e03067e44b17d5a54a9a1</p><a class="site-evidence-link" data-evidence-key="5dd9d67a543eef6e29b81dfe1c29fe7d2541912d4a8fbdcccf6ae0a94504a7c4" href="../../证据/5dd9d67a543eef6e29b81dfe1c29fe7d2541912d4a8fbdcccf6ae0a94504a7c4.html#content">查看完整原文／记录 ↗ <small>5dd9d67a543e</small></a></details><details><summary>sdk!IMVS_StopExecute_V30 @ 0x180647920 · 1–77</summary><p>docs/architecture-recovery/global-variable-followup.resources/sdk-bind-stop/180647920.asm.txt</p><p>SHA256 fab418c4f218d9c2b04f0c2259893487b8c4912048f896ecfb07199f5e04e9fb · offline-ghidra-assembly · b62d7e15588ccda6671228aebc11fec3e27aca878f0e03067e44b17d5a54a9a1</p><a class="site-evidence-link" data-evidence-key="fefdcb9f841e895b726410d34cba979ec7a28afc3cd03b986a20b4c86881cb04" href="../../证据/fefdcb9f841e895b726410d34cba979ec7a28afc3cd03b986a20b4c86881cb04.html#content">查看完整原文／记录 ↗ <small>fefdcb9f841e</small></a></details><details><summary>sdk!FUN_1806702f0 @ 0x1806702f0 · 1–46</summary><p>docs/architecture-recovery/global-variable-followup.resources/sdk-command/1806702f0.c</p><p>SHA256 2959ec5895e48cbe6b058bd9d79f3cdd9b2708fdb6170263e55cabd07eeb58fc · offline-ghidra-pseudocode · b62d7e15588ccda6671228aebc11fec3e27aca878f0e03067e44b17d5a54a9a1</p><a class="site-evidence-link" data-evidence-key="dc4860b1c7d9b50f781f6d907b1e9ed009c2a2ebd266eb3a623d1c7d039951d8" href="../../证据/dc4860b1c7d9b50f781f6d907b1e9ed009c2a2ebd266eb3a623d1c7d039951d8.html#content">查看完整原文／记录 ↗ <small>dc4860b1c7d9</small></a></details><details><summary>sdk!FUN_1806702f0 @ 0x1806702f0 · 1–97</summary><p>docs/architecture-recovery/global-variable-followup.resources/sdk-command/1806702f0.asm.txt</p><p>SHA256 3862f9bc9dfe7cdd76c95fafb891e7c54605667d67dde406b6dc0e0f04760264 · offline-ghidra-assembly · b62d7e15588ccda6671228aebc11fec3e27aca878f0e03067e44b17d5a54a9a1</p><a class="site-evidence-link" data-evidence-key="38135d066dbadbf42286e21d2dc29ad70281a1df737f7dec1a7934a882efb5b4" href="../../证据/38135d066dbadbf42286e21d2dc29ad70281a1df737f7dec1a7934a882efb5b4.html#content">查看完整原文／记录 ↗ <small>38135d066dba</small></a></details><details><summary>sdk!IMVS_ContinousRunStart_V30 @ 0x180647820 · 1–58</summary><p>docs/architecture-recovery/global-variable-followup.resources/sdk-bind-stop/180647820.c</p><p>SHA256 d9796cda0c4b9cd302ba20d52e9039f385a2ec914672add0f71086482a018532 · offline-ghidra-