":"edge","edgeId":"P25","classification":"source-confirmed"},{"title":"IVmProcedure.IsBootMode / CalibrationData接口写入 → 选定VmProcedure接收者 → 字段变更与通知","kind":"edge","edgeId":"P26","classification":"source-confirmed"},{"title":"CalibrationGuideData.Parent / VmProcedure.SaveCalibData → 当前父流程注册SaveData → XML字节写CalibData键","kind":"edge","edgeId":"P27","classification":"source-confirmed"}]},{"title":"引导字节装载、保存预备与返回差异","kind":"evidence-lane","children":[{"title":"VmProcedure.Init(PROCESS_INFO) → 流程信息/父级与历史 → CalibData字节 → 模式位","kind":"edge","edgeId":"P28","classification":"source-confirmed"},{"title":"ProjectManager保存预备 / ToolControl保存预备 → Dispatcher调用SaveCalibUserData → 逐流程SaveCalibData回调","kind":"edge","edgeId":"P29","classification":"source-confirmed"},{"title":"ProjectManager.SaveSolution两个重载 / 外部工具栏 → 预备写入之后：导出返回门、结果丢弃与Task路径分流","kind":"edge","edgeId":"P30","classification":"source-confirmed"}]},{"title":"页面/节点容器、数据包装与默认样式","kind":"evidence-lane","children":[{"title":"DiagramArea模板内DiagramPage / 页面构造 → ItemsPage基类 + 自身BAML → Canvas容器工厂","kind":"edge","edgeId":"P31","classification":"source-confirmed"},{"title":"页面与节点DataContextChanged → 已有装饰器保留；原数据按不同类型包装","kind":"edge","edgeId":"P32","classification":"source-confirmed"},{"title":"DiagramItem默认样式键 / themes/generic原BAML → 类型键 → 合并DiagramItemTemplate声明 → 条件节点样式","kind":"edge","edgeId":"P33","classification":"source-confirmed"},{"title":"ItemsPage / DiagramPage构造后的Loaded回调 → 单选/装饰器准备 → 可重复订阅或一次添加门","kind":"edge","edgeId":"P34","classification":"source-confirmed"}]},{"title":"显示类型来源、转换门及Group双击导航","kind":"evidence-lane","children":[{"title":"ModuleDisplayType → DiagramItemDisplayConverter → 7种MODULE / 7种ADORNER / 其余DEFAULT","kind":"edge","edgeId":"P35","classification":"source-confirmed"},{"title":"VmModuleBaseDecorator静态构造 → CurrentPathHelper路径 + ModulePathGenerate.txt → 类型名共享表","kind":"edge","edgeId":"P36","classification":"source-confirmed"},{"title":"DisplayType / TargetDisplayType getter与setter → 实例nullable缓存 / 类型名共享缓存 / 子显示缓存分离","kind":"edge","edgeId":"P37","classification":"source-confirmed"},{"title":"Group/流程DisplayType覆盖 → 原样式触发器 → 固定GROUP/PROCESS → 各自模板与双击合同","kind":"edge","edgeId":"P38","classification":"source-confirmed"},{"title":"GROUP双击 → VmProcedureDecorator.OpenGroupCommandExecute → 禁用/加载失败门 → PasswordA校验 → DisplayModuleSet导航","kind":"edge","edgeId":"P39","classification":"source-confirmed"}]},{"title":"宿主模式、目录/注册表分支与资源候选","kind":"evidence-lane","children":[{"title":"CurrentPathHelper静态构造 / ConfigurationHelper.GetConfig → 宿主AppSettings.StartClientMode → 单例字段与公开模式标志","kind":"edge","edgeId":"P40","classification":"source-confirmed"},{"title":"CurrentPathHelper.GetCurrentPath → 基目录或SDK注册表默认值；先补反斜杠再判空","kind":"edge","edgeId":"P41","classification":"source-confirmed"},{"title":"GetRegistryPath / GetVMInstallPath / 注册表helper → 原默认值、安装卸载路径和基应用目录三种合同","kind":"edge","edgeId":"P42","classification":"source-confirmed"},{"title":"显示表初始化 / 全局触发模块工厂等消费者 → GetCurrentPath返回值 → 文件/程序集候选；不是统一回退保证","kind":"edge","edgeId":"P43","classification":"source-confirmed"}]},{"title":"动态载体与 native 执行缺口","kind":"evidence-lane","children":[{"title":"原扩展程序集 / ParamsTabControlBase → 具体配置执行与生命周期全集","kind":"edge","edgeId":"U01","classification":"unknown"}]}]},{"title":"当前独立插件宿主","kind":"subsystem","children":[{"title":"普通配置窗口与身份","kind":"evidence-lane","children":[{"title":"OpenToolConfiguration → Group 分流 / provider 能力检查","kind":"edge","edgeId":"C01","classification":"independent-implementation"},{"title":"ToolConfigurationWindowHost.Open → 同身份复用 / 关旧失败拒绝新窗","kind":"edge","edgeId":"C02","classification":"independent-implementation"},{"title":"配置 Apply / Window.Closed → 所有者与目录守卫 / 文档参数 / scope 记忆","kind":"edge","edgeId":"C03","classification":"independent-implementation"}]},{"title":"调试上下文、输入与缓存失效","kind":"evidence-lane","children":[{"title":"CreateScopedToolEditorContext.Guard → Dispatcher / epoch / solution / scope / 节点存活","kind":"edge","edgeId":"C04","classification":"independent-implementation"},{"title":"调试 execute delegate → 缓存输入 / scope lease → NodeDebugExecutor","kind":"edge","edgeId":"C05","classification":"independent-implementation"},{"title":"InvalidateToolDebugResult / ToolDebugInputs → 三类边的后继失效 / 双缓存合并","kind":"edge","edgeId":"C06","classification":"independent-implementation"}]},{"title":"调试会话状态机","kind":"evidence-lane","children":[{"title":"ToolDebugSession.Start / RunOnceAsync → 互斥运行 / 参数快照 / linked cancellation","kind":"edge","edgeId":"C07","classification":"independent-implementation"},{"title":"ToolDebugSession.RunContinuousAsync → 每轮参数快照 / completed / 状态退出","kind":"edge","edgeId":"C08","classification":"independent-implementation"},{"title":"StopAsync / DisposeAsync → Stopping → cancel/await → Disposed","kind":"edge","edgeId":"C09","classification":"independent-implementation"}]},{"title":"隔离图、scope 与关闭释放","kind":"evidence-lane","children":[{"title":"NodeDebugExecutor.RunAsync → 明确缓存输入 → 单节点 GraphExecutor","kind":"edge","edgeId":"C10","classification":"independent-implementation"},{"title":"ModuleExecutionScope.ForProcedure / State → 借用流程视图 / 方案根资源","kind":"edge","edgeId":"C11","classification":"independent-implementation"},{"title":"scope Enter / Dispose / Exit → 取消后等租约归零再释放","kind":"edge","edgeId":"C12","classification":"independent-implementation"},{"title":"BindToolEditorLifetime → 取消本次关闭 / await Dispose / 再 Close","kind":"edge","edgeId":"C13","classification":"independent-implementation"}]},{"title":"对照与原机验收断点","kind":"evidence-lane","children":[{"title":"原版参数窗 / 当前 provider、debug与scope → 全插件宿主语义与原机验收","kind":"edge","edgeId":"U02","classification":"unknown"}]}]}]}};const names={'source-confirmed':'源码确认','independent-implementation':'当前独立实现',unknown:'未知'};const el=(tag,text)=>{const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n};for(const c of Object.keys(names)){const b=el('span',names[c]+' '+model.edges.filter(e=>e.classification===c).length);b.className='badge';document.getElementById('counts').append(b)}
 function show(e){document.querySelectorAll('.edge').forEach(b=>b.classList.toggle('selected',b.dataset.id===e.id));const d=document.getElementById('detail');d.replaceChildren(el('h2',e.id+' · '+names[e.classification]),el('h3',e.from+' → '+e.to),el('p',e.behavior));if(e.unknowns.length){d.append(el('h3','仍需追踪'));const u=el('ul');for(const s of e.unknowns)u.append(el('li',s));d.append(u)}for(const r of e.refs){const x=el('details');x.append(el('summary',r.member+' · '+r.start+'–'+r.end),el('p',r.path),el('p',r.evidenceType+' · SHA-256 '+r.sha256),el('pre',r.excerpt));d.append(x)}d.append(el('p','静态检查；未执行运行验证；不声明 native 等价。'))}
 function route(value){document.querySelectorAll('#routes button').forEach(b=>b.classList.toggle('active',b.textContent===value));const h=document.getElementById('edges');h.replaceChildren();const es=model.edges.filter(e=>e.route===value);for(const e of es){const b=el('button');b.type='button';b.dataset.id=e.id;b.className='edge '+e.classification;b.append(el('strong',e.id+' · '+e.from+' → '+e.to),el('small',names[e.classification]));b.onclick=()=>show(e);h.append(b)}show(es[0])}for(const value of [...new Set(model.edges.map(e=>e.route))]){const b=el('button',value);b.type='button';b.onclick=()=>route(value);document.getElementById('routes').append(b)}route(model.edges[0].route);
const hierarchyEdges=new Map(model.edges.map(e=>[e.id,e])),edgePaths=new Map();
const flatShow=show;show=function(e){flatShow(e);const detail=document.getElementById('detail'),crumb=el('div',(edgePaths.get(e.id)||[]).concat(e.id).join(' › '));crumb.className='crumb';detail.prepend(crumb);const leaf=document.querySelector('#hierarchy button[data-id="'+e.id+'"]');for(let p=leaf?.parentElement;p;p=p.parentElement)if(p.tagName==='DETAILS')p.open=true;document.querySelectorAll('#hierarchy .edge').forEach(b=>b.classList.toggle('selected',b.dataset.id===e.id));history.replaceState(null,'','#edge-'+e.id)};
function treeBranch(node,trail=[],level=0){if(node.edgeId){edgePaths.set(node.edgeId,trail);const e=hierarchyEdges.get(node.edgeId),button=el('button');button.type='button';button.dataset.id=e.id;button.className='edge '+e.classification;button.append(el('strong',e.id+' · '+node.title),el('small',names[e.classification]));button.onclick=()=>{route(e.route);show(e)};return button}const d=el('details');d.open=level<2;d.dataset.level=String(level);d.append(el('summary',node.title));const branch=el('div');branch.className='branch';for(const child of node.children)branch.append(treeBranch(child,trail.concat(node.title),level+1));d.append(branch);return d}
document.getElementById('hierarchy').append(treeBranch(model.hierarchy));
function hierarchyMode(tree){document.getElementById('treePane').hidden=!tree;document.getElementById('routes').hidden=tree;document.getElementById('edges').hidden=tree;for(const [id,on]of [['treeMode',tree],['listMode',!tree]]){const b=document.getElementById(id);b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on))}}
document.getElementById('treeMode').onclick=()=>hierarchyMode(true);document.getElementById('listMode').onclick=()=>hierarchyMode(false);document.getElementById('expandAll').onclick=()=>document.querySelectorAll('#hierarchy details').forEach(d=>d.open=true);document.getElementById('collapseAll').onclick=()=>document.querySelectorAll('#hierarchy details').forEach(d=>d.open=d.dataset.level==='0');hierarchyMode(true);function restoreEvidenceBookmark(){let key;try{key=decodeURIComponent(location.hash.slice(1)).replace(/^edge-/,'')}catch{key=''}const desiredEdge=hierarchyEdges.get(key)||model.edges[0];route(desiredEdge.route);show(desiredEdge)}restoreEvidenceBookmark();addEventListener('hashchange',restoreEvidenceBookmark);
</script></html><script data-document-web src="document-web-links.js"></script>