ConfigurationProcedure(flow);var cached=ToolDebugInputs(flow);var baseDirectory=doc.BaseDirectory;var invocationInputs=workflowSessions.GetValueOrDefault(flow)?.WorkflowInputs;var invocationIndex=workflowSessions.GetValueOrDefault(flow)?.GroupLoopIndex;InvalidateToolDebugResult(flow,id);NodeRunRecord record;var ownerScope=executionScope;using var scopeLease=ownerScope.Enter();\n   try{record=await Task.Run(()=>new NodeDebugExecutor(modules).RunAsync(procedure,id,baseDirectory,values,cached,invocationInputs,cancellationToken:token,groupLoopIndex:invocationIndex,scope:ownerScope.ForProcedure(flow)));}catch(InvalidDataException e){record=new(id,NodeRunStatus.Failed,new Dictionary\u003cstring,PortValue>(),0,\"DebugInputUnavailable\",e.Message);}\n   if(IsCurrentExecutionOwner(owner)&&!token.IsCancellationRequested&&session!.State!=ToolDebugState.Disposed&&doc.SolutionId==solution)StoreToolDebugResult(flow,record);return record;\n  });toolDebugSessions.Add(session);","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C06","route":"当前 · 调试上下文与缓存","classification":"independent-implementation","from":"InvalidateToolDebugResult / ToolDebugInputs","to":"三类边的后继失效 / 双缓存合并","behavior":"以执行边、数据连线和订阅 producer 边求后继闭包，失效并移除 debug record；输入合并未失效 workflowSessions 和同 solution/procedure 的 debug records，后者覆盖同节点。此处允许显式缓存，不是普通整图本轮取值合同。","refs":[{"path":"src/VisionEditor/ToolEditorHost.cs","member":"Current debug input merge","sha256":"452e7aff9f62299ed5f6ff8a00705acd1ee9d775d6b7db414573c16202d77fb3","start":15,"end":15,"excerpt":" IReadOnlyList\u003cNodeRunRecord> ToolDebugInputs(string flow){EnsureToolDebugSolution();var merged=new Dictionary\u003cstring,NodeRunRecord>();if(workflowSessions.TryGetValue(flow,out var previous))foreach(var record in previous.Nodes)if(!toolDebugInvalid.Contains(DebugIdentity(flow,record.NodeId)))merged[record.NodeId]=record;foreach(var pair in toolDebugRecords.Where(p=>p.Key.SolutionId==doc.SolutionId&&p.Key.ProcedureId==flow))merged[pair.Key.NodeId]=pair.Value;return merged.Values.ToArray();}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/ToolEditorHost.cs","member":"Current debug invalidation closure","sha256":"452e7aff9f62299ed5f6ff8a00705acd1ee9d775d6b7db414573c16202d77fb3","start":18,"end":24,"excerpt":" void InvalidateToolDebugResult(string flow,string nodeId)\n {\n  EnsureToolDebugSolution();var procedure=ConfigurationProcedure(flow);var affected=new HashSet\u003cstring>{nodeId};\n  var edges=ProcedureGraph.ExecutionEdges(procedure).Select(e=>(From:e.FromNode,To:e.ToNode)).Concat(procedure.Connections.Select(c=>(From:c.FromNode,To:c.ToNode))).Concat(procedure.Configuration.Subscriptions.Select(b=>(From:WorkflowSubscriptions.Producer(procedure,b.Source),To:b.NodeId)).Where(e=>e.From is not null).Select(e=>(From:e.From!,To:e.To))).ToArray();\n  bool changed;do{changed=false;foreach(var edge in edges)if(affected.Contains(edge.From))changed|=affected.Add(edge.To);}while(changed);\n  foreach(var id in affected){var key=DebugIdentity(flow,id);toolDebugInvalid.Add(key);toolDebugRecords.Remove(key);}if(doc.CurrentProcedureId==flow){RestoreWorkflowResults();RefreshRight();}\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C07","route":"当前 · 调试会话状态机","classification":"independent-implementation","from":"ToolDebugSession.Start / RunOnceAsync","to":"互斥运行 / 参数快照 / linked cancellation","behavior":"Start 在锁下拒绝 closing 或 active未完成；设置 mode、创建linked token，Task.Yield 后调用 action；finally 按所属 cancellation 还原 Idle或Disposed并释放 token。单次先 Clone JSON 参数。","refs":[{"path":"src/VisionFramework/ToolDebugSession.cs","member":"ToolDebugSession.Start","sha256":"8e9030cc070fb8c9ec6263452f73b936287a87f0bae0456e913a1d531ada0211","start":21,"end":27,"excerpt":" Task\u003cT> Start\u003cT>(ToolDebugState mode,CancellationToken token,Func\u003cCancellationToken,Task\u003cT>> action)\n {\n  lock(gate){ObjectDisposedException.ThrowIf(closing,this);if(active is {IsCompleted:false})throw new InvalidOperationException(\"Debug session is already running.\");state=mode;var owner=CancellationTokenSource.CreateLinkedTokenSource(token);cancellation=owner;var task=Execute();active=task;return task;\n   async Task\u003cT> Execute(){await Task.Yield();try{return await action(owner.Token);}finally{lock(gate){if(ReferenceEquals(cancellation,owner)){cancellation=null;state=closing?ToolDebugState.Disposed:ToolDebugState.Idle;}}owner.Dispose();}}\n  }\n }\n public Task\u003cNodeRunRecord> RunOnceAsync(IReadOnlyDictionary\u003cstring,JsonElement> values,CancellationToken cancellationToken=default){var snapshot=Snapshot(values);return Start(ToolDebugState.RunningOnce,cancellationToken,token=>execute(snapshot,token));}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/ToolDebugSession.cs","member":"ToolDebugSession.RunOnceAsync","sha256":"8e9030cc070fb8c9ec6263452f73b936287a87f0bae0456e913a1d531ada0211","start":27,"end":27,"excerpt":" public Task\u003cNodeRunRecord> RunOnceAsync(IReadOnlyDictionary\u003cstring,JsonElement> values,CancellationToken cancellationToken=default){var snapshot=Snapshot(values);return Start(ToolDebugState.RunningOnce,cancellationToken,token=>execute(snapshot,token));}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C08","route":"当前 · 调试会话状态机","classification":"independent-implementation","from":"ToolDebugSession.RunContinuousAsync","to":"每轮参数快照 / completed / 状态退出","behavior":"每轮取消检查、execute、再检查取消后 completed；Failed/TimedOut/Cancelled 结束循环；其它状态按默认300ms间隔或 Yield 继续。该300ms是当前默认，不称原生连续运行间隔。","refs":[{"path":"src/VisionFramework/ToolDebugSession.cs","member":"ToolDebugSession default interval","sha256":"8e9030cc070fb8c9ec6263452f73b936287a87f0bae0456e913a1d531ada0211","start":17,"end":17,"excerpt":" public ToolDebugSession(Func\u003cIReadOnlyDictionary\u003cstring,JsonElement>,CancellationToken,Task\u003cNodeRunRecord>> execute,int intervalMs=300){this.execute=execute??throw new ArgumentNullException(nameof(execute));if(intervalMs\u003c0)throw new ArgumentOutOfRangeException(nameof(intervalMs));this.intervalMs=intervalMs;}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/ToolDebugSession.cs","member":"ToolDebugSession.RunContinuousAsync","sha256":"8e9030cc070fb8c9ec6263452f73b936287a87f0bae0456e913a1d531ada0211","start":28,"end":32,"excerpt":" public async Task RunContinuousAsync(Func\u003cIReadOnlyDictionary\u003cstring,JsonElement>> values,Action\u003cNodeRunRecord> completed,CancellationToken cancellationToken=default)\n {\n  ArgumentNullException.ThrowIfNull(values);ArgumentNullException.ThrowIfNull(completed);\n  await Start(ToolDebugState.RunningContinuous,cancellationToken,async token=>{while(true){token.ThrowIfCancellationRequested();var record=await execute(Snapshot(values()),token);token.ThrowIfCancellationRequested();completed(record);if(record.Status is NodeRunStatus.Failed or NodeRunStatus.TimedOut or NodeRunStatus.Cancelled)break;if(intervalMs>0)await Task.Delay(intervalMs,token);else await Task.Yield();}return true;});\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C09","route":"当前 · 调试会话状态机","classification":"independent-implementation","from":"StopAsync / DisposeAsync","to":"Stopping → cancel/await → Disposed","behavior":"Stop 对活动任务置 Stopping并Cancel，await只吞 OperationCanceledException；Dispose先置closing，await Stop，finally置Disposed。一般执行异常可以传播，不能写成全部关闭错误被吞。","refs":[{"path":"src/VisionFramework/ToolDebugSession.cs","member":"ToolDebugSession.StopAsync","sha256":"8e9030cc070fb8c9ec6263452f73b936287a87f0bae0456e913a1d531ada0211","start":33,"end":34,"excerpt":" public async Task StopAsync(){Task? wait;lock(gate){wait=active;if(wait is {IsCompleted:false}){state=ToolDebugState.Stopping;cancellation?.Cancel();}}if(wait is not null){try{await wait;}catch(OperationCanceledException){}}}\n public async ValueTask DisposeAsync(){lock(gate){closing=true;if(active is not {IsCompleted:false})state=ToolDebugState.Disposed;}try{await StopAsync();}finally{lock(gate)state=ToolDebugState.Disposed;}}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C10","route":"当前 · 隔离执行与释放","classification":"independent-implementation","from":"NodeDebugExecutor.RunAsync","to":"明确缓存输入 → 单节点 GraphExecutor","behavior":"拒绝 Group与禁用节点，排除本节点旧记录；解析绑定和类型，建只含目标节点的隔离 Procedure，通过 workflow输入注入缓存值，保留原执行后继及延迟reader，调用 GraphExecutor。不会自动执行上游生产者。","refs":[{"path":"src/VisionFramework/NodeDebugExecutor.cs","member":"NodeDebugExecutor.RunAsync guards","sha256":"c673966959f33e76ea98498147e367be5e554c82f6881e5dc6ffaf2d89f57133","start":17,"end":25,"excerpt":" public async Task\u003cNodeRunRecord> RunAsync(ProcedureDocument procedure,string nodeId,string baseDirectory,IReadOnlyDictionary\u003cstring,JsonElement> values,IReadOnlyList\u003cNodeRunRecord>? cachedResults=null,IReadOnlyDictionary\u003cstring,PortValue>? workflowInputs=null,CancellationToken cancellationToken=default,int? groupLoopIndex=null,ModuleExecutionScope? scope=null)\n {\n  var node=procedure.Nodes.SingleOrDefault(n=>n.Id==nodeId)??throw new InvalidDataException(\"Debug node no longer exists.\");\n  if(node.ModuleId==WorkflowCalls.ModuleId)throw new InvalidOperationException(\"Group debugging requires its module-set execution service.\");\n  if(!node.Enabled)throw new InvalidOperationException(\"Disabled node cannot self-run.\");\n  var descriptor=registry.GetDescriptor(node);var records=(cachedResults??[]).Where(r=>r.NodeId!=nodeId).Select(r=>r with{Outputs=CompoundOutputFields.Expand(r.Outputs)}).ToDictionary(r=>r.NodeId);\n  var scoped=procedure with{Configuration=procedure.Configuration with{Subscriptions=procedure.Configuration.Subscriptions.Where(b=>b.NodeId==nodeId).ToArray()}};var context=new WorkflowRunContext(scoped,workflowInputs,records,groupLoopIndex);\n  foreach(var source in records.Keys)context.Update(source);\n  var inputs=new Dictionary\u003cstring,PortValue>(StringComparer.Ordinal);","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/NodeDebugExecutor.cs","member":"NodeDebugExecutor isolated graph","sha256":"c673966959f33e76ea98498147e367be5e554c82f6881e5dc6ffaf2d89f57133","start":35,"end":41,"excerpt":"  var isolated=new ProcedureDocument(procedure.Id,procedure.Name,[node with{Parameters=parameters}],[],[]){Configuration=new(){Inputs=inputSpecs,Subscriptions=inputSpecs.Select(p=>new WorkflowSubscription(nodeId,p.Name,false,new(WorkflowSourceKind.WorkflowInput,p.Id))).ToArray()}};\n  var originalSuccessors=Array.AsReadOnly(ProcedureGraph.ExecutionEdges(procedure).Where(edge=>edge.FromNode==nodeId).Select(edge=>new ExecutionSuccessor(edge.ToNode)).ToArray());\n  // Read selectors during this execution, not while materializing cached input containers.\n  var numericReader=numericIndices.Count==0?null:new WorkflowNumericInputRead(inputs,numericIndices,context.Resolve);\n  var run=await new GraphExecutor(registry).RunAsync(isolated,baseDirectory,cancellationToken:cancellationToken,inputs:inputs,scope:scope,numericInputRead:(id,name,index)=>id==nodeId?numericReader?.Read(name,index):null,integerInputRead:(id,name,index)=>id==nodeId?numericReader?.ReadInteger(name,index):null,textInputRead:(id,name,index,capacity)=>id==nodeId?numericReader?.ReadText(name,index,capacity):null,executionSuccessorRead:id=>id==nodeId?originalSuccessors:null);\n  return run.Nodes.Single();\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C11","route":"当前 · 隔离执行与释放","classification":"independent-implementation","from":"ModuleExecutionScope.ForProcedure / State","to":"借用流程视图 / 方案根资源","behavior":"ForProcedure 返回绑定流程的借用视图；State 键是 procedure/module/node 三元组，状态由根scope保存。借用视图 Dispose 不关闭整个方案；不是每轮重建所有工具状态。","refs":[{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"ModuleExecutionScope.ForProcedure","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":17,"end":17,"excerpt":" public ModuleExecutionScope ForProcedure(string procedure){ArgumentException.ThrowIfNullOrWhiteSpace(procedure);return ProcedureId==procedure?this:new(Root,procedure);}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"ModuleExecutionScope.State","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":33,"end":35,"excerpt":" public T State\u003cT>(string module,string node,Func\u003cT> create)where T:class {\n  var root=Root;lock(root.gate){ObjectDisposedException.ThrowIf(root.closing,this);var key=(ProcedureId,module,node);if(!root.states.TryGetValue(key,out var value))root.states.Add(key,value=create());return (T)value;}\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C12","route":"当前 · 隔离执行与释放","classification":"independent-implementation","from":"scope Enter / Dispose / Exit","to":"取消后等租约归零再释放","behavior":"Enter 在根锁下累加lease；Dispose标closing并取消，finally写cancellationComplete，TryRelease要求leases==0且尚未release。最后Exit可能触发Release，逐资源释放并收CleanupFailures；这属于当前资源合同。","refs":[{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"ModuleExecutionScope.Enter","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":40,"end":40,"excerpt":" public IDisposable Enter(){if(owner is not null)return owner.Enter();lock(gate){ObjectDisposedException.ThrowIf(closing,this);leases++;return new Lease(this);}}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"ModuleExecutionScope.Dispose and release gate","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":45,"end":49,"excerpt":" public void Dispose(){if(owner is not null)return;lock(gate){if(closing)return;closing=true;}try{stopping.Cancel();}catch(Exception error){RecordCleanupFailure(\"cancel\",stopping,error);}finally{bool release;lock(gate){cancellationComplete=true;release=TryRelease();}if(release)Release();}}\n bool TryRelease(){if(!closing||!cancellationComplete||leases!=0||releaseStarted)return false;releaseStarted=true;return true;}\n void Exit(){bool release;lock(gate){leases--;release=TryRelease();}if(release)Release();}\n void Release(){object[] values;lock(gate){values=states.Values.Concat(ownedServices).Distinct(ReferenceEqualityComparer.Instance).ToArray();states.Clear();effectiveParameters.Clear();services.Clear();ownedServices.Clear();}foreach(var value in values)if(value is IDisposable disposable)try{disposable.Dispose();}catch(Exception error){RecordCleanupFailure(\"resource\",value,error);}try{stopping.Dispose();}catch(Exception error){RecordCleanupFailure(\"token\",stopping,error);}}\n sealed class Lease(ModuleExecutionScope scope):IDisposable {ModuleExecutionScope? owner=scope;public void Dispose()=>Interlocked.Exchange(ref owner,null)?.Exit();}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C13","route":"当前 · 隔离执行与释放","classification":"independent-implementation","from":"BindToolEditorLifetime","to":"取消本次关闭 / await Dispose / 再 Close","behavior":"窗口Closing先取消并防重入，await调试session.DisposeAsync；finally移除会话、ready并调度Close，Closed再次移除。不是立即关闭后让后台继续运行。","refs":[{"path":"src/VisionEditor/ToolEditorHost.cs","member":"Current dedicated editor close protocol","sha256":"452e7aff9f62299ed5f6ff8a00705acd1ee9d775d6b7db414573c16202d77fb3","start":70,"end":73,"excerpt":" void BindToolEditorLifetime(Window window,ToolEditorContext context){window.Owner=this;bool ready=false,pending=false;\n  window.Closing+=async(_,e)=>{if(ready||e.Cancel)return;e.Cancel=true;if(pending)return;pending=true;try{await context.Session!.DisposeAsync();}catch(Exception error){if(!windowClosed)StatusText.Text=\"调试关闭：\"+error.Message;}finally{toolDebugSessions.Remove(context.Session!);ready=true;_ = window.Dispatcher.BeginInvoke(new Action(window.Close));}};\n  window.Closed+=(_,_)=>toolDebugSessions.Remove(context.Session!);\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"U02","route":"原版与当前 · 对照缺口","classification":"unknown","from":"原版参数窗 / 当前 provider、debug与scope","to":"全插件宿主语义与原机验收","behavior":"本页仅列现有明确路径；未穷尽所有插件程序集、通用/专用模板、native SelfRun上游准备、设备/ROI会话和宿主切换。","refs":[],"unknowns":["当前显式缓存调试、租约和取消不能用测试通过冒称原 SDK 生命周期等价。","浏览器交互和本文链的原机操作尚未验证。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"P08","route":"原版 · 主界面配置入口分流","classification":"source-confirmed","from":"画布模块按钮 / Group按钮 / MODULE样式双击","to":"DiagramArea.ConfigParamsCommand → ItemDoubleClick委托","behavior":"图形按钮和Group按钮声明向祖先DiagramArea.ConfigParamsCommand传当前对象；DiagramItem的MODULE DataTrigger另声明AttachedRoutedEvent.Event=MouseDoubleClick、相同命令/参数。命令getter缓存DelegateCommand\u003cobject>，处理器对装饰器IsForbidden直接不继续；IsLoadFailed=true时显示模块名+加载错误提示，不调用委托；否则含Group/非Group两分支均调用ItemDoubleClick?.Invoke(this,new ObjectEventArgs{Param=obj})。不能把双击样式外推所有DisplayType，也不能把不同入口的失败反馈混为一套。","refs":[{"path":"docs/architecture-recovery/configuration-entry-cil-evidence.json","member":"VMControls.WPF.Base.DiagramArea::get_ConfigParamsCommand","sha256":"860333c515ea2cf911e6338e246044126b23e0ef42cb6eaec0f8c19b9854049c","start":2852,"end":2871,"excerpt":"          \"token\": \"0x06000b35\",\n          \"symbol\": {\n            \"token\": \"0x06000b35\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.Base.DiagramArea\",\n            \"name\": \"get_ConfigParamsCommand\",\n            \"parameters\": 0,\n            \"attributes\": \"Public, HideBySig, SpecialName\",\n            \"signatureBytes\": \"20001280c5\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 37,\n          \"ilSha256\": \"3d2b35c2dbce4a211a8b1438bc5a8a4d325355f668a4dab823e68d77a13090ee\",\n          \"ilBytes\": \"027bc2050004252d1b260202fe06360b0006732102000a732202000a250a7dc2050004062a\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"ldarg.0\",","evidenceType":"original-managed-cil","binaryIdentity":"99ffa401c8784472913ad43813d68a8a5577890c00e149506e3e5664fa61c97d / MVID d144317f-3992-4275-9b0f-13fb6163e07d"},{"path":"docs/architecture-recovery/configuration-entry-cil-evidence.json","member":"VMControls.WPF.Base.DiagramArea::ConfigParamsCommandExecute","sha256":"860333c515ea2cf911e6338e246044126b23e0ef42cb6eaec0f8c19b9854049c","start":3012,"end":3031,"excerpt":"          \"token\": \"0x06000b36\",\n          \"symbol\": {\n            \"token\": \"0x06000b36\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.Base.DiagramArea\",\n            \"name\": \"ConfigParamsCommandExecute\",\n            \"parameters\": 1,\n            \"attributes\": \"Private, HideBySig\",\n            \"signatureBytes\": \"2001011c\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 215,\n          \"ilSha256\": \"5b7d1a6cfb342257db9c2814eedd1cbf0b81426b8ca88298cbbadeee26350695\",\n          \"ilBytes\": \"\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"nop\",","evidenceType":"original-managed-cil","binaryIdentity":"99ffa401c8784472913ad43813d68a8a5577890c00e149506e3e5664fa61c97d / MVID d144317f-3992-4275-9b0f-13fb6163e07d"},{"path":"analysis/decompiled/VMControls.WPF/base/diagramitemtemplate.xaml","member":"graphical config button command","sha256":"95dc48af35a601585c893a2377665781bc4a72a2d5b2ab562d82b4ba0dc5f4f9","start":1381,"end":1381,"excerpt":"          \u003ccommomcontrol:SuperImageButton Command=\"{Binding ConfigParamsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramArea}}\" CommandParameter=\"{Binding}\">","evidenceType":"local-extracted-resource","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VMControls.WPF/base/diagramitemtemplate.xaml","member":"group config button command","sha256":"95dc48af35a601585c893a2377665781bc4a72a2d5b2ab562d82b4ba0dc5f4f9","start":1659,"end":1659,"excerpt":"        \u003cButton Grid.Column=\"0\" Margin=\"7,0,0,0\" Command=\"{Binding ConfigParamsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramArea}}\" CommandParameter=\"{Binding}\">","evidenceType":"local-extracted-resource","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VMControls.WPF/base/diagramitemtemplate.xaml","member":"MODULE trigger attached double-click command","sha256":"95dc48af35a601585c893a2377665781bc4a72a2d5b2ab562d82b4ba0dc5f4f9","start":1792,"end":1802,"excerpt":"      \u003cDataTrigger Value=\"{x:Static local:DiagramItemDisplayEnum.MODULE}\" Binding=\"{Binding DisplayType, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource diagramItemDisplayConverter}}\">\n        \u003cSetter Property=\"local:DiagramItem.IsModuleForbidden\" Value=\"{Binding IsForbidden}\" />\n        \u003cSetter Property=\"local:DiagramItem.IsModuleFailed\" Value=\"{Binding IsLoadFailed}\" />\n        \u003cSetter Property=\"local:DiagramItem.RunState\" Value=\"{Binding DecorateSource.IsRunOK}\" />\n        \u003cSetter Property=\"local:DiagramItem.NextItemsSource\" Value=\"{Binding Path=DecorateSource.(VMInterface:IVmModule.NextModules)}\" />\n        \u003cSetter Property=\"local:DiagramItem.Position\" Value=\"{Binding Position}\" />\n        \u003cSetter Property=\"Attached:AttachedRoutedEvent.Event\" Value=\"MouseDoubleClick\" />\n        \u003cSetter Property=\"Attached:AttachedRoutedEventBase.Command\" Value=\"{Binding ConfigParamsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:DiagramArea}}\" />\n        \u003cSetter Property=\"Attached:AttachedRoutedEventBase.CommandParameter\" Value=\"{Binding}\" />\n        \u003cSetter Property=\"FrameworkElement.ContextMenu\" Value=\"{StaticResource NormalOperateMenu}\" />\n      \u003c/DataTrigger>","evidenceType":"local-extracted-resource","binaryIdentity":"not revalidated in this slice"}],"unknowns":["附加事件辅助原件已补P16–P17；实际RoutedEvent/模板选择、可见启用、命令参数/委托属性赋值和鼠标键盘投递仍未知。入口WPF16体是独立CIL加REA身份；此辅助12体另与REA摘要逐一匹配，不混同证据级别。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"P09","route":"原版 · 主界面配置入口分流","classification":"source-confirmed","from":"流程设置按钮 → ProcedureConfigControl.ConfigParamsCommand","to":"禁用/加载失败门 → 直接处理器调用 → OpenParams","behavior":"按钮资源向祖先ProcedureConfigControl.ConfigParamsCommand传DisplayModuleSet，并另注册SuperImageButton_Click。配置命令遇装饰器IsForbidden直接返回，IsLoadFailed=true时本处理器不提示也不继续；其它情况Group/非Group两分支都直接调用DiagramArea_ItemDoubleClick(this,ObjectEventArgs{Param=obj})，处理器取Param后OpenParams。按钮Click回调另设父TabItem.IsSelected=true并调HeadText_MouseDown；不能假定Click与Command的真实先后，或把Click本身等同为打开参数。","refs":[{"path":"docs/architecture-recovery/configuration-entry-cil-evidence.json","member":"VMControls.WPF.ProcedureConfigControl::get_ConfigParamsCommand","sha256":"860333c515ea2cf911e6338e246044126b23e0ef42cb6eaec0f8c19b9854049c","start":433,"end":452,"excerpt":"          \"token\": \"0x0600028c\",\n          \"symbol\": {\n            \"token\": \"0x0600028c\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.ProcedureConfigControl\",\n            \"name\": \"get_ConfigParamsCommand\",\n            \"parameters\": 0,\n            \"attributes\": \"Public, HideBySig, SpecialName\",\n            \"signatureBytes\": \"20001280c5\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 37,\n          \"ilSha256\": \"acfc7bbb57a52a7e434c31956c8ccad3f45ab079ca65027f55d8080d17512496\",\n          \"ilBytes\": \"027b34010004252d1b260202fe068d020006732102000a732202000a250a7d34010004062a\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"ldarg.0\",","evidenceType":"original-managed-cil","binaryIdentity":"99ffa401c8784472913ad43813d68a8a5577890c00e149506e3e5664fa61c97d / MVID d144317f-3992-4275-9b0f-13fb6163e07d"},{"path":"docs/architecture-recovery/configuration-entry-cil-evidence.json","member":"VMControls.WPF.Proc