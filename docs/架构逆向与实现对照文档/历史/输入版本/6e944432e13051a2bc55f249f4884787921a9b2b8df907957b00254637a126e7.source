 new VmProcedureDecorator\n\t\t\t\t{\n\t\t\t\t\tDecorateSource = e.NewValue\n\t\t\t\t};\n\t\t\t}\n\t\t}\n\t\telse\n\t\t{\n\t\t\tIsGlobleMode = (DataContext as IDecorate).DecorateSource is IVmSolution;\n\t\t}\n\t}\n","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VMControls.WPF/VMControls.WPF.Base/DiagramItem.xaml.cs","member":"node data wrapper choices","sha256":"19d967cb454fa6ba9aae63a53c2b394b318ce9dd1391d7c5ec8a00a77f683ce3","start":532,"end":572,"excerpt":"\tprivate void DiagramItem_DataContextChanged(object sender, DependencyPropertyChangedEventArgs e)\n\t{\n\t\tif (!(DataContext is IDecorate))\n\t\t{\n\t\t\tif (e.NewValue is IVmProcedure)\n\t\t\t{\n\t\t\t\tDataContext = new VmProcedureDecorator\n\t\t\t\t{\n\t\t\t\t\tDecorateSource = e.NewValue\n\t\t\t\t};\n\t\t\t}\n\t\t\telse if (e.NewValue is IVMGroup)\n\t\t\t{\n\t\t\t\tDataContext = new VmGroupDecorator\n\t\t\t\t{\n\t\t\t\t\tDecorateSource = e.NewValue\n\t\t\t\t};\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tDataContext = new VmModuleDecorator\n\t\t\t\t{\n\t\t\t\t\tDecorateSource = e.NewValue\n\t\t\t\t};\n\t\t\t}\n\t\t\tforeach (Connection item in from p in ConnectionPanel.Children.OfType\u003cConnection>()\n\t\t\t\twhere p.TargetItem == null\n\t\t\t\tselect p)\n\t\t\t{\n\t\t\t\tif (item.DataContext is VmConnectionDecorator vmConnectionDecorator && vmConnectionDecorator.DecorateSource == e.NewValue)\n\t\t\t\t{\n\t\t\t\t\titem.TargetItem = this;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\ttempDataContext = DataContext as IDecorate;\n\t\tif (!(e.NewValue is IDecorate))\n\t\t{\n\t\t\tReplaceCurBox();\n\t\t}\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["装饰器构造/DecorateSource setter、绑定重入、ConnectionPanel为null/连线修补、ReplaceCurBox与真实对象类型未齐；静态包装规则不证明所有显示节点已被正确包装或独立Group命令已绑定。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},