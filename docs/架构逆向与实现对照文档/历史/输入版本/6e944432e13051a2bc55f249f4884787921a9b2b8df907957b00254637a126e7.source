n\t\t\t\t\t\tdisplayTypeDic.Add(VMModule.ModuleTypeName, displayType ?? ModuleDisplayType.NORMAL);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn displayType ?? ModuleDisplayType.DEFAULT;\n\t\t}\n\t\tset\n\t\t{\n\t\t\tif (value != displayType)\n\t\t\t{\n\t\t\t\tdisplayType = value;\n\t\t\t\tOnPropertyChanged(\"DisplayType\");\n\t\t\t}\n\t\t}\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VMControls.WPF/VMControls.WPF.DataForUI/VmModuleBaseDecorator.cs","member":"sub-display caching","sha256":"f124b9a5e3ce5b8e2e856d3e325b00a4b143f7074513ccc74d542ec35c2695dd","start":160,"end":211,"excerpt":"\tpublic DiagramItemSubDisplayEnum TargetDisplayType\n\t{\n\t\tget\n\t\t{\n\t\t\tif (!_targetDisplayType.HasValue)\n\t\t\t{\n\t\t\t\tswitch (DisplayType)\n\t\t\t\t{\n\t\t\t\tcase ModuleDisplayType.IMAGE:\n\t\t\t\tcase ModuleDisplayType.IMAGEADORNER:\n\t\t\t\t{\n\t\t\t\t\tDiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.IMAGE);\n\t\t\t\t\treturn diagramItemSubDisplayEnum.Value;\n\t\t\t\t}\n\t\t\t\tcase ModuleDisplayType.IFBRANCH:\n\t\t\t\tcase ModuleDisplayType.IFBRANCHADORNER:\n\t\t\t\t{\n\t\t\t\t\tDiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.IFBRANCH);\n\t\t\t\t\treturn diagramItemSubDisplayEnum.Value;\n\t\t\t\t}\n\t\t\t\tcase ModuleDisplayType.FUNCTION:\n\t\t\t\tcase ModuleDisplayType.FUNCTIONADORNER:\n\t\t\t\t{\n\t\t\t\t\tDiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.FUNCTION);\n\t\t\t\t\treturn diagramItemSubDisplayEnum.Value;\n\t\t\t\t}\n\t\t\t\tcase ModuleDisplayType.TIMER:\n\t\t\t\tcase ModuleDisplayType.TIMERADORNER:\n\t\t\t\t{\n\t\t\t\t\tDiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.TIMER);\n\t\t\t\t\treturn diagramItemSubDisplayEnum.Value;\n\t\t\t\t}\n\t\t\t\tcase ModuleDisplayType.SHELL:\n\t\t\t\tcase ModuleDisplayType.SHELLADORNER:\n\t\t\t\t{\n\t\t\t\t\tDiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.SHELL);\n\t\t\t\t\treturn diagramItemSubDisplayEnum.Value;\n\t\t\t\t}\n\t\t\t\tcase ModuleDisplayType.COMMUNCATION:\n\t\t\t\tcase ModuleDisplayType.COMMUNCATIONADORNER:\n\t\t\t\t{\n\t\t\t\t\tDiagramItemSubDisplayEnum? diagramItemSubDisplayEnum = (_targetDisplayType = DiagramItemSubDisplayEnum.COMMUNCATION);\n\t\t\t\t\treturn diagramItemSubDisplayEnum.Value;\n\t\t\t\t}\n\t\t\t\tdefault:\n\t\t\t\t\treturn DiagramItemSubDisplayEnum.DEFAULT;\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn _targetDisplayType.Value;\n\t\t}\n\t}\n","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["ToolBoxItemData.loadXml错误/部分对象、模块类型名/目录变化、全部缓存清理者/派生覆盖和真实绑定刷新未齐；静态构造依赖仍先于可用实例，不能把NORMAL回退泛化成所有失败都可恢复。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"P38","route":"原版 · 显示类型、样式与配置/导航门","classification":"source-confirmed","from":"Group/流程DisplayType覆盖 → 原样式触发器","to":"固定GROUP/PROCESS → 各自模板与双击合同","behavior":"VmGroupDecorator getter固定GROUP，VmProcedureDecorator固定PROCESS，未走普通显示类型表/文件getter。原节点字典的GROUP触发器设GROUP模板、状态/位置/连线，并将双击命令绑定祖先DiagramArea.SubSource.OpenGroupCommand，参数当前对象；PROCESS用PROCESS模板与菜单，选定触发器未给相同附加双击。GROUPADORNER只声明模板（原资源重复一条相同模板触发器），不能由名称推与GROUP相同命令；Group模板内配置按钮另走P08的DiagramArea.ConfigParamsCommand。","refs":[{"path":"docs/architecture-recovery/display-type-cil-evidence.json","member":"VMControls.WPF.DataForUI.VmGroupDecorator::get_DisplayType","sha256":"fcd9746c400807513768c9e6a3c53fa4510b461677dc221580f86d12076786db","start":4290,"end":4309,"excerpt":"          \"token\": \"0x060008c6\",\n          \"symbol\": {\n            \"token\": \"0x060008c6\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.DataForUI.VmGroupDecorator\",\n            \"name\"