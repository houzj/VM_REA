age()\n\t{\n\t\tWidth = DiagramPageWidth;\n\t\tHeight = DiagramPageWidth;\n\t\tInitializeComponent();\n\t\tDataContextChanged += DiagramPage_DataContextChanged;\n\t\tAddVisualChild(_adornerLayer);\n\t\tSetBinding(ToolBoxItemsSourceProperty, new Binding(\"ToolSource\")\n\t\t{\n\t\t\tSource = ViewData\n\t\t});\n\t\tLoaded += (object s, RoutedEventArgs e) =>\n\t\t{\n\t\t\tif (!hasAddedTransformAdorner)\n\t\t\t{\n\t\t\t\tSystem.Windows.Documents.AdornerLayer.GetAdornerLayer(this).Add(TransformAdorner);\n\t\t\t\thasAddedTransformAdorner = true;\n\t\t\t}\n\t\t};\n\t}\n","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["其它卸载/移除路径、ContextMenu更换、Loaded真实次数、AdornerLayer缺失后果和Add失败/重载表现未运行观察；缺少本体去重不等于已证明重复动作或泄漏。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"P35","route":"原版 · 显示类型、样式与配置/导航门","classification":"source-confirmed","from":"ModuleDisplayType → DiagramItemDisplayConverter","to":"7种MODULE / 7种ADORNER / 其余DEFAULT","behavior":"原枚举常量与原CIL switch分支逐项对应：NORMAL、IMAGE、IFBRANCH、FUNCTION、SHELL、COMMUNCATION、TIMER归MODULE，其对应ADORNER枚举归ADORNER；DEFAULT、NONE、PROCESS/PROCESSADORNER、GROUP/GROUPADORNER归DEFAULT，非该枚举对象或未命中值也返回DEFAULT。ConvertBack直接调用Convert，不是反向映射。因而MODULE双击触发器只覆盖这组条件，不能把所有“模块”概念都当成同一配置双击入口。","refs":[{"path":"docs/architecture-recovery/display-type-cil-evidence.json","member":"VMControls.WPF.Base.DiagramItemDisplayConverter::Convert","sha256":"fcd9746c400807513768c9e6a3c53fa4510b461677dc221580f86d12076786db","start":70,"end":89,"excerpt":"          \"token\": \"0x06000b93\",\n          \"symbol\": {\n            \"token\": \"0x06000b93\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.Base.DiagramItemDisplayConverter\",\n            \"name\": \"Convert\",\n            \"parameters\": 4,\n            \"attributes\": \"Public, Final, Virtual, HideBySig, VtableLayoutMask\",\n            \"signatureBytes\