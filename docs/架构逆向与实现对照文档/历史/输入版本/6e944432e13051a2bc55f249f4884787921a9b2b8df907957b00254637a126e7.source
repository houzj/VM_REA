e_Closed(object sender, EventArgs e)\n\t{\n\t\tDispatcher.Invoke(() =>\n\t\t{\n\t\t\tcurTabControlBase = null;\n\t\t\tif (ROIPartUI is ModuleResultView moduleResultView)\n\t\t\t{\n\t\t\t\tmoduleResultView.Tag = null;\n\t\t\t}\n\t\t\tSetCurrentValue(IsOpenParamsProperty, false);\n\t\t\tSetRoiVisible(v: false);\n\t\t});\n\t\tIoc.Get\u003cIUnRedoService>()?.RemoveEmptyOperation();\n\t}\n","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"P06","route":"原版 · 两种参数窗入口","classification":"source-confirmed","from":"VmModuleDecorator.ConfigParamsExecute","to":"同 ParamsConfig 返回 / 否则关旧开新","behavior":"直接装饰器路径先自己的 CanOpenConfigurationInterface；已有窗口且 ParamsConfig 就是当前 VMModule.Params 则返回；否则 Close，再调用自己的 OpenParamsTabControl。不能将 P01 的总关旧规则外推到此。","refs":[{"path":"analysis/decompiled/VMControls.WPF/VMControls.WPF.DataForUI/VmModuleDecorator.cs","member":"VmModuleDecorator.ConfigParamsExecute","sha256":"fcf5adfaf9cc6422e9f12b3ff19a3d880a5ef6ef4174fe8dfa5355fc31c7c9e4","start":225,"end":240,"excerpt":"\tpublic void ConfigParamsExecute(HikImageView roiUIPart, bool isFrontedShow = false, Window frontWindow = null)\n\t{\n\t\tif (!CanOpenConfigurationInterface())\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tif (curTabControlBase != null)\n\t\t{\n\t\t\tif (curTabControlBase.ParamsConfig == VMModule.Params)\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tcurTabControlBase.Close();\n\t\t}\n\t\tOpenParamsTabControl(roiUIPart, isFrontedShow, frontWindow);\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"P07","route":"原版 · 两种参数窗入口","classification":"source-confirmed","from":"VmModuleDecorator.OpenParamsTabControl","to":"直接通用窗口 / 前台 Owner","behavior":"这里直接创建 ParamsTabControlBase，不调用 P03 扩展查找；登记 ModifyConfig，赋 Params/ROI，根据 isFrontedShow/frontWindow 选 Owner，Show 后记录引用、订阅 Closed。","refs":[{"path":"analysis/decompiled/VMControls.WPF/VMControls.WPF.DataForUI/VmModuleDecorator.cs","member":"VmModuleDecorator.OpenParamsTabControl","sha256":"fcf5adfaf9cc6422e9f12b3ff19a3d880a5ef6ef4174fe8dfa5355fc31c7c9e4","start":242,"end":264,"excerpt":"\tprivate void OpenParamsTabControl(HikImageView roiUIPart, bool isFrontedShow = false, Window frontWindow = null)\n\t{\n\t\tIoc.Get\u003cIUnRedoService>()?.Register(new RootOperation\n\t\t{\n\t\t\tRootOperType = \"ModifyConfig\"\n\t\t}, AppLocalizationService.GetLang(\"修改配置\") + \": \" + VMModule.Name);\n\t\tParamsTabControlBase paramsTabControlBase = new ParamsTabControlBase();\n\t\tparamsTabControlBase.ParamsConfig = VMModule.Params;\n\t\tparamsTabControlBase.ROIPartUI = roiUIPart;\n\t\tif (isFrontedShow && frontWindow != null)\n\t\t{\n\t\t\tparamsTabControlBase.Owner = frontWindow;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tparamsTabControlBase.Owner = Application.Current?.MainWindow;\n\t\t}\n\t\tparamsTabControlBase.Show();\n\t\tcurTabControlBase = paramsTabControlBase;\n\t\tcurTabControlBase.Closed += CurTabControlBase_Closed;\n\t}\n\n\tprivate void CurTabControlBase_Closed(object sender, EventArgs e)","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"U01","route":"原版 · 宿主缺口","classification":"unknown","from":"原扩展程序集 / ParamsTabControlBase","to":"具体配置执行与生命周期全集","behavior":"本页恢复两种打开路径；两者到每个实际菜单/模板/前台调用者的可达关系，以及扩展 TabWinBase 的模型操作、单次执行、线程和 native 准备仍须逐载体核查。","refs":[],"unknowns":["画布/流程按钮与双击样式、依赖属性委托及独立Group密码配置已分片P08–P11；原BAML、附加事件辅助、实际前台/其它调用者、扩展TabWinBase模型操作/单次执行/线程和native准备仍未齐，不以当前插件接口补缺。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C01","route":"当前 · 普通配置窗口","classification":"independent-implementation","from":"OpenToolConfiguration","to":"Group 分流 / provider 能力检查","behavior":"Group 调用节点转 OpenSubprogramCall；普通节点拒绝关闭/锁/运行态，要求配置 provider 或 WPF factory，无能力则显示未接入。捕获 solution/procedure/node 身份，再交配置窗口宿主。","refs":[{"path":"src/VisionEditor/ToolConfigurationHost.cs","member":"Current ordinary configuration entry","sha256":"2b1f110a2ab7b4cbf55b973109f6a99db56e111d90bfead811854d98d018b5b1","start":16,"end":27,"excerpt":" void OpenToolConfiguration(string id){\n  var procedure=doc.CurrentProcedure;\n  var node=procedure.Nodes.Single(n=>n.Id==id);\n  if(node.ModuleId==WorkflowCalls.ModuleId){OpenSubprogramCall(id);return;}\n  if(windowClosed||isLocked||activeRun is not null)return;\n  if(parameterEditorOpen&&toolConfigurationWindows?.Current is null)return;\n  var plugin=plugins.Find(node.ModuleId);\n  if(plugin is not (IToolConfigurationProvider or IWpfToolEditorFactory)){System.Windows.MessageBox.Show(this,\"该节点的配置模型尚未接入。\",\"模块参数\");return;}\n  string solution=doc.SolutionId;var owner=CaptureExecutionOwner();\n  var identity=new ToolConfigurationIdentity(solution,procedure.Id,id);\n  ConfigurationWindows().Open(identity,()=>{\n   var ownerDirectory=doc.BaseDirectory;configurationBaseDirectory=ownerDirectory;bool active=true;","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C02","route":"当前 · 普通配置窗口","classification":"independent-implementation","from":"ToolConfigurationWindowHost.Open","to":"同身份复用 / 关旧失败拒绝新窗","behavior":"UI 线程校验；同 identity 直接返回 existing；其它先 Close，若仍 Current 非空则抛取消关闭异常。创建后绑定 Owner、Identity、Closed，再 Show；异常解除事件并清身份。","refs":[{"path":"src/VisionPluginContracts/ToolConfigurationWindowHost.cs","member":"ToolConfigurationWindowHost.Open","sha256":"b31a677bb000a70168dbc56a648db41e52e609aad8281ff888e4689fcba5ae71","start":18,"end":30,"excerpt":" public Window Open(ToolConfigurationIdentity identity,Func\u003cWindow> create){\n  owner.Dispatcher.VerifyAccess();ArgumentNullException.ThrowIfNull(identity);ArgumentNullException.ThrowIfNull(create);\n  if(Current is {} existing&&Identity==identity)return existing;\n  Close();\n  if(Current is not null)throw new InvalidOperationException(\"当前配置窗口取消了关闭。\");\n  var window=create()??throw new InvalidOperationException(\"配置宿主未创建窗口。\");\n  if(ReferenceEquals(window,owner))throw new InvalidOperationException(\"配置窗口不能复用主窗口。\");\n  window.Owner=owner;window.ShowInTaskbar=false;Current=window;Identity=identity;\n  window.Closed+=OnClosed;\n  try{window.Show();Changed?.Invoke();return window;}\n  catch{window.Closed-=OnClosed;Current=null;Identity=null;throw;}\n }\n void OnClosed(object? sender,EventArgs args){","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C03","route":"当前 · 普通配置窗口","classification":"independent-implementation","from":"配置 Apply / Window.Closed","to":"所有者与目录守卫 / 文档参数 / scope 记忆","behavior":"Apply 同时检查 epoch、active、锁、运行、solution 和 base directory，并验证节点还在；文档写入后 RememberConfigurationParameters。Closed 将 active=false，ValidateToolConfigurationOwner 还检查身份/节点/目录后关闭失效窗。","refs":[{"path":"src/VisionEditor/ToolConfigurationHost.cs","member":"Current configuration Apply","sha256":"2b1f110a2ab7b4cbf55b973109f6a99db56e111d90bfead811854d98d018b5b1","start":28,"end":34,"excerpt":"   void Apply(Dictionary\u003cstring,JsonElement> values){\n    if(!IsCurrentExecutionOwner(owner)||!active||windowClosed||isLocked||activeRun is not null||doc.SolutionId!=solution||!StringComparer.OrdinalIgnoreCase.Equals(ownerDirectory,doc.BaseDirectory))throw new InvalidOperationException(\"当前模块不可编辑。\");\n    if(!doc.Document.Procedures.Any(p=>p.Id==procedure.Id&&p.Nodes.Any(n=>n.Id==id)))throw new InvalidOperationException(\"模块已移除。\");\n    var before=doc.Document.Procedures.Single(p=>p.Id==procedure.Id).Nodes.Single(n=>n.Id==id).Parameters;\n    doc.SetProcedureNodeParameters(procedure.Id,id,values);\n    executionScope.ForProcedure(procedure.Id).RememberConfigurationParameters(node.ModuleId,id,before,values);\n   }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/ToolConfigurationHost.cs","member":"Current window activity flag","sha256":"2b1f110a2ab7b4cbf55b973109f6a99db56e111d90bfead811854d98d018b5b1","start":42,"end":42,"excerpt":"   window.Closed+=(_,_)=>active=false;return window;","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/ToolConfigurationHost.cs","member":"Current configuration owner validation","sha256":"2b1f110a2ab7b4cbf55b973109f6a99db56e111d90bfead811854d98d018b5b1","start":45,"end":50,"excerpt":" void ValidateToolConfigurationOwner(){\n  if(toolConfigurationWindows?.Identity is not {} identity)return;\n  bool exists=doc.Document.Procedures.Any(p=>p.Id==identity.ProcedureId&&p.Nodes.Any(n=>n.Id==identity.NodeId));\n  if(doc.SolutionId!=identity.SolutionId||!exists||!StringComparer.OrdinalIgnoreCase.Equals(configurationBaseDirectory,doc.BaseDirectory))CloseToolConfiguration();\n }\n void CloseToolConfiguration(){toolConfigurationWindows?.Close();if(toolConfigurationWindows?.Current is null)configurationBaseDirectory=null;}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C04","route":"当前 · 调试上下文与缓存","classification":"independent-implementation","from":"CreateScopedToolEditorContext.Guard","to":"Dispatcher / epoch / solution / scope / 节点存活","behavior":"Guard 检查UI线程、当前所有者、锁/运行、方案、activeScope 与节点；此调试上下文和