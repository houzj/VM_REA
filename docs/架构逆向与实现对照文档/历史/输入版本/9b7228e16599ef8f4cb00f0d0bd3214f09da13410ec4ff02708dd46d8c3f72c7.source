	public void Redo()
	{
		if (RootOperType == &quot;CopyModule&quot;)
		{
			Actions.Where((IUnRedoActionOperation x) =&gt; x.ExecutePriority != ExecutePriority.Lower).ToList().ForEach((IUnRedoActionOperation x) =&gt;
