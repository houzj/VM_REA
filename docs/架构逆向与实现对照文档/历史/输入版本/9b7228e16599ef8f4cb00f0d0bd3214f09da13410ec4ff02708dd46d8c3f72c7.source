    {
        IsDataComplete = true; // Source sets this before Update, including when capture throws.
        newValue = capture();
        hasNewValue = true;
    }
    void ReleaseReplaced(T value)</pre></details><details><summary>Current restore delegates · current-source</summary><pre>src/VisionEditor.Core/DocumentHistoryEngine.cs:218–219
SHA256 4f33d5d51a205be0c36e042cd8a25f024e93f0ffce1f81c9ebe29667216953aa
