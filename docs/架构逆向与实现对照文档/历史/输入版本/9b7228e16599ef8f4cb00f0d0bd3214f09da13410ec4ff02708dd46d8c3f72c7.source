	public void RemoveEmptyOperation()
	{
		if (_undoStack.Count != 0)
		{
			IUnRedoOperation unRedoOperation = _undoStack.Peek();
			if ((unRedoOperation as IBuilder).Actions.Count == 0)
			{
				_undoStack.Pop();
				NotifyProperty();
			}
		}
	}
</pre></details></article><article id="RC01" class="independent-implementation"><h2>RC01 · 当前DocumentHistoryEngine / GraphEditorDocument → 独立快照历史与错误记录</h2><p>independent-implementation：当前DocumentHistoryEngine.Replay先对尚未完成part调用CompleteNewValue，再将root从source移至destination，按Ordered执行；异常记录LastError并false返回，finally减replayDepth，无默认回滚。GraphEditorDocument.Undo/Redo在重放前调整快照视口合并。当前Parts恢复委托/文档值，不是原名称字符串再索引模块；不能用共同的栈次序证明身份解析或嵌套Group改名等价。</p><p>待追：原生模块状态、操作级撤销/重做差分尚未闭合；当前名称编辑payload见RC02，不再将该已取得源码路径列作未知。</p><details><summary>Current independent replay · current-source</summary><pre>src/VisionEditor.Core/DocumentHistoryEngine.cs:82–111
SHA256 4f33d5d51a205be0c36e042cd8a25f024e93f0ffce1f81c9ebe29667216953aa
    bool Replay(bool isUndo)
    {
        LastError = null;
        replayDepth++;
        try
        {
            var source = isUndo ? undo : redo;
            var destination = isUndo ? redo : undo;
            if (source.Count == 0) return false;
            var root = source[^1];
            if (isUndo)
                foreach (var part in root.Parts.Where(part =&gt; !part.IsDataComplete).ToArray()) part.CompleteNewValue();
            source.RemoveAt(source.Count - 1);
            destination.Add(root);
            Trim(destination);
            foreach (var part in Ordered(root, isUndo))
                if (isUndo) part.Undo(); else part.Redo();
            return true;
        }
        catch (Exception error)
        {
            // Original service catches failures: no implicit rollback or safe retry is invented.
            LastError = error;
            return false;
        }
        finally { replayDepth--; }
    }

    static IEnumerable&lt;DocumentHistoryPart&lt;T&gt;&gt; Ordered(DocumentHistoryRoot&lt;T&gt; root, bool undo)
    {</pre></details><details><summary>Current document replay entry · current-source</summary><pre>src/VisionEditor.Core/GraphEditorDocument.cs:282–291
SHA256 4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558
    public void Undo() {
        if (history.CurrentRoot is { } root)
            foreach (var part in root.Parts.Where(p=&gt;p.IsDataComplete)) part.AdaptNewValue(MergeCurrentView);
        history.Undo();
    }
    public void Redo() {
        if (history.NextRedoRoot is { } root)
            foreach (var part in root.Parts) part.AdaptOldValue(MergeCurrentView);
        history.Redo();
    }</pre></details></article><article id="RC02" class="independent-implementation"><h2>RC02 · 当前WPF流程改名 → 文档Edit → history document part → 快照载荷、首次Undo与恢复的确切路径</h2><p>independent-implementation：WorkflowTabs.RenameProcedure在Enter或LostKeyboardFocus仅提交一次，Trim文本后再次CanEditProcedure并经Safe调用doc.RenameProcedure，随后RefreshAll。文档RequireName/禁用字符/同名返回后按procedure Id改Name；若为Group子流程，亦按GroupOwner的ProcedureId/NodeId同步拥有者节点名。Edit先计算并验证next，RecordEditHistory在document=next前执行。普通编辑BeginRoot/RegisterPart(document,Capture,RestoreSnapshot)捕获旧SolutionDocument副本、ProcedureId及BaseDirectory；不是三字符串改名part。无指定payload目录且序列化小于64KiB存内存，否则交HistoryPayloadStore持有文件。首次Undo的CompleteNewValue先置完成标志再调用capture；Replay之后移栈并restore旧值，Redo恢复所存new值。RestoreSnapshot经Rebase后替换文档和当前流程，设dirty/增Revision/发Changed；FilePath不在Snapshot字段中。</p><p>待追：仅追当前流程/Group子流程改名支路，不能扩为所有模块标题编辑器或原SDK载荷。外层Safe异常处理、文件写入失败与生命周期详见各独立专题，未运行窗口或厂商程序。</p><p>待追：原版改名使用名称路径与三个字符串，当前以完整文档及ID结构恢复；不从该独立快照机制推导原版同名/父改名失败行为。</p><details><summary>Current WPF procedure commit · current-source</summary><pre>src/VisionEditor/WorkflowTabs.cs:324–345
SHA256 24a398d5cd2a16ba2ea01ce980df4b7a3c4f4b9afe27c34720195bcd0b48cb45
    void RenameProcedure(string id)
    {
        if (!CanEditProcedure(id) || !procedureHeaders.TryGetValue(id, out var holder)) return;
        var procedure = doc.Document.Procedures.First(p =&gt; p.Id == id);
        var editor = new TextBox { Text = procedure.Name, MaxLength = 64, MinWidth = 65, MaxWidth = 240, FontSize = 14, Foreground = Brushes.White, Background = new SolidColorBrush(Color.FromRgb(40, 42, 44)), BorderThickness = new Thickness(0), ContextMenu = null };
        bool finished = false;
        void Commit()
        {
            if (finished) return;
            finished = true;
            string name = editor.Text.Trim();
            workflowHeaderStates.Remove(id);
            if (CanEditProcedure(id)) Safe(() =&gt; doc.RenameProcedure(id, name));
            RefreshAll();
        }
        editor.LostKeyboardFocus += (_, _) =&gt; Commit();
        editor.KeyDown += (_, e) =&gt; { if (e.Key == Key.Return) { e.Handled = true; Commit(); } };
        holder.Child = editor;
        Dispatcher.BeginInvoke(new Action(() =&gt; { editor.Focus(); editor.SelectAll(); }));
    }
}
</pre></details><details><summary>Current rename and owner ID updates · current-source</summary><pre>src/VisionEditor.Core/GraphEditorDocument.cs:110–116
SHA256 4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558
    public void RenameProcedure(string id,string name) {
        RequireName(name);
        // VmModuleBaseDecorator.Name rejects these characters before invoking the SDK.
        if(name.IndexOfAny(&quot;?;.[]&lt;&gt;()`&quot;.ToCharArray())&gt;=0)throw new ArgumentException(&quot;名称不能包含 ? ; . [ ] &lt; &gt; ( ) `。&quot;,nameof(name));
        var procedure=Procedure(id); if(procedure.Name==name)return;
        Edit(d=&gt;d with {Procedures=d.Procedures.Select(p=&gt;p.Id==id?p with {Name=name}:procedure.GroupOwner is {} owner&amp;&amp;p.Id==owner.ProcedureId?p with{Nodes=p.Nodes.Select(n=&gt;n.Id==owner.NodeId?n with{Name=name}:n).ToArray()}:p).ToArray()});
    }</pre></details><details><summary>Current snapshot payload contract · current-source</summary><pre>src/VisionEditor.Core/GraphEditorDocument.cs:15–22
SHA256 4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558
    sealed record Snapshot(SolutionDocument? MemoryDocument, string ProcedureId, string BaseDirectory,
        [property:System.Text.Json.Serialization.JsonIgnore] HistoryPayloadLease? Payload = null) : IDisposable
    {
        public SolutionDocument Document =&gt; MemoryDocument ?? JsonSerializer.Deserialize&lt;SolutionDocument&gt;(Payload!.ReadBytes())
            ?? throw new InvalidDataException(&quot;Invalid owned history document payload.&quot;);
        public void Dispose() =&gt; Payload?.Dispose();
    }
    public GraphEditorDocument(ModuleRegistry registry, string? historyPayloadParentDirectory=null)</pre></details><details><summary>Current edit ordering and snapshot capture · current-source</summary><pre>src/VisionEditor.Core/GraphEditorDocument.cs:296–323
SHA256 4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558
    void Edit(Func&lt;SolutionDocument,SolutionDocument&gt; action,string? selectedProcedure=null) { var next=Copy(SynchronizeGroupNames(PruneOwnedGroups(CloneOwnedCopies(action(Copy(document))))));
        if(PrepareExecutionTopologyChange is { } prepare){
            var before=document.Procedures.ToDictionary(p=&gt;p.Id,StringComparer.Ordinal);
            next=next with{Procedures=next.Procedures.Select(after=&gt;{
                if(!before.TryGetValue(after.Id,out var old))return after;
                var oldEdges=ProcedureGraph.ExecutionEdges(old).Select(e=&gt;(e.FromNode,e.ToNode));
                var newEdges=ProcedureGraph.ExecutionEdges(after).Select(e=&gt;(e.FromNode,e.ToNode));
                return oldEdges.SequenceEqual(newEdges)?after:prepare(old,after);
            }).ToArray()};
        }
        SolutionStore.ValidateStructure(next); RecordEditHistory();document=next;if(selectedProcedure is not null)CurrentProcedureId=selectedProcedure;if(!document.Procedures.Any(p=&gt;p.Id==CurrentProcedureId))CurrentProcedureId=document.Procedures.FirstOrDefault(p=&gt;p.GroupOwner is null)?.Id??&quot;&quot;;IsDirty=true;Revision++;Changed?.Invoke(); }
    Snapshot Capture()=&gt;CaptureSnapshot(Copy(document),CurrentProcedureId,BaseDirectory);
    Snapshot CaptureSnapshot(SolutionDocument value,string procedure,string directory)
    {
        ObjectDisposedException.ThrowIf(disposed,this);
        var bytes=JsonSerializer.SerializeToUtf8Bytes(value);
        if(historyPayloadParentDirectory is null &amp;&amp; bytes.Length&lt;64*1024)return new(value,procedure,directory);
        historyPayloadStore??=new(historyPayloadParentDirectory??Path.Combine(Path.GetTempPath(),&quot;VisionEditor-History&quot;));
        return new(null,procedure,directory,historyPayloadStore.CreateFile(bytes));
    }
    void RestoreSnapshot(Snapshot snapshot) {
        var next=Rebase(snapshot.Document,snapshot.BaseDirectory,BaseDirectory);
        document=next;CurrentProcedureId=snapshot.ProcedureId;IsDirty=true;Revision++;Changed?.Invoke();
    }
    Snapshot MergeCurrentView(Snapshot snapshot) {
        // Independent main view-data adapter: retain A03.3 zoom changes made
        // between replays without altering the action&#39;s structural old/new data.
        if(snapshot is null)return snapshot!; // Preserve an original failed-completion payload; do not invent one.</pre></details><details><summary>Current history root/part registration · current-source</summary><pre>src/VisionEditor.Core/GraphEditorDocument.History.cs:50–68
SHA256 d4a3f13130e6c9334547ecaf567c5cbf34e122e976166990fa02bb796522411f
    void RecordEditHistory()
    {
        if (configurationHistory is { NeedsRoot: true } session &amp;&amp; session.Generation == solutionGeneration)
        {
            BeginDocumentHistoryRoot();
            session.NeedsRoot = false;
            SetHistoryRecordingForbidden(session.ForbidBuild);
        }
        else if (history.CurrentRoot is not { ForbidBuild: true })
            BeginDocumentHistoryRoot();
    }

    void BeginDocumentHistoryRoot()
    {
        if (!history.BeginRoot()) return;
        history.RegisterPart(&quot;document&quot;,Capture,RestoreSnapshot,
            canRegister:(root,key)=&gt;!root.Parts.Any(part=&gt;part.Key==key));
    }
}</pre></details><details><summary>Current old-payload admission · current-source</summary><pre>src/VisionEditor.Core/DocumentHistoryEngine.cs:57–72
SHA256 4f33d5d51a205be0c36e042cd8a25f024e93f0ffce1f81c9ebe29667216953aa
    public bool RegisterPart(string key, Func&lt;T&gt; capture, Action&lt;T&gt; restore, int priority = 0,
        Func&lt;DocumentHistoryRoot&lt;T&gt;, string, bool&gt;? canRegister = null)
    {
        ArgumentNullException.ThrowIfNull(key);
        ArgumentNullException.ThrowIfNull(capture);
        ArgumentNullException.ThrowIfNull(restore);
        var root = CurrentRoot;
        if (IsReplaying || lazyLoadingDepth &gt; 0 || root is null || root.ForbidBuild || (canRegister is not null &amp;&amp; !canRegister(root, key))) return false;
        T oldValue = capture();
        // BuildPart invalidates redo only after a new part passed registration.
        ReleaseStack(redo);
        root.Add(new(key, priority, oldValue, capture, restore, releasePayload));
        return true;
    }

    public bool Undo() =&gt; Replay(isUndo: true);</pre></details><details><summary>Current first undo captures new payload · current-source</summary><pre>src/VisionEditor.Core/DocumentHistoryEngine.cs:197–203
SHA256 4f33d5d51a205be0c36e042cd8a25f024e93f0ffce1f81c9ebe29667216953aa
