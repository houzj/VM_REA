	public virtual string FullName
	{
		get
		{
			string text = &quot;&quot;;
			VmFrameTreeBase vmFrameTreeBase = this;
			while (vmFrameTreeBase != null &amp;&amp; !string.IsNullOrEmpty(vmFrameTreeBase.Name))
			{
				if (vmFrameTreeBase is VmIO)
				{
					text = ((vmFrameTreeBase.Parent != null) ? $&quot;({vmFrameTreeBase.UniqueName}).{text}&quot; : $&quot;{vmFrameTreeBase.UniqueName}.{text}&quot;);
					vmFrameTreeBase = (vmFrameTreeBase as VmIO).Root;
				}
				else
				{
					text = ((!(vmFrameTreeBase is IVmModule { ModuleType: 25u })) ? $&quot;{vmFrameTreeBase.UniqueName}.{text}&quot; : string.Format(&quot;{0}.{1}&quot;, &quot;[UserVar]&quot;, text));
					vmFrameTreeBase = vmFrameTreeBase.Parent as VmFrameTreeBase;
				}
			}
			if (text.Contains(&#39;.&#39;))
			{
				text = text.Remove(text.LastIndexOf(&#39;.&#39;));
			}
			return text;
		}
	}

