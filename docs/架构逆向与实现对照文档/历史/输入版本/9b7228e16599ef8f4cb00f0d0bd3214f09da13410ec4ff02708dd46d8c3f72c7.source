public class UnRedo_NameData
{
	/// &lt;summary&gt;
	/// 模块对象名称
	/// &lt;/summary&gt;
	public string ModuleFullName;

	/// &lt;summary&gt;
	/// 旧名称
	/// &lt;/summary&gt;
	public string OldName;

	/// &lt;summary&gt;
	/// 新名称
	/// &lt;/summary&gt;
	public string NewName;

	public UnRedo_NameData(string fullName, string oldName, string newName)
	{
		ModuleFullName = fullName;
		OldName = oldName;
		NewName = newName;
	}
}
