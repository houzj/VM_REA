	private void SetOldName(UnRedo_NameData nameData, IUnRedoParams unRedoParams)
	{
		string moduleFullName = nameData.ModuleFullName;
		string text = moduleFullName.Substring(0, moduleFullName.LastIndexOf(&#39;.&#39;));
		string sub = text + &quot;.&quot; + nameData.NewName;
		object obj = VmSolution.Instance[sub];
		(obj as IVmModule).Name = nameData.OldName;
	}

	private void SetNewName(UnRedo_NameData nameData, IUnRedoParams unRedoParams)
	{
		object obj = VmSolution.Instance[nameData.ModuleFullName];
		(obj as IVmModule).Name = nameData.NewName;
	}

	private void SkipToModuleCommandExecute()</pre></details></article><article id="RH04" class="source-confirmed"><h2>RH04 · VmFrameTreeBase.FullName / IVmFullPath → 沿Parent或VmIO.Root组成名称路径</h2><p>source-confirmed：FullName从当前节点沿树上行到null或Name为空；普通节点拼UniqueName，ModuleType25换[UserVar]，VmIO按Parent存在与否加括号并转Root；最后去末尾点。VmModule.UniqueName返回Name，VmModule.FullName委托base，改名快照因此是当时名称树路径，不是GUID路径；父链后续变化不会自动重写UnRedo_NameData字符串。</p><p>待追：所有节点UniqueName/Parent/Root变更、循环父链和GUID路径消费者不在改名有限片内；未以当前实例验证路径。</p><details><summary>VM.Core.VmFrameTreeBase::get_FullName · original-managed-cil</summary><pre>docs/architecture-recovery/workflow-rename-history-audit.cil.json:4501–4520
