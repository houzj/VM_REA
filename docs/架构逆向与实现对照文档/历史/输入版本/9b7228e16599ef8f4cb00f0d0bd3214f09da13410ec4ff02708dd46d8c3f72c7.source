SHA256 0d1c4043b6339eda89464301d9f42b78acd2be53f67681b7546c8afd332aeda4
public class ReNameUnRedoOperation : DisplayNotify, IUnRedoActionOperation, IUnRedoOperation, IDisposable, IUnRedoDataDone&lt;UnRedo_NameData&gt;
{
	public bool IsPart { get; set; } = true;

	public UnRedo_NameData Data { get; set; }

	public IUnRedoParams Params { get; set; }

	public IBuilder ParentNode { get; set; }

	public Action&lt;UnRedo_NameData, IUnRedoParams&gt; RedoAction { get; set; }

	public Action&lt;UnRedo_NameData, IUnRedoParams&gt; UndoAction { get; set; }

	public Action&lt;UnRedo_NameData&gt; UpdateAction { get; set; }

	public bool IsDataComplete { get; set; } = true;

	public ExecutePriority ExecutePriority { get; set; }

	public ReNameUnRedoOperation(Action&lt;UnRedo_NameData, IUnRedoParams&gt; redoAction, Action&lt;UnRedo_NameData, IUnRedoParams&gt; undoAction, UnRedo_NameData data)
	{
		RedoAction = redoAction;
		UndoAction = undoAction;
		Data = data;
	}

	public void Redo()
	{
		RedoAction(Data, Params);
	}

	public void Undo()
	{
		UndoAction(Data, Params);
	}

	public void Update()
	{
	}

	public void Dispose()
	{
		RedoAction = null;
		UndoAction = null;
		UpdateAction = null;
