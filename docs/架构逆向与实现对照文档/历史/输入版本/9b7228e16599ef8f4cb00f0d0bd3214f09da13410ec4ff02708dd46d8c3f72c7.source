SHA256 c141e2c53913b233b768782d6757fae5997ecaf638b35db2ddf98f5ef951a13e
	public override object this[string sub]
	{
		get
		{
			if (sub == null)
			{
				return null;
			}
			if (sub.Length == 0)
			{
				return this;
			}
			if (sub.Contains(&quot;[Params]&quot;))
			{
				return sub;
			}
			string[] array = sub.Split(&#39;.&#39;);
			string procInfo = array[0];
			VmModule vmModule = Modules.FirstOrDefault((VmModule p) =&gt; p.Name == procInfo);
			if (vmModule == null &amp;&amp; procInfo == VirtualPro.Name)
			{
				vmModule = VirtualPro;
			}
			if (procInfo == &quot;[UserVar]&quot;)
			{
				vmModule = AllModules.Values?.FirstOrDefault((VmModule p) =&gt; p != null &amp;&amp; ((IVmModule)p).ModuleType == 5);
			}
			if (sub.Contains(&#39;.&#39;))
			{
				return vmModule?[sub.Remove(0, array[0].Length + 1)];
			}
			return vmModule;
		}
	}
</pre></details><details><summary>Recursive frame path resolution · local-decompiled-source</summary><pre>analysis/decompiled/VM.Core/VM.Core/VmFrameTreeBase.cs:101–142
SHA256 e1464d00357b690eec97a7ed0a8c7fc5c6c14066779bcac65e52c280059784f0
	public virtual object this[string sub]
	{
		get
		{
			if (sub == null || sub.Length == 0)
			{
				return this;
			}
			string[] array = sub.Split(&#39;.&#39;);
			object obj = null;
			if (array[0].First() == &#39;[&#39; &amp;&amp; array[0].Last() == &#39;]&#39; &amp;&amp; this is IVmExternPath vmExternPath)
			{
				return vmExternPath.GetExternNode(sub);
			}
			obj = GetNode(array[0]);
			if (obj == null)
			{
				obj = GetNode($&quot;%{array[0]}%&quot;);
			}
			int num = sub.IndexOf(&#39;.&#39;) + 1;
			if (num != 0)
			{
				string text = sub.Substring(num);
				string[] nextSplit = text.Split(&#39;.&#39;);
				string sub2 = ((nextSplit.Length &gt; 1) ? nextSplit[1] : null);
				if (obj is VmFrameTreeBase vmFrameTreeBase)
				{
					return vmFrameTreeBase[text];
				}
				if (obj is VmIOCollection vmIOCollection)
				{
					return vmIOCollection.GetIO(nextSplit[0])?[sub2];
				}
				if (obj is IList source)
				{
					return source.Cast&lt;VmFrameTreeBase&gt;().FirstOrDefault((VmFrameTreeBase p) =&gt; p.Name == nextSplit[0])?[sub2];
				}
			}
			return obj;
		}
	}
</pre></details><details><summary>Module-set path lookup · local-decompiled-source</summary><pre>analysis/decompiled/VM.Core/VM.Core/VmModuleSet.cs:852–878
SHA256 f3b98c4436686b0a9babf8cde4f5f6c83814664b8f7835dfabbeb02e2a64a346
	public override object GetNode(string key)
	{
		object obj = null;
		if (!string.IsNullOrEmpty(key) &amp;&amp; key.First() == &#39;(&#39; &amp;&amp; key.Last() == &#39;)&#39;)
		{
			obj = base.GetNode(key);
		}
		else
		{
			obj = GetModuleByProtocol(key);
			if (obj == null)
			{
				obj = base.GetNode(key);
			}
		}
		return obj;
	}

	protected VmModule GetModuleByProtocol(string moduleInfo)
	{
		if (string.IsNullOrEmpty(moduleInfo))
		{
			return null;
		}
		return Modules.FirstOrDefault((VmModule p) =&gt; p != null &amp;&amp; p.Name == moduleInfo);
	}
</pre></details></article><article id="RH06" class="source-confirmed"><h2>RH06 · 原config候选 / App.OnStartup → IUnRedoService类型注入与服务转发</h2><p>source-confirmed：安装config候选中UnRedoServiceImplement指myLibs\VM.UnRedo.dll、UnRedoStackCount=15。原App.OnStartup以BaseDirectory+ConfigurationHelper.GetConfig得到路径，Assembly.LoadFrom后选首个实现IUnRedoService的类型Ioc.Set。新取原VM.UnRedo身份及离线源表明UnRedoService构造new UnRedoSchedule，Register/Undo/Redo/RemoveEmptyOperation直接转发；本审计只静态取证，不执行LoadFrom、服务构造或其临时文件清理。</p><p>待追：ConfigurationHelper配置优先级、实际Assembly/Ioc实例、泛型/反射运行绑定未知；路径候选存在不证明原机采用了该服务。</p><details><summary>VisionMaster.App::OnStartup · original-managed-cil</summary><pre>docs/architecture-recovery/workflow-rename-history-audit.cil.json:23992–24011
