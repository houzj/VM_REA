SHA256 babebf8e2bef407d7d06105aa4540bb844e32644a25d9a8c8c7faebfe57cf3f7
		string text = AppDomain.CurrentDomain.BaseDirectory + ConfigurationHelper.GetConfig(&quot;UnRedoServiceImplement&quot;);
		LogHelper.Info(&quot;撤销重做注入ioc,准备的dll路径为&quot; + text);
		Assembly assembly = Assembly.LoadFrom(text);
		Type typeto = assembly.GetTypes().FirstOrDefault((Type c) =&gt; c.GetInterfaces().Contains(typeof(IUnRedoService)));
		Ioc.Set(typeof(IUnRedoService), typeto);
		Program.UpdateTitleBinding();</pre></details><details><summary>Service creation and forwarding · original-managed-offline-decompilation</summary><pre>docs/architecture-recovery/workflow-rename-history-audit.original/VM.UnRedo.UnRedoService.decompiled.cs:12–29
SHA256 d139eaffdd22d07b27dac23206f13575f006343b7e808584256c11cc24fe5c01
	public UnRedoService()
	{
		_unRedoSchedule = new UnRedoSchedule();
	}

	public void Redo(object dispatcher)
	{
		_unRedoSchedule.Redo(dispatcher);
	}

	public void Register(IUnRedoOperation unRedoOperation, string displayName, Expression&lt;Func&lt;IBuilder, IUnRedoOperation, bool&gt;&gt; CanRegister = null)
	{
		_unRedoSchedule.Register(unRedoOperation, displayName, CanRegister);
	}

	public void SetIsLaziLoading(bool isLaziLoading)
	{
		_unRedoSchedule.SetIsLaziLoading(isLaziLoading);</pre></details></article><article id="RH07" class="source-confirmed"><h2>RH07 · UnRedoSchedule.Register → 录制条件、part与root构建</h2><p>source-confirmed：Register仅当_unRedoing&lt;=0、_nLaziLoading&lt;=0、可选CanRegister允许且必要栈非空、IsPart要求栈非空且top.ForbidBuild=false才构建；不满足时本体不加入/不Dispose传入对象。part经BuildPart，非part经BuildRoot，再通知。Root新建RootUnRedoOperation+SafeObservableCollection，复制IRootParam类型/ForbidBuild并TryPush；溢出时Dispose移出root。part先清redo栈，设ParentNode/top、显示名/IsUndoStack，再追加Actions。当前Register体没有按IsRunning/LockAreaStatus/IsOpenParam统一拒绝；外层入口权限不能由该体臆造。</p><p>待追：SafeObservableCollection跨线程、CanRegister动态表达式/空参数失败和所有root并发创建者未知；未加入并不等于撤销了调用方后续原生操作。</p><details><summary>VM.UnRedo.UnRedoSchedule::Register · original-managed-cil</summary><pre>docs/architecture-recovery/workflow-rename-history-audit.cil.json:13533–13552
