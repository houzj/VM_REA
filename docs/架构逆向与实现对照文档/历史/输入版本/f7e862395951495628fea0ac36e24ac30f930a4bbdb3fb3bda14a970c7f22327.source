	{
		FileStream fileStream = null;
		try
		{
			fileStream = new FileStream(fileName, FileMode.Create);
			fileStream.Write(pReadByte, 0, pReadByte.Length);
		}
		catch
		{
			return false;
		}
		finally
		{
			fileStream?.Close();
		}
		return true;
	}
</pre></details></details><details id="E12" class="source-confirmed"><summary>E12 · CheckData共享图像回填 → GetImageBufferByFileName→Win32映射/ExternalCallHelper边界 · source-confirmed</summary><p>Buffer为空且MemoryAddress非空才走原共享图像读取：OpenFileMapping(4)、先映16字节读长度与offset，Gray8要求width*height其它三倍，再映长度+offset，IntPtr2Bytes取内容。catch把result置null；finally按非零指针Unmap与CloseHandle。首段Unmap后没有把指针清零，后续失败和finally范围照原体保留，不执行验证。</p><p>待核：映射头协议、Win32 API真实错误、IntPtr2Bytes ABI与目标进程实际共享内存未运行；不推断设备入口或读取任意地址。</p><details><summary>Apps.Data.Common.ImageSaveOpenCvHelper::CheckData · 22892–22911</summary><p><code>docs/architecture-recovery/image-export-entry-audit.cil.json · original-managed-cil · SHA 3496589e41ca17d3b459cf5e6c451436766fa3aff3c39d04de6a8101b7f05fc0</code></p><pre>          &quot;token&quot;: &quot;0x06000288&quot;,
