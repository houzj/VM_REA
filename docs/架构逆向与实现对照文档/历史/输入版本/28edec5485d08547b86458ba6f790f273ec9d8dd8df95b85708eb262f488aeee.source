    {
      "id": "ME02",
      "classification": "source-confirmed",
      "from": "TitleBar.MenuSource.Items / MenueDataTemplate.Items",
      "to": "NormalMenuItemStyle.MenuItem.Command",
      "behavior": "TitleBar原资源将顶层Menu绑定MenuSource.Items，HierarchicalDataTemplate子层绑定Items。顶层ItemContainerStyle BasedOn NormalMenuItemStyle；新提取Apps.Style原MenuStyle资源把MenuItem.Command绑定ItemClickCommand、IsEnabled绑定IsEnabled，并在IsDisplayInMenu=false时折叠。TitleBar本地样式另在IsVisible=false时折叠、RunData.IsRunning=true时禁用。这里区分集合来源、容器样式与命令接收者；不由展示字段自动推出权限生产者。",
      "refs": [
        {
          "path": "docs/architecture-recovery/menu-entry-materialization-audit.resources/titlebar.xaml",
          "member": "Hierarchical child source",
          "sha256": "f047a087f97b3217145d37d85c3b4f68c0d1dac21c7ed803d2879b3708c5e67d",
          "start": 15,
          "end": 30,
          "excerpt": "      <HierarchicalDataTemplate x:Key=\"MenueDataTemplate\" ItemsSource=\"{Binding Items}\">\n        <TextBlock>\n          <FrameworkElement.Style>\n            <Style TargetType=\"{x:Type TextBlock}\">\n              <Setter Property=\"Text\" Value=\"{Lang:ResourceBinding Name}\" />\n              <Style.Triggers>\n                <DataTrigger Value=\"True\" Binding=\"{Binding IsSolutionPath}\">\n                  <Setter Property=\"Text\" Value=\"{Binding Name, Mode=OneWay}\" />\n                  <Setter Property=\"FrameworkElement.ToolTip\" Value=\"{Binding ToolTip}\" />\n                </DataTrigger>\n              </Style.Triggers>\n            </Style>\n          </FrameworkElement.Style>\n        </TextBlock>\n      </HierarchicalDataTemplate>\n      <Style x:Key=\"SolutionButton\" TargetType=\"{x:Type Button}\">",
          "evidenceType": "original-baml-offline-decoded-resource",
          "binaryIdentity": "319618b9f82dfc30546c900c1c19a665e0fce1d87d2a7ffa7bb4345915b180c1"
        },
        {
          "path": "docs/architecture-recovery/menu-entry-materialization-audit.resources/titlebar.xaml",
          "member": "Menu root and local container gates",
          "sha256": "f047a087f97b3217145d37d85c3b4f68c0d1dac21c7ed803d2879b3708c5e67d",
          "start": 334,
          "end": 348,
          "excerpt": "        <Menu Name=\"menu\" WindowChrome.IsHitTestVisibleInChrome=\"True\" Grid.Row=\"1\" Grid.Column=\"1\" VerticalAlignment=\"Stretch\" Margin=\"0,3,0,1\" Background=\"#00FFFFFF\" Style=\"{StaticResource NormalMenuStyle}\" ItemTemplate=\"{StaticResource MenueDataTemplate}\" FontSize=\"14\" HorizontalAlignment=\"Left\" IsEnabled=\"{Binding IsButtonClickEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:TitleBar}}\" ItemsSource=\"{Binding MenuSource.Items}\">\n          <ItemsControl.ItemContainerStyle>\n            <Style BasedOn=\"{StaticResource NormalMenuItemStyle}\" TargetType=\"{x:Type MenuItem}\">\n              <Style.Triggers>\n                <DataTrigger Value=\"True\" Binding=\"{Binding Path=RunData.(VMInterface:IVMRun.IsRunning)}\">\n                  <Setter Property=\"IsEnabled\" Value=\"False\" />\n                </DataTrigger>\n                <DataTrigger Value=\"False\" Binding=\"{Binding IsVisible}\">\n                  <Setter Property=\"Visibility\" Value=\"Collapsed\" />\n                </DataTrigger>\n              </Style.Triggers>\n              <EventSetter Event=\"SubmenuOpened\" Handler=\"MenuItem_SubmenuOpened\" />\n            </Style>\n          </ItemsControl.ItemContainerStyle>\n        </Menu>",
          "evidenceType": "original-baml-offline-decoded-resource",
          "binaryIdentity": "319618b9f82dfc30546c900c1c19a665e0fce1d87d2a7ffa7bb4345915b180c1"
        },
        {
          "path": "docs/architecture-recovery/menu-entry-materialization-audit.resources/menustyle.xaml",
          "member": "Business command and base enabled binding",
          "sha256": "afa3f2fe0cfddb7a781d926f9099cd35ad0dba7981b080fd7633646a72aae67d",
          "start": 113,
          "end": 126,
          "excerpt": "  <win:Style x:Key=\"NormalMenuItemStyle\" TargetType=\"{x:Type MenuItem}\">\n    <win:Setter Property=\"HorizontalContentAlignment\" Value=\"{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}\" />\n    <win:Setter Property=\"VerticalContentAlignment\" Value=\"{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}\" />\n    <win:Setter Property=\"Background\" Value=\"#00FFFFFF\" />\n    <win:Setter Property=\"BorderBrush\" Value=\"#00FFFFFF\" />\n    <win:Setter Property=\"BorderThickness\" Value=\"1\" />\n    <win:Setter Property=\"ScrollViewer.PanningMode\" Value=\"Both\" />\n    <win:Setter Property=\"Stylus.IsFlicksEnabled\" Value=\"False\" />\n    <win:Setter Property=\"Foreground\" Value=\"{win:DynamicResource Col_Menubar_Foreground}\" />\n    <win:Setter Property=\"MenuItem.Command\" Value=\"{Binding ItemClickCommand}\" />\n    <win:Setter Property=\"IsEnabled\" Value=\"{Binding IsEnabled}\" />\n    <win:Style.Triggers>\n      <win:Trigger Property=\"MenuItem.Role\" Value=\"TopLevelHeader\">\n        <win:Setter Property=\"Background\" Value=\"#00FFFFFF\" />",
          "evidenceType": "original-baml-offline-decoded-resource",
          "binaryIdentity": "8980a9964c8c530511ae79fe04cf19534dc14377cdc73ffe03f26921f7d0db63"
        },
        {
          "path": "docs/architecture-recovery/menu-entry-materialization-audit.resources/menustyle.xaml",
          "member": "Menu-only visibility flag",
          "sha256": "afa3f2fe0cfddb7a781d926f9099cd35ad0dba7981b080fd7633646a72aae67d",
          "start": 142,
          "end": 144,
          "excerpt": "      <win:DataTrigger Value=\"false\" Binding=\"{Binding IsDisplayInMenu}\">\n        <win:Setter Property=\"Visibility\" Value=\"Collapsed\" />\n      </win:DataTrigger>",
          "evidenceType": "original-baml-offline-decoded-resource",
          "binaryIdentity": "8980a9964c8c530511ae79fe04cf19534dc14377cdc73ffe03f26921f7d0db63"
        }
      ],
      "unknowns": [
        "子层容器是否应用同一派生样式、外部样式覆盖、IsEnabled/IsVisible全部生产者与权限变更刷新尚未闭合；原资源声明不等于点击发生。"
      ],
      "runtimeExecuted": false,
      "fullBehaviorClosed": false
    },
    {
      "id": "ME03",
      "classification": "source-confirmed",
      "from": "TitleToolBar.ItemsSource / CollectionViewSource",
      "to": "默认工具栏按钮的命令、可见门和样式",
      "behavior": "已有原TitleToolBar解码资源用x:Reference us读取ItemsSource，按ToolGroupItemInfo.GroupName分组；默认TitleToolButtonDataTemplate中Button.Command=ItemClickCommand，Visibility仅绑定IsVisible。它BasedOn ToolBarButtonStyle，新提取原NormalButtonStyle确认该样式IsEnabled绑定IsEnabled。默认模板另以RunData.IsRunning禁用。IsDisplayInMenu与IsShowExternal在该默认按钮/基础样式所选体没有作为可见门，不能把三个同义化；五个特殊模板仍分别处理，不推广默认规则到全部模板。",
      "refs": [
        {
          "path": "docs/architecture-recovery/menu-universe-next-original-resources/titletoolbar.xaml",
          "member": "Toolbar source/grouping",
          "sha256": "f4ecfe33da73766665c4a909919707a6e24894d6820f865acecdbb68ca5ad339",
          "start": 12,
          "end": 16,
          "excerpt": "      <CollectionViewSource x:Key=\"src\" IsLiveGroupingRequested=\"True\" Source=\"{Binding ItemsSource, Source={x:Reference us}}\">\n        <CollectionViewSource.GroupDescriptions>\n          <PropertyGroupDescription PropertyName=\"ToolGroupItemInfo.GroupName\" />\n        </CollectionViewSource.GroupDescriptions>\n      </CollectionViewSource>",
          "evidenceType": "local-extracted-resource",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "docs/architecture-recovery/menu-universe-next-original-resources/titletoolbar.xaml",
          "member": "Default toolbar command and Click event",
          "sha256": "f4ecfe33da73766665c4a909919707a6e24894d6820f865acecdbb68ca5ad339",
          "start": 158,
          "end": 172,
          "excerpt": "      <DataTemplate x:Key=\"TitleToolButtonDataTemplate\">\n        <Button Margin=\"4,0,4,0\" Height=\"36\" Width=\"36\" Command=\"{Binding ItemClickCommand}\" ToolTip=\"{Lang:ResourceBinding Name}\" Visibility=\"{Binding IsVisible, Converter={StaticResource boolToVisibilityCvt}}\">\n          <FrameworkElement.Style>\n            <Style TargetType=\"{x:Type Button}\" BasedOn=\"{StaticResource ToolBarButtonStyle}\">\n              <Style.Triggers>\n                <DataTrigger Value=\"True\" Binding=\"{Binding Path=RunData.(VMInterface:IVMRun.IsRunning)}\">\n                  <Setter Property=\"IsEnabled\" Value=\"False\" />\n                </DataTrigger>\n              </Style.Triggers>\n              <EventSetter Event=\"Click\" Handler=\"Button_Click\" />\n            </Style>\n          </FrameworkElement.Style>\n        </Button>\n      </DataTemplate>\n      <DataTemplate x:Key=\"customDataTemplate\">",
          "evidenceType": "local-extracted-resource",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "docs/architecture-recovery/menu-entry-materialization-audit.resources/normalbuttonstyle.xaml",
          "member": "Base toolbar enabled binding",
          "sha256": "0ca27d6dd39d1ac0943b526664af4a07306a6a344833fa15f50e4c3041b33ea8",
          "start": 1235,
          "end": 1243,
          "excerpt": "  <Style x:Key=\"ToolBarButtonStyle\" TargetType=\"{x:Type Button}\">\n    <Setter Property=\"FrameworkElement.FocusVisualStyle\" Value=\"{x:Null}\" />\n    <Setter Property=\"IsEnabled\" Value=\"{Binding IsEnabled}\" />\n    <Setter Property=\"Template\">\n      <Setter.Value>\n        <ControlTemplate TargetType=\"{x:Type Button}\">\n          <Border Name=\"border\" CornerRadius=\"2\" Background=\"#00FFFFFF\" BorderThickness=\"1\">\n            <Grid>\n              <Image Name=\"fore\" Width=\"36\" Height=\"36\" Source=\"{Binding ImageEnablePath}\" />",
          "evidenceType": "original-baml-offline-decoded-resource",
          "binaryIdentity": "8980a9964c8c530511ae79fe04cf19534dc14377cdc73ffe03f26921f7d0db63"
        },
        {
          "path": "docs/architecture-recovery/menu-universe-next-original-resources/titletoolbar.xaml",
          "member": "Default and finite special template selection",
          "sha256": "f4ecfe33da73766665c4a909919707a6e24894d6820f865acecdbb68ca5ad339",
          "start": 172,
          "end": 199,
          "excerpt": "      <DataTemplate x:Key=\"customDataTemplate\">\n        <ContentPresenter Name=\"cp\" Content=\"{Binding}\">\n          <FrameworkElement.Style>\n            <Style TargetType=\"{x:Type ContentPresenter}\">\n              <Setter Property=\"ContentTemplate\" Value=\"{StaticResource TitleToolButtonDataTemplate}\" />\n              <Style.Triggers>\n                <DataTrigger Value=\"SingleRunTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource SingleRunTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"ContinousRunTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource ContinousRunTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"DownPopTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource DownPopTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"RedoTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource RedoTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"LockingTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource LockingTemplate}\" />\n                </DataTrigger>\n              </Style.Triggers>\n            </Style>\n          </FrameworkElement.Style>\n        </ContentPresenter>\n      </DataTemplate>\n    </ResourceDictionary>\n  </FrameworkElement.Resources>",
          "evidenceType": "local-extracted-resource",
          "binaryIdentity": "not revalidated in this slice"
        }
      ],
      "unknowns": [
        "Linux SaveLoadSolutionTemplate在此原字典未声明的既有缺口仍保留；未证明其它字典替代、活模板选择与实际CanExecute/WPF优先级。"
      ],
      "runtimeExecuted": false,
      "fullBehaviorClosed": false
    },
    {
      "id": "ME04",
      "classification": "source-confirmed",
      "from": "TitleToolBar.IStyleConnector.Connect(connectionId=2)",
      "to": "Click → Button_Click → SeMenuFocus",
      "behavior": "新取原generated CIL：connectionId==2时创建EventSetter，Event=ButtonBase.ClickEvent、Handler=本实例Button_Click，再加到传入Style.Setters；其它值直接结束。Button_Click只将sender as UIElement交MainWindow.SeMenuFocus。后者找祖先MainWindow，再找后代ProcedureConfigControl，curTabControlBase非null才FocusManager.SetFocusedElement。业务methodName没有在这个Click处理器中执行；它与Button.Command是两条静态接线。",
      "refs": [
        {
