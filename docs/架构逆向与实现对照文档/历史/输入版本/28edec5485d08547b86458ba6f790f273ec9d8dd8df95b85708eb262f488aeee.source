        {
          "path": "analysis/decompiled/VisionMasterMain/VisionMasterMain/MainWindow.xaml.cs",
          "member": "Focus scope selected branch",
          "sha256": "19da4fa478dc4600f611feb4e5c757c77a0311d93cdd12e13b9d659fa5d54a37",
          "start": 95,
          "end": 107,
          "excerpt": "\tpublic static void SeMenuFocus(UIElement element)\n\t{\n\t\tMainWindow mainWindow = VisualTreeHelperEx.FindAncestorByType<MainWindow>(element);\n\t\tif (mainWindow != null)\n\t\t{\n\t\t\tProcedureConfigControl procedureConfigControl = VisualTreeHelperEx.FindDescendantByType<ProcedureConfigControl>(mainWindow);\n\t\t\tif (procedureConfigControl?.curTabControlBase != null)\n\t\t\t{\n\t\t\t\tFocusManager.SetFocusedElement(procedureConfigControl.curTabControlBase, element);\n\t\t\t}\n\t\t}\n\t}\n",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        }
      ],
      "unknowns": [
        "connectionId=2与具体活Style的分派、Command/Click触发顺序、实际焦点效果未运行核对；不把generated连接器的存在视为点击验收。"
      ],
      "runtimeExecuted": false,
      "fullBehaviorClosed": false
    },
    {
      "id": "ME05",
      "classification": "source-confirmed",
      "from": "TitleBar.IStyleConnector.Connect(connectionId=1/2/3)",
      "to": "关闭Click、SubmenuOpened、横向滚轮分别接收",
      "behavior": "原generated CIL对connectionId减1后switch：1把Button.Click接TitleBar.Button_Click；2创建MenuItem.SubmenuOpenedEvent的EventSetter接MenuItem_SubmenuOpened；3接ScrollViewer.PreviewMouseWheel。MenuItem_SubmenuOpened只交SeMenuFocus，TitleBar.Button_Click只记录用户点击关闭窗口按钮日志；原资源关闭按钮的业务Command是SystemCommands.CloseWindowCommand。不能误将同名Button_Click认成菜单业务总分发。",
