      "id": "ME09",
      "classification": "independent-implementation",
      "from": "当前MainWindow.BuildChrome/Menu/Tool",
      "to": "直接Action事件的有限当前实现",
      "behavior": "当前BuildChrome通过BuildFileMenu及Menu函数创建明确菜单；Menu把Action接Click并Safe执行，SubmenuOpened接SetShellMenuFocus。Tool创建Button，action null即禁用，有action才接Safe(action)，另接焦点Click。BuildFileMenu的AddFileCommand也直接接Click。此为当前独立事件装配，与原ItemData/反射方法/XML类型工厂分开；当前可见操作不证明原214声明、权限与动态资源物化已复现。",
      "refs": [
        {
          "path": "src/VisionEditor/MainWindow.xaml.cs",
          "member": "Finite current chrome menu/toolbar construction",
          "sha256": "034c0dae3e04a9b592031d87e1c1349c23b14091b04564c295267a97fcaa1b4a",
          "start": 51,
          "end": 54,
          "excerpt": " void BuildChrome(){BuildFileMenu();Menu(\"设置\",(\"所选模块参数\",()=>OpenSelected()),(\"运行策略\",OpenRunModeSettings));Menu(\"工具\",(\"撤销\",UndoShell),(\"重做\",RedoShell),(\"流程校验\",()=>Validate()),(\"适应画布\",()=>Fit()));Menu(\"系统\",(\"模块目录\",()=>ShowToolPicker(\"all\")));Menu(\"帮助\",(\"操作说明\",()=>MessageBox.Show(this,\"悬停左侧分类打开工具项，将已启用工具拖入画布；双击节点打开参数窗口；点击连接端口建立数据连接。\")),(\"帮助文档（在线）\",OpenOnlineHelpDocument),(\"关于\",ShowAbout));\n  Tool(\"toolbar_toolbarSave_normal.png\",\"保存\",()=>Save(false));Tool(\"toolbar_toolbarOpen_normal.png\",\"打开方案\",Open);undoToolButton=Tool(\"toolbar_ic_topbar_undo_normal.png\",\"撤销\",UndoShell);SetToolbarStateIcon(undoToolButton,\"toolbar_ic_topbar_undo_normal.png\",\"toolbar_ic_topbar_undo_disable.png\");redoToolButton=Tool(\"toolbar_ic_topbar_redo_normal.png\",\"重做\",RedoShell);SetToolbarStateIcon(redoToolButton,\"toolbar_ic_topbar_redo_normal.png\",\"toolbar_ic_topbar_redo_disable.png\");lockToolButton=Tool(\"toolbar_ic_topbar_lock_normal.png\",\"锁定工作区\",RequestWorkAreaLock);Sep();Tool(\"toolbar_ic_topbar_camera_normal.png\",\"相机列表\",()=>RefreshCameraProvider(true));Tool(\"toolbar_ic_全局变量_normal.png\",\"全局变量（变量模型尚未接入）\",null);Tool(\"toolbar_ic_通信管理_normal.png\",\"通信管理（通信模块尚未接入）\",null);Tool(\"toolbar_ic_topbar_全局触发_normal.png\",\"全局触发（触发器尚未接入）\",null);Tool(\"toolbar_ic_script_normal.png\",\"脚本（脚本引擎尚未接入）\",null);Sep();Tool(\"toolbar_toolbarStart_normal.png\",\"运行流程\",()=>{_=Run();});continuousToolButton=Tool(\"toolbar_toolbarRunRepeat_normal.png\",\"连续运行\",StartContinuous);stopToolButton=Tool(\"toolbar_toolBarStop_normal.png\",\"停止\",()=>activeRun?.Cancel());Tool(\"toolbar_ic_topbar_综合配置_normal.png\",\"综合配置（系统配置尚未接入）\",null);\n  BuildRail();}\n void ToggleToolboxClick(object sender,RoutedEventArgs e)=>ToggleToolbox();",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor/MainWindow.xaml.cs",
          "member": "Current direct Action menu and toolbar receivers",
          "sha256": "034c0dae3e04a9b592031d87e1c1349c23b14091b04564c295267a97fcaa1b4a",
          "start": 56,
          "end": 57,
          "excerpt": " MenuItem Menu(string title,params (string,Action)[] items){var root=new MenuItem{Header=title,Foreground=new SolidColorBrush(Color.FromRgb(192,192,192)),Padding=new Thickness(10,4,10,4)};root.SubmenuOpened+=(_,_)=>SetShellMenuFocus(root);foreach(var item in items){var mi=new MenuItem{Header=item.Item1};mi.Click+=(_,_)=>Safe(item.Item2);root.Items.Add(mi);}MenuHost.Items.Add(root);return root;}\n Button Tool(string asset,string tip,Action? action){var b=new Button{Width=44,Height=42,Margin=new Thickness(0),Padding=new Thickness(8),Background=Brushes.Transparent,BorderBrush=Brushes.Transparent,BorderThickness=new Thickness(0),ToolTip=tip,IsEnabled=action is not null};b.Template=PlainTemplate();b.Content=new Image{Source=Asset(asset),Width=26,Height=26,Stretch=Stretch.Uniform};if(action is not null)b.Click+=(_,_)=>Safe(action);b.Click+=(_,_)=>SetShellMenuFocus(b);ToolBar.Children.Add(b);return b;}",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor/MainWindow.ShellFileMenu.cs",
          "member": "Current file-command direct receiver",
          "sha256": "74ff798d63820e6f357c702179e5e4ee00e9f454635f58447a9c007b801f70a3",
          "start": 27,
          "end": 32,
          "excerpt": "    void AddFileCommand(MenuItem parent, string title, Action action)\n    {\n        var item = new MenuItem { Header = title, Style = (System.Windows.Style)FindResource(\"ShellFileMenuItem\") };\n        item.Click += (_, _) => Safe(action);\n        parent.Items.Add(item);\n    }",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        }
