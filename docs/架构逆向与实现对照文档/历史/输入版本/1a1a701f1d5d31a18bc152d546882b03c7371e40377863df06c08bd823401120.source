          &quot;ilBytes&quot;: &quot;00288800000a6feb00000a027b150200046f6003000a2628bd00000a7b1803000a027b150200046f9802000a6f0e04000a0002147d150200042a&quot;,
          &quot;instructions&quot;: [
            {
              &quot;offset&quot;: 0,
