SHA256 0dc267a72c454a282293173a4d0306011991bab5793a93c4e16b66bc70741509
	public void GetData(bool isInnerModule = false, bool isPopErrorInfo = true)
	{
		lock (_lock)
		{
			int binaryData = ServerSDKManager.serverSDKManager.mModuleManager.GetBinaryData((uint)ModuleID, &quot;LightDeviceList&quot;, out var data);
			try
			{
				if (binaryData &gt; 0)
				{
					IMVS_LIGHT_DEVICE_LIST list = Marshal.PtrToStructure&lt;IMVS_LIGHT_DEVICE_LIST&gt;(data);
					Debugger.Log(0, null, &quot;LightManagerUI：dataLen [&quot; + binaryData + &quot;], Items.Count[&quot; + Items.Count + &quot;], target.Count[&quot; + list.nCount + &quot;]&quot;);
					if (!CheckDeviceList(list))
					{
						LogHelper.Info(&quot;重新获取控制器列表&quot;);
						needForceRefresh = false;
						ClearDevices();
						bool flag = false;
						for (int i = 0; i &lt; list.nCount; i++)
						{
							IMVS_LIGHT_DEVICE item = list.stLightDevice[i];
							if (AddDevice(item, i))
							{
								flag = true;
							}
						}
						if (flag)
						{
							ReFreshIndex();
						}
						if (Items.Count &gt; 0)
						{
							instance.CurLightDeviceA = Items[0];
						}
					}
				}
				else
				{
					ClearDevices();
					if (isPopErrorInfo)
					{
						HikMessageBox.Show(AppLocalizationService.GetLang(&quot;Lang_GetGlobalLightListERR&quot;), MessageIcons.Error);
					}
				}
			}
			catch (Exception ex)
			{
				if (isPopErrorInfo)
				{
					HikMessageBox.Show(ex.Message, MessageIcons.Error);
				}
			}
			finally
			{
				if (data != IntPtr.Zero)
				{
					Marshal.FreeHGlobal(data);
					data = IntPtr.Zero;
				}
			}
		}
		if (!isInnerModule &amp;&amp; instance.CurLightDeviceA != null &amp;&amp; CurLightDeviceA is LightSourceDevice lightSourceDevice)
		{
			lightSourceDevice.GetChannelParam();
		}
	}
</pre></details><details><summary>Collection clearing order · local-decompiled-source</summary><pre>analysis/decompiled/VMControls.WPF/VMControls.WPF.GlobalUI/LightSourceManager.cs:257–266
SHA256 0dc267a72c454a282293173a4d0306011991bab5793a93c4e16b66bc70741509
	public void ClearDevices()
	{
		if (Items.Count &gt; 0)
		{
			instance.CurLightDeviceA = null;
			Items.Clear();
			creatingItems.Clear();
		}
	}
</pre></details><details><summary>Authority is an add-operation projection · local-decompiled-source</summary><pre>analysis/decompiled/VMControls.WPF/VMControls.WPF.GlobalUI/LightSourceManager.cs:490–503
SHA256 0dc267a72c454a282293173a4d0306011991bab5793a93c4e16b66bc70741509
	public void GetAuthority()
	{
		AccessUser loginUser = CodeManager.GetInstance().GetLoginUser();
		if (loginUser == AccessUser.Tech || loginUser == AccessUser.Operator || ((IVMRun)VmSolution.Instance).ContinuousRunEnable)
		{
			IsAddEnabled = false;
		}
		else
		{
			IsAddEnabled = true;
		}
	}

	private void AddDevCommandExecute()</pre></details></article><article id="MU-T01" class="source-confirmed"><h2>MU-T01 · Linux两资源的四个工具栏声明 → SaveLoadSolutionTemplate + Remote主命令／Local子菜单入口</h2><p>source-confirmed：两个Linux资源各有Lang_OpenSol和Lang_SaveSol把customItemTemplateName设SaveLoadSolutionTemplate，主methodName分别OpenSolutionRemote/SaveSolutionRemote，toolbar优先级分别1/0；另有Local菜单子项指向OpenSolutionNative/SaveSolutionNative。已有O01/B01证明方法包装，不证明模板中的每个按钮、点击命令和参数已经定位。</p><p>待追：四声明不是四次已验证交互；子菜单和自定义工具栏模板的关系、当前模式选择和运行可达性仍未闭合。</p><details><summary>Linux open template declaration · local-extracted-resource</summary><pre>docs/architecture-recovery/menu-universe-next-MenuItemsLinux.xml:16–27
