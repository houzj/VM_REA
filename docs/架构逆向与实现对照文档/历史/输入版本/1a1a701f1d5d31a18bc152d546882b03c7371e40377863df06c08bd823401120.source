SHA256 b1c349c4808c0ce49c45e6fcca2972d370ed5a8f3e96ac51a157a680b42c9187
	public void LoadOldLightMoudle()
	{
		VmModule vmModule = VmSolution.Instance.Modules.FirstOrDefault((VmModule m) =&gt; m.ID == 14000);
		TitleMenueItemData titleMenueItemData = Items.OfType&lt;TitleMenueItemData&gt;().FirstOrDefault((TitleMenueItemData p) =&gt; p.Name == &quot;Lang_System&quot;);
		if (titleMenueItemData != null)
		{
			ControllerSet = titleMenueItemData.Items.OfType&lt;TitleMenueItemData&gt;().FirstOrDefault((TitleMenueItemData p) =&gt; p.Name == &quot;Lang_ControllerSet&quot;);
			if (ControllerSet != null)
			{
				TitleMenueItemData controllerSet = ControllerSet;
				bool flag = (ControllerSet.IsVisible = vmModule != null);
				controllerSet.IsDisplayInMenu = flag;
			}
		}
	}

	public static void DeleteOldLightModule()</pre></details></article><article id="MU-L03" class="source-confirmed"><h2>MU-L03 · H20 LightSet窗口返回后的DeleteOldLightModule → 再次读设备集合 → 空集合门 → UI提示/菜单隐藏/模块移除和SDK关闭</h2><p>source-confirmed：现有configuration-hosts:H20已定位调用但将旧模块删除条件留未知。补取原方法：找不到14000即返回；否则设ModuleID=14000，GetAuthority/GetData，再取ItemsA。非null且Count==0才显示NoButton提示，并在ControllerSet非null时设IsVisible=false；随后Application.Current.Dispatcher?.Invoke中先VmSolution.Modules.Remove(oldLightMoudle)，再CloseOneModule(oldLightMoudle.ID)，最后置局部null。这里没有读取CloseOneModule返回值，也没有围绕这两个操作做本地回滚。</p><p>待追：外围LightSet的catch可以提示异常但不证明恢复已移除模块；SDK关闭、方案持久化、真正设备影响和这一路实际运行仍未验证。</p><details><summary>VisionMaster.AppMainWindow.TitleMenueItemData::DeleteOldLightModule · original-managed-cil</summary><pre>docs/architecture-recovery/menu-universe-next-cil-evidence.json:2478–2497
