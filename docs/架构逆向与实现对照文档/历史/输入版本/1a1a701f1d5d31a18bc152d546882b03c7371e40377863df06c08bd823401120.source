              &quot;opcode&quot;: &quot;nop&quot;,</pre></details><details><summary>Post-dialog module cleanup predicate · local-decompiled-source</summary><pre>analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.AppMainWindow/TitleMenueItemData.cs:1864–1890
SHA256 b1c349c4808c0ce49c45e6fcca2972d370ed5a8f3e96ac51a157a680b42c9187
	public static void DeleteOldLightModule()
	{
		VmModule oldLightMoudle = VmSolution.Instance.Modules.FirstOrDefault((VmModule m) =&gt; m.ID == 14000);
		if (oldLightMoudle == null)
		{
			return;
		}
		LightSourceManager.Instance.ModuleID = 14000;
		LightSourceManager.Instance.GetAuthority();
		LightSourceManager.Instance.GetData();
		ObservableCollection&lt;object&gt; itemsA = LightSourceManager.Instance.ItemsA;
		if (itemsA != null &amp;&amp; itemsA.Count == 0)
		{
			HikMessageBox.Show(AppLocalizationService.GetLang(&quot;Lang_LogTips&quot;), AppLocalizationService.GetLang(&quot;UpgradedControllerTips&quot;), MessageButtons.NoButton, MessageIcons.Ok);
			if (ControllerSet != null)
			{
				ControllerSet.IsVisible = false;
			}
			System.Windows.Application.Current.Dispatcher?.Invoke(() =&gt;
			{
				VmSolution.Instance.Modules.Remove(oldLightMoudle);
				ServerSDKManager.serverSDKManager.mModuleManager.CloseOneModule(oldLightMoudle.ID);
				oldLightMoudle = null;
			});
		}
	}
}</pre></details></article><article id="MU-L04" class="source-confirmed"><h2>MU-L04 · LightSourceManager.GetData/ClearDevices/ItemsA → 读取失败或列表变更可改变删除门所读集合</h2><p>source-confirmed：所选WPF原件独立CIL确认GetData在lock内调用GetBinaryData(ModuleID,LightDeviceList,out data)；返回&gt;0才PtrToStructure并在CheckDeviceList不匹配时重建。返回&lt;=0调用ClearDevices并可提示；catch可提示并吞到后续，finally非零data执行FreeHGlobal。ClearDevices只在Items.Count&gt;0时先清当前选中、再清Items和creatingItems；ItemsA getter返回同一Items。GetAuthority只投影IsAddEnabled，不能把它当DeleteOldLightModule再次通过了同一权限门。</p><p>待追：这是条件链：若读取失败并且清理正常完成造成空集合，则上游可满足空集合门；不能宣称native实际失败、模块必删或空集合必表示没有真实设备。GetBinaryData在try之前、getter/通知/FreeHGlobal异常和读取后GetChannelParam的副作用仍要逐支恢复；WPF体未做REA逐体交叉核对。</p><details><summary>VMControls.WPF.GlobalUI.LightSourceManager::GetData · original-managed-cil</summary><pre>docs/architecture-recovery/menu-universe-next-cil-evidence.json:4580–4599
SHA256 b81d5a2a73c26be1d3eae5eea17003e4391f9524547cb674d43504dcadcd2ef0
