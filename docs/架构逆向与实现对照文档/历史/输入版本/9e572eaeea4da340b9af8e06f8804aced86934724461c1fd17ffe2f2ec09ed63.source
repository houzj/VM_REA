function show(entry){selected=entry.resource+':'+entry.id;document.querySelectorAll('.entry').forEach(b=>b.classList.toggle('selected',b.dataset.id===selected));const d=document.getElementById('detail');d.replaceChildren();const crumb=el('div',entry.resource+' › '+entry.hierarchy.join(' › '));crumb.className='crumb';d.append(crumb,el('h2',entry.name),el('p','XML 类型：'+entry.sourceType+'；'+(entry.hidden?'隐藏声明仍保留':'普通声明')),el('p','本入口完整行为链：未关闭'));if(!entry.resolvers.length)d.append(el('p','没有 resolver 字段：结构容器或特殊模板仍需核查，不虚造点击方法。'));for(const resolver of entry.resolvers){d.append(el('h3',resolver.role+' → '+resolver.name),el('p',resolver.status+'；运行时类型未观察'));for(const id of resolver.members){const m=members.get(id);d.append(el('p',m.Type+'::'+m.Signature),el('p',m.Path+':'+m.Start+'–'+m.End),el('small','SHA-256 '+m.Sha256));if(m.HasDecompilerWarnings){const warning=el('p','此体含反编译 IL 警告：需 CIL/ABI 核查，不能以可解析等同语义已确认。');warning.className='warn';d.append(warning)}const body=el('details');body.open=true;body.append(el('summary','原始成员体'),el('pre',m.Body));d.append(body);for(const [label,key]of [['调用表达式（目标尚未语义解析）','Calls'],['if 条件','Conditions'],['赋值左值（不等于已解析字段写入）','Assignments'],['抛出语句','Throws']]){const section=el('details');section.append(el('summary',label+' · '+m[key].length),el('pre',m[key].join('\n')||'本语法切片无记录'));d.append(section)}}}}
function render(){const resource=document.getElementById('resource').value,q=document.getElementById('search').value.trim().toLowerCase(),warnings=document.getElementById('warnings').checked;const entries=map.entries.filter(e=>(!resource||e.resource===resource)&&(!q||(e.name+' '+e.sourceType+' '+e.hierarchy.join(' ')+' '+e.resolvers.map(r=>r.name).join(' ')).toLowerCase().includes(q))&&(!warnings||e.resolvers.some(r=>r.members.some(id=>members.get(id).HasDecompilerWarnings))));const h=document.getElementById('entries');h.replaceChildren();for(const entry of entries){const b=el('button');b.className='entry';b.type='button';b.dataset.id=entry.resource+':'+entry.id;b.append(el('strong',entry.id+' · '+entry.name),el('small',entry.resource+' / '+entry.sourceType),el('small',entry.resolvers.map(r=>r.role+': '+r.name).join('；')||'结构/特殊模板'));b.onclick=()=>show(entry);h.append(b)}document.getElementById('status').textContent='显示 '+entries.length+' / '+map.entries.length+' 条声明；去重方法体 '+map.members.length+'，不是完成项计数。';if(entries.length)show(entries.find(e=>e.resource+':'+e.id===selected)||entries[0]);else document.getElementById('detail').replaceChildren(el('p','当前筛选无匹配声明。'));}for(const id of ['resource','search','warnings'])document.getElementById(id).addEventListener('input',render);render();</script></html><script data-document-web src="document-web-links.js"></script>