<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:Color="clr-namespace:Apps.ColorFun;assembly=Apps.ColorFun" xmlns:convert="clr-namespace:VM.Utility.Convert;assembly=VM.Controls">
  <ResourceDictionary.MergedDictionaries>
    <x:StaticExtension Member="Color:ColorThemesResourceDictionary.Instance" />
  </ResourceDictionary.MergedDictionaries>
  <convert:CheckedConvert x:Key="CheckedConvert" />
  <Style x:Key="Orange_ButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="#D6D5D4" />
    <Setter Property="BorderBrush" Value="#B6B4B4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#666666" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Value="{DynamicResource Col_Theme}" Property="Background" />
              <Setter Value="{DynamicResource Col_Theme}" Property="BorderBrush" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Background" Value="#80D6D5D4" />
              <Setter Property="BorderBrush" Value="#80B6B4B4" />
              <Setter Property="Foreground" Value="#80666666" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BottomButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Orange_ButtonStyle}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="66" />
  </Style>
  <Style x:Key="textCodeBoxStyle" TargetType="{x:Type PasswordBox}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="PasswordBox.MaxLength" Value="15" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="PasswordBox.PasswordChar" Value="*" />
    <Setter Property="Foreground" Value="#FF666666" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="controls:PasswordBoxWaterMark.IsMonitoring" Value="True" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:PasswordBoxWaterMark.PasswordLength" Value="0">
              <Setter TargetName="Message" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="textBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="TextBox.MaxLength" Value="15" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="#FF666666" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontFamily" Value="Microsoft YaHei" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Bd" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              <TextBlock Name="Message" FontSize="14" VerticalAlignment="Center" Foreground="#FFD3D3D3" Padding="3,0,0,0" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Message" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="eyeToggleButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Background="#00FFFFFF">
            <Image Name="icon" Stretch="None" Source="/PasswordWindowUI;component/Resources/not-see_normal.png" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="False" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/PasswordWindowUI;component/Resources/not-see_normal.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/PasswordWindowUI;component/Resources/not-_see_click.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="False" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsPressed, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/PasswordWindowUI;component/Resources/not-_see_click.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="False" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/PasswordWindowUI;component/Resources/see_normal.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/PasswordWindowUI;component/Resources/see_click.png" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
                <Condition Value="True" Binding="{Binding Path=IsPressed, RelativeSource={RelativeSource Self}, Converter={StaticResource CheckedConvert}}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="icon" Property="Image.Source" Value="/PasswordWindowUI;component/Resources/see_click.png" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>