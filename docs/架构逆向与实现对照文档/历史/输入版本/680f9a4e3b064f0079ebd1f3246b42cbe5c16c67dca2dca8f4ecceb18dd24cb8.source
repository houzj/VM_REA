[data-execution-host]{overflow-wrap:anywhere}.exec-nav,.exec-project-map{display:flex;gap:12px;flex-wrap:wrap;margin:15px 0}.exec-nav button,.exec-project-map button,.exec-project-picker{font:inherit;color:inherit;background:#18334a;border:1px solid #507995;border-radius:8px;padding:12px;cursor:pointer}.exec-columns{display:grid;grid-template-columns:1fr 1fr;gap:18px}.exec-lane{min-width:0;border:1px solid #38566e;border-radius:12px;padding:15px}.exec-nav .selected{outline:2px solid #92d9ff}.exec-edge{display:block;width:100%;text-align:left;margin:10px 0;padding:13px;color:inherit;background:#112638;border:1px solid #4a708c;border-left:5px solid #71baff;border-radius:8px;cursor:pointer;font:inherit}.exec-edge.source-confirmed{border-left-color:#f1bd73}.exec-edge.unknown{border-left-color:#ee9cb0;border-style:dashed}.exec-edge strong,.exec-edge small{display:block}.exec-edge small{margin-top:8px;color:#a9c1d4}.exec-arrow{color:#8ed8fa;font-size:22px;padding:4px 0}.exec-detail,.exec-project-detail{border:1px solid #466781;background:#112438;border-radius:12px;padding:20px;margin:18px 0}.exec-detail details,.exec-project-detail details{padding:10px;border:1px solid #385168;border-radius:8px;margin:10px 0}.exec-detail pre,.exec-project-detail pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:420px;overflow:auto;background:#081724;padding:12px;font:12px/1.6 Consolas,monospace}.exec-note{border-left:3px solid #e3b06b;padding:10px 14px;color:#c8c9c4}.exec-project-targets{display:grid;gap:8px;flex:1;min-width:220px}.exec-project-map>button{align-self:center}.exec-project-targets button{text-align:left}.exec-dependency-canvas{overflow:auto;background:#0d2030;border:1px solid #3b6179;border-radius:12px}.exec-dependency-canvas svg{display:block;width:100%}.exec-dependency-node,.exec-dependency-edge{cursor:pointer}.exec-dependency-node:hover rect,.exec-dependency-node:focus rect{stroke:#fff;stroke-width:2.5}.exec-dependency-edge:hover,.exec-dependency-edge:focus{stroke:#a6ddff;stroke-width:3}.exec-branch{border-top:1px dashed #52748a;padding-top:14px}@media(max-width:950px){.exec-columns{grid-template-columns:1fr}}