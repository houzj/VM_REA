\",\n            \"type\": \"VMControls.WPF.ToolControl\",\n            \"name\": \"SaveAsSolutionProcess\",\n            \"parameters\": 0,\n            \"attributes\": \"Private, HideBySig\",\n            \"signatureBytes\": \"200002\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 363,\n          \"ilSha256\": \"bb43be99a216348f6e41c25a6a1207dcbfc8f30a809c075721867d827a930e5c\",\n          \"ilBytes\": \"\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"nop\",","evidenceType":"original-managed-cil","binaryIdentity":"99ffa401c8784472913ad43813d68a8a5577890c00e149506e3e5664fa61c97d / MVID d144317f-3992-4275-9b0f-13fb6163e07d"}],"unknowns":["主路径/密码版本、取消/异常窗口及原生存储合同未闭合。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"G16","route":"原版 · 外部全局工具栏","classification":"source-confirmed","from":"文件保存对话框Ok/Cancel","to":"仅Ok保存；正常取消仍return true","behavior":"Show结果仅数值1/源码Ok分支运行SaveCalibUserData、SaveAs(选定路径,temp密码)、Reset标志；SaveAs返回值pop。非Ok绕过这些操作，Dispose后仍走ldc.i4.1返回true；只有前置解密拒绝返回false。G14无路径调用者因此可在文件取消后Start续作，不把此true命名为已保存。","refs":[{"path":"docs/architecture-recovery/toolbar-effects-cil-evidence.json","member":"VMControls.WPF.ToolControl::SaveAsSolutionProcess","sha256":"a2ad5f9f47d3bdc8270f93bff155ff4f06d107b262c06ff32c81b07cdecab0a3","start":3443,"end":3462,"excerpt":"          \"token\": \"0x060004ab\",\n          \"symbol\": {\n            \"token\": \"0x060004ab\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.ToolControl\",\n            \"name\": \"SaveAsSolutionProcess\",\n            \"parameters\": 0,\n            \"attributes\": \"Private, HideBySig\",\n            \"signatureBytes\": \"200002\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 363,\n