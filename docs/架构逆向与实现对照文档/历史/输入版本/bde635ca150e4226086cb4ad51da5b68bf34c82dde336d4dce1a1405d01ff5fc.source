cessAdministatorCode非空时提示并写tempStrPassWord。Encryption取消虽返回true但值空，在此被过滤。显示提示读PasswordBox字段，返回载荷取AccessAdministatorCode，不能据提示证明native已保存。","refs":[{"path":"docs/architecture-recovery/toolbar-effects-cil-evidence.json","member":"VMControls.WPF.ToolControl::encryptCheckClick","sha256":"a2ad5f9f47d3bdc8270f93bff155ff4f06d107b262c06ff32c81b07cdecab0a3","start":4699,"end":4718,"excerpt":"          \"token\": \"0x060004ad\",\n          \"symbol\": {\n            \"token\": \"0x060004ad\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.ToolControl\",\n            \"name\": \"encryptCheckClick\",\n            \"parameters\": 2,\n            \"attributes\": \"Private, HideBySig\",\n            \"signatureBytes\": \"2002011c12811d\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 164,\n          \"ilSha256\": \"34b1e5f5bebf417931de2347c35e35d50f50f9c15dacffad22eb13c2f52d7ba0\",\n          \"ilBytes\": \"\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"nop\",","evidenceType":"original-managed-cil","binaryIdentity":"99ffa401c8784472913ad43813d68a8a5577890c00e149506e3e5664fa61c97d / MVID d144317f-3992-4275-9b0f-13fb6163e07d"}],"unknowns":["可见明文编辑同步、临时字段跨取消/重入和加密算法/受保护文件往返未验。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}}],"hierarchy":{"title":"主界面","kind":"ui-root","organization":"independent-reading-organization","meaning":"按主界面子系统组织证据；成员调用由叶节点对应的证据边表达。","children":[{"title":"外部/嵌入宿主（主窗实例化未证）","kind":"subsystem","children":[{"title":"模板、独立资源与投影","kind":"evidence-lane","children":[{"title":"VmGlobalToolControl模板/公开接口 → ToolControl（主窗宿主实例化未证明）","kind":"edge","edgeId":"G01","classification":"source-confirmed"},{"title":"VmGlobalToolData.LoadData → CurrentPath/GlobalToolResource/GlobalToolItems.xml","kind":"edge","edgeId":"G02","classification":"source-confirmed"},{"title":"DecorateSource/GetItems → 分组排序、IsShowExternal筛选与缓存","kind":"edge","edgeId":"G03","classification":"source-confirmed"},{"title":"ToolControl.ItemsSource/XAML按钮 → GlobalToolDataItem.ItemClickCommand","kind":"edge","edgeId":"G04","classification":"source-confirmed"}]},{"title":"事件转发、分派及可见性","kind":"evidence-lane","children":[{"title":"11个GlobalToolDataItem动作 → ExecuteFcuntion → VmGlobalToolData转发","kind":"edge","edgeId":"G05","classification":"source-confirmed"},{"title":"ToolData_FunctionExecuteEvent → 11种字符串 → ToolControl自己的操作方法","kind":"edge","edgeId":"G06","classification":"source-confirmed"},{"title":"ToolControl.Init/加载完成回调 → 工具条副本与ControllerSet可见性","kind":"edge","edgeId":"G07","classification":"source-confirmed"}]},{"title":"生命周期与公开调用","kind":"evidence-lane","children":[{"title":"Loaded/Unloaded/Dispose → Init与DeInit订阅/资源释放","kind":"edge","edgeId":"G08","classification":"source-confirmed"},{"title":"包装公开Open方法 / OpenGloablModule → Dispatcher.Invoke → 同一字符串分派","kind":"edge","edgeId":"G09","classification":"source-confirmed"}]},{"title":"脚本保护、事件与执行","kind":"evidence-lane","children":[{"title":"ToolControl.GlobalScript → 脚本缓存、参数门和独立密码校验","kind":"edge","edgeId":"G11","classification":"source-confirmed"},{"title":"脚本窗ExcuteEvent add/remove/add → 三个不同原MethodDef → VmSolution.Instance.Run","kind":"edge","edgeId":"G12","classification":"source-confirmed"}]},{"title":"保存、续作、验证与取消","kind":"evidence-lane","children":[{"title":"ToolControl.SaveSolution() → Dispatcher标定数据 → Task保存 → continuation","kind":"edge","edgeId":"G13","classification":"source-confirmed"},{"title":"ToolControl.SaveSolution(Task)重载 → catch日志worker / Reset标志 / afterSaveTask.Start","kind":"edge","edgeId":"G14","classification":"source-confirmed"},{"title":"ToolControl.SaveAsSolutionProcess → 已有密码验证 / 独立新密码载荷","kind":"edge","edgeId":"G15","classification":"source-confirmed"},{"title":"文件保存对话框Ok/Cancel → 仅Ok保存；正常取消仍return true","kind":"edge","edgeId":"G16","classification":"source-confirmed"},{"title":"另存对话框encryptButton.Click → Encryption true且非空 → 临时密码","kind":"edge","edgeId":"G17","classification":"source-confirmed"}]},{"title":"旧载体和全链断点","kind":"evidence-lane","children":[{"title":"所有外部/嵌入宿主及旧GlobalToolData → 完整可达性与下游行为","kind":"edge","edgeId":"G10","classification":"unknown"}]}]}]}};const names={'source-confirmed':'源码确认','independent-implementation':'当前独立实现',unknown:'未知'};const el=(tag,text)=>{const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n};for(const c of Object.keys(names)){const b=el('span',names[c]+' '+model.edges.filter(e=>e.classification===c).length);b.className='badge';document.getElementById('counts').append(b)}
 function show(e){document.querySelectorAll('.edge').forEach(b=>b.classList.toggle('selected',b.dataset.id===e.id));const d=document.getElementById('detail');d.replaceChildren(el('h2',e.id+' · '+names[e.classification]),el('h3',e.from+' → '+e.to),el('p',e.behavior));if(e.unknowns.length){d.append(el('h3','仍需追踪'));const u=el('ul');for(const s of e.unknowns)u.append(el('li',s));d.append(u)}for(const r of e.refs){const x=el('details');x.append(el('summary',r.member+' · '+r.start+'–'+r.end),el('p',r.path),el('p',r.evidenceType+' · SHA-256 '+r.sha256),el('pre',r.excerpt));d.append(x)}d.append(el('p','静态检查；未执行运行验证；不声明 native 等价。'))}
 function route(value){document.querySelectorAll('#routes button').forEach(b=>b.classList.toggle('active',b.textContent===value));const h=document.getElementById('edges');h.replaceChildren();const es=model.edges.filter(e=>e.route===value);for(const e of es){const b=el('button');b.type='button';b.dataset.id=e.id;b.className='edge '+e.classification;b.append(el('strong',e.id+' · '+e.from+' → '+e.to),el('small',names[e.classification]));b.onclick=()=>show(e);h.append(b)}show(es[0])}for(const value of [...new Set(model.edges.map(e=>e.route))]){const b=el('button',value);b.type='button';b.onclick=()=>route(value);document.getElementById('routes').append(b)}route(model.edges[0].route);
const hierarchyEdges=new Map(model.edges.map(e=>[e.id,e])),edgePaths=new Map();
const flatShow=show;show=function(e){flatShow(e);const detail=document.getElementById('detail'),crumb=el('div',(edgePaths.get(e.id)||[]).concat(e.id).join(' › '));crumb.className='crumb';detail.prepend(crumb);const leaf=document.querySelector('#hierarchy button[data-id="'+e.id+'"]');for(let p=leaf?.parentElement;p;p=p.parentElement)if(p.tagName==='DETAILS')p.open=true;document.querySelectorAll('#hierarchy .edge').forEach(b=>b.classList.toggle('selected',b.dataset.id===e.id));history.replaceState(null,'','#edge-'+e.id)};
function treeBranch(node,trail=[],level=0){if(node.edgeId){edgePaths.set(node.edgeId,trail);const e=hierarchyEdges.get(node.edgeId),button=el('button');button.type='button';button.dataset.id=e.id;button.className='edge '+e.classification;button.append(el('strong',e.id+' · '+node.title),el('small',names[e.classification]));button.onclick=()=>{route(e.route);show(e)};return button}const d=el('details');d.open=level<2;d.dataset.level=String(level);d.append(el('summary',node.title));const branch=el('div');branch.className='branch';for(const child of node.children)branch.append(treeBranch(child,trail.concat(node.title),level+1));d.append(branch);return d}
document.getElementById('hierarchy').append(treeBranch(model.hierarchy));
function hierarchyMode(tree){document.getElementById('treePane').hidden=!tree;document.getElementById('routes').hidden=tree;document.getElementById('edges').hidden=tree;for(const [id,on]of [['treeMode',tree],['listMode',!tree]]){const b=document.getElementById(id);b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on))}}
document.getElementById('treeMode').onclick=()=>hierarchyMode(true);document.getElementById('listMode').onclick=()=>hierarchyMode(false);document.getElementById('expandAll').onclick=()=>document.querySelectorAll('#hierarchy details').forEach(d=>d.open=true);document.getElementById('collapseAll').onclick=()=>document.querySelectorAll('#hierarchy details').forEach(d=>d.open=d.dataset.level==='0');hierarchyMode(true);function restoreEvidenceBookmark(){let key;try{key=decodeURIComponent(location.hash.slice(1)).replace(/^edge-/,'')}catch{key=''}const desiredEdge=hierarchyEdges.get(key)||model.edges[0];route(desiredEdge.route);show(desiredEdge)}restoreEvidenceBookmark();addEventListener('hashchange',restoreEvidenceBookmark);
</script></html><script data-document-web src="document-web-links.js"></script>