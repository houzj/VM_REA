e2.Where((GlobalToolDataItem p) => p.IsShowExternal).ToList();\n\t\t\tsource = objItems;\n\t\t}\n\t\treturn source;\n\t}\n\n\tprivate void LoadData()","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["GetAllChildren、相等优先级和动态工厂实际触发/宿主刷新未全闭合。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"G04","route":"原版 · 外部全局工具栏","classification":"source-confirmed","from":"ToolControl.ItemsSource/XAML按钮","to":"GlobalToolDataItem.ItemClickCommand","behavior":"CollectionViewSource绑定ItemsSource并分组；ToolButtonDataTemplate按钮绑定ItemClickCommand。原件getter懒建DelegateCommand，执行先查IsEnabled与MethodName非null，再反射GetType().GetMethod()?.Invoke(this,null)，本地catch为空。接收者是GlobalToolDataItem，与主菜单TitleMenueItemData不同。","refs":[{"path":"analysis/decompiled/VMControls.WPF/VMControls.WPF/ToolControl.xaml","member":"ToolControl collection projection","sha256":"8be1c902252155bbabbfe9056b099a72eeca39d2199338f2bdc6b499f2f1cfaf","start":12,"end":17,"excerpt":"      \u003cCollectionViewSource x:Key=\"src\" IsLiveGroupingRequested=\"True\" Source=\"{Binding ItemsSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ToolControl}}\">\n        \u003cCollectionViewSource.GroupDescriptions>\n          \u003cPropertyGroupDescription PropertyName=\"ToolGroupItemInfo.GroupName\" />\n        \u003c/CollectionViewSource.GroupDescriptions>\n      \u003c/CollectionViewSource>\n      \u003cDataTemplate x:Key=\"customDataTemplate\">","evidenceType":"local-extracted-resource","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/Apps.Style/itemscontrolstyle/itemscontrolstyle.xaml","member":"ToolButtonDataTemplate command","sha256":"fb05637d2c3bc8b556d8c0c095d852dda97fb18d9414fbc2fafe987932913027","start":12,"end":14,"excerpt":"  \u003cDataTemplate x:Key=\"ToolButtonDataTemplate\">\n    \u003cButton Margin=\"4,0,4,0\" Height=\"36\" Width=\"36\" S