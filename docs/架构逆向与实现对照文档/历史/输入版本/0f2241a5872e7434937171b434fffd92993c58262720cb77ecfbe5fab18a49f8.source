sue\": null,\n          \"ilSize\": 160,\n          \"ilSha256\": \"d8577c7d2797dbe8cc5f29485da99e27e51bbe89069d5f39d67ca3da0a0fb5cc\",\n          \"ilBytes\": \"\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"nop\",","evidenceType":"original-managed-cil","binaryIdentity":"42e2437780ec21c9d1ade2d07ace0a26635961f5c90559934a7fde7e233e0c23 / MVID 77c739a5-b0ec-4834-8a1e-64dd9b618ae5"},{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/ProjectManager.cs","member":"BeginSave local path gate","sha256":"1ae41a0841dd65f5dfa7461078c370822e61826877c42e299939af1fd47f9370","start":346,"end":370,"excerpt":"\tprivate bool BeginSave(string path, string strPassWord, Task afterSaveTask = null, bool isRemoteSave = false)\n\t{\n\t\tif (!isRemoteSave)\n\t\t{\n\t\t\ttry\n\t\t\t{\n\t\t\t\tPath.GetFullPath(path);\n\t\t\t}\n\t\t\tcatch (PathTooLongException message)\n\t\t\t{\n\t\t\t\tLogHelper.objLog.Warn(message);\n\t\t\t\tuint num = 3758096905u;\n\t\t\t\tstring errorInfo = ErrorCodeInfo.GetErrorInfo((int)num);\n\t\t\t\tHikMessageBox.Show(Application.Current.MainWindow, AppLocalizationService.GetLang(\"Lang_SolSaveFail\"), errorInfo, MessageIcons.Warning);\n\t\t\t\treturn false;\n\t\t\t}\n\t\t\tcatch (Exception message2)\n\t\t\t{\n\t\t\t\tLogHelper.objLog.Warn(message2);\n\t\t\t\tHikMessageBox.Show(Application.Current.MainWindow, AppLocalizationService.GetLang(\"Lang_SolSaveFail\"), AppLocalizationService.GetLang(\"Lang_FileSaveError\"), MessageIcons.Warning);\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}\n\t\treturn SaveSolution(path, strPassWord, afterSaveTask);\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["native文件可写性和真实格式/加密由下游决定；不能把GetFullPath成功当作保存有效。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"B06","route":"原版 · 主菜单保