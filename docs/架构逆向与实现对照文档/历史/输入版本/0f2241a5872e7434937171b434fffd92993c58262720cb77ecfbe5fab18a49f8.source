ack);\n    ExecutionOwnerStamp CaptureExecutionOwner() => executionOwnerEpoch.Capture(doc.SolutionId,executionScope);\n    bool IsCurrentExecutionOwner(ExecutionOwnerStamp stamp) => !windowClosed &&\n        executionOwnerEpoch.IsCurrent(stamp,doc.SolutionId,executionScope);\n    void DispatchWorkflowCallback(Action callback)\n    {\n        if(windowClosed)return;\n        if(Dispatcher.CheckAccess())callback();\n        else _=Dispatcher.BeginInvoke(callback);\n    }\n}\n","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["当前Action载荷不是原native callback结果结构；hasExecuteCount、订阅者异常和默认不开缓存不能外推全部原回调路径。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"M07","route":"当前 · 回调缓存与关闭","classification":"independent-implementation","from":"FrameworkCallbackQueue缓存/扩容/worker/Close","to":"满容量丢弃、缓冲交换与关闭边界","behavior":"cache开启时满receive.Length则DroppedCount++并返回Overflow，否则入receive；调用处未使用Enqueue返回值。worker在gate内交换send/receive、取count并清receiveCount，锁外逐项dispatch成功才置default；异常记录DispatchErrors、alive=false并退出，当前/余项不保证释放或再发。ExpandCapacity只在更大时重建两数组并丢receive批次。Close仅alive=false，不join/drain；已经取得的batch仍可继续，且Enqueue不检查alive，因此Close后非缓存分支仍能调用dispatch、缓存分支仍可入队但worker不再取新批。主窗另有windowClosed/owner门，不能用Close代替它们。","refs":[{"path":"src/VisionFramework/FrameworkCallbackQueue.cs","member":"Current receive buffer admission and expansion","sha256":"af27ece2a43db6473a9199a5e31221e900557805f2a036420b299ba143ad9a82","start":34,"end":55,"excerpt":" public CallbackEnqueueResult Enqueue(T value)\n {\n  lock(gate){\n   if(cacheEnabled){\n    if(receiveCount==receive.Length){dropped++;return CallbackEnqueueResult.Overflow;}\n    receive[receiveCount++]=value;return CallbackEnqueueResult.Queued;\n   }\n  }\n  dispatch(value);return CallbackEnqueueResult.Dispatched;\n }\n // As in the original, expansion discards queued receives. Call before active dispatch.\n public void ExpandCapacity(int 