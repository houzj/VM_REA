onously and then\n   // publishes the same result to its double-buffer callback queue.  The","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["节点/参数校验具体规则、所有者票据实现另属后续切片。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"M03","route":"当前 · 运行","classification":"independent-implementation","from":"SolutionExecutor.RunAsync","to":"GraphExecutor.RunAsync","behavior":"先校验并复制方案/参数；校验调用及资源；WaitTimeMs 使用链接 CTS，调用 GraphExecutor 后把等待超时导致的 Cancelled 改为 TimedOut。","refs":[{"path":"src/VisionFramework/SolutionExecutor.cs","member":"SolutionExecutor.RunAsync","sha256":"a49ba2ac2b924d8c5fa16941f138a78f92a6d81e47180753fd95b2d54349fc3b","start":11,"end":56,"excerpt":"    public async Task\u003cExecutionSessionResult> RunAsync(SolutionWorkspace workspace,string procedureId,IProgress\u003cExecutionEvent>? progress=null,CancellationToken cancellationToken=default,IReadOnlyDictionary\u003cstring,PortValue>? inputs=null,ModuleExecutionScope? scope=null,ModuleRunControl? control=null){\n        SolutionStore.ValidateStructure(workspace.Document);\n        var document=workspace.Document with{Resources=workspace.Document.Resources.ToArray(),Procedures=workspace.Document.Procedures.Select(p=>p with{Configuration=(p.GroupOwner is not null?GroupDisplayLinks.Synchronize(p.Configuration,p.Configuration):p.Configuration).Snapshot(),Connections=p.Connections.ToArray(),ExecutionLinks=p.ExecutionLinks?.ToArray(),Nodes=p.Nodes.Select(n=>n with{Call=n.Call?.Snapshot(),GroupBreak=n.GroupBreak?.Snapshot(),Parameters=n.Parameters.ToDictionary(v=>v.Key,v=>v.Value.Clone()),Rois=n.Rois?.Select(r=>r with{Vertices=r.Vertices?.ToArray()}).ToArray(),RoiGroups=RoiData.SnapshotGroups(n.RoiGroups)}).ToArray()}).ToArray()};\n        WorkflowCalls.Validate(document,procedureId);\n        var checkedProcedures=new HashSet\u003cstring>();void ValidateBreaks(string id){if(!checkedProcedures.Add(id))return;var parent=document.Procedures.Single(p=>p.Id==id);foreach(var node in parent.Nodes){if(node.GroupBreak is not null){var body=document.Procedures.SingleOrDefault(p=>p.Id==node.Call?.ProcedureId)??throw new InvalidDataException(\"Break metadata requires a Group body.\");GroupBreak.Validate(parent,node,body,registry);}if(node.Enabled&&node.Call is {} call)ValidateBreaks(call.ProcedureId);}}ValidateBreaks(procedureId);\n        var resources=document.Resources.ToArray();var catalog=new ResourceCatalog(workspace.BaseDirectory,resources);\n        foreach(var resource in resources){if(cancellationToken.IsCancellationRequested)break;using var stream=catalog.OpenVerified(resource.Id);}\n        async Task\u003cExecutionSessionResult> Execute(string id,IReadOnlyDictionary\u003cstring,PortValue>? arguments,CancellationToken token,int depth,int? groupLoopIndex=null){\n            if(depth>32)throw new InvalidDataException(\"Independent subprogram depth limit is 32.\");\n            var procedure=document.Procedures.SingleOrDefault(p=>p.Id==id)??throw new InvalidDataException(\"Unknown procedure: \"+id);\n            using var wait=new CancellationTokenSource();\n            if(procedure.WaitTimeMs>0)wait.CancelAfter(procedure.WaitTimeMs);\n            using var linked=CancellationTokenSource.CreateLinkedTokenSource(token,wait.Token);\n            var runToken=linked.Token;\n            async Task\u003cExecutionSessionResult> Call(NodeDocument node,IReadOnlyDictionary\u003cstring,PortValue> values,CancellationToken childToken){\n                var body=document.Procedures.Single(p=>p.Id==node.Call!.ProcedureId);\n                // Legacy cross-flow calls retain one-shot behavior. Native Group loops own their body.\n                if(body.GroupOwner is null)return await Execute(body.Id,values,childToken,depth+1);\n                return await Task.Run(async()=>{\n                var loop=GroupLoop.Read(node);ExecutionSessionResult? last=null;int completed=0;bool broke=false;int? breakIndex=null;var diagnostics=new List\u003cstring>();var accumulator=new GroupOutputAccumulator(body);\n                for(long index=loop.Start;index\u003cloop.End;index+=loop.Increment){\n                    childToken.ThrowIfCancellationRequested();\n                    if(index\u003cint.MinValue||index>int.MaxValue)throw new InvalidOperationException(\"Independent Group index overflow guard.\");\n                    // Independent resource guard; this is not a recovered VM iteration limit.\n                    if(completed>=10000)throw new InvalidOperationException(\"Independent Group iteration limit is 10000.\");\n                    if(GroupBreak.Evaluate(node,body,last,(int)index,diagnostics,values,(name,element)=>accumulator.ReadSelfElement(name,element,last))){broke=true;breakIndex=(int)index;break;}\n                    last=await Execute(body.Id,values,childToken,depth+1,(int)index);completed++;\n                    if(last.Status==SessionStatus.Success)accumulator.Add(last);\n                    if(last.Status!=SessionStatus.Success)break;\n                    if(loop.IntervalMs>0)await Task.Delay(loop.IntervalMs,childToken);\n                }\n                return (last??new ExecutionSessionResult(SessionStatus.Success,[])) with{CompletedGroupIterations=completed,GroupBroke=broke,GroupBreakIndex=breakIndex,GroupDiagnostics=diagnostics.AsReadOnly(),WorkflowOutputs=accumulator.Finish(last),WorkflowDisplays=accumulator.FinishDisplays()};\n                },childToken);\n            }\n            try\n            {\n                var session=await new GraphExecutor(registry).RunAsync(procedure,workspace.BaseDirectory,depth==0?progress:null,runToken,arguments,Call,groupLoopIndex,scope,control,new ResourceCatalog(workspace.BaseDirectory,workspace.Document.Resources));\n                if(wait.IsCancellationRequested&&!token.IsCancellationRequested&&session.Status==SessionStatus.Cancelled)\n                    session=session with{Status=SessionStatus.TimedOut,Nodes=session.Nodes.Select(n=>n.Status==NodeRunStatus.Cancelled?n with{Status=NodeRunStatus.TimedOut,ErrorCode=\"ProcedureWaitTimeout\",Message=\"Procedure wait time elapsed\"}:n).ToArray()};\n                return session with{GroupLoopIndex=groupLoopIndex};\n            }\n            catch(OperationCanceledException) when(wait.IsCancellationRequested&&!token.IsCancellationRequested)\n            {\n                return new ExecutionSessionResult(SessionStatus.TimedOut,[]){GroupLoopIndex=groupLoopIndex};\n            }\n","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["GraphExecutor 内部节点分支、Group 轮次和工具释放需单独展开，未由这一边关闭。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"M04","route":"当前 · 运行","classification":"independent-implementation","from":"RunCore await 返回","to":"WorkflowCallbacks.PublishModuleResult","behavior":"所有者失效即拒绝发布；通过后提交结果与运行历史，并更新当前流程视图。OperationCanceledException 和其它异常仅在当前所有者下更新状态。","refs":[{"path":"src/VisionEditor/WorkflowExecution.cs","member":"MainWindow.RunCore","sha256":"62dfe19e6836de7c116f3c89a6c17521d64b252d14dd137116987aadc9a666d4","start":40,"end":67,"excerpt":"   if(control.StopRequested)continuousRun=false;\n\n   var elapsed=session.Nodes.Sum(r=>r.ElapsedMilliseconds);\n   // VmSolution's ModuleResult callback commits state synchronously and then\n   // publishes the same result to its double-buffer callback queue.  The\n   // managed host uses the same seam; the queue's default CacheEnabled=false\n   // preserves the existing synchronous presentation path.\n   WorkflowCallbacks.PublishModuleResult(\n    () => {\n      if(!IsCurrentExecutionOwner(owner))return;\n      if(doc.HasCurrentProcedure&&doc.RootProcedureId(doc.CurrentProcedureId)==procedureId){RestoreWorkflowResults();ProcessTimeText.Text=elapsed.ToString(\"F2\");StatusText.Text=\"流程完成：\"+session.Status+(session.OutputErrors.Count>0?\" · \"+string.Join(\"；\",session.OutputErrors):\"\");StatusIcon.Source=Asset(session.Nodes.All(r=>r.Status is NodeRunStatus.Success or NodeRunStatus.NoMatch or NodeRunStatus.Skipped)?\"bottombar_run.png\":\"bottombar_abnormal.png\");RefreshRight();}\n      if(workflowOverview)RenderWorkflowOverview();\n      if(configurationProcedureId==procedureId)workflowConfigurationWindow?.RefreshResults();\n    },\n    () => {\n      StoreWorkflowCallResults(procedureId,session);RecordWorkflowRun(procedureId,elapsed);\n      if(!windowClosed)RecordFrameworkRunHistory(procedureId,session);\n    });\n   return session.Status==SessionStatus.Success&&session.Nodes.All(r=>r.Status is NodeRunStatus.Success or NodeRunStatus.Skipped);\n  }\n  catch(OperationCanceledException){if(IsCurrentExecutionOwner(owner))StatusText.Text=\"运行已停止\";}\n  catch(Exception e){if(IsCurrentExecutionOwner(owner))StatusText.Text=\"运行失败：\"+e.Message;}\n  return false;\n }\n void ClearWorkflowCallResults(string procedure){var seen=new HashSet\u003cstring>();void Clear(string id){if(!seen.Add(id))return;workflowSessions.Remove(id);ClearToolDebugResults(id);var p=doc.Document.Procedures.FirstOrDefault(p=>p.Id==id);if(p is not null)foreach(var n in p.Nodes.Where(n=>n.Call is not null))Clear(n.Call!.ProcedureId);}Clear(procedure);}\n void StoreWorkflowCallResults(string procedure,ExecutionSessionResult session){ClearToolDebugResults(procedure);clearedWorkflowResultViews.Remove(procedure);workflowSessions[procedure]=session;var p=doc.Document.Procedures.Single(x=>x.Id==procedure);foreach(var pair in session.Calls){var target=p.Nodes.Single(n=>n.Id==pair.Key).Call!.ProcedureId;StoreWorkflowCallResults(target,pair.Value);}}\n void RestoreWorkflowResults()\n {","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["具体发布次序见M06/M07；托管缓存不是原native回调生产、线程或设备停止的等价证明。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"M05","route":"当前 · 连续与停止","classification":"independent-implementation","from":"StartContinuous / ContinuousRun / 工具栏Stop","to":"单CTS循环、轮间策略与身份限定清理","behavior":"StartContinuous若已有activeRun只Cancel并return；否则经CanStartWorkflow建立CTS并开始根流程循环。每轮await RunCore后核owner，重新读取该流程StopOnNg和ContinuousRunIntervalMs；!ok且StopOnNg才停。工具栏Stop只Cancel现CTS，FinishWorkflowRun仅ReferenceEquals(activeRun,owner)时清activeRun/runningProcedureId/continuousRun并Dispose，旧运行不能清掉新owner。control.StopRequested在RunCore置continuousRun=false，但当前轮返回后仍可能进入间隔Delay，直到下一轮条件才退出；用户取消token则跳过或中断Delay。","refs":[{"path":"src/VisionEditor/WorkflowExecution.cs","member":"Current continuous start, loop, and ownership cleanup","sha256":"62dfe19e6836de7c116f3c89a6c17521d64b252d14dd137116987aadc9a666d4","start":73,"end":93,"excerpt":" void StartContinuous()\n {\n  if(activeRun is not null){activeRun.Cancel();return;}\n  if(!CanStartWorkflow())return;\n  continuousRun=true;runningProcedureId=doc.RootProcedureId(doc.CurrentProcedureId);var owner=new CancellationTokenSource();activeRun=owner;RefreshAll();_=ContinuousRun(runningProcedureId,owner);\n }\n void StartProcedureLoop(string id){if(activeRun is not null){activeRun.Cancel();return;}if(!doc.HasCurrentProcedure||doc.RootProcedureId(doc.CurrentProcedureId)!=id)SelectWorkflow(id);StartContinuous();}\n async Task ContinuousRun(string procedureId,CancellationTokenSource owner)\n {\n  var stamp=CaptureExecutionOwner();\n  try{while(!owner.IsCancellationRequested&&continuousRun&&IsCurrentExecutionOwner(stamp)){bool ok=await RunCore(procedureId,owner.Token);if(!IsCurrentExecutionOwner(stamp))break;var p=doc.Document.Procedures.FirstOrDefault(p=>p.Id==procedureId);if(p is null)break;if(!ok&&p.StopOnNg&&!owner.IsCancellationRequested){StatusText.Text=\"流程 NG，已停止连续运行\";break;}if(!owner.IsCancellationRequested){if(p.ContinuousRunIntervalMs>0)await Task.Delay(p.ContinuousRunIntervalMs,owner.Token);else await System.Windows.Threading.Dispatcher.Yield(System.Windows.Threading.DispatcherPriority.Background);}}}\n  catch(OperationCanceledException){if(IsCurrentExecutionOwner(stamp))StatusText.Text=\"连续运行已停止\";}\n  catch(Exception error){if(IsCurrentExecutionOwner(stamp))StatusText.Text=\"连续运行失败：\"+error.Message;}\n  finally{FinishWorkflowRun(owner);}\n }\n void FinishWorkflowRun(CancellationTokenSource owner)\n {\n  if(ReferenceEquals(activeRun,owner)){activeRun=null;runningProcedureId=null;continuousRun=false;owner.Dispose();if(!windowClosed)RefreshAll();}\n }\n protected override void OnClosed(EventArgs e)\n {","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/WorkflowExecution.cs","member":"Current control stop versus successful return","sha256":"62dfe19e6836de7c116f3c89a6c17521d64b252d14dd137116987aadc9a666d4","start":40,"end":67,"excerpt":"   if(control.StopRequested)continuousRun=false;\n\n   var elapsed=session.Nodes.Sum(r=>r.ElapsedMilliseconds);\n   // VmSolution's ModuleResult callback commits state synchronously and then\n   // publishes the same result to its double-buffer callback queue.  The\n   // managed host uses the same seam; the queue's default CacheEnabled=false\n   // preserves the existing synchronous presentation path.\n   WorkflowCallbacks.PublishModuleResult(\n    () => {\n      if(!IsCurrentExecutionOwner(owner))return;\n      if(doc.HasCurrentProcedure&&doc.RootProcedureId(doc.CurrentProcedureId)==procedureId){RestoreWorkflowResults();ProcessTimeText.Text=elapsed.ToString(\"F2\");StatusText.Text=\"流程完成：\"+session.Status+(session.OutputErrors.Count>0?\" · \"+string.Join(\"；\",session.OutputErrors):\"\");StatusIcon.Source=Asset(session.Nodes.All(r=>r.Status is NodeRunStatus.Success or NodeRunStatus.NoMatch or NodeRunStatus.Skipped)?\"bottombar_run.png\":\"bottombar_abnormal.png\");RefreshRight();}\n      if(workflowOverview)RenderWorkflowOverview();\n      if(configurationProcedureId==procedureId)workflowConfigurationWindow?.RefreshResults();\n    },\n    () => {\n      StoreWorkflowCallResults(procedureId,session);RecordWorkflowRun(procedureId,elapsed);\n      if(!windowClosed)RecordFrameworkRunHistory(procedureId,session);\n    });\n   return session.Status==SessionStatus.Success&&session.Nodes.All(r=>r.Status is NodeRunStatus.Success or NodeRunStatus.Skipped);\n  }\n  catch(OperationCanceledException){if(IsCurrentExecutionOwner(owner))StatusText.Text=\"运行已停止\";}\n  catch(Exception e){if(IsCurrentExecutionOwner(owner))StatusText.Text=\"运行失败：\"+e.Message;}\n  return false;\n }\n void ClearWorkflowCallResults(string procedure){var seen=new HashSet\u003cstring>();void Clear(string id){if(!seen.Add(id))return;workflowSessions.Remove(id);ClearToolDebugResults(id);var p=doc.Document.Procedures.FirstOrDefault(p=>p.Id==id);if(p is not null)foreach(var n in p.Nodes.Where(n=>n.Call is not null))Clear(n.Call!.ProcedureId);}Clear(procedure);}\n void StoreWorkflowCallResults(string procedure,ExecutionSessionResult session){ClearToolDebugResults(procedure);clearedWorkflowResultViews.Remove(procedure);workflowSessions[procedure]=session;var p=doc.Document.Procedures.Single(x=>x.Id==procedure);foreach(var pair in session.Calls){var target=p.Nodes.Single(n=>n.Id==pair.Key).Call!.ProcedureId;StoreWorkflowCallResults(target,pair.Value);}}\n void RestoreWorkflowResults()\n {","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.xaml.cs","member":"Current toolbar stop is CTS cancellation","sha256":"034c0dae3e04a9b592031d87e1c1349c23b14091b04564c295267a97fcaa1b4a","start":52,"end":52,"excerpt":"  Tool(\"toolbar_toolbarSave_normal.png\",\"保存\",()=>Save(false));Tool(\"toolbar_toolbarOpen_normal.png\",\"打开方案\",Open);undoToolButton=Tool(\"toolbar_ic_topbar_undo_normal.png\",\"撤销\",UndoShell);SetToolbarStateIcon(undoToolButton,\"toolbar_ic_topbar_undo_normal.png\",\"toolbar_ic_topbar_undo_disable.png\");redoToolButton=Tool(\"toolbar_ic_topbar_redo_normal.pn