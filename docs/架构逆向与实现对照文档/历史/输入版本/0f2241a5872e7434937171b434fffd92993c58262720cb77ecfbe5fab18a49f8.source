Lang_GlobalScript\") + \":\" + ErrorCodeInfo.GetErrorInfo(ex2.errorCode);\n\t\t\t\tHikMessageBox.Show(strMsg, MessageIcons.Error);\n\t\t\t}\n\t\t}\n\t}\n\n\tprivate static void MutiOrStopRun(bool isContinousRunEnable)\n\t{\n\t\t((IVMRun)VmSolution.Instance).ContinuousRunEnable = isContinousRunEnable;\n\t}\n\n\tpublic static void StopRun()\n\t{\n\t\tMutiOrStopRun(isContinousRunEnable: false);\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"docs/architecture-recovery/run-exit-cil-evidence.json","member":"VisionMaster.AppMainWindow.TitleMenueItemData::MutiRun","sha256":"daa072c5c62d7e2e804653fb5e5c810e9354177868fe2a55d368251964af4304","start":1745,"end":1764,"excerpt":"          \"token\": \"0x060002e7\",\n          \"symbol\": {\n            \"token\": \"0x060002e7\",\n            \"kind\": \"method-def\",\n            \"type\": \"VisionMaster.AppMainWindow.TitleMenueItemData\",\n            \"name\": \"MutiRun\",\n            \"parameters\": 0,\n            \"attributes\": \"Public, Static, HideBySig\",\n            \"signatureBytes\": \"000001\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 115,\n          \"ilSha256\": \"4fdb3478e252bf544a9bdc7203f30839efbb844b7fcfa848963217343c3d65a9\",\n          \"ilBytes\": \"000028e502000616fe010a062c02de621728e802000600725500007072293d0070282d00000a1617282e00000a2600de410b00077527000001250c14fe030d092c2d0072053d0070282d00000a728b390070086f7500000a287800000a287900000a130411041916282c01000a260000de002a\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"nop\",","evidenceType":"original-managed-cil","binaryIdentity":"42e2437780ec21c9d1ade2d07ace0a26635961f5c90559934a7fde7e233e0c23 / MVID 77c739a5-b0ec-4834-8a1e-64dd9b618ae5"},{"path":"docs/architecture-recovery/run-exit-cil-evidence.json","member":"VisionMaster.AppMainWindow