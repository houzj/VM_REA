utionStore.Save","behavior":"PrepareSave 接收文档副本，随后 Rebase 并落盘；返回后才替换 document、基目录、路径、Dirty、Revision 并发 Changed。","refs":[{"path":"src/VisionEditor.Core/GraphEditorDocument.cs","member":"GraphEditorDocument.Save","sha256":"4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558","start":68,"end":75,"excerpt":"    public void Save(string path) {\n        string full = Path.GetFullPath(path), directory = Path.GetDirectoryName(full)!;\n        var prepared=PrepareSave?.Invoke(Copy(document),BaseDirectory)??document;\n        var rebased = Rebase(prepared, BaseDirectory, directory);\n        SolutionStore.Save(full, rebased); // Commit editor state only after an atomic successful write.\n        document = rebased; BaseDirectory = directory; FilePath = full; IsDirty = false; Revision++; Changed?.Invoke();\n    }\n    public void SelectProcedure(string id) { if (!document.Procedures.Any(p => p.Id == id)) throw new KeyNotFoundException(id); if(CurrentProcedureId == id)return; CurrentProcedureId = id; Changed?.Invoke(); }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["PrepareSave / Rebase 的插件私有资源及历史一致性不由这一方法证明。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"J03","route":"当前 · 保存","classification":"independent-implementation","from":"SolutionStore.Save","to":"临时文件 → Flush(true) → File.Move","behavior":"先校验/序列化、限制 32MiB、检查重复键；同目录独占新临时文件写入和 Flush(true)，Move(overwrite:true)，finally 清临时文件。","refs":[{"path":"src/VisionFramework/SolutionStore.cs","member":"SolutionStore.Save","sha256":"533f7dfd5314570ef1ca97c41ed0dce44b926953135b2b286133b52fe5f50365","start":17,"end":25,"excerpt":"    public static void Save(string path,SolutionDocument solution) {\n        ValidateStructure(solution);byte[] json=JsonSerializer.SerializeToUtf8Bytes(solution,Options);if(json.Length>MaximumBytes)throw new InvalidDataException(\"Solution exceeds size limit.\");\n        // Opaque plugin payloads can contain duplicate members. Reject the same\n        // serialized shape as Load before creating directories or replacing a file.\n        using(var parsed=JsonDocument.Parse(json))RejectDuplicateProperties(parsed.RootElement);\n        string full=Path.GetFullPath(path),directory=Path.GetDirectoryName(full)!;Directory.CreateDirectory(directory);string temp=Path.Combine(directory,\".\"+Path.GetFileName(full)+\".\"+Guid.NewGuid().ToString(\"N\")+\".tmp\");\n        try{using(var output=new FileStream(temp,FileMode.CreateNew,FileAccess.Write,FileShare.None)){output.Write(json);output.Flush(true);}File.Move(temp,full,overwrite:true);}finally{if(File.Exists(temp))File.Delete(temp);}\n    }\n    public static void ValidateStructure(SolutionDocument solution){","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["不证明断电、跨卷、native 保存事务或全部插件资产兼容。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"J04","route":"当前 · 文件菜单与独立载荷","classification":"independent-implementation","from":"GraphEditorDocument.PrepareSave","to":"ToolPluginRegistry参与者投影 → Rebase → JSON存储","behavior":"MainWindow构造将PrepareSave委托连到plugins.PrepareSave并传当前executionScope。ToolPluginRegistry先按已注册持久化参与者前缀排除旧资源，再逐节点调用IToolAssetPersistence.PrepareSave，资源按Id覆盖；没有参与者的节点直接保留。Rebase复制投影，保留绝对路径，仅重算资源相对路径及vision.image-file的Path参数，不递归改写任意插件参数。","refs":[{"path":"src/VisionEditor/MainWindow.xaml.cs","member":"PrepareSave hook attachment","sha256":"034c0dae3e04a9b592031d87e1c1349c23b14091b04564c295267a97fcaa1b4a","start":48,"end":48,"excerpt":" public MainWindow(){InitializeComponent();runningModeIndex=ShellRunningModePreference.Read();shellIsNormalMode=runningModeIndex!=1;InitializeToolDisplays();BuiltinModules.RegisterAll(modules);plugins.Register(new ImageSourcePlugin(),modules);plugins.Register(new ImageAcquisitionPlugin(),modules);plugins.Register(new ImageBufferPlugin(),modules);plugins.Register(new LightPlugin(),modules);plugins.Register(new NPointPlugin(),modules);plugins.Register(new NImagePlugin(),modules);plugins.Register(new VisionPlugins.CameraMapping.CameraMappingPlugin(),modules);plugins.Register(new VisionPlugins.CalibrationBoard.CalibrationBoardPlugin(),modules);plugins.Register(new VisionPlugins.DistortionCalibration.DistortionCalibrationPlugin(),modules);plugins.Register(new VisionPlugins.MapCalibration.MapCalibrationPlugin(),modules);plugins.Register(new TranslationPlugin(),modules);plugins.Register(new ReadCalibFilePlugin(),modules);plugins.Register(new RotateCalibrationPlugin(),modules);plugins.Register(new CoordinateModulePlugin(),modules);plugins.Register(new VisionPlugins.ImageBinary.ImageBinaryPlugin(),modules);plugins.Register(new VisionPlugins.BranchModule.BranchModulePlugin(),modules);plugins.Register(new VisionPlugins.BranchString.BranchStringPlugin(),modules);plugins.Register(new VisionPlugins.Fixture.FixturePlugin(),modules);doc=new GraphEditorDocument(modules){PrepareSave=(document,baseDirectory)=>plugins.PrepareSave(document,baseDirectory,executionScope)};InitializeFrameworkResultHistory();Logo.Source=Asset(\"logo_vm.png\");StatusIcon.Source=Asset(\"bottombar_run.png\");ZoomIcon.Source=Asset(\"zoom_magnifier.png\");Resources[\"WorkflowNgOff\"]=Asset(\"workflow-ng-off.png\");Resources[\"WorkflowNgOn\"]=Asset(\"workflow-ng-on.png\");Resources[\"ToolboxCategoryClosed\"]=Asset(\"toolbox-category-closed.png\");Resources[\"ToolboxCategoryOpen\"]=Asset(\"toolbox-category-open.png\");Resources[\"ToolboxExpandNormal\"]=Asset(\"toolbox-expand-normal.png\");Resources[\"ToolboxExpandHover\"]=Asset(\"toolbox-expand-hover.png\");BuildChrome();InitializeCanvasInput();Closing+=DrainWorkflowBeforeClose;ImageRunMode.Loaded+=(_,_)=>RefreshAll();AttachExecutionScope();doc.SolutionReplaced+=ReplaceExecutionScope;doc.Changed+=()=>{ValidateToolConfigurationOwner();RetainExecutionNodes();RefreshAll();RefreshCo