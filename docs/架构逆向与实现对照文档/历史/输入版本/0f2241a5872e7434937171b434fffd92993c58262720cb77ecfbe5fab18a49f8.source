thValue(string path)=>Path.IsPathFullyQualified(path)?path:Path.GetRelativePath(newBase,Path.GetFullPath(path,oldBase));\n        return copy with { Resources=copy.Resources.Select(r=>r with {Path=PathValue(r.Path)}).ToArray(),Procedures=copy.Procedures.Select(p=>p with {Nodes=p.Nodes.Select(n=> {if(n.ModuleId!=\"vision.image-file\"||!n.Parameters.TryGetValue(\"Path\",out var v)||v.ValueKind!=JsonValueKind.String)return n; var values=n.Parameters.ToDictionary(k=>k.Key,k=>k.Value.Clone());values[\"Path\"]=JsonSerializer.SerializeToElement(PathValue(v.GetString()!));return n with {Parameters=values};}).ToArray()}).ToArray() };\n    }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["各插件私有资产/缓存副作用和失败回滚未由框架投影证明；只读当前main源码，不更改插件框架或其它worktree。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"J05","route":"当前 · 文件菜单与独立载荷","classification":"independent-implementation","from":"doc.Save返回 / Shell.Save后续","to":"文件提交、文档状态、Changed、偏好和最近记录分段","behavior":"SolutionStore写JSON字节并Flush/Move后，doc.Save才改document/BaseDirectory/FilePath/Dirty/Revision并触发Changed；Changed抛错可在文件和字段已变化后中断返回。Shell只有doc.Save正常返回才Remember目录（选新路径时）、Update最近及刷新。Remember的目录创建/写入不捕获；后续失败由Safe显示错误，代码未回滚已写文件或文档。该选定写盘路径直接写序列化JSON，没有原.sol密码/加密提供器步骤。","refs":[{"path":"src/VisionEditor.Core/GraphEditorDocument.cs","member":"Save commit before Changed","sha256":"4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558","start":68,"end":74,"excerpt":"    public void Save(string path) {\n        string full = Path.GetFullPath(path), directory = Path.GetDirectoryName(full)!;\n        var prepared=PrepareSave?.Invoke(Copy(document),BaseDirectory)??document;\n        var rebased = Rebase(prepared, BaseDirectory, directory);\n        SolutionStore.Save(full, rebased); // Commit editor state only after an atomic successful write.\n        document = rebased; BaseDirectory = directory; FilePath = full; IsDirty = false; Revision++; Changed?.Invoke();\n    }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellSaveSolution.cs","member":"shell save continuation","sha256":"f550855c25ec424dc1bbc66268ed1099596896179529fd5ad6ca112de96aba2f","start":65,"end":83,"excerpt":"    bool Save(bool asNew)\n    {\n        var file = doc.FilePath;\n        var selectedPath = asNew || file is null;\n        if (selectedPath)\n        {\n            file = solutionSavePicker.Pick(this, SaveSolutionDirectoryPreference.InitialDirectory());\n            if (string.IsNullOrWhiteSpace(file)) return false;\n        }\n        if (file is null) return false;\n        doc.Save(file);\n        if (selectedPath)\n            SaveSolutionDirectoryPreference.Remember(file);\n        RecentSolutionStore.Update(doc.FilePath!);\n        RefreshRecentSolutionsMenu();\n        return true;\n    }\n}\n","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellSaveSolution.cs","member":"save-directory persistence","sha256":"f550855c25ec424dc1bbc66268ed1099596896179529fd5ad6ca112de96aba2f","start":48,"end":52,"excerpt":"    internal static void Remember(string file)\n    {\n        Directory.CreateDirectory(Path.GetDirectoryName(FilePath)!);\n        File.WriteAllText(FilePath, Path.GetDirectoryName(Path.GetFullPath(file))!);\n    }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/SolutionStore.cs","member":"serialized JSON file write","sha256":"533f7dfd5314570ef1ca97c41ed0dce44b926953135b2b286133b52fe5f50365","start":17,"end":25,"excerpt":"    public static void Save(string path,SolutionDocument solution) {\n        ValidateStructure(solution);byte[] json=JsonSerializer.SerializeToUtf8Bytes(solution,Options);if(json.Length>MaximumBytes)throw new InvalidDataException(\"Solution exceeds size limit.\");\n        // Opaque plugin payloads can contain duplicate members. Reject the same\n        // serialized shape as Load before creating directories or replacing a file.\n        using(var parsed=JsonDocument.Parse(json))RejectDuplicateProperties(parsed.RootElement);\n        string full=Path.GetFullPath(path),directory=Path.GetDirectoryName(full)!;Directory.CreateDirectory(directory);string temp=Path.Combine(directory,\".\"+Path.GetFileName(full)+\".\"+Guid.NewGuid().ToString(\"N\")+\".tmp\");\n        try{using(var output=new FileStream(temp,FileMode.CreateNew,FileAccess.Write,FileShare.None)){output.Write(json);output.Flush(true);}File.Move(temp,full,overwrite:true);}finally{if(File.Exists(temp))File.Delete(temp);}\n    }\n    public static void ValidateStructure(SolutionDocument solution){","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.xaml.cs","member":"Safe postcommit error display","sha256":"034c0dae3e04a9b592031d87e1c1349c23b14091b04564c295267a97fcaa1b4a","start":63,"end":63,"excerpt":" void Safe(Action a){try{a();}catch(Exception e){StatusText.Text=e.Message;}}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["文件系统原子性/断电、Changed全部消费者及插件私有payload保护策略未验证；只确认此主框架JSON写入路径，不推断所有插件字段均无保护。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"J06","route":"当前 · 文件菜单与独立载荷","classification":"independent-implementation","from":"GraphEditorDocument.Load / PrepareLoad","to":"解析/分离/恢复/校验 → 文档提交 → scope替换事件","behavior":"Load先读独立格式、ProcedureGraph.Separate和Copy，再PrepareLoad及ValidateStructure；ToolPluginRegistry恢复提供者必须保持Id/ModuleId/ModuleVersion，否则抛错。提交字段、清历史、Dirty=false并增Revision后才发SolutionReplaced/Changed。MainWindow订阅SolutionReplaced到ReplaceExecutionScope，后者失效旧owner、取消activeRun、清缓存、Dispose旧scope、创建并挂新scope；事件异常没有跨上述步骤的事务回滚。","refs":[{"path":"src/VisionEditor.Core/GraphEdit