(()=>{'use strict';
 const routes=window.DOC_ROUTES||{},prefix=document.documentElement.dataset.sitePrefix||'',params=new URLSearchParams(location.search);
 function error(text){const h=document.getElementById('route-message');if(h){h.hidden=false;h.textContent=text;}}
 function reveal(){let id;try{id=decodeURIComponent(location.hash.slice(1));}catch{error('锚点编码无效。');return;}if(!id)return;let e=document.getElementById(id);if(!e&&id.includes('/'))e=document.getElementById(id.split('/').pop());if(!e)e=[...document.querySelectorAll('[data-fact-id],[data-global-execution-fact],[data-image-fact],[data-parameter-fact]')].find(x=>Object.values(x.dataset).includes(id));if(e){for(let p=e;p;p=p.parentElement)if(p.tagName==='DETAILS')p.open=true;e.dataset.revealed='true';e.scrollIntoView({block:'start'});}else if(document.documentElement.dataset.pageKind!=='imported'&&!document.querySelector('[data-scene-panel="'+CSS.escape(id)+'"]'))error('本页没有锚点「'+id+'」。请从首页选择对应入口，或查看旧路由清单。');}
 function redirect(){if(document.documentElement.dataset.routeHost!=='true')return false;const old=params.get('legacy')||'framework-architecture.html';let hash;try{hash=decodeURIComponent(location.hash);}catch{error('旧路由编码无效。');return true;}if(!params.has('legacy')&&['','main','tools','results'].includes(hash.slice(1)))return false;const key=old+hash,target=routes[key]||(!hash&&routes[old]);if(target){const u=new URL(prefix+target,location.href);for(const [k,v]of params)if(k!=='legacy')u.searchParams.append(k,v);if(u.href!==location.href){location.replace(u.href);return true;}}else if(hash||params.has('legacy')){error('未登记的旧入口：'+key+'。已保留原始查询，请使用下方主题目录。');}return false;}
 if(redirect())return;
 document.querySelectorAll('[data-scene]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.scene;document.querySelectorAll('[data-scene-panel]').forEach(p=>p.hidden=p.dataset.scenePanel!==id);document.querySelectorAll('[data-scene]').forEach(p=>p.setAttribute('aria-selected',String(p===b)));history.pushState(null,'','#'+id);}));
 function filter(){const q=(document.querySelector('[data-tool-search]')?.value||'').trim().toLowerCase(),category=document.querySelector('[data-tool-category]')?.value||'';document.querySelectorAll('[data-tool-item]').forEach(e=>e.hidden=!!((category&&e.dataset.category!==category)||(q&&!e.textContent.toLowerCase().includes(q))));const counter=document.querySelector('[data-tool-counter]');if(counter)counter.textContent='当前显示 '+document.querySelectorAll('[data-tool-item]:not([hidden])').length+' 个已登记工具；登记不等于完整恢复。';}
 document.querySelector('[data-tool-search]')?.addEventListener('input',filter);document.querySelector('[data-tool-category]')?.addEventListener('change',filter);filter();
 document.querySelectorAll('[data-site-search]').forEach(input=>input.addEventListener('input',()=>{const q=input.value.toLowerCase();document.querySelectorAll('[data-search-item]').forEach(e=>e.hidden=!e.textContent.toLowerCase().includes(q));}));
 if(params.has('project')){const key=params.get('project'),item=[...document.querySelectorAll('[data-project]')].find(e=>e.dataset.project===key);if(item){item.open=true;item.scrollIntoView();}else error('当前页面尚未登记项目查询：'+key+'；查询参数已保留。');}
 addEventListener('hashchange',reveal);addEventListener('popstate',()=>{const id=location.hash.slice(1),scene=document.querySelector('[data-scene-panel="'+CSS.escape(id)+'"]');if(scene){document.querySelectorAll('[data-scene-panel]').forEach(p=>p.hidden=p!==scene);document.querySelectorAll('[data-scene]').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.scene===id)));}else reveal();});
 addEventListener('beforeprint',()=>{document.querySelectorAll('details').forEach(e=>{e.dataset.wasOpen=String(e.open);e.open=true;});});addEventListener('afterprint',()=>document.querySelectorAll('details[data-was-open]').forEach(e=>{e.open=e.dataset.wasOpen==='true';delete e.dataset.wasOpen;}));const initialScene=document.querySelector('[data-scene-panel="'+CSS.escape(location.hash.slice(1))+'"]');if(initialScene){document.querySelectorAll('[data-scene-panel]').forEach(e=>e.hidden=e!==initialScene);document.querySelectorAll('[data-scene]').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.scene===location.hash.slice(1))));}else reveal();
})();
