is SubAlgorithmTabRoot subAlgorithmTabRoot)\n\t\t\t{\n\t\t\t\tiO = vmModule.GetIO(AppLocalizationService.UnDoTranslate(text + \"_\" + subAlgorithmTabRoot.HashCode));\n\t\t\t}\n\t\t\tif (iO == null && vmModule is VmModuleSet vmModuleSet)\n\t\t\t{\n\t\t\t\tvmModule = vmModuleSet.ProcedureCommunicaitonModule as VmModule;\n\t\t\t\tiO = vmModule.GetIO(text);\n\t\t\t}\n\t\t\tif (iO == null)\n\t\t\t{\n\t\t\t\tstring lang = AppLocalizationService.GetLang(\"Lang_IO_Message\");\n\t\t\t\tHikMessageBox.Show(lang + \":\" + AppLocalizationService.GetLang(text), MessageIcons.Warning);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tVmIO outputFilter = null;\n\t\t\tstring BindingIndex = null;\n\t\t\tbool isBindGlobalVar = false;","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"D03","route":"原版 · 来源选择与订阅","classification":"source-confirmed","from":"GetOutputInfo / 常量校验","to":"RelateIO 与 RelateIndex 赋值","behavior":"来源解析失败将 ButtonSelecter.CurValueA 恢复 OldCurValue；非空来源补 Root/TypeName，常量先 CheckValue；之后依次赋 RelateIO、RelateIndex。并非一个无副作用的字符串字段赋值。","refs":[{"path":"analysis/decompiled/Apps.XmlParser.CapabilityAudit/Apps.XmlParser.ParamTab/SetFilterSourceOperation.cs","member":"SetFilterSourceOperation source resolution and mutation","sha256":"197ec3eb19974776db4dc9ab293cababed6319ef2a5a1c0da6a8a9bfd5eb0401","start":86,"end":116,"excerpt":"\t\t\tif (!GetOutputInfo(vmModule, filterString, ref outputFilter, ref BindingIndex, ref isBindGlobalVar))\n\t\t\t{\n\t\t\t\tif (buttonSelecter != null)\n\t\t\t\t{\n\t\t\t\t\tbuttonSelecter.CurValueA = buttonSelecter.OldCurValue;\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (outputFilter != null)\n\t\t\t{\n\t\t\t\tif (outputFilter != VmSolution.ExternIO && outputFilter.Root == null)\n\t\t\t\t{\n\t\t\t\t\toutputFilter.Root = vmModule;\n\t\t\t\t}\n\t\t\t\tif (string.IsNullOrEmpty(outputFilter.TypeName))\n\t\t\t\t{\n\t\t\t\t\toutputFilter.TypeName = iO.TypeName;\n\t\t\t\t}\n\t\t\t\tif (outputFilter is VmConstantIO vmConstantIO && !CheckValue(vmConstantIO.Name, iO.TypeName))\n\t\t\t\t{\n\t\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"订阅失败\"), MessageIcons.Warning);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t}\n\t\t\tiO.RelateIO = outputFilter;\n\t\t\tiO.RelateIndex = GetBindIndex(vmModule, BindingIndex);\n\t\t\tstring[] array = text.Split('_');\n\t\t\tif (array.Length == 2)\n\t\t\t{\n\t\t\t\tstring objName = array[1].Substring(0, array[1].Length - 1);\n\t\t\t\t((VmSolution.Instance[((IVmFullPath)vmModule).FullPath + \".[Display]\"] is ParamRoot paramRoot) ? (from a in paramRoot.GetDisplayList().OfType\u003cObject>()","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["GetOutputInfo/GetBindIndex 的所有外部变量、数组及错误分支尚未在此图闭合。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"D04","route":"原版 · 来源选择与订阅","classification":"source-confirmed","from":"VmIO.RelateIO setter","to":"登记订阅历史 → 解旧 → 订新","behavior":"LazyLoad 后叶节点同值直接返回；先登记 SubscribeUnRedoAction，读取旧来源，存在则 Root.UnSubscribe，否则对子项清订阅；赋新来源后 Root.Subscribe，失败清 _relateIO 再抛。不能推断失败会恢复旧订阅。","refs":[{"path":"analysis/decompiled/VM.Core/VM.Core/VmIO.cs","member":"VmIO.RelateIO setter unsubscribe/register","sha256":"15e1832243422b6bfa2714f300b796d54c365950573639eb1039c5df58e99cb0","start":167,"end":198,"excerpt":"\t\t\t\tExpression\u003cFunc\u003cobject>> oldSubList = () => Root.GetModuleAllSubscribe();\n\t\t\t\tstring displayName = string.Format(\"{0}{1}{2}\", AppLocalizationService.GetLang(\"Lang_Edit\"), Root.FullName, AppLocalizationService.GetLang(\"RunParam_Subscribe\"));\n\t\t\t\tIoc.Get\u003cIUnRedoService>()?.Register(new SubscribeUnRedoAction(Subscribe_Redo, Subscribe_Undo, Subscribe_Update, new UnRedo_SubscribeData\n\t\t\t\t{\n\t\t\t\t\tModuleFullName = Root.FullName,\n\t\t\t\t\tOldSubList = oldSubList,\n\t\t\t\t\tNewSubList = null\n\t\t\t\t}), displayName, (IBuilder builder, IUnRedoOperation operation) => CanRegisterSubscribe(builder, operation));\n\t\t\t\tVmIO relateIO = RelateIO;\n\t\t\t\tif (relateIO != null)\n\t\t\t\t{\n\t\t\t\t\tRoot.UnSubscribe(this, relateIO);\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tforeach (VmIO child in Childs)\n\t\t\t\t\t{\n\t\t\t\t\t\tchild.RelateIO = null;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t_relateIO = value;\n\t\t\t\tif (_relateIO != null)\n\t\t\t\t{\n\t\t\t\t\ttry\n\t\t\t\t\t{\n\t\t\t\t\t\tRoot.Subscribe(this, _relateIO);\n\t\t\t\t\t}\n\t\t\t\t\tcatch (Exception ex)\n\t\t\t\t\t{\n\t\t\t\t\t\t_relateIO = null;\n\t\t\t\t\t\tthrow ex;\n\t\t\t\t\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"D05","route":"原版 · 来源选择与订阅","classification":"source-confirmed","from":"VmIO 新订阅完成","to":"RelatedIOChanged / Ready 刷新","behavior":"建立新订阅后发 RelatedIOChanged，Root 未进入 Dispose 才 ReFlashReadyState；调用顺序与字段变更分开记录。","refs":[{"path":"analysis/decompiled/VM.Core/VM.Core/VmIO.cs","member":"VmIO subscription notification","sha256":"15e1832243422b6bfa2714f300b796d54c365950573639eb1039c5df58e99cb0","start":200,"end":209,"excerpt":"\t\t\t\tRelatedIOChanged?.Invoke(this, new ValueEventArgs\n\t\t\t\t{\n\t\t\t\t\tValue = _relateIO\n\t\t\t\t});\n\t\t\t\tif (!Root.IsOnDispose)\n\t\t\t\t{\n\t\t\t\t\tRoot.ReFlashReadyState();\n\t\t\t\t}\n\t\t\t}\n\t\t\tcatch (Exception ex2)","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"D06","route":"原版 · 来源选择与订阅","classification":"source-confirmed","from":"VmModule.Subscribe / UnSubscribe","to":"类型检查、叶订阅 SDK 或对子项递归","behavior":"先 IsSuitable；双方叶节点使用 GetSubInfo(source)、GetPubInfo(target,source.RelateIndex)，交 SubscribeResult/UnSubscribeResult。组合 Subscribe 要求子项数量相同，逐项赋 RelateIO，否则抛不对齐异常。变量名 source 在此是订阅方，不应按英语词义反转生产/消费方向。","refs":[{"path":"analysis/decompiled/VM.Core/VM.Core/VmModule.cs","member":"VmModule.Subscribe","sha256":"53e2f0f9032c4631b59cf0eb2a00e06d50469d94706e7e370e9cc7e1059c72ce","start":1823,"end":1846,"excerpt":"\tinternal virtual void Subscribe(VmIO source, VmIO target)\n\t{\n\t\tif (!IsSuitable(target.TypeName, source.TypeName))\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tif (target.IsLeafNode && source.IsLeafNode)\n\t\t{\n\t\t\tImvsSdkDefine.IMVS_SUBSCRIBE_BASIC_INFO subInfo = GetSubInfo(source);\n\t\t\tImvsSdkDefine.IMVS_PUBLISH_BASIC_INFO pubInfo = GetPubInfo(target, source.RelateIndex);\n\t\t\tServerSDKManager.serverSDKManager.mModuleManager.SubscribeResult(subInfo, pubInfo);\n\t\t\treturn;\n\t\t}\n\t\tif (source.Childs.Count == target.Childs.Count)\n\t\t{\n\t\t\tfor (int i = 0; i \u003c target.Childs.Count; i++)\n\t\t\t{\n\t\t\t\tsource.Childs[i].RelateIO = target.Childs[i];\n\t\t\t}\n\t\t\treturn;\n\t\t}\n\t\tstring lang = AppLocalizationService.GetLang(\"SubscriptionsNotAligned\");\n\t\tthrow new Exception(lang);\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VM.Core/VM.Core/VmModule.cs","member":"VmModule.UnSubscribe","sha256":"53e2f0f9032c4631b59cf0eb2a00e06d50469d94706e7e370e9cc7e1059c72ce","start":1853,"end":1868,"excerpt":"\tinternal virtual void UnSubscribe(VmIO source, VmIO target)\n\t{\n\t\ttry\n\t\t{\n\t\t\tif (!IsSuitable(target.TypeName, source.TypeName))\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (target.IsLeafNode && source.IsLeafNode)\n\t\t\t{\n\t\t\t\tImvsSdkDefine.IMVS_SUBSCRIBE_BASIC_INFO subInfo = GetSubInfo(source);\n\t\t\t\tImvsSdkDefine.IMVS_PUBLISH_BASIC_INFO pubInfo = GetPubInfo(target, source.RelateIndex);\n\t\t\t\tServerSDKManager.serverSDKManager.mModuleManager.UnSubscribeResult(subInfo, pubInfo);\n\t\t\t}\n\t\t\telse\n\t\t\t{","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"D07","route":"原版 · 来源选择与订阅","classification":"source-confirmed","from":"VmProcedure.Subscribe","to":"自定义流程输出订阅合同","behavior":"流程专用方法双方叶节点时用 source.Name 填 strInputParamName，target.Name 填 strOutputParamName，过程 ID 与 target.Root.ID 填结构，再交 SetCustomOutputSubscribeInfo；这与普通模块 SubscribeResult 是不同 SDK 路径。","refs":[{"path":"analysis/decompiled/VM.Core/VM.Core/VmProcedure.cs","member":"VmProcedure custom output Subscribe","sha256":"fdde074d17c50c37f8d0bfe097cf20f904cdb4b59d4ac39612fc023c3f0b69da","start":984,"end":1004,"excerpt":"\tprivate void Subscribe(VmIO source, VmIO target, bool IfDelete)\n\t{\n\t\tif (!IsSuitable(target.TypeName, source.TypeName))\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tif (target.IsLeafNode && source.IsLeafNode)\n\t\t{\n\t\t\tImvsSdkDefine.IMVS_CUSTOM_SUBSCRIBE_INFO customOutputSubscribeInfo = new ImvsSdkDefine.IMVS_CUSTOM_SUBSCRIBE_INFO\n\t\t\t{\n\t\t\t\tstrInputParamName = VM.PlatformSDKCS.StringUtil.UTF8GetFixLenBytes(source.Name, 256),\n\t\t\t\tstrOutputParamName = VM.PlatformSDKCS.StringUtil.UTF8GetFixLenBytes(target.Name, 256),\n\t\t\t\tnIfDelete = (IfDelete ? 1 : 0),\n\t\t\t\tnOutputType = source.ValueTypeIndex,\n\t\t\t\tnSubProcessID = (int)ID,\n\t\t\t\tnPubModuleID = (int)target.Root.ID\n\t\t\t};\n\t\t\tServerSDKManager.serverSDKManager.mVmInterfaceManager.SetCustomOutputSubscribeInfo(customOutputSubscribeInfo);\n\t\t\treturn;\n\t\t}\n\t\tif (source.Childs.Count == target.Childs.Count)","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"U01","route":"原版 · 未闭合