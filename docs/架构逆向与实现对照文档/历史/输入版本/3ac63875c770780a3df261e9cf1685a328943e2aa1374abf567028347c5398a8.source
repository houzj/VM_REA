  "gates": [
    {
      "id": "E0",
      "title": "原件与程序集范围",
      "state": "open",
      "gap": "28 个本地反编译树不等于全部随包程序集；各版本 SHA/MVID、依赖和遗漏程序集仍需对账。"
    },
    {
      "id": "E1",
      "title": "资源声明全集",
      "state": "partial",
      "gap": "四份模式菜单资源与独立GlobalToolItems.xml已清点；后者11个具名声明另列，不并入214主菜单声明。其它BAML/XAML、动态和外部宿主仍未穷尽。"
    },
    {
      "id": "E2",
      "title": "交互与局部输入",
      "state": "open",
      "gap": "全树扫描只提供候选；WPF 焦点/路由、附加行为、系统命令及 Gesture/Key 的 BAML 歧义仍需逐载体核对。"
    },
    {
      "id": "E3",
      "title": "后台与反向入口",
      "state": "open",
      "gap": "SDK/native/设备/外部触发、定时器和跨线程回调的注册与生产者需独立追链，不保证经过主窗点击。"
    },
    {
      "id": "E4",
      "title": "声明到 handler",
      "state": "open",
      "gap": "每条资源、反射 resolver、动态注册必须定位真实对象类型、handler 与启用/权限条件；词法匹配不算绑定确认。"
    },
    {
      "id": "E5",
      "title": "完整行为与回流",
      "state": "open",
      "gap": "每个入口必须追状态/身份、持久化、执行、回调、异常/取消/释放；已有局部边不能替代全链。"
    },
    {
      "id": "E6",
      "title": "入口与模型双向对账",
      "state": "open",
      "gap": "需保证每个已证实入口都有链，每条链都有入口或回调来源，重复别名共用证据但不丢声明。"
    },
    {
      "id": "E7",
      "title": "有限范围自审与运行证据",
      "state": "open",
      "gap": "先固定原件/载体范围，再逐入口审查。当前未运行原版；静态源、重建测试、原机证据分别记录。"
    }
  ],
