SHA256 53e2f0f9032c4631b59cf0eb2a00e06d50469d94706e7e370e9cc7e1059c72ce
	public override string Name
	{
		get
		{
			return name;
		}
		set
		{
			if (!(name != value))
			{
				return;
			}
			ServerSDKManager.serverSDKManager.mModuleManager.SetModuDisplayName(ID, value);
			string fullName = FullName;
			string text = name;
			name = value;
			foreach (VmModule preModule in PreModules)
			{
				byte[] value2 = preModule.UserData[&quot;SourceIndex&quot; + text];
				byte[] value3 = preModule.UserData[&quot;TargetIndex&quot; + text];
				preModule.UserData[&quot;SourceIndex&quot; + text] = null;
				preModule.UserData[&quot;TargetIndex&quot; + text] = null;
				preModule.UserData[&quot;SourceIndex&quot; + name] = value2;
				preModule.UserData[&quot;TargetIndex&quot; + name] = value3;
			}
			NotifyNameChangedToParent(text);
			OnPropertyChanged(&quot;Name&quot;);
			((IVmSolution)VmSolution.Instance).OnModuleActionChanged(&quot;ReName&quot;, fullName, FullName);
		}
	}
</pre></details><details><summary>Parent unready-name cache update · local-decompiled-source</summary><pre>analysis/decompiled/VM.Core/VM.Core/VmModuleSet.cs:229–242
SHA256 f3b98c4436686b0a9babf8cde4f5f6c83814664b8f7835dfabbeb02e2a64a346
	internal void ReFlashReadyInfoOfName(VmModule node, string oldName)
	{
		initUnReadyModuleNames();
		if ((!node.IsReady) ?? false)
		{
			int num = -1;
			if ((num = UnReadyModuleNames.IndexOf(oldName)) &gt;= 0)
			{
				UnReadyModuleNames[num] = node.Name;
				UserData[&quot;UnReadyModuleNames&quot;] = VM.PlatformSDKCS.StringUtil.UTF8GetBytesPadZero(string.Join(&quot;;&quot;, UnReadyModuleNames));
				OnPropertyChanged(&quot;UnReadyModuleName&quot;);
			}
		}
	}</pre></details><details><summary>Original Group base class declaration · local-decompiled-source</summary><pre>analysis/decompiled/VM.Core/VM.Core/IMVSGroup.cs:20–20
