SHA256 f124b9a5e3ce5b8e2e856d3e325b00a4b143f7074513ccc74d542ec35c2695dd
	public string Name
	{
		get
		{
			return VMModule.Name;
		}
		set
		{
			if (VMModule.Name != value)
			{
				try
				{
					if (value.Contains(&#39;?&#39;) || value.Contains(&#39;;&#39;) || value.Contains(&#39;.&#39;) || value.Contains(&quot;[&quot;) || value.Contains(&quot;]&quot;) || value.Contains(&quot;&lt;&quot;) || value.Contains(&quot;&gt;&quot;) || value.Contains(&quot;(&quot;) || value.Contains(&quot;)&quot;) || value.Contains(&quot;`&quot;))
					{
						HikMessageBox.Show(AppLocalizationService.GetLang(&quot;Lang_ModuleNameErrorInclude&quot;) + Environment.NewLine + &quot;                             ? ; . [ ] &lt; &gt; ( ) `&quot;, MessageIcons.Error);
						return;
					}
					string displayName = AppLocalizationService.GetLang(&quot;Lang_ModuRename&quot;) + &quot;:&quot; + VMModule.Name + &quot;, &quot; + value;
					Ioc.Get&lt;IUnRedoService&gt;()?.Register(new ReNameUnRedoOperation(SetNewName, SetOldName, new UnRedo_NameData(VMModule.FullName, VMModule.Name, value)), displayName);
					UILogManager.logCreate(&quot;信息&quot;, AppLocalizationService.GetLang(&quot;Lang_ModuRename&quot;) + AppLocalizationService.GetPunctuation(&quot;：&quot;) + VMModule.Name + &quot; &quot; + AppLocalizationService.GetLang(&quot;修改为&quot;) + &quot; &quot; + value, ifLang: false);
					VMModule.Name = value;
				}
				catch (VmException ex)
				{
					if (string.IsNullOrEmpty(value))
					{
						HikMessageBox.Show(AppLocalizationService.GetLang(&quot;Lang_NameEmpty&quot;), MessageIcons.Error);
					}
					else
					{
						ShowMessage.ShowVmExceptionMessage(ex);
					}
					UILogManager.logCreate(&quot;错误&quot;, ErrorCodeInfo.GetErrorInfo(ex.errorCode), ifLang: false);
				}
				OnPropertyChanged(&quot;Name&quot;);
				VMModule.OnPropertyChanged(&quot;FullName&quot;);
			}
			else
			{
				Ioc.Get&lt;IUnRedoService&gt;()?.RemoveEmptyOperation();
			}
		}
	}

	public ICommand RenameWindowCommand
	{
		get
		{
			//IL_0017: Unknown result type (might be due to invalid IL or missing references)
			//IL_001c: Unknown result type (might be due to invalid IL or missing references)
			//IL_001e: Expected Obj, but got Unknown
			//IL_0023: Expected Obj, but got Unknown
			DelegateCommand val = _RenameWindowCommand;</pre></details></article><article id="WTN06" class="source-confirmed"><h2>WTN06 · VmModule.Name / IMVSGroup基类链 → SDK显示名写入 → 本地name → 前驱键迁移/父状态</h2><p>source-confirmed：VmModule原setter同名早退，先ModuleManager.SetModuDisplayName(ID,value)，成功返回才记旧FullName/name并写本地name；遍历PreModules将UserData中SourceIndex+旧名/TargetIndex+旧名读取后清旧键、写新键，通知父ready名称、Name及IVmSolution.OnModuleActionChanged(ReName,oldFullName,newFullName)。原类型元数据IMVSGroup→VmModuleSet→VmModule；未发现两中间类原源Name重写，本片以该基类路径为有限Group改名来源，不臆造Group专用保存。</p><p>待追：UserData getter/setter内部存储、部分键迁移失败/事件订阅者失败、Group运行类型替代、文件字节和native持久化尚未闭合。</p><details><summary>VM.Core.VmModule::get_Name · original-managed-cil</summary><pre>docs/architecture-recovery/workflow-title-commit-audit.cil.json:6163–6182
