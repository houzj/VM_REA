SHA256 64d7234a19006d86a81059d26ce952ccdfa5e2dd67f51324f985ce433014a516
	private static void OnIsReNameChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
	{
		HeadReNameTextBox headReNameTextBox = d as HeadReNameTextBox;
		bool flag = (bool)e.OldValue;
		if ((bool)e.NewValue)
		{
			headReNameTextBox.Focus();
			headReNameTextBox.SelectAll();
		}
		if (flag)
		{
			BindingExpression bindingExpression = headReNameTextBox.GetBindingExpression(TextBox.TextProperty);
			bindingExpression.UpdateSource();
		}
	}

	public HeadReNameTextBox()</pre></details><details><summary>Key and focus exit handlers · local-decompiled-source</summary><pre>analysis/decompiled/Apps.PcUI.ImageSourceAudit/Apps.PcUI/HeadReNameTextBox.cs:53–65
SHA256 64d7234a19006d86a81059d26ce952ccdfa5e2dd67f51324f985ce433014a516
	private void HeadReNameTextBox_LostFocus(object sender, RoutedEventArgs e)
	{
		IsReName = false;
	}

	private void HeadReNameTextBox_KeyDown(object sender, KeyEventArgs e)
	{
		if (e.Key == Key.Return)
		{
			IsReName = false;
		}
	}
}</pre></details></article><article id="WTN04" class="source-confirmed"><h2>WTN04 · HeadReNameTextBox本地样式 → 静态显示TextBlock与可编辑PART_ContentHost切换</h2><p>source-confirmed：本地generic资源将IsHitTestVisible绑定自身IsReName；模板默认TextBlock显示Text、PART_ContentHost Hidden，IsReName=true折叠前者并显示后者。禁用态另降border透明度。这个样式解释标题显示/编辑两个视觉部分，不意味着值已写入模块或磁盘。</p><p>待追：Apps.PcUI generic原BAML/实际主题命中尚未在此核验；这是本地提取声明，与已核CIL分列。</p><details><summary>Rename hit-test declaration · local-extracted-resource</summary><pre>analysis/decompiled/Apps.PcUI.ImageSourceAudit/themes/generic.xaml:20–20
