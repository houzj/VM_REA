          &lt;TextBox Name=&quot;ModuleID&quot; BorderThickness=&quot;0&quot; Width=&quot;100&quot; VerticalContentAlignment=&quot;Center&quot; Background=&quot;{DynamicResource ListViewComboBoxBackground}&quot; Text=&quot;{Binding Name}&quot; /&gt;
