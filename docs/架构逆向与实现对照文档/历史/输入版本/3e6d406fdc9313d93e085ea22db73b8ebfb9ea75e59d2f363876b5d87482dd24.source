SHA256 4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558
    public void SetNodeName(string id,string name) { RequireName(name); ChangeNode(id,n=&gt;n with {Name=name}); }</pre></details><details><summary>Current procedure rename API · current-source</summary><pre>src/VisionEditor.Core/GraphEditorDocument.cs:110–116
SHA256 4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558
    public void RenameProcedure(string id,string name) {
        RequireName(name);
        // VmModuleBaseDecorator.Name rejects these characters before invoking the SDK.
        if(name.IndexOfAny(&quot;?;.[]&lt;&gt;()`&quot;.ToCharArray())&gt;=0)throw new ArgumentException(&quot;名称不能包含 ? ; . [ ] &lt; &gt; ( ) `。&quot;,nameof(name));
        var procedure=Procedure(id); if(procedure.Name==name)return;
        Edit(d=&gt;d with {Procedures=d.Procedures.Select(p=&gt;p.Id==id?p with {Name=name}:procedure.GroupOwner is {} owner&amp;&amp;p.Id==owner.ProcedureId?p with{Nodes=p.Nodes.Select(n=&gt;n.Id==owner.NodeId?n with{Name=name}:n).ToArray()}:p).ToArray()});
    }</pre></details><details><summary>Current document save boundary · current-source</summary><pre>src/VisionEditor.Core/GraphEditorDocument.cs:68–74
SHA256 4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558
    public void Save(string path) {
        string full = Path.GetFullPath(path), directory = Path.GetDirectoryName(full)!;
        var prepared=PrepareSave?.Invoke(Copy(document),BaseDirectory)??document;
        var rebased = Rebase(prepared, BaseDirectory, directory);
        SolutionStore.Save(full, rebased); // Commit editor state only after an atomic successful write.
        document = rebased; BaseDirectory = directory; FilePath = full; IsDirty = false; Revision++; Changed?.Invoke();
    }</pre></details></article><article id="WTU01" class="unknown"><h2>WTU01 · 标题提交与名称/保存消费者 → 活绑定、取消失败与存储往返仍未知</h2><p>unknown：已恢复显式UpdateSource、装饰器校验、模块/流程不同setter和SDK保存消费者；仍不是一个已观察的编辑→写盘→重载闭环。SetOldName/SetNewName已取原体但只证明undo调用IVmModule.Name，未证明完整历史事务/名称路径在失败后总可解析。</p><p>待追：下一原边：HeadReNameTextBox模板实际选择与绑定错误路由；VMModule.Name失败后视觉恢复；全部取消/窗口关闭；UserData native写入；TempVmSolution和IMVS_SaveSolution名称序列化/重载；当前逐操作差分。</p><details><summary>VMControls.WPF.DataForUI.VmModuleBaseDecorator::SetOldName · original-managed-cil</summary><pre>docs/architecture-recovery/workflow-title-commit-audit.cil.json:4554–4573
