	public bool IsReName
	{
		get
		{
			return _IsReName;
		}
		set
		{
			if (_IsReName != value)
			{
				_IsReName = value;
				if (_IsReName)
				{
					Ioc.Get&lt;IUnRedoService&gt;()?.Register(new RootOperation(), AppLocalizationService.GetLang(&quot;Lang_ModuRename&quot;) ?? &quot;&quot;);
				}
				OnPropertyChanged(&quot;IsReName&quot;);
			}
		}
	}

	public ICommand SkipToModuleCommand
	{</pre></details><details><summary>Dialog data context restriction · local-decompiled-source</summary><pre>analysis/decompiled/VMControls.WPF/VMControls.WPF.Base/ModifyName.xaml.cs:21–36
SHA256 9e2fd69869e055ab23815d47c5bce9c52be9ea8ce5bc127fe2f754a41481ff82
	public ModifyName(VmModuleBaseDecorator decorator)
	{
		InitializeComponent();
		if (decorator is VmModuleDecorator dataContext)
		{
			DataContext = dataContext;
		}
	}

	private void SearchClick(object sender, RoutedEventArgs e)
	{
		DataContext = null;
		Close();
	}
}
</pre></details><details><summary>Dialog text and confirm declarations · local-extracted-resource</summary><pre>analysis/decompiled/VMControls.WPF/VMControls.WPF.Base/ModifyName.xaml:21–23
