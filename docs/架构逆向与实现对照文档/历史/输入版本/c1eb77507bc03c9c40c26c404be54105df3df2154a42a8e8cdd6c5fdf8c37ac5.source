const baseline={schemaVersion:1,sourceMain:origin,sourceMainSha256:sha(Buffer.from(main)),sourceMainBytes:Buffer.byteLength(main),sourcePages:imported.length,entries:ui.entries.length,tools:tool.tools.length,dataChapters:chapters.length,inputs:versionedInputs,implementationCredit:0,sourceDocumentUntouched:true,oldRootEntryReplaced:false};
write('清单/拆分前基线.json',JSON.stringify(baseline,null,2)+'\n');write('清单/旧路由映射.json',JSON.stringify(routes,null,2)+'\n');write('公共资源/routes.js','window.DOC_ROUTES='+JSON.stringify(routes).replaceAll('<','\\u003c')+';\n');write('公共资源/site.css',input(posix(path.relative(root,path.join(__dirname,'site.css')))));write('公共资源/site.js',input(posix(path.relative(root,path.join(__dirname,'site.js')))));
