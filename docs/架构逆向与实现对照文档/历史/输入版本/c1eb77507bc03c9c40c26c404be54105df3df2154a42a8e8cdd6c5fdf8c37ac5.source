for(const e of evidence.values()){const back=[...new Set(e.backlinks)];write(e.path,shell(e.path,'原文证据 '+e.key.slice(0,12),'<p>内容寻址：SHA256 '+e.key+'。此值核对本页保留的原始 HTML 块；原始源码／程序集 SHA 以调用页的来源记录为准。</p><div id="content">'+e.html+'</div><h2>返回引用位置</h2>'+list(back.map(p=>({label:pages.find(x=>x.path===p)?.title||p,href:relative(e.path,p)}))),{kind:'evidence'}));}
const drift=[...inputs].filter(([p,h])=>sha(read(p))!==h).map(([p,h])=>({path:p,capturedSha256:h,currentSha256:sha(read(p)),meaning:'Source changed after capture; frozen version remains authoritative for this split. No semantic status upgraded.'}));
const status={phase:'initial-split-generated',canonicalDirectory:'docs/架构逆向与实现对照文档',oldRootEntryReplaced:false,sourceMainUnchanged:true,protection:'Standalone builder only; parent generator and in-progress global-variable source are not modified.',counts:{pages:pages.length,evidencePages:evidence.size,evidenceOccurrences:occurrences.length,importedPages:imported.length,entryPages:ui.entries.length,toolPages:tool.tools.length,oldRoutes:Object.keys(routes).length,relationshipEdges:relationships.length},browserVerification:{rendered:false,reason:'Browser URL security policy rejected file://; no alternate surface, localhost server or other workaround attempted.'},unknowns:['原 docs/framework-architecture.html 仍由在制专项生成；本批不覆盖，旧地址继续提供原页面。新目录兼容入口和首页已具路由映射，根入口切换待唯一写者合入。','390/768/桌面、打印、键盘和实际浏览器前进后退尚待本批浏览器验收；浏览器 URL 安全策略拒绝本地 file://，静态路由不等于已验呈现。','既有专题保留原图和交互；本批新增入口／执行关系投影，不宣称所有 Owner、状态关系均已获得结构化原始模型。'],productModified:false,implementationCredit:0};
