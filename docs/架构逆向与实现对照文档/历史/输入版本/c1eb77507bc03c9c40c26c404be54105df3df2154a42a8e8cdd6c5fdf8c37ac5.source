const indexBody='<p class="site-notice">从你看到的界面位置进入。以下是导航示意，非软件运行截图；点击后直接查看原版入口、当前实现、数据链、Owner、差异和证据。</p><div class="site-scene-tabs" role="tablist" aria-label="界面场景"><button data-scene="main" role="tab" aria-selected="true">主界面</button><button data-scene="tools" role="tab" aria-selected="false">工具窗口</button><button data-scene="results" role="tab" aria-selected="false">运行与结果</button></div><section data-scene-panel="main" class="map-panel"><h2>主界面位置地图</h2><div class="ui-schematic"><a class="menu" href="入口/菜单与工具栏.html">菜单栏 · 文件／设置／工具／系统／帮助<small>查看全部已登记声明与触发关系</small></a><div class="toolbar">'+list(ui.entries.slice(0,9).map(e=>({label:e.label,href:entry(e.id)})))+'</div><div class="tools"><a href="工具/index.html">工具箱 · 分类／搜索／具体工具</a>'+a('toolbox','分类与拖入')+'</div><div class="canvas">'+a('tabs','工作流 Tab')+a('nodes','流程画布／节点操作')+a('connections','连线与数据路径')+a('group','Group／子程序')+'</div><div class="results">'+a('image','图像／预览')+a('results','模块结果／结果表')+'<a href="数据/index.html">数据类型、缓存与释放</a></div><div class="status">'+a('stop','状态／停止／后台收尾')+'</div></div><h3>直接选择具体入口</h3>'+list(ui.entries.map(e=>({label:e.label,href:entry(e.id)})))+'</section><section data-scene-panel="tools" class="map-panel" hidden><h2>工具窗口：选择具体工具</h2><p>参数、算法、输入图像、模块结果、缓存与释放按原记录分层，未知明确保留。</p>'+toolPicker('index.html')+'</section><section data-scene-panel="results" class="map-panel" hidden><h2>运行、结果与最后读者</h2>'+list([{label:'执行与状态',href:'主题/执行与状态.html'},...chapters.map(c=>({label:c.title,href:c.dest}))])+'</section><h2>辅助入口</h2>'+list([{label:'全景架构',href:'主题/全景架构.html'},{label:'全部既有专题',href:'清单/专题索引.html'},{label:'交付范围与旧路由',href:'清单/交付与兼容.html'}]);
