'use strict';
// Standalone documentation projection. Does not run reverse-engineering/build-index,
// rewrite its sources, or replace the main thread's in-progress document.
const fs=require('fs'),path=require('path'),crypto=require('crypto'),vm=require('vm'),assert=require('assert/strict');
const root=path.resolve(__dirname,'../../..'),target=path.join(root,'docs/架构逆向与实现对照文档'),origin='docs/framework-architecture.html',sourceDir='docs/architecture-recovery';
const sha=b=>crypto.createHash('sha256').update(b).digest('hex'),esc=x=>String(x??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;'),posix=x=>x.replaceAll('\\','/'),read=p=>fs.readFileSync(path.resolve(root,p)),json=p=>JSON.parse(read(p).toString().replace(/^\uFEFF/,''));
const inputs=new Map(),buffers=new Map(),outputs=new Map(),routes={},evidence=new Map(),occurrences=[],assets=new Map(),pages=[],relationships=[],externalLinks=new Set();
function input(p){const key=posix(path.relative(root,path.resolve(root,p)));if(buffers.has(key))return buffers.get(key);const b=read(p);inputs.set(key,sha(b));buffers.set(key,b);return b;}
function write(p,body){const b=Buffer.isBuffer(body)?body:Buffer.from(body),abs=path.join(target,p);fs.mkdirSync(path.dirname(abs),{recursive:true});if(!fs.existsSync(abs)||sha(fs.readFileSync(abs))!==sha(b))fs.writeFileSync(abs,b);outputs.set(p,{path:p,sha256:sha(b),bytes:b.length});}
if(process.argv.includes('--assets-only')){
 const m=JSON.parse(fs.readFileSync(path.join(target,'清单/构建清单.json'))),b=JSON.parse(fs.readFileSync(path.join(target,'清单/拆分前基线.json')));
 for(const name of ['site.css','site.js']){const src=posix(path.relative(root,path.join(__dirname,name))),bytes=read(src),hash=sha(bytes),snapshot='历史/输入版本/'+hash+'.source';write('公共资源/'+name,bytes);write(snapshot,bytes);const existing=b.inputs.find(x=>x.path===src);if(existing)Object.assign(existing,{sha256:hash,snapshot});else b.inputs.push({path:src,sha256:hash,snapshot});}
 write('清单/拆分前基线.json',JSON.stringify(b,null,2)+'\n');for(const row of outputs.values()){const i=m.outputs.findIndex(x=>x.path===row.path);if(i>=0)m.outputs[i]=row;else m.outputs.push(row);}m.incrementalUpdates=[...(m.incrementalUpdates||[]),{kind:'shared-assets-only',files:['公共资源/site.css','公共资源/site.js'],sourceEvidenceRescanned:false,topicBodiesModified:false,implementationCredit:0}];write('清单/构建清单.json',JSON.stringify(m,null,2)+'\n');console.log(JSON.stringify({mode:'shared-assets-only',files:2,sourceEvidenceRescanned:false,topicBodiesModified:false}));process.exit(0);
}
function relative(from,to){return posix(path.relative(path.dirname(from),to))||path.basename(to);}
function prefix(p){return posix(path.relative(path.dirname(p),'.'))+(path.dirname(p)==='.'?'':'/');}
function slug(x){return String(x).normalize('NFKC').replace(/[^\p{L}\p{N}_.-]+/gu,'-').slice(0,100)||'item';}
function snapshot(p){const b=input(p);write('历史/源快照/'+posix(p).replace(/^docs\//,'')+'.source.txt',b);return b.toString();}
function extractModel(p,marker){const s=input(p).toString(),a=s.indexOf(marker);assert(a>=0,'model marker '+p);let start=a+marker.length;while(/\s/.test(s[start]))start++;let q=false,e=false,depth=0;for(let i=start;i<s.length;i++){const c=s[i];if(q){if(e)e=false;else if(c==='\\')e=true;else if(c==='"')q=false;}else if(c==='"')q=true;else if(c==='{'||c==='[')depth++;else if(c==='}'||c===']'){if(--depth===0)return JSON.parse(s.slice(start,i+1));}}throw Error('JSON model unterminated '+p);}
function section(html,id){const re=new RegExp('<section\\b[^>]*\\bid="'+id+'"[^>]*>','i'),m=re.exec(html);assert(m,'section '+id);let depth=0;for(const t of html.slice(m.index).matchAll(/<\/?section\b[^>]*>/gi)){depth+=t[0].startsWith('</')?-1:1;if(!depth){const end=m.index+t.index+t[0].length;return {html:html.slice(m.index,end),start:m.index,end};}}throw Error('unclosed section '+id);}
function register(key,dest){if(routes[key]&&routes[key]!==dest){if(key.startsWith('architecture-recovery/tool-plugin-map.html#tool-'))return;throw Error('route collision '+key);}routes[key]=dest;}
function routeFor(href,source){let u;try{u=new URL(href,'https://local.invalid/'+source.replace(/^docs\//,''));}catch{return null;}if(u.origin!=='https://local.invalid')return null;const key=decodeURI(u.pathname.slice(1))+decodeURI(u.hash);return routes[key]||routes[decodeURI(u.pathname.slice(1))]&&(routes[decodeURI(u.pathname.slice(1))]+u.hash);}
function evidenceLink(pre,page,kind='original-pre'){const key=sha(Buffer.from(pre)),file='证据/'+key+'.html';if(!evidence.has(key))evidence.set(key,{key,path:file,html:pre,kind,backlinks:[]});evidence.get(key).backlinks.push(page);occurrences.push({page,key,kind});return '<a class="site-evidence-link" data-evidence-key="'+key+'" href="'+relative(page,file)+'#content">查看完整原文／记录 ↗ <small>'+key.slice(0,12)+'</small></a>';}
function externalizePre(body,page){return body.replace(/<pre\b[^>]*>[\s\S]*?<\/pre>/gi,pre=>evidenceLink(pre,page));}
function copyAsset(source){source=posix(source);if(assets.has(source))return assets.get(source);const file='公共资源/原页/'+source.replace(/^docs\//,'');assets.set(source,file);const b=input(source);write(file,b);return file;}
function href(value,source,page){if(!value||/^(?:data:|javascript:|mailto:|https?:|file:|plugin:)/i.test(value))return value;const clean=value.split(/[?#]/)[0],absolute=posix(path.normalize(path.join(path.dirname(source),decodeURI(clean))));if(/\.md$/i.test(clean)&&typeof webMap!=='undefined'){const mappedMd=webMap[absolute.replace(/^docs\//,'')];if(mappedMd)return href(mappedMd+value.slice(clean.length),'docs/index.html',page);}const mapped=routeFor(value,source);if(mapped)return relative(page,mapped.split('#')[0])+(value.includes('?')?'?'+value.split('?')[1].split('#')[0]:'')+(mapped.includes('#')?'#'+mapped.split('#').slice(1).join('#'):'');if(value.startsWith('#'))return value;if(absolute.startsWith('docs/architecture-recovery/')&&fs.existsSync(path.join(root,absolute))&&fs.statSync(path.join(root,absolute)).isFile()){const copied=copyAsset(absolute);return relative(page,copied)+value.slice(clean.length);}externalLinks.add(value);return relative(page,'../'+absolute.replace(/^docs\//,''))+value.slice(clean.length);}
function rewriteAttributes(body,source,page){return body.replace(/\b(href|src)=(['"])([^'"<>]*)\2/gi,(all,key,q,value)=>key+'='+q+esc(href(value.replaceAll('&amp;','&'),source,page))+q);}
function shell(file,title,body,options={}){const pre=prefix(file),kind=options.kind||'topic',siteNav='<a href="'+pre+'index.html">首页／界面入口</a><a href="'+pre+'主题/主界面入口.html">主界面</a><a href="'+pre+'工具/index.html">工具窗口</a><a href="'+pre+'数据/index.html">数据与 Owner</a><a href="'+pre+'主题/执行与状态.html">执行与结果</a><a href="'+pre+'清单/交付与兼容.html">范围／兼容</a>';pages.push({path:file,title,kind});return '<!doctype html><html lang="zh-CN" data-site-prefix="'+pre+'" data-page-kind="'+kind+'"'+(options.routeHost?' data-route-host="true"':'')+'><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+esc(title)+' · 架构逆向与实现对照文档</title>'+ (options.head||'')+'<link rel="stylesheet" href="'+pre+'公共资源/site.css"></head><body><a class="site-skip" href="#main-content">跳到正文</a><header class="site-header"><nav aria-label="主导航">'+siteNav+'</nav><p class="breadcrumb">架构逆向与实现对照文档 / '+esc(title)+'</p><h1>'+esc(title)+'</h1><p class="muted">原版事实、当前独立实现、拟议设计与未知分别保留。导航示意属于文档组织，不代表原程序的控件树或完整运行验证。</p><p id="route-message" role="status" hidden></p></header><main id="main-content" class="site-main">'+body+'</main><footer class="site-footer"><nav>'+siteNav+'</nav><p class="site-progress">文档分页不增加产品实施完成数。主框架口径：41/96＝42.71%；本批实施增量 0。</p></footer>'+(options.scripts||'')+'<script src="'+pre+'公共资源/routes.js"></script><script src="'+pre+'公共资源/site.js"></script></body></html>';}
const main=snapshot(origin),oldFiles=fs.readdirSync(path.join(root,sourceDir),{recursive:true}).filter(f=>f.endsWith('.html')).map(posix).sort();
const imported=oldFiles.map(name=>({source:sourceDir+'/'+name,dest:'专题/'+name}));for(const p of imported)register(p.source.replace(/^docs\//,''),p.dest);
const topics=[['overview','主题/全景架构.html','全景架构'],['routes','主题/主界面入口.html','主界面入口'],['data-design','数据/index.html','数据类型与数据流'],['execution','主题/执行与状态.html','执行与状态'],['domains','主题/领域索引.html','领域索引'],['method','主题/范围与证据.html','范围与证据']];
for(const [id,dest]of topics)register('framework-architecture.html#'+id,dest);register('framework-architecture.html','index.html');
function captureClient(p){const s=input(p).toString();assert(s.includes('(function client(model){'));const context={};vm.runInNewContext(s.replace('(function client(model){','(function client(model){capturedModel=model;return;'),context,{timeout:2000});assert(context.capturedModel);return context.capturedModel;}
const ui=extractModel(sourceDir+'/ui-entry-navigation.js','const model='),tool=captureClient(sourceDir+'/tool-map-inline.js'),data=captureClient(sourceDir+'/data-design-tab.js'),execution=JSON.parse(input(sourceDir+'/execution-architecture-evidence.json'));
const menu=extractModel(sourceDir+'/menu-map-inline.js','window.__menuMapModel='),entryPages=new Map(),toolPages=new Map();
const webMap=extractModel(sourceDir+'/document-web-links.js','map=');for(const [md,html]of Object.entries(webMap))if(routes[html])register(md,routes[html]);
for(const e of ui.entries){const dest='入口/'+slug(e.id)+'.html';entryPages.set(e.id,dest);register('framework-architecture.html#entry/'+e.id,dest);}
for(const t of tool.tools){const key=t.key||t.id, dest='工具/'+slug(key)+'-'+sha(key).slice(0,8)+'.html';toolPages.set(key,dest);register('framework-architecture.html#tool/'+key,dest);if(t.anchor)register('architecture-recovery/tool-plugin-map.html#'+t.anchor,dest);}
const chapterNames={'parameter-pipeline':'参数：定义、绑定与运行快照','image-pipeline':'图像：来源、处理、显示与释放','retirement-operation-map':'图像回收：操作与最后读者','nonimage-pipeline':'模块结果与普通数据','group-data-pipeline':'Group 与自研子程序的数据边界','configuration-data-pipeline':'工具参数编辑与提交','global-variable-analysis':'全局变量：同流程、跨流程与停止','domain-data-obligations':'23 领域的数据责任'};
const chapters=Object.entries(chapterNames).map(([id,title])=>({id,title,dest:'数据/'+id+'.html',...section(main,id)}));
for(const c of chapters){let html=c.html;for(const child of chapters.filter(x=>x.start>c.start&&x.end<c.end))html=html.replace(child.html,'');c.standalone=html;register('framework-architecture.html#data-design/'+c.id,c.dest);for(const m of html.matchAll(/\bid="([^"]+)"/g))register('framework-architecture.html#'+m[1],c.dest+'#'+m[1]);for(const m of html.matchAll(/\bdata-[\w-]*fact="([^"]+)"/g))register('framework-architecture.html#data-design/'+c.id+'/'+m[1],c.dest+'#'+m[1]);}
for(const c of chapters)for(const m of c.standalone.matchAll(/\bdata-[\w-]*fact="([^"]+)"/g)){const key='framework-architecture.html#data-design/fact/'+m[1];if(!routes[key])register(key,c.dest+'#'+m[1]);}
const domainChapter=chapters.find(c=>c.id==='domain-data-obligations');for(const id of data.dataDomainIds||[])register('framework-architecture.html#data-design/domain/'+id,domainChapter.dest+'#'+id);
const globalPage=chapters.find(c=>c.id==='global-variable-analysis').dest;register('framework-architecture.html#data-design/global-variable-execution',globalPage+'#global-variable-execution');
for(const m of section(main,'global-variable-analysis').html.matchAll(/data-global-execution-fact="([^"]+)"/g))register('framework-architecture.html#data-design/global-variable-execution/'+m[1],globalPage+'#'+m[1]);
for(const p of imported){const html=snapshot(p.source);p.html=html;for(const m of html.matchAll(/\bid="([^"]+)"/g))register(p.source.replace(/^docs\//,'')+'#'+m[1],p.dest+'#'+m[1]);const edgePath=p.source.replace(/\.html$/,'.edges.json');if(fs.existsSync(path.join(root,edgePath))){const model=JSON.parse(input(edgePath));for(const e of model.edges||[])register(p.source.replace(/^docs\//,'')+'#edge-'+e.id,p.dest+'#edge-'+e.id);}}
const labels={id:'编号',title:'标题',label:'名称',classification:'事实分类',program:'程序侧',behavior:'已记录行为',meaning:'含义与边界',condition:'成立条件',from:'来源',to:'去向',refs:'源码证据',limits:'限制',unknowns:'待分析项',verification:'验证范围',fields:'字段',representation:'载体与复制',cache:'缓存与失效',release:'释放边界',current:'当前独立实现',original:'原版',operations:'入口操作',stages:'分析环节',algorithmComparison:'算法对照',declarations:'声明与资源',currentImplementationEvidence:'当前实现证据',sections:'分层说明',sourcePath:'来源路径',lifecycle:'生命周期',owner:'持有者',proposed:'拟议设计',question:'需要回答的问题',priority:'优先级'};
function anchor(x,fallback){return String(x?.id||x?.key||fallback||'');}
function record(value,page,label='完整记录',depth=0){
 if(value===null)return '<span class="muted">null（原记录保留）</span>';if(typeof value!=='object'){const s=String(value);if(/^(excerpt|ilBytes|pseudocode|assembly|raw)$/i.test(label)||s.length>2400)return evidenceLink('<pre class="site-evidence">'+esc(s)+'</pre>',page,'record-value');if(/^[^\s<>]+\.html(?:[?#][^\s<>]*)?$/.test(s)&&!(/^[A-Za-z]:[\\/]/.test(s))&&s.length<500)return '<a href="'+esc(href(s,sourceDir+'/index.html',page))+'">'+esc(s)+'</a>';return '<span>'+esc(s)+'</span>';}
 if(Array.isArray(value))return value.length?value.map((x,i)=>record(x,page,(typeof x==='object'&&x&&(x.title||x.label||x.name||x.id))||label+' '+(i+1),depth+1)).join(''):'<span class="muted">空列表（原记录保留）</span>';
 const id=anchor(value),heading=value.title||value.label||value.displayName||value.member||value.name||value.id||label,classification=value.classification||value.status||'',meta=value.sha256?' · SHA256 '+value.sha256:'';
 return '<details class="record"'+(id?' id="'+esc(id)+'" data-fact-id="'+esc(id)+'"':'')+(depth<1?' open':'')+'><summary>'+esc(heading)+(classification?' · '+esc(classification):'')+'</summary>'+ (meta?'<p class="muted">'+esc(meta)+'</p>':'')+'<dl>'+Object.entries(value).map(([k,v])=>'<dt>'+esc(labels[k]||k)+'</dt><dd>'+record(v,page,k,depth+1)+'</dd>').join('')+'</dl></details>';
}
function recordPage(file,title,value,lead='',diagram=''){const machine='清单/条目/'+sha(file).slice(0,20)+'.json';write(machine,JSON.stringify(value,null,2)+'\n');write(file,shell(file,title,lead+diagram+record(value,file)+'<p><a href="'+relative(file,machine)+'">本页完整机器记录（原字段保留）</a></p>'));}
function lines(s,max=28){const text=String(s||''),out=[];for(let i=0;i<text.length;i+=max)out.push(text.slice(i,i+max));return out.slice(0,3);}
function graph(rows,file,title){rows=rows.filter(r=>r&&typeof r.from==='string'&&typeof r.to==='string');if(!rows.length)return '';const selected=rows.slice(0,28),height=selected.length*132+40;
 const text=(value,x,y)=>'<text x="'+x+'" y="'+y+'">'+lines(value).map((line,i)=>'<tspan x="'+x+'" dy="'+(i?'20':'0')+'">'+esc(line)+'</tspan>').join('')+'</text>';
 const svg=selected.map((r,i)=>{const y=i*132+18,id=anchor(r,'edge-'+i),cl=['source-confirmed','independent-implementation'].includes(r.classification)?r.classification:'unknown';relationships.push({page:file,id,from:r.from,to:r.to,classification:r.classification||'unknown',condition:r.condition||null});return '<g class="'+cl+'"><a href="#'+esc(id)+'" tabindex="0" aria-label="'+esc(id+' '+r.from+' 到 '+r.to)+'"><title>'+esc(r.from+' → '+r.to+'；'+(r.condition||r.behavior||''))+'</title><rect x="12" y="'+y+'" width="290" height="94" rx="9"/>'+text(r.from,26,y+26)+'<line x1="312" y1="'+(y+48)+'" x2="516" y2="'+(y+48)+'" marker-end="url(#arr)"/>'+text(id+' · '+cl,316,y+16)+'<rect x="526" y="'+y+'" width="350" height="94" rx="9"/>'+text(r.to,540,y+26)+'</a></g>';}).join('');
 return '<h2>'+esc(title)+'</h2><p class="muted">每行是一条已有事实关系；行序不表示执行先后。点击关系展开原文与来源。'+(rows.length>28?'首图显示 28 条，下方完整保留 '+rows.length+' 条。':'')+'</p><div class="relation-legend"><span>蓝：原版源码事实</span><span>绿：当前独立实现</span><span>虚线：未知或尚未分类</span></div><div class="relation-scroll"><svg class="relation-svg" role="img" aria-label="'+esc(title)+'" viewBox="0 0 890 '+height+'"><defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#8eb6d0"/></marker></defs>'+svg+'</svg></div>';
}
function allFacts(x,result=[]){if(Array.isArray(x))x.forEach(v=>allFacts(v,result));else if(x&&typeof x==='object'){if(typeof x.from==='string'&&typeof x.to==='string')result.push(x);else Object.values(x).forEach(v=>allFacts(v,result));}return result;}
function list(items){return '<div class="site-link-grid">'+items.map(x=>'<a href="'+esc(x.href)+'">'+esc(x.label)+'</a>').join('')+'</div>';}
for(const e of ui.entries){const file=entryPages.get(e.id),facts=(ui.deepData.entryFacts[e.id]||[]).map(id=>ui.deepData.facts.find(f=>f.id===id)).filter(Boolean),tracks=(e.lifecycleTracks||[]).map(id=>ui.lifecycle.tracks.find(t=>t.id===id)).filter(Boolean),scoped={entry:e,operationBinding:ui.operationBindings[e.id]||null,dataFacts:facts,lifecycleTracks:tracks,lifecycleFacts:ui.lifecycle.facts.filter(f=>tracks.some(t=>t.factIds.includes(f.id)))};recordPage(file,e.label,scoped,'<p class="site-notice">从主界面位置进入本页，下面依次保留入口操作、数据关系、缓存／释放和源码证据。入口完整性尚未证明。</p>',graph([...e.operations,...facts],file,'入口与数据关系'));
}
for(const t of tool.tools){const key=t.key||t.id,file=toolPages.get(key),summary='<div class="matrix"><article><h2>原版入口与证据</h2><p>'+esc(t.plugin||key)+'</p><p>工具项声明：'+esc(t.originalToolItem?.present?'已登记':'未确认')+'。具体行为以逐项原文为准。</p></article><article><h2>当前实现与差异</h2><p>'+esc(t.currentCatalog?.meaning||'当前目录登记不作为运行完成证明。')+'</p><p>分析优先级：'+esc(t.analysisPriority?.level||'原记录未指定')+'</p></article></div>'+list((t.stages||[]).map(s=>({label:s.label+' · '+s.statusLabel,href:'#'+s.id})));recordPage(file,(t.displayName||t.plugin||key)+' · 工具对照',t,'<p class="site-notice">工具分类：'+esc(t.categoryLabel||t.category)+'。原版已证、当前映射、实际实现与待分析按原记录分列；未恢复内容不补为设计事实。</p>'+summary,graph(allFacts(t),file,'本工具已有调用／传递关系'));}
recordPage('入口/菜单与工具栏.html','菜单栏与工具栏：声明、入口和差异',menu,'<p class="site-notice">完整保留现有声明与来源。声明存在不等于每种状态下都可点击；资源变体和未知保持原分类。</p>');
for(const c of chapters){let html=c.html;for(const other of chapters.filter(x=>x.id!==c.id&&x.start>c.start&&x.end<c.end))html=html.replace(other.html,'<p class="site-notice">该分支已独立分页：<a href="'+relative(c.dest,other.dest)+'">'+esc(other.title)+'</a></p>');html=html.replace(/\bdata-([\w-]*fact)="([^"]+)"/g,(all,key,id)=>all+' id="'+id+'"');html=externalizePre(html,c.dest);html=rewriteAttributes(html,origin,c.dest);const styles=[...main.matchAll(/<style\b[^>]*>([\s\S]*?)<\/style>/g)].map(m=>{const file='公共资源/样式/'+sha(m[1])+'.css';write(file,m[1]);return '<link rel="stylesheet" href="'+relative(c.dest,file)+'">';}).join('');write(c.dest,shell(c.dest,c.title,'<p class="site-notice">本页正文与分类来自拆分前页面。长原文已迁移到内容寻址证据页，原始 SHA 和返回路径仍保留。</p><div class="source-content">'+html+'</div>',{head:styles}));}
const dataIndex='数据/index.html';for(const s of data.steps)register('framework-architecture.html#data-design/'+s.id,dataIndex+'#'+s.id);recordPage(dataIndex,'数据类型与数据流：从输入到最后读者',{steps:data.steps,typeDesign:data.typeDesign,structures:data.structures,chains:data.chains,lifecycle:data.lifecycle,organization:data.organization},'<p class="site-notice">先按阅读顺序定位：参数与图像输入 → 工具处理 → 模块结果 → 显示／历史 → 替换与回收。此顺序属于讲解组织，具体条件以各页事实为准。</p>'+list(chapters.map(c=>({label:c.title,href:relative(dataIndex,c.dest)}))),graph(data.lifecycle.facts,dataIndex,'已证的数据传递、缓存与释放关系'));
let outerData=section(main,'data-design').html;for(const c of chapters)outerData=outerData.replace(c.html,'<p class="site-notice"><a href="'+relative('数据/原页补充说明.html',c.dest)+'">独立分页：'+esc(c.title)+'</a></p>');outerData=outerData.replace(/\s+hidden(?:="[^"]*")?/g,'').replace(/<button([^>]*data-data-step="([^"]+)"[^>]*)>([\s\S]*?)<\/button>/g,(_,attrs,id,label)=>'<a href="index.html#'+id+'">'+label+'</a>');for(const m of outerData.matchAll(/\bid="([^"]+)"/g)){const key='framework-architecture.html#'+m[1];if(!routes[key])register(key,'数据/原页补充说明.html#'+m[1]);}write('数据/原页补充说明.html',shell('数据/原页补充说明.html','原数据页：类型、例示与其余完整说明','<p class="site-notice">保留原数据页除已独立分页章节以外的全部静态说明与证据。原文分支同时展开用于阅读，示意不作为运行验证。</p><div class="source-content">'+rewriteAttributes(externalizePre(outerData,'数据/原页补充说明.html'),origin,'数据/原页补充说明.html')+'</div>'));
for(const chain of execution.chains){const file='执行/'+slug(chain.id)+'.html';register('framework-architecture.html#execution/'+chain.id,file);recordPage(file,chain.title,chain,'<p class="site-notice">原版与当前实现逐入口对齐，保留条件和未闭合边；下图不把不同程序的关系拼成同一调用栈。</p>',graph([...(chain.original||[]),...(chain.current||[])],file,'原版／当前执行关系'));}
recordPage('主题/执行与状态.html','执行、状态与后台回流',execution,'<p class="site-notice">按实际场景进入：启动、单次／连续、完成事件、停止与收尾。运行模式仍按原授权保留待分析。</p>'+list(execution.chains.map(c=>({label:c.title,href:'../执行/'+slug(c.id)+'.html'}))));
const cards=ui.entries.map(e=>({label:e.label,href:'../'+entryPages.get(e.id)}));
write('主题/主界面入口.html',shell('主题/主界面入口.html','主界面：从控件到分析链','<p class="site-notice">已登记入口直接打开单项说明。菜单／工具栏另有完整声明页；本图不声明入口已经穷尽。</p><p><a href="../入口/菜单与工具栏.html">菜单栏与工具栏完整声明 ↗</a></p>'+list(cards)));
const overview=section(main,'overview').html,nMatch=main.match(/const N=(\{[\s\S]*?\n\});/),architectureNodes=nMatch?vm.runInNewContext('('+nMatch[1]+')',{}, {timeout:1000}):{};
function activateButtons(html,file){return html.replace(/<button([^>]*\bdata-map-entry="([^"]+)"[^>]*)>([\s\S]*?)<\/button>/gi,(_,attrs,id,label)=>'<a class="wregion" href="'+relative(file,entryPages.get(id)||'主题/主界面入口.html')+'">'+label+'</a>').replace(/<button([^>]*\bdata-node="([^"]+)"[^>]*)>([\s\S]*?)<\/button>/gi,(_,attrs,id,label)=>'<a class="node" href="#'+esc(id)+'">'+label+'</a>');}
for(const [id,file,title]of topics.filter(t=>['overview','domains','method'].includes(t[0]))){let body=activateButtons(section(main,id).html,file);if(id==='overview')body+='<h2>架构节点：原版、当前及未知</h2>'+Object.entries(architectureNodes).map(([key,value])=>record({id:key,...value},file)).join('');if(id==='domains'){const coverage=JSON.parse(input(sourceDir+'/coverage.json'));body+=record(coverage.domains,file,'领域与已有视图');}const styles=[...main.matchAll(/<style\b[^>]*>([\s\S]*?)<\/style>/g)].slice(0,1).map(m=>{const f='公共资源/样式/'+sha(m[1])+'.css';write(f,m[1]);return '<link rel="stylesheet" href="'+relative(file,f)+'">';}).join('');write(file,shell(file,title,'<div class="source-content">'+rewriteAttributes(externalizePre(body,file),origin,file)+'</div>',{head:styles}));}
for(const [id,file]of topics.filter(t=>t[0]!=='data-design'))for(const m of section(main,id).html.matchAll(/\bid="([^"]+)"/g)){const key='framework-architecture.html#'+m[1];if(!routes[key])register(key,file+'#'+m[1]);}
register('framework-architecture.html#delivery-status','清单/交付与兼容.html#delivery-status');
let outerMain=/<body\b[^>]*>([\s\S]*?)<\/body>/i.exec(main)[1].replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi,'');for(const [id]of topics)outerMain=outerMain.replace(section(main,id).html,'');outerMain=outerMain.replace(section(main,'delivery-status').html,'').replace(/<\/?main\b[^>]*>/gi,'').replace(/<button[^>]*data-tab="([^"]+)"[^>]*>([\s\S]*?)<\/button>/gi,(_,id,label)=>'<a href="'+relative('清单/原主页面说明.html',topics.find(t=>t[0]===id)?.[1]||'index.html')+'">'+label+'</a>');write('清单/原主页面说明.html',shell('清单/原主页面说明.html','拆分前主页面的其余完整说明','<p class="site-notice">保留拆分前主页面在各主题之外的标题、统计、提示和页脚；主题正文已独立分页。数字与判断属于所捕获版本，不因分页升级为运行验证。</p><div class="source-content">'+rewriteAttributes(externalizePre(outerMain,'清单/原主页面说明.html'),origin,'清单/原主页面说明.html')+'</div>'));
// Existing standalone pages keep their own finite graph models and behavior. The
// original HTML bytes are separately frozen; code and CSS become shared assets.
for(const p of imported){let html=p.html,scripts='',head='';html=html.replace(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi,(all,attrs,code)=>{const src=/\bsrc=['"]([^'"]+)['"]/.exec(attrs);if(src){scripts+='<script'+rewriteAttributes(attrs,p.source,p.dest)+'></script>';return '';}if(/type=['"]application\/json/.test(attrs))return all;if(code.trim()){const f='公共资源/脚本/'+sha(code)+'.js';write(f,code);scripts+='<script src="'+relative(p.dest,f)+'"></script>';}return '';});html=html.replace(/<style\b[^>]*>([\s\S]*?)<\/style>/gi,(all,css)=>{const f='公共资源/样式/'+sha(css)+'.css';write(f,css);head+='<link rel="stylesheet" href="'+relative(p.dest,f)+'">';return '';});for(const m of html.matchAll(/<link\b[^>]*rel=['"]stylesheet['"][^>]*>/gi))head+=rewriteAttributes(m[0],p.source,p.dest);const body=/<body\b[^>]*>([\s\S]*?)<\/body>/i.exec(html)?.[1]||html.replace(/<!doctype[^>]*>|<\/?html[^>]*>|<head>[\s\S]*?<\/head>/gi,'');const title=/<title>([\s\S]*?)<\/title>/i.exec(p.html)?.[1]||path.basename(p.source,'.html');write(p.dest,shell(p.dest,title,'<p class="site-notice">既有专题已纳入独立目录。保留原始分支、关系图、状态分类与完整证据；动态交互的浏览器验收另列。</p><div class="source-content">'+rewriteAttributes(externalizePre(body,p.dest),p.source,p.dest)+'</div>',{kind:'imported',head,scripts}));}
function toolPicker(file){return '<div class="tool-picker"><label>按分类选择<select data-tool-category><option value="">全部分类</option>'+tool.categories.map(c=>{const id=typeof c==='string'?c:c.id||c.key||c.category;return '<option value="'+esc(id)+'">'+esc(typeof c==='string'?c:c.label||c.name||id)+'</option>';}).join('')+'</select></label><label>搜索具体工具<input data-tool-search type="search" placeholder="工具名称、模块或编号"></label></div><p data-tool-counter class="site-counter"></p><ul class="site-list">'+tool.tools.map(t=>'<li data-tool-item data-category="'+esc(t.category)+'"><a href="'+relative(file,toolPages.get(t.key||t.id))+'">'+esc(t.displayName||t.plugin||t.key)+'</a><small class="muted"> · '+esc(t.categoryLabel||t.category)+'</small></li>').join('')+'</ul>';}
