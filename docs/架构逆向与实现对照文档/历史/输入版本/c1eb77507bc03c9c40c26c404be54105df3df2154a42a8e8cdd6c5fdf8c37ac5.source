for(const e of evidence.values())if(!outputs.has(e.path)){const back=[...new Set(e.backlinks)];write(e.path,shell(e.path,'原文证据 '+e.key.slice(0,12),'<p>内容寻址：SHA256 '+e.key+'；原始源码 SHA 仍以引用页记录为准。</p><div id="content">'+e.html+'</div><h2>返回引用位置</h2>'+list(back.map(p=>({label:pages.find(x=>x.path===p)?.title||p,href:relative(e.path,p)}))),{kind:'evidence'}));}
status.counts.pages=pages.length;status.counts.evidencePages=evidence.size;status.counts.evidenceOccurrences=occurrences.length;status.sourceDrift=drift;
write('清单/关系投影.json',JSON.stringify(relationships,null,2)+'\n');write('清单/证据保留.json',JSON.stringify({evidence:[...evidence.values()].map(({html,...e})=>e),occurrences},null,2)+'\n');write('清单/构建清单.json',JSON.stringify({...status,pages,outputs:[...outputs.values()]},null,2)+'\n');console.log(JSON.stringify({...status.counts,entrypoint:path.join(target,'index.html'),oldRootEntryReplaced:false}));
