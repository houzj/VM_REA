          "excerpt": "\tprivate void AddConnections(IEnumerable newValue)\n\t{\n\t\tif (ConnectionPanel == null)\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tforeach (object data in newValue)\n\t\t{\n\t\t\tConnection connection = new Connection(ItemDiagramPage);\n\t\t\tconnection.DataContext = new VmConnectionDecorator\n\t\t\t{\n\t\t\t\tConnectionSource = (DataContext as IDecorate).DecorateSource,\n\t\t\t\tDecorateSource = data\n\t\t\t};\n\t\t\tConnection connection2 = connection;\n\t\t\tconnection2.SourceItem = this;\n\t\t\tDiagramItem diagramItem = HostPanel.Children.OfType<DiagramItem>().FirstOrDefault((DiagramItem p) => (p.DataContext as IDecorate).DecorateSource == data);\n\t\t\tif (diagramItem != null)\n\t\t\t{\n\t\t\t\tconnection2.TargetItem = diagramItem;\n\t\t\t}\n\t\t\tConnectionPanel.Children.Add(connection2);\n\t\t}\n\t}\n",
