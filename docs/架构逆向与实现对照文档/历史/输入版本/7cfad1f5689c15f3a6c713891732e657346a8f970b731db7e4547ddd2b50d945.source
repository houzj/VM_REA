          "sha256": "cc185a2b2b8a30013b3914d6abf8fbe02f59ff0a590660f3a292d8dcfd2f25a7",
          "start": 252,
          "end": 278,
          "excerpt": "\tprivate static void OnPositionChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)\n\t{\n\t\tConnection connection = (Connection)d;\n\t\tif (connection.isInited && (e.Property == StartPositionProperty || e.Property == EndPositionProperty || e.Property == SourceIndexProperty || e.Property == TargetIndexProperty))\n\t\t{\n\t\t\tconnection.PathPoints = null;\n\t\t}\n\t\tif (connection.IsFocused && (e.Property == SourceIndexProperty || e.Property == TargetIndexProperty))\n\t\t{\n\t\t\tconnection.MidPoints.Clear();\n\t\t}\n\t\tconnection.SetPath();\n\t}\n\n\tprivate void SetPath()\n\t{\n\t\tif ((PathPoints == null || PathPoints.Count == 0) && SourceIndex >= 0 && TargetIndex >= 0 && SourceActualWidth != 0.0 && TargetActualWidth != 0.0)\n\t\t{\n\t\t\tSetPath(Page.GetPath(SourceItem, TargetItem, SourceIndex, TargetIndex));\n\t\t}\n\t}\n\n\tprivate static void PathPointsChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)\n\t{\n\t\t(d as Connection).OnPathPointsChanged();\n\t}\n",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "analysis/decompiled/VMControls.WPF/VMControls.WPF.Base/Connection.xaml.cs",
          "member": "Explicit point display",
          "sha256": "cc185a2b2b8a30013b3914d6abf8fbe02f59ff0a590660f3a292d8dcfd2f25a7",
          "start": 279,
          "end": 289,
          "excerpt": "\tprivate void OnPathPointsChanged()\n\t{\n\t\tif (PathPoints != null && PathPoints.Count > 0)\n\t\t{\n\t\t\tList<Point> list = PathPoints.ToList();\n\t\t\tPathFinder.Passivation(list);\n\t\t\tSetPath(list);\n\t\t\tOnIsSelectedChanged();\n\t\t\tisInited = true;\n\t\t}\n\t}",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        }
