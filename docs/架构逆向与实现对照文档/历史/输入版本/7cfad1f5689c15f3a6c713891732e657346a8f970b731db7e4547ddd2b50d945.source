          "member": "Current arrow geometry",
          "sha256": "5c9dc9be71f343d4c4ae4a497d6e20468c033bf83617231744d3c8c5a43a12eb",
          "start": 26,
          "end": 30,
          "excerpt": " static PointCollection OriginalWireArrow(IReadOnlyList<RoutePoint> points)\n {\n  var end=new Point(points[^1].X,points[^1].Y);var prior=points.Take(points.Count-1).LastOrDefault(p=>p!=points[^1]);var vector=new System.Windows.Vector(prior.X-end.X,prior.Y-end.Y);if(vector.Length==0)return new();vector.Normalize();\n  double angle=Math.Atan2(8,5)*180/Math.PI,length=Math.Sqrt(89);var center=end+6*vector;var matrix=new Matrix();matrix.Rotate(90);var first=center+5*vector*matrix;matrix.Rotate(180-angle);var second=first+length*vector*matrix;matrix.Rotate(2*angle);return new(){first,second,second+length*vector*matrix};\n }",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        }
