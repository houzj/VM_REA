          "excerpt": "          \"token\": \"0x06000ac0\",\n          \"symbol\": {\n            \"token\": \"0x06000ac0\",\n            \"kind\": \"method-def\",\n            \"type\": \"VMControls.WPF.Base.Connection\",\n            \"name\": \"SetPath\",\n            \"parameters\": 1,\n            \"attributes\": \"Public, HideBySig\",\n            \"signatureBytes\": \"20010115128221011180bd\"\n          },\n          \"status\": \"decoded\",\n          \"issue\": null,\n          \"ilSize\": 403,\n          \"ilSha256\": \"55c17c2dd1445e6556810795f9cb703218ceab9bfd311b155d2e7e6eeac16869\",\n          \"ilBytes\": \"\",\n          \"instructions\": [\n            {\n              \"offset\": 0,\n              \"label\": \"IL_0000\",\n              \"opcode\": \"nop\",",
          "evidenceType": "original-managed-cil",
          "binaryIdentity": "99ffa401c8784472913ad43813d68a8a5577890c00e149506e3e5664fa61c97d / MVID d144317f-3992-4275-9b0f-13fb6163e07d"
