          "start": 1125,
          "end": 1150,
          "excerpt": "  <ControlTemplate x:Key=\"NORMAL\" TargetType=\"{x:Type local:DiagramItem}\">\n    <Grid Name=\"PART_View\" Width=\"110\" Height=\"30\">\n      <Rectangle Name=\"Rec\" Fill=\"#00FFFFFF\" Margin=\"-10\" />\n      <Path Name=\"itemBorder\" Margin=\"0.2\" Style=\"{StaticResource NormalModulePathStyle}\">\n        <UIElement.Effect>\n          <DropShadowEffect Color=\"#FF121111\" ShadowDepth=\"3\" Opacity=\"0.45\" />\n        </UIElement.Effect>\n      </Path>\n      <Canvas Name=\"StateFlag\" Width=\"26\" HorizontalAlignment=\"Left\" Clip=\"{Binding Data, ElementName=itemBorder}\" />\n      <Image Name=\"LogoIm\" Stretch=\"None\" HorizontalAlignment=\"Left\" VerticalAlignment=\"Center\" Margin=\"4,0,0,0\" Source=\"{Binding StateImagePath}\" />\n      <Path Name=\"errorBorder\" Visibility=\"Collapsed\" Stroke=\"#FF636468\" StrokeThickness=\"2\" Stretch=\"Fill\" Data=\"{Binding Data, ElementName=itemBorder}\" />\n      <Grid Margin=\"26,0,0,0\">\n        <Grid HorizontalAlignment=\"Center\" TextBlock.FontWeight=\"Bold\" TextBlock.FontSize=\"12\" TextBlock.Foreground=\"{Color:ColorResourceBinding Col_EditProcess_Foreground}\">\n          <Grid.ColumnDefinitions>\n            <ColumnDefinition Width=\"Auto\" />\n            <ColumnDefinition Width=\"*\" />\n          </Grid.ColumnDefinitions>\n          <TextBlock Name=\"Id\" VerticalAlignment=\"Center\" IsHitTestVisible=\"False\" Text=\"{Binding DecorateSource.ID}\" />\n          <appUi:HeadReNameTextBox Name=\"itemName\" Grid.Column=\"1\" Background=\"#00FFFFFF\" FontWeight=\"Bold\" FontSize=\"12\" VerticalAlignment=\"Center\" BorderThickness=\"0\" MaxLength=\"{x:Static local:DiagramItem.MaxNameLenth}\" Foreground=\"{Color:ColorResourceBinding Col_EditProcess_Foreground}\" Text=\"{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}\" IsReName=\"{Binding IsReName, Mode=TwoWay}\" />\n        </Grid>\n      </Grid>\n      <ContentPresenter Name=\"leftConnector\" Content=\"{x:Null}\" />\n      <ContentPresenter Name=\"rightConnector\" Content=\"{x:Null}\" />\n      <ContentPresenter Name=\"topConnector\" Content=\"{x:Null}\" />\n      <ContentPresenter Name=\"bottomConnector\" Content=\"{x:Null}\" />\n    </Grid>",
          "evidenceType": "local-extracted-resource",
          "binaryIdentity": "not revalidated in this slice"
        },
