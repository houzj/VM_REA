          "excerpt": "  <Style x:Key=\"{x:Type local:Connection}\" TargetType=\"{x:Type local:Connection}\">\n    <Setter Property=\"Stroke\" Value=\"{DynamicResource Col_EditProcess_Ligature}\" />\n    <Setter Property=\"Fill\" Value=\"{Binding Path=Stroke, RelativeSource={RelativeSource Mode=Self}}\" />\n    <Setter Property=\"StrokeThickness\" Value=\"2\" />\n    <Setter Property=\"FrameworkElement.ContextMenu\">\n      <Setter.Value>\n        <controls:HikContextMenu>\n          <MenuItem Header=\"{DynamicResource Lang_Delet}\" Command=\"{Binding DeleteConnectionCommand}\" />\n        </controls:HikContextMenu>\n      </Setter.Value>\n    </Setter>\n    <Style.Triggers>\n      <Trigger Property=\"UIElement.IsFocused\" Value=\"True\">\n        <Setter Property=\"Stroke\" Value=\"{DynamicResource Col_EditProcess_Selected_Ligature}\" />\n      </Trigger>\n      <DataTrigger Value=\"true\" Binding=\"{Binding SourceItem.IsFocused, RelativeSource={RelativeSource Self}}\">\n        <Setter Property=\"Stroke\" Value=\"{DynamicResource Col_EditProcess_Selected_Ligature}\" />\n      </DataTrigger>\n      <DataTrigger Value=\"true\" Binding=\"{Binding TargetItem.IsFocused, RelativeSource={RelativeSource Self}}\">\n        <Setter Property=\"Stroke\" Value=\"{DynamicResource Col_EditProcess_Selected_Ligature}\" />\n      </DataTrigger>\n      <DataTrigger Value=\"True\" Binding=\"{Binding IsLockWorkArea, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ItemsPage}}\">\n        <Setter Property=\"IsEnabled\" Value=\"False\" />\n      </DataTrigger>\n      <DataTrigger Value=\"False\" Binding=\"{Binding IsAdmin, Source={x:Static user:CodeManager.Instance}}\">\n        <Setter Property=\"IsEnabled\" Value=\"False\" />\n      </DataTrigger>\n      <Trigger Property=\"UIElement.IsMouseOver\" Value=\"True\">\n        <Setter Property=\"StrokeThickness\" Value=\"3\" />\n      </Trigger>\n      <Trigger Property=\"local:Connection.IsDragOver\" Value=\"True\">\n  