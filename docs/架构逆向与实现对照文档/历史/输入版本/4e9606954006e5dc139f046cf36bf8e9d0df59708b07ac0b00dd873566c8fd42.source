        {
          "path": "analysis/decompiled/VMControls.WPF/VMControls.WPF.GlobalUI/GlobalVariableDialog.xaml.cs",
          "member": "Local import choice, confirmation and unused length",
          "sha256": "1c094b64a96a507586386affe364c9589a7feb889b25a0e2818a7b49dafb0296",
          "start": 1578,
          "end": 1611,
          "excerpt": "\tprivate void BtnImport_Click(object sender, RoutedEventArgs e)\n\t{\n\t\ttry\n\t\t{\n\t\t\tif (DecorateSource == null)\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (!RemoteOperate.IsRemoteMode)\n\t\t\t{\n\t\t\t\tMicrosoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog();\n\t\t\t\topenFileDialog.CheckFileExists = true;\n\t\t\t\topenFileDialog.CheckPathExists = true;\n\t\t\t\topenFileDialog.Filter = \"*.gvar|*.gvar\";\n\t\t\t\tbool? flag = openFileDialog.ShowDialog();\n\t\t\t\tstring fileName = openFileDialog.FileName;\n\t\t\t\tif (flag.Value && (Items.Count <= 0 || HikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_ImportSure\"), AppLocalizationService.GetLang(\"Lang_ImportEmpty\"), MessageButtons.YesOrNo, MessageIcons.Question) == VM.Controls.DialogResult.Yes))\n\t\t\t\t{\n\t\t\t\t\tlong length = new FileInfo(fileName).Length;\n\t\t\t\t\tProcessbarMessage = AppLocalizationService.GetLang(\"Lang_Import\");\n\t\t\t\t\tIsShowProcessbar = \"Visible\";\n\t\t\t\t\tImportGlobalVar(fileName);\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tPopImport.IsOpen = true;\n\t\t\t}\n\t\t}\n\t\tcatch (Exception ex)\n\t\t{\n\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_LoadFail\"));\n\t\t\tLogHelper.objLog.Error(\"全局变量导入失败，ex:\" + ex.ToString());\n\t\t}",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        }
      ],
