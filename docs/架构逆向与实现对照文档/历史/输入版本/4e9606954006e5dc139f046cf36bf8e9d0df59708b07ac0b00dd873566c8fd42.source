          "excerpt": "\tpublic static VarRunParamInfo[] GetLinkModuleInfoByRunParams(List<RunParamsBaseNode> SelectedRunParams)\n\t{\n\t\tif (SelectedRunParams != null && SelectedRunParams.Count > 0)\n\t\t{\n\t\t\tVarRunParamInfo[] array = new VarRunParamInfo[SelectedRunParams.Count];\n\t\t\tfor (int i = 0; i < SelectedRunParams.Count; i++)\n\t\t\t{\n\t\t\t\tVarRunParamInfo varRunParamInfo = new VarRunParamInfo();\n\t\t\t\tvarRunParamInfo.nModuleID = (int)SelectedRunParams[i].ModuleID.Value;\n\t\t\t\tvarRunParamInfo.Name = SelectedRunParams[i].Name;\n\t\t\t\tvarRunParamInfo.Type = SelectedRunParams[i].RunParamIoType;\n\t\t\t\tvarRunParamInfo.IsSupportSub = SelectedRunParams[i].IsSupportSub;\n\t\t\t\tvarRunParamInfo.Owner = SelectedRunParams[i].TargetObject;\n\t\t\t\tarray[i] = varRunParamInfo;\n\t\t\t}\n\t\t\treturn array;\n\t\t}\n\t\treturn null;\n\t}\n}\n",
