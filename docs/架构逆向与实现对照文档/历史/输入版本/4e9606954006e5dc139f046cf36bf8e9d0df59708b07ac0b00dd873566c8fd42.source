        {
          "path": "analysis/decompiled/VMControls.WPF/VMControls.WPF.GlobalUI/GlobalVariableDialog.xaml.cs",
          "member": "Original import task snapshot and delete callback",
          "sha256": "1c094b64a96a507586386affe364c9589a7feb889b25a0e2818a7b49dafb0296",
          "start": 1614,
          "end": 1650,
          "excerpt": "\tprivate async void ImportGlobalVar(string filePath)\n\t{\n\t\tint nRet = 0;\n\t\tTask importTask = Task.Factory.StartNew(() =>\n\t\t{\n\t\t\ttry\n\t\t\t{\n\t\t\t\tDictionary<string, VarRunParamInfo[]> varRunParamDict = new Dictionary<string, VarRunParamInfo[]>();\n\t\t\t\tDispatcher?.Invoke(() =>\n\t\t\t\t{\n\t\t\t\t\tforeach (GlobalVariableItem item in Items)\n\t\t\t\t\t{\n\t\t\t\t\t\tvarRunParamDict.Add(item.Name, GlobalVarExtern.GetLinkModuleInfoByRunParams(item.SelectedRunParams));\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\tvarManager.ImportVar(filePath, isFromUI: true, varRunParamDict, () =>\n\t\t\t\t{\n\t\t\t\t\tDispatcher?.Invoke(() =>\n\t\t\t\t\t{\n\t\t\t\t\t\tif (DecorateSource is VmModule vmModule)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor (int num = vmModule.Outputs.Count - 1; num >= 0; num--)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tvmModule.Outputs[num].Dispose();\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t}\n\t\t\tcatch (Exception ex)\n\t\t\t{\n\t\t\t\tDispatcher.Invoke(() =>\n\t\t\t\t{\n\t\t\t\t\tIsShowProcessbar = \"Collapsed\";\n\t\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_LoadFail\"), MessageIcons.Error);\n\t\t\t\t});\n\t\t\t\tLogHelper.objLog.Error(\"导入失败:\" + ex.ToString());",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
