          "start": 1713,
          "end": 1755,
          "excerpt": "\tprivate async void ExportGlobalVar(string filePath, string downLoadPath = \"\")\n\t{\n\t\tTask exportTask = Task.Factory.StartNew(() =>\n\t\t{\n\t\t\tint nRet = 0;\n\t\t\ttry\n\t\t\t{\n\t\t\t\tvarManager.ExportVar(filePath);\n\t\t\t}\n\t\t\tcatch (Exception ex)\n\t\t\t{\n\t\t\t\tDispatcher.Invoke(() =>\n\t\t\t\t{\n\t\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_ExportFailed\"), MessageIcons.Error);\n\t\t\t\t});\n\t\t\t\tLogHelper.objLog.Error(\"导出全局变量失败:\" + ex.ToString());\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (downLoadPath != \"\")\n\t\t\t{\n\t\t\t\tif (!ServerSDKAPI.FtpDownloadFile(CVmObjectBase.mhandle, downLoadPath, filePath, bCover: true) || !File.Exists(downLoadPath))\n\t\t\t\t{\n\t\t\t\t\tLogHelper.objLog.Error(\"Down load file error, local file path = \" + downLoadPath + \", remote file path = \" + filePath + \".\");\n\t\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"导出失败\"), MessageIcons.Error);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tServerSDKAPI.FtpRemoveFile(CVmObjectBase.mhandle, filePath);\n\t\t\t}\n\t\t\tstring msg = ((nRet == 0) ? \"Lang_ExportSuccess\" : \"导出失败\");\n\t\t\tDispatcher.Invoke(() =>\n\t\t\t{\n\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(msg), (nRet == 0) ? MessageIcons.Ok : MessageIcons.Error);\n\t\t\t});\n\t\t});\n\t\tawait exportTask;\n\t}\n\n\tprivate void Sv_ScrollChanged(object sender, ScrollChangedEventArgs e)\n\t{\n\t\tif (!CanScroll)\n\t\t{\n\t\t\tCanScroll = true;\n\t\t}",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "analysis/decompiled/VMControls.WPF/VMControls.WPF.GlobalUI/GlobalVariableDialog.xaml.cs",
