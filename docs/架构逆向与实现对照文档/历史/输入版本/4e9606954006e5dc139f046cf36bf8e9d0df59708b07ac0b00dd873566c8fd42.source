        {
          "path": "analysis/decompiled/VMControls.WPF/VMControls.WPF.GlobalUI/GlobalVariableDialog.xaml.cs",
          "member": "Export dialog admission",
          "sha256": "1c094b64a96a507586386affe364c9589a7feb889b25a0e2818a7b49dafb0296",
          "start": 1682,
          "end": 1710,
          "excerpt": "\tprivate void BtnExport_Click(object sender, RoutedEventArgs e)\n\t{\n\t\ttry\n\t\t{\n\t\t\tif (DecorateSource == null || Items.Count <= 0)\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (!RemoteOperate.IsRemoteMode)\n\t\t\t{\n\t\t\t\tMicrosoft.Win32.SaveFileDialog saveFileDialog = new Microsoft.Win32.SaveFileDialog();\n\t\t\t\tsaveFileDialog.Filter = \"*.gvar|*.gvar\";\n\t\t\t\tsaveFileDialog.FilterIndex = 1;\n\t\t\t\tsaveFileDialog.RestoreDirectory = true;\n\t\t\t\tif (saveFileDialog.ShowDialog() == true)\n\t\t\t\t{\n\t\t\t\t\tExportGlobalVar(saveFileDialog.FileName);\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tPopExport.IsOpen = true;\n\t\t\t}\n\t\t}\n\t\tcatch (Exception ex)\n\t\t{\n\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_ExportFailed\"));\n\t\t\tLogHelper.objLog.Error(\"全局变量导出失败，ex:\" + ex.ToString());\n\t\t}",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
