erRadius=\"4\" Padding=\"0,4,0,4\" Background=\"{DynamicResource GlobalBorderBg}\">\n                <UIElement.Effect>\n                  <DropShadowEffect Color=\"#1F0E01\" BlurRadius=\"4\" ShadowDepth=\"4\" Opacity=\"0.4\" />\n                </UIElement.Effect>\n                <StackPanel>\n                  <Button Content=\"{DynamicResource Local}\" Style=\"{StaticResource MyButtonStyle}\" Click=\"LocalExport_Click\" />\n                  <Button Content=\"{DynamicResource Remote}\" Style=\"{StaticResource MyButtonStyle}\" Click=\"RemoteExport_Click\" />\n                </StackPanel>",
