          "excerpt": "\tprivate void LocalImport_Click(object sender, RoutedEventArgs e)\n\t{\n\t\ttry\n\t\t{\n\t\t\tMicrosoft.Win32.OpenFileDialog openFileDialog = new Microsoft.Win32.OpenFileDialog();\n\t\t\topenFileDialog.CheckFileExists = true;\n\t\t\topenFileDialog.CheckPathExists = true;\n\t\t\topenFileDialog.Filter = \"*.gvar|*.gvar\";\n\t\t\tbool? flag = openFileDialog.ShowDialog();\n\t\t\tstring filePath = (flag.Value ? \"/root/vmtempfiles/ftp/ModelFiles/temp.gvar\" : \"\");\n\t\t\tif (flag.Value)\n\t\t\t{\n\t\t\t\tif (!ServerSDKAPI.FtpUploadFile(CVmObjectBase.mhandle, openFileDialog.FileName, \"/root/vmtempfiles/ftp/ModelFiles/temp.gvar\", bCreatDir: true, bCover: true))\n\t\t\t\t{\n\t\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_LoadFail\"));\n\t\t\t\t\tLogHelper.objLog.Error(\"Upload local file \" + openFileDialog.FileName + \" to remote path /root/vmtempfiles/ftp/ModelFiles/temp.gvar fail\");\n\t\t\t\t}\n\t\t\t\telse if (Items.Count <= 0 || HikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_ImportSure\"), AppLocalizationService.GetLang(\"Lang_ImportEmpty\"), MessageButtons.YesOrNo, MessageIcons.Question) == VM.Controls.DialogResult.Yes)\n\t\t\t\t{\n\t\t\t\t\tImportGlobalVar(filePath);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tcatch (Exception ex)\n\t\t{\n\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_LoadFail\"));\n\t\t\tLogHelper.objLog.Error(\"全局变量导入失败，ex:\" + ex.ToString());\n\t\t}\n\t}\n\n\tprivate void RemoteImport_Click(object sender, RoutedEventArgs e)",
