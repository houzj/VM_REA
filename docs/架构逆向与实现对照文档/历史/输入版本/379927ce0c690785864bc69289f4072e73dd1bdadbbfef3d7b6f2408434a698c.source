          "excerpt": "      <DataTemplate x:Key=\"TitleToolButtonDataTemplate\">\n        <Button Margin=\"4,0,4,0\" Height=\"36\" Width=\"36\" Command=\"{Binding ItemClickCommand}\" ToolTip=\"{Lang:ResourceBinding Name}\" Visibility=\"{Binding IsVisible, Converter={StaticResource boolToVisibilityCvt}}\">\n          <FrameworkElement.Style>\n            <Style TargetType=\"{x:Type Button}\" BasedOn=\"{StaticResource ToolBarButtonStyle}\">\n              <Style.Triggers>\n                <DataTrigger Value=\"True\" Binding=\"{Binding Path=RunData.(VMInterface:IVMRun.IsRunning)}\">\n                  <Setter Property=\"IsEnabled\" Value=\"False\" />\n                </DataTrigger>\n              </Style.Triggers>\n              <EventSetter Event=\"Click\" Handler=\"Button_Click\" />\n            </Style>\n          </FrameworkElement.Style>\n        </Button>\n      </DataTemplate>\n      <DataTemplate x:Key=\"customDataTemplate\">\n        <ContentPresenter Name=\"cp\" Content=\"{Binding}\">\n          <FrameworkElement.Style>\n            <Style TargetType=\"{x:Type ContentPresenter}\">\n              <Setter Property=\"ContentTemplate\" Value=\"{StaticResource TitleToolButtonDataTemplate}\" />\n              <Style.Triggers>\n                <DataTrigger Value=\"SingleRunTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource SingleRunTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"ContinousRunTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource ContinousRunTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"DownPopTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource DownPopTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"RedoTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource RedoTemplate}\" />\n                </DataTrigger>\n                <DataTrigger Value=\"LockingTemplate\" Binding=\"{Binding CustomItemTemplateName}\">\n                  <Setter Property=\"ContentTemplate\" Value=\"{StaticResource LockingTemplate}\" />\n                </DataTrigger>\n              </Style.Triggers>\n            </Style>\n          </FrameworkElement.Style>\n        </ContentPresenter>\n      </DataTemplate>\n    </ResourceDictionary>\n  </FrameworkElement.Resources>\n  <ItemsControl ItemsPanel=\"{StaticResource HorizontalItemsPanelTemplate}\" ItemTemplate=\"{StaticResource customDataTemplate}\" ItemsSource=\"{Binding Source={StaticResource src}}\">\n    <ItemsControl.GroupStyle>",
