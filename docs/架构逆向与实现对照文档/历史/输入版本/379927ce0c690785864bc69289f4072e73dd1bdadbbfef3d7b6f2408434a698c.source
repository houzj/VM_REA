  "findings": [
    {
      "id": "MU-L01",
      "chain": "controller-hidden-lifecycle",
      "classification": "source-confirmed",
      "classificationScope": "Only cited original CIL/metadata/resource or local decompiled statements; runtime activation and whole-chain closure remain separate.",
      "from": "四资源Lang_ControllerSet声明",
      "to": "默认隐藏差异 → 成功加载后动态可见",
      "behavior": "MenuItems/NeutralMenuItems的控制器项显式isVisible=false、isDisplayInMenu=false；Linux两资源的同名LightSet入口没有这两项字段。MainWindowData.VmSolution_LoadEnd仅在e!=null且ErrorCode==0的分支调用MenuSource.LoadOldLightMoudle。不能因默认隐藏或本轮没点击到就从菜单全集移除。",
      "refs": [
        {
          "path": "docs/architecture-recovery/menu-universe-next-MenuItems.xml",
