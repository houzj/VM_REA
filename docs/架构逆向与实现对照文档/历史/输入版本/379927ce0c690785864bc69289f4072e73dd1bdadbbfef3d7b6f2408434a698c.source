    {
      "id": "MU-L02",
      "chain": "controller-hidden-lifecycle",
      "classification": "source-confirmed",
      "classificationScope": "Only cited original CIL/metadata/resource or local decompiled statements; runtime activation and whole-chain closure remain separate.",
      "from": "LoadOldLightMoudle",
      "to": "模块14000 → Lang_System下Lang_ControllerSet → 两个显示字段",
      "behavior": "原方法先查询模块ID14000，在Items中取首个Name=Lang_System，再在其Items中取首个Name=Lang_ControllerSet，写静态ControllerSet。命中时IsVisible及IsDisplayInMenu均赋模块是否非null。父节点未找到时不清已有静态ControllerSet；不把本字段当每次都重新绑定到当前方案的保证。",
      "refs": [
        {
