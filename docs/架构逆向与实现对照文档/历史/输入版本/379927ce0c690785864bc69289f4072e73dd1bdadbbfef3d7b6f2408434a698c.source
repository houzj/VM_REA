          "end": 184,
          "excerpt": "\t\t\t\t\t<name>Lang_ControllerSet</name>\n\t\t\t\t\t<methodName>LightSet</methodName>\n                    <isVisible>false</isVisible>\n\t\t\t\t\t<isDisplayInMenu>false</isDisplayInMenu>\n\t\t\t\t\t<isShowExternal>true</isShowExternal>\n\t\t\t\t\t<toolGroupItemInfo>\n\t\t\t\t\t\t<groupName>group1</groupName>\n\t\t\t\t\t\t<priority>1</priority>\n\t\t\t\t\t</toolGroupItemInfo>",
          "evidenceType": "local-extracted-resource",
          "binaryIdentity": "not revalidated in this slice"
        },
