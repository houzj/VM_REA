_NODE_TREE_INFO.GetValueOrDefault();\n\t\t\tif (!iMVS_NODE_TREE_INFO.HasValue)\n\t\t\t{\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tfor (int i = 0; i \u003c valueOrDefault.nChildNodeNum; i++)\n\t\t\t{\n\t\t\t\tImvsSdkDefine.IMVS_MODULE_INFO proInfo = valueOrDefault.astChildNodeInfo[i];\n\t\t\t\ttry\n\t\t\t\t{\n\t\t\t\t\tbool flag = _preGenerateModules.ContainsKey(proInfo.nNodeID);\n\t\t\t\t\tVmModule vmModule = (flag ? _preGenerateModules[proInfo.nNodeID] : CreatModuleByInfo(proInfo));\n\t\t\t\t\tif (!flag)\n\t\t\t\t\t{\n\t\t\t\t\t\tvmModule.PreAddModuleTo(this);\n\t\t\t\t\t}\n\t\t\t\t\tvmModuleCollection.Add(vmModule);\n\t\t\t\t}\n\t\t\t\tcatch (Exception ex)\n\t\t\t\t{\n\t\t\t\t\tstring text = proInfo.nNodeID + \" \" + Hik.Util.StringUtil.UTF8GetString(proInfo.strDisplayName) + \", \" + ex.Message;\n\t\t\t\t\ttext = text + \"\\r\\n\" + ex.StackTrace;\n\t\t\t\t\tLogHelper.Error(\"Create module error: \" + text);\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (_preGenerateModules.Count > 0)\n\t\t\t{\n\t\t\t\t_preGenerateModules = new Dictionary\u003cuint, VmModule>();\n\t\t\t}\n\t\t\tif (!VmSolution.IsLoading && vmModuleCollection.Count > 0)\n\t\t\t{\n\t\t\t\tImvsSdkDefine.IMVS_REPORT_MODULE_STATUS_INFO_LIST? iMVS_REPORT_MODULE_STATUS_INFO_LIST = ServerSDKManager.serverSDKManager.mProcessManager.QueryModuleRunningState(vmModuleCollection.Select((VmModule p) => p.ID).ToArray());\n\t\t\t\tImvsSdkDefine.IMVS_REPORT_MODULE_STATUS_INFO_LIST? iMVS_REPORT_MODULE_STATUS_INFO_LIST2 = iMVS_REPORT_MODULE_STATUS_INFO_LIST;\n\t\t\t\tImvsSdkDefine.IMVS_REPORT_MODULE_STATUS_INFO_LIST valueOrDefault2 = iMVS_REPORT_MODULE_STATUS_INFO_LIST2.GetValueOrDefault();\n\t\t\t\tif (iMVS_REPORT_MODULE_STATUS_INFO_LIST2.HasValue)\n\t\t\t\t{\n\t\t\t\t\tImvsSdkDefine.IMVS_REPORT_MODULE_STATUS_INFO[] pstModuleStatuInfo = valueOrDefault2.pstModuleStatuInfo;\n\t\t\t\t\tfor (int num = 0; num \u003c valueOrDefault2.nNum; num++)\n\t\t\t\t\t{\n\t\t\t\t\t\tImvsSdkDefine.IMVS_REPORT_MODULE_STATUS_INFO moduleState = pstModuleStatuIn