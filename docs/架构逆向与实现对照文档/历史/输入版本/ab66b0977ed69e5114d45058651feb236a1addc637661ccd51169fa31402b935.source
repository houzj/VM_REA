	public object RunData
	{
		get
		{
			if (runData == null &amp;&amp; IsEnableByRun)
			{
				runData = VmSolution.Instance;
				VmSolution.RestoreDefaultDisplay += VmSolution_RestoreDefaultDisplay;
			}
			return runData;
		}
		set
		{
			if (runData != value &amp;&amp; IsEnableByRun)
			{
				runData = value;
				if (runData == null)
				{
					VmSolution.RestoreDefaultDisplay -= VmSolution_RestoreDefaultDisplay;
				}
				OnPropertyChanged(&quot;RunData&quot;);
			}
		}
	}

