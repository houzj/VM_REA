SHA256 ead2899adc43791594d39b72f3e2b4683e52c0b298f2239d782be2dd19755cd4
 void RequestWorkAreaLock()
 {
  if(isLocked){ToggleLock();return;}
  if(ShellLockPreference.Read()){ToggleLock();return;}
  var prompt=new ShellLockPrompt{Owner=this};
  bool accepted=prompt.ShowDialog()==true;
  ShellLockPreference.Write(prompt.SkipNextTime);
  if(accepted)ToggleLock();
 }</pre></details><details><summary>Current direct toggle and control updates · current-source</summary><pre>src/VisionEditor/MainWindow.xaml.cs:113–113
SHA256 034c0dae3e04a9b592031d87e1c1349c23b14091b04564c295267a97fcaa1b4a
 void ToggleLock(){isLocked=!isLocked;StatusText.Text=isLocked?&quot;工作区已锁定&quot;:&quot;工作区已解锁&quot;;AddProcedureButton.IsEnabled=!isLocked;Rail.IsEnabled=!isLocked;ToggleToolboxButton.IsEnabled=!isLocked;if(lockToolButton?.Content is Image image)image.Source=Asset(isLocked?&quot;toolbar_ic_topbar_unlock_normal.png&quot;:&quot;toolbar_ic_topbar_lock_normal.png&quot;);if(lockToolButton is not null)lockToolButton.ToolTip=isLocked?&quot;解锁工作区&quot;:&quot;锁定工作区&quot;;RefreshAll();}</pre></details><details><summary>Current independent control state gates · current-source</summary><pre>src/VisionEditor/WorkflowTabs.cs:145–154
