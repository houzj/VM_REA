SHA256 9d235d16f1e30caa64a4cb61cf83b482a93ac74c1577bf78650f47f4d7a1d3b4
	public bool IsEnabled
	{
		get
		{
			return isEnabled;
		}
		set
		{
			if (isEnabled != value)
			{
				isEnabled = value;
				OnPropertyChanged(&quot;IsEnabled&quot;);
			}
		}
	}

	public bool IsGroupData =&gt; isGroupData;
</pre></details><details><summary>Direct notification · local-decompiled-source</summary><pre>docs/architecture-recovery/menu-state-producers-audit.NotifyBaseNode.cs:20–23
SHA256 525f02e67019feb992d8d575e58e5724661e7adbda8bff07b08e4a21302a5a71
	public virtual void OnPropertyChanged(string name)
	{
		PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
	}</pre></details></article><article id="MS02" class="source-confirmed"><h2>MS02 · AreaLocking/AreaUnLocking → MainWindowData.IsWorkAreaLocking → 先改宿主锁字段 → IUnRedoService → Lang_ImportProcess.IsEnabled</h2><p>source-confirmed：AreaLocking在IsNotifyLock=false时显示LockDlg，保存其IsNotifyLock，DialogResult??false为true才设工作区锁true；已免提示则直接true；取消不会在该体主动置false。AreaUnLocking直接设false。IsWorkAreaLocking仅值变化才先写isWorkAreaLocking，再Ioc.Get&lt;IUnRedoService&gt;()?.SetLockStatus、LockProcess，最后通知IsWorkAreaLocking。LockProcess按Title.Items找Lang_File，再找Lang_ImportProcess，仅命中项IsEnabled=!isLock；不是所有菜单统一禁用。本地没有catch/回滚，前序异常可留下锁字段已改、导入项或最后通知未完成。</p><p>待追：根字段托管默认false；原实际锁状态、动态Items返回null、Ioc/通知异常与全部外部写入者尚未知，不能称锁状态与UI更新原子提交。</p><details><summary>VisionMaster.AppMainWindow.TitleMenueItemData::AreaLocking · original-managed-cil</summary><pre>docs/architecture-recovery/menu-state-producers-audit.cil.json:9117–9136
