	{
		get
		{
			return isDisplayInMenu;</pre></details><details><summary>Display restore field-reset order · local-decompiled-source</summary><pre>analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.AppMainWindow/TitleMenueItemData.cs:310–314
