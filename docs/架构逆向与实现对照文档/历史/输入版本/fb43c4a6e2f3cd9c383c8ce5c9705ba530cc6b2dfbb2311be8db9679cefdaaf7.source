.menu-map-tree{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}.menu-map-tree details{padding:8px;border:1px solid #38546b;border-radius:7px}.menu-map-tree details details{margin:8px 0}.menu-map-tree button,.menu-map-toolbar button{font:inherit;color:inherit;background:#1b3248;border:1px solid #52768f;padding:9px;border-radius:7px;cursor:pointer;text-align:left}.menu-map-tree button{display:block;margin:8px 0}.menu-map-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.menu-map-toolbar small{padding:0 5px;color:#9db8d0}[data-menu-map-host]{border:1px solid #46657b;border-radius:10px;padding:16px;margin:16px 0;overflow-wrap:anywhere}[data-menu-map-host] select{max-width:100%;font:inherit;background:#1b3248;color:inherit;padding:9px;border-radius:7px}