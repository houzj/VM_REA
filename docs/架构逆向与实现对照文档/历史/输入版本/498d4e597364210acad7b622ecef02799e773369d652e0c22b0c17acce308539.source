            &quot;parameters&quot;: 0,
            &quot;attributes&quot;: &quot;Public, Static, HideBySig&quot;,
            &quot;signatureBytes&quot;: &quot;000002&quot;
          },
          &quot;status&quot;: &quot;decoded&quot;,
          &quot;issue&quot;: null,
          &quot;ilSize&quot;: 30,
          &quot;ilSha256&quot;: &quot;bdace0d5aaf346e123db8b01d1f253b73a2d85b4c631dc790b4e92bbbeaca610&quot;,
          &quot;ilBytes&quot;: &quot;28aa02000a6fab02000a0a061a2e0d061c2e09062080000000fe012a172a&quot;,
          &quot;instructions&quot;: [
            {
              &quot;offset&quot;: 0,
              &quot;label&quot;: &quot;IL_0000&quot;,
              &quot;opcode&quot;: &quot;call&quot;,</pre></details><details><summary>OpenCvSharp.NativeMethods · 4922–4945</summary><p><code>docs/architecture-recovery/export-text-rendering-audit.resources/OpenCvSharp.NativeMethods.decompiled.cs · original-managed-offline-ilspy-decompilation · SHA e3d29507c7ac7c97f8f4b283df9f552107bc633d83501af3553bc73c8ec5d081</code></p><pre>	public static void LoadLibraries(IEnumerable&lt;string&gt; additionalPaths = null)
	{
		if (!IsUnix())
		{
			string[] array = ((additionalPaths == null) ? new string[0] : EnumerableEx.ToArray(additionalPaths));
			List&lt;string&gt; list = new List&lt;string&gt;(array);
			list.Add(Environment.GetFolderPath(Environment.SpecialFolder.System));
			string[] runtimeDllNames = RuntimeDllNames;
			foreach (string dllName in runtimeDllNames)
			{
				WindowsLibraryLoader.Instance.LoadLibrary(dllName, list);
			}
			runtimeDllNames = OpenCVDllNames;
			foreach (string text in runtimeDllNames)
			{
				WindowsLibraryLoader.Instance.LoadLibrary(text + &quot;400&quot;, array);
			}
			WindowsLibraryLoader.Instance.LoadLibrary(&quot;OpenCvSharpExtern&quot;, array);
			IntPtr prevUserdata = IntPtr.Zero;
			redirectError(ErrorHandlerThrowException, prevUserdata, ref prevUserdata);
		}
	}

	private static void SetDefaultHandler(IntPtr currentHandler)</pre></details></details><details id="L05" class="source-confirmed"><summary>L05 · WindowsLibraryLoader实例/平台门/缓存 → 空AdditionalPaths与按名称记录成功 · source-confirmed</summary><p>实例由静态属性初值new建立，构造把AdditionalPaths置空List。平台只接受Win32NT或Win32Windows；否则LoadLibrary立即返回。锁内先查loadedAssemblies.Contains(dllName)，命中即返回；LoadLibraryRaw只有Win32LoadLibrary返回非零才把名称加入List。缓存按dllName，不记录成功文件完整路径或实际导出/ABI。</p><p>待核：缓存不是系统已装载模块的独立清单，AdditionalPaths是可变List；本专题未证明初始化前所有写入者。</p><details><summary>OpenCvSharp.WindowsLibraryLoader::.cctor · 6831–6850</summary><p><code>docs/architecture-recovery/rendering-native-loader-audit.cil.json · original-managed-cil · SHA 6fb283895af9aae658a8942ead14ce40eb9f68b89c82f21a976ba02a365779f3</code></p><pre>          &quot;token&quot;: &quot;0x06001927&quot;,
