          &quot;ilBytes&quot;: &quot;1680fc050004168d4b00000180ff050004168d4b00000180000600047e22080004fe06261f0006738302000680030600047e22080004fe06271f000673830200068004060004281a1900066f1b190006281c150006281e1500062a&quot;,
