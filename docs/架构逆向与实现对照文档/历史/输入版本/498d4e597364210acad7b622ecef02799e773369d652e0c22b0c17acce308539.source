              &quot;opcode&quot;: &quot;ldarg.1&quot;,</pre></details><details><summary>OpenCvSharp.WindowsLibraryLoader · 45–65</summary><p><code>docs/architecture-recovery/rendering-native-loader-audit.resources/OpenCvSharp.WindowsLibraryLoader.decompiled.cs · original-managed-offline-ilspy-decompilation · SHA 3c087dd8dad8497696441340addf5c31f99c4a30d75469aa6e15b1fedb8eaa93</code></p><pre>	private readonly Dictionary&lt;string, string&gt; processorArchitecturePlatforms = new Dictionary&lt;string, string&gt;(StringComparer.OrdinalIgnoreCase)
	{
		{ &quot;x86&quot;, &quot;x86&quot; },
		{ &quot;AMD64&quot;, &quot;x64&quot; },
		{ &quot;IA64&quot;, &quot;Itanium&quot; },
		{ &quot;ARM&quot;, &quot;WinCE&quot; }
	};

	private readonly Dictionary&lt;string, int&gt; processorArchitectureAddressWidthPlatforms = new Dictionary&lt;string, int&gt;(StringComparer.OrdinalIgnoreCase)
	{
		{ &quot;x86&quot;, 4 },
		{ &quot;AMD64&quot;, 8 },
		{ &quot;IA64&quot;, 8 },
		{ &quot;ARM&quot;, 4 }
	};

	private readonly object syncLock = new object();

	private const CharSet DefaultCharSet = CharSet.Auto;

	public static WindowsLibraryLoader Instance { get; } = new WindowsLibraryLoader();</pre></details><details><summary>OpenCvSharp.WindowsLibraryLoader · 154–188</summary><p><code>docs/architecture-recovery/rendering-native-loader-audit.resources/OpenCvSharp.WindowsLibraryLoader.decompiled.cs · original-managed-offline-ilspy-decompilation · SHA 3c087dd8dad8497696441340addf5c31f99c4a30d75469aa6e15b1fedb8eaa93</code></p><pre>	private ProcessArchitectureInfo GetProcessArchitecture()
	{
		string environmentVariable = Environment.GetEnvironmentVariable(&quot;PROCESSOR_ARCHITECTURE&quot;);
		ProcessArchitectureInfo processArchitectureInfo = new ProcessArchitectureInfo();
		if (!string.IsNullOrEmpty(environmentVariable))
		{
			processArchitectureInfo.Architecture = environmentVariable;
		}
		else
		{
			processArchitectureInfo.AddWarning(&quot;Failed to detect processor architecture, falling back to x86.&quot;);
			processArchitectureInfo.Architecture = ((IntPtr.Size == 8) ? &quot;x64&quot; : &quot;x86&quot;);
		}
		int num = processorArchitectureAddressWidthPlatforms[processArchitectureInfo.Architecture];
		if (num != IntPtr.Size)
		{
			if (string.Equals(processArchitectureInfo.Architecture, &quot;AMD64&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; IntPtr.Size == 4)
			{
				processArchitectureInfo.Architecture = &quot;x86&quot;;
				processArchitectureInfo.AddWarning(&quot;Expected the detected processing architecture of {0} to have an address width of {1} Bytes but was {2} Bytes, falling back to x86.&quot;, processArchitectureInfo.Architecture, num, IntPtr.Size);
			}
			else
			{
				processArchitectureInfo.AddWarning(&quot;Expected the detected processing architecture of {0} to have an address width of {1} Bytes but was {2} Bytes.&quot;, processArchitectureInfo.Architecture, num, IntPtr.Size);
			}
		}
		return processArchitectureInfo;
	}

	private IntPtr LoadLibraryInternal(string dllName, string baseDirectory, ProcessArchitectureInfo processArchInfo)
	{
		string platformName = GetPlatformName(processArchInfo.Architecture);
		string baseDirectory2 = Path.Combine(Path.Combine(baseDirectory, &quot;dll&quot;), platformName);
		return LoadLibraryRaw(dllName, baseDirectory2);
	}</pre></details></details><details id="L07" class="source-confirmed"><summary>L07 · WindowsLibraryLoader.LoadLibrary → 附加目录直查→四类基目录的dll/平台目录 · source-confirmed</summary><p>取得架构后先按additionalPaths顺序直接LoadLibraryRaw(dllName,additionalPath)；非零立即返回。再依次取执行程序集Location目录、BaseDirectory、CurrentDirectory及HttpContext存在时的Web bin，每个交LoadLibraryInternal。Internal把基目录拼为base/dll/GetPlatformName(architecture)，再交Raw；不是直接搜索每个基目录根。多处返回都保留，Web路径有条件门。</p><p>待核：执行程序集Location未在本专题运行采样；独立静态路径代入只显示候选与当下文件存在性，不决定实际装载。</p><details><summary>OpenCvSharp.WindowsLibraryLoader::LoadLibrary · 3714–3733</summary><p><code>docs/architecture-recovery/rendering-native-loader-audit.cil.json · original-managed-cil · SHA 6fb283895af9aae658a8942ead14ce40eb9f68b89c82f21a976ba02a365779f3</code></p><pre>          &quot;token&quot;: &quot;0x06001920&quot;,
