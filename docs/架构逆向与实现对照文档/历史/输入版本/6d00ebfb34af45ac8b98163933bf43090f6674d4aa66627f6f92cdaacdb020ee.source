        {
          "path": "analysis/decompiled/VM.Core/VM.Core/VmSolution.cs",
          "member": "Solution name path first segment",
          "sha256": "c141e2c53913b233b768782d6757fae5997ecaf638b35db2ddf98f5ef951a13e",
          "start": 460,
          "end": 494,
          "excerpt": "\tpublic override object this[string sub]\n\t{\n\t\tget\n\t\t{\n\t\t\tif (sub == null)\n\t\t\t{\n\t\t\t\treturn null;\n\t\t\t}\n\t\t\tif (sub.Length == 0)\n\t\t\t{\n\t\t\t\treturn this;\n\t\t\t}\n\t\t\tif (sub.Contains(\"[Params]\"))\n\t\t\t{\n\t\t\t\treturn sub;\n\t\t\t}\n\t\t\tstring[] array = sub.Split('.');\n\t\t\tstring procInfo = array[0];\n\t\t\tVmModule vmModule = Modules.FirstOrDefault((VmModule p) => p.Name == procInfo);\n\t\t\tif (vmModule == null && procInfo == VirtualPro.Name)\n\t\t\t{\n\t\t\t\tvmModule = VirtualPro;\n\t\t\t}\n\t\t\tif (procInfo == \"[UserVar]\")\n\t\t\t{\n\t\t\t\tvmModule = AllModules.Values?.FirstOrDefault((VmModule p) => p != null && ((IVmModule)p).ModuleType == 5);\n\t\t\t}\n\t\t\tif (sub.Contains('.'))\n\t\t\t{\n\t\t\t\treturn vmModule?[sub.Remove(0, array[0].Length + 1)];\n\t\t\t}\n\t\t\treturn vmModule;\n\t\t}\n\t}\n",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "analysis/decompiled/VM.Core/VM.Core/VmFrameTreeBase.cs",
          "member": "Recursive frame path resolution",
          "sha256": "e1464d00357b690eec97a7ed0a8c7fc5c6c14066779bcac65e52c280059784f0",
          "start": 101,
          "end": 142,
          "excerpt": "\tpublic virtual object this[string sub]\n\t{\n\t\tget\n\t\t{\n\t\t\tif (sub == null || sub.Length == 0)\n\t\t\t{\n\t\t\t\treturn this;\n\t\t\t}\n\t\t\tstring[] array = sub.Split('.');\n\t\t\tobject obj = null;\n\t\t\tif (array[0].First() == '[' && array[0].Last() == ']' && this is IVmExternPath vmExternPath)\n\t\t\t{\n\t\t\t\treturn vmExternPath.GetExternNode(sub);\n\t\t\t}\n\t\t\tobj = GetNode(array[0]);\n\t\t\tif (obj == null)\n\t\t\t{\n\t\t\t\tobj = GetNode($\"%{array[0]}%\");\n\t\t\t}\n\t\t\tint num = sub.IndexOf('.') + 1;\n\t\t\tif (num != 0)\n\t\t\t{\n\t\t\t\tstring text = sub.Substring(num);\n\t\t\t\tstring[] nextSplit = text.Split('.');\n\t\t\t\tstring sub2 = ((nextSplit.Length > 1) ? nextSplit[1] : null);\n\t\t\t\tif (obj is VmFrameTreeBase vmFrameTreeBase)\n\t\t\t\t{\n\t\t\t\t\treturn vmFrameTreeBase[text];\n\t\t\t\t}\n\t\t\t\tif (obj is VmIOCollection vmIOCollection)\n\t\t\t\t{\n\t\t\t\t\treturn vmIOCollection.GetIO(nextSplit[0])?[sub2];\n\t\t\t\t}\n\t\t\t\tif (obj is IList source)\n\t\t\t\t{\n\t\t\t\t\treturn source.Cast<VmFrameTreeBase>().FirstOrDefault((VmFrameTreeBase p) => p.Name == nextSplit[0])?[sub2];\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn obj;\n\t\t}\n\t}\n",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "analysis/decompiled/VM.Core/VM.Core/VmModuleSet.cs",
          "member": "Module-set path lookup",
          "sha256": "f3b98c4436686b0a9babf8cde4f5f6c83814664b8f7835dfabbeb02e2a64a346",
          "start": 852,
          "end": 878,
          "excerpt": "\tpublic override object GetNode(string key)\n\t{\n\t\tobject obj = null;\n\t\tif (!string.IsNullOrEmpty(key) && key.First() == '(' && key.Last() == ')')\n\t\t{\n\t\t\tobj = base.GetNode(key);\n\t\t}\n\t\telse\n\t\t{\n\t\t\tobj = GetModuleByProtocol(key);\n\t\t\tif (obj == null)\n\t\t\t{\n\t\t\t\tobj = base.GetNode(key);\n\t\t\t}\n\t\t}\n\t\treturn obj;\n\t}\n\n\tprotected VmModule GetModuleByProtocol(string moduleInfo)\n\t{\n\t\tif (string.IsNullOrEmpty(moduleInfo))\n\t\t{\n\t\t\treturn null;\n\t\t}\n\t\treturn Modules.FirstOrDefault((VmModule p) => p != null && p.Name == moduleInfo);\n\t}\n",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        }
      ],
