          "start": 142,
          "end": 156,
          "excerpt": "\tpublic void Register(IUnRedoOperation unRedoOperation, string displayStr, Expression<Func<IBuilder, IUnRedoOperation, bool>> CanRegister = null)\n\t{\n\t\tif (_unRedoing <= 0 && _nLaziLoading <= 0 && (CanRegister == null || _undoStack.Count != 0) && (!unRedoOperation.IsPart || _undoStack.Count != 0) && (!unRedoOperation.IsPart || !(_undoStack.Peek() as IRootParam).ForbidBuild) && (CanRegister == null || CanRegister.Compile()(_undoStack.Peek() as IBuilder, unRedoOperation)))\n\t\t{\n\t\t\tif (unRedoOperation.IsPart)\n\t\t\t{\n\t\t\t\tBuildPart(unRedoOperation as IUnRedoActionOperation, displayStr);\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tBuildRoot(displayStr, unRedoOperation as IRootParam);\n\t\t\t}\n\t\t\tNotifyProperty();\n\t\t}\n\t}",
          "evidenceType": "original-managed-offline-decompilation",
          "binaryIdentity": "aa719d093c948e8e6573d20c0198b60ef493f2bed8c029caab95ed5621a7aaa2 / MVID 05297188-764c-48da-a387-1ca4029dd9b8"
        },
        {
          "path": "docs/architecture-recovery/workflow-rename-history-audit.original/VM.UnRedo.UnRedoSchedule.decompiled.cs",
          "member": "Root and action construction",
          "sha256": "920fe4239369a12521c0b23cb0fcf9e30d2f25193a67e10a50c03ac51fd9c407",
          "start": 342,
          "end": 378,
          "excerpt": "\tprivate void BuildRoot(string displayName, IRootParam param)\n\t{\n\t\tIBuilder builder = new RootUnRedoOperation();\n\t\tbuilder.Actions = new SafeObservableCollection<IUnRedoActionOperation>();\n\t\tbuilder.BuildDispalyName(displayName);\n\t\tbuilder.BuildInStack(isUndoStack: true);\n\t\tbuilder.BuildOperType(param);\n\t\tif (_undoStack.TryPush(builder as IUnRedoOperation, out var removeItem))\n\t\t{\n\t\t\t(removeItem as IDisposable).Dispose();\n\t\t}\n\t}\n\n\tprivate void BuildPart(IUnRedoActionOperation unRedoOperation, string displayStr)\n\t{\n\t\tif (_undoStack.Count != 0)\n\t\t{\n\t\t\tif (unRedoOperation is IDisposeTempFile compareObject)\n\t\t\t{\n\t\t\t\tRedoStackClear(compareObject);\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tRedoStackClear();\n\t\t\t}\n\t\t\tIBuilder builder = (unRedoOperation.ParentNode = _undoStack.Peek() as IBuilder);\n\t\t\t(unRedoOperation as DisplayNotify).DisplayNameA = displayStr;\n\t\t\t(unRedoOperation as DisplayNotify).IsUndoStack = true;\n\t\t\tbuilder.BuildPart(unRedoOperation);\n\t\t}\n\t}\n\n\tprivate void UpdateActionData()\n\t{\n\t\tIBuilder builder = _undoStack.Peek() as IBuilder;\n\t\tbuilder.Actions?.Where((IUnRedoActionOperation x) => !x.IsDataComplete).ToList().ForEach((IUnRedoActionOperation x) =>\n\t\t{",
          "evidenceType": "original-managed-offline-decompilation",
          "binaryIdentity": "aa719d093c948e8e6573d20c0198b60ef493f2bed8c029caab95ed5621a7aaa2 / MVID 05297188-764c-48da-a387-1ca4029dd9b8"
        },
        {
          "path": "docs/architecture-recovery/workflow-rename-history-audit.original/VM.UnRedo.PoolStack-1.decompiled.cs",
          "member": "Bounded root insertion",
          "sha256": "ad79427ff203f606d9dc2a091887d6c3dbfba2da5c4fab45720187c9d4ab4d1c",
          "start": 68,
          "end": 87,
          "excerpt": "\tpublic bool TryPush(T item, out object removeItem)\n\t{\n\t\tsl.Insert(0, item);\n\t\tbool result = false;\n\t\tif (Count > length)\n\t\t{\n\t\t\tremoveItem = sl[Count - 1];\n\t\t\tsl.RemoveAt(Count - 1);\n\t\t\tresult = true;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tremoveItem = null;\n\t\t}\n\t\tOnPropertyChanged(\"EnumEntrysA\");\n\t\treturn result;\n\t}\n\n\tpublic T TryRemoveLast()\n\t{",
          "evidenceType": "original-managed-offline-decompilation",
          "binaryIdentity": "aa719d093c948e8e6573d20c0198b60ef493f2bed8c029caab95ed5621a7aaa2 / MVID 05297188-764c-48da-a387-1ca4029dd9b8"
        }
      ],
      "unknowns": [
        "SafeObservableCollection跨线程、CanRegister动态表达式/空参数失败和所有root并发创建者未知；未加入并不等于撤销了调用方后续原生操作。"
      ],
      "operationComplete": false
    },
    {
      "id": "RH08",
      "classification": "source-confirmed",
      "relation": "research: selected rename history and name-path resolution",
      "from": "UnRedoSchedule.Undo / Redo",
      "to": "移动栈后构建Params，再执行，异常吞掉",
      "behavior": "Undo先增_unRedoing；undo非空则UpdateActionData，对未完成part先置IsDataComplete=true再Update；随后Pop undo并Push redo、BuildParams(dispatcher,RecoverStack表达式)、BuildInStack(false)后执行Undo。Redo同样先把redo搬回undo再Params/标记/Redo。两者catch Exception为空，finally减_unRedoing再NotifyProperty；finally通知异常不在此前catch保护。失败发生时栈已经可能移动，不是先成功再提交；PoolStack.Push超容量只移除末项不Dispose。",
