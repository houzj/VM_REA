      "behavior": "WorkflowTabs.RenameProcedure在Enter或LostKeyboardFocus仅提交一次，Trim文本后再次CanEditProcedure并经Safe调用doc.RenameProcedure，随后RefreshAll。文档RequireName/禁用字符/同名返回后按procedure Id改Name；若为Group子流程，亦按GroupOwner的ProcedureId/NodeId同步拥有者节点名。Edit先计算并验证next，RecordEditHistory在document=next前执行。普通编辑BeginRoot/RegisterPart(document,Capture,RestoreSnapshot)捕获旧SolutionDocument副本、ProcedureId及BaseDirectory；不是三字符串改名part。无指定payload目录且序列化小于64KiB存内存，否则交HistoryPayloadStore持有文件。首次Undo的CompleteNewValue先置完成标志再调用capture；Replay之后移栈并restore旧值，Redo恢复所存new值。RestoreSnapshot经Rebase后替换文档和当前流程，设dirty/增Revision/发Changed；FilePath不在Snapshot字段中。",
      "refs": [
        {
          "path": "src/VisionEditor/WorkflowTabs.cs",
          "member": "Current WPF procedure commit",
          "sha256": "24a398d5cd2a16ba2ea01ce980df4b7a3c4f4b9afe27c34720195bcd0b48cb45",
          "start": 324,
          "end": 345,
          "excerpt": "    void RenameProcedure(string id)\n    {\n        if (!CanEditProcedure(id) || !procedureHeaders.TryGetValue(id, out var holder)) return;\n        var procedure = doc.Document.Procedures.First(p => p.Id == id);\n        var editor = new TextBox { Text = procedure.Name, MaxLength = 64, MinWidth = 65, MaxWidth = 240, FontSize = 14, Foreground = Brushes.White, Background = new SolidColorBrush(Color.FromRgb(40, 42, 44)), BorderThickness = new Thickness(0), ContextMenu = null };\n        bool finished = false;\n        void Commit()\n        {\n            if (finished) return;\n            finished = true;\n            string name = editor.Text.Trim();\n            workflowHeaderStates.Remove(id);\n            if (CanEditProcedure(id)) Safe(() => doc.RenameProcedure(id, name));\n            RefreshAll();\n        }\n        editor.LostKeyboardFocus += (_, _) => Commit();\n        editor.KeyDown += (_, e) => { if (e.Key == Key.Return) { e.Handled = true; Commit(); } };\n        holder.Child = editor;\n        Dispatcher.BeginInvoke(new Action(() => { editor.Focus(); editor.SelectAll(); }));\n    }\n}\n",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor.Core/GraphEditorDocument.cs",
          "member": "Current rename and owner ID updates",
          "sha256": "4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558",
          "start": 110,
          "end": 116,
          "excerpt": "    public void RenameProcedure(string id,string name) {\n        RequireName(name);\n        // VmModuleBaseDecorator.Name rejects these characters before invoking the SDK.\n        if(name.IndexOfAny(\"?;.[]<>()`\".ToCharArray())>=0)throw new ArgumentException(\"名称不能包含 ? ; . [ ] < > ( ) `。\",nameof(name));\n        var procedure=Procedure(id); if(procedure.Name==name)return;\n        Edit(d=>d with {Procedures=d.Procedures.Select(p=>p.Id==id?p with {Name=name}:procedure.GroupOwner is {} owner&&p.Id==owner.ProcedureId?p with{Nodes=p.Nodes.Select(n=>n.Id==owner.NodeId?n with{Name=name}:n).ToArray()}:p).ToArray()});\n    }",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor.Core/GraphEditorDocument.cs",
          "member": "Current snapshot payload contract",
          "sha256": "4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558",
          "start": 15,
          "end": 22,
          "excerpt": "    sealed record Snapshot(SolutionDocument? MemoryDocument, string ProcedureId, string BaseDirectory,\n        [property:System.Text.Json.Serialization.JsonIgnore] HistoryPayloadLease? Payload = null) : IDisposable\n    {\n        public SolutionDocument Document => MemoryDocument ?? JsonSerializer.Deserialize<SolutionDocument>(Payload!.ReadBytes())\n            ?? throw new InvalidDataException(\"Invalid owned history document payload.\");\n        public void Dispose() => Payload?.Dispose();\n    }\n    public GraphEditorDocument(ModuleRegistry registry, string? historyPayloadParentDirectory=null)",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor.Core/GraphEditorDocument.cs",
          "member": "Current edit ordering and snapshot capture",
          "sha256": "4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558",
          "start": 296,
          "end": 323,
          "excerpt": "    void Edit(Func<SolutionDocument,SolutionDocument> action,string? selectedProcedure=null) { var next=Copy(SynchronizeGroupNames(PruneOwnedGroups(CloneOwnedCopies(action(Copy(document))))));\n        if(PrepareExecutionTopologyChange is { } prepare){\n            var before=document.Procedures.ToDictionary(p=>p.Id,StringComparer.Ordinal);\n            next=next with{Procedures=next.Procedures.Select(after=>{\n                if(!before.TryGetValue(after.Id,out var old))return after;\n                var oldEdges=ProcedureGraph.ExecutionEdges(old).Select(e=>(e.FromNode,e.ToNode));\n                var newEdges=ProcedureGraph.ExecutionEdges(after).Select(e=>(e.FromNode,e.ToNode));\n                return oldEdges.SequenceEqual(newEdges)?after:prepare(old,after);\n            }).ToArray()};\n        }\n        SolutionStore.ValidateStructure(next); RecordEditHistory();document=next;if(selectedProcedure is not null)CurrentProcedureId=selectedProcedure;if(!document.Procedures.Any(p=>p.Id==CurrentProcedureId))CurrentProcedureId=document.Procedures.FirstOrDefault(p=>p.GroupOwner is null)?.Id??\"\";IsDirty=true;Revision++;Changed?.Invoke(); }\n    Snapshot Capture()=>CaptureSnapshot(Copy(document),CurrentProcedureId,BaseDirectory);\n    Snapshot CaptureSnapshot(SolutionDocument value,string procedure,string directory)\n    {\n        ObjectDisposedException.ThrowIf(disposed,this);\n        var bytes=JsonSerializer.SerializeToUtf8Bytes(value);\n        if(historyPayloadParentDirectory is null && bytes.Length<64*1024)return new(value,procedure,directory);\n        historyPayloadStore??=new(historyPayloadParentDirectory??Path.Combine(Path.GetTempPath(),\"VisionEditor-History\"));\n        return new(null,procedure,directory,historyPayloadStore.CreateFile(bytes));\n    }\n    void RestoreSnapshot(Snapshot snapshot) {\n        var next=Rebase(snapshot.Document,snapshot.BaseDirectory,BaseDirectory);\n        document=next;CurrentProcedureId=snapshot.ProcedureId;IsDirty=true;Revision++;Changed?.Invoke();\n    }\n    Snapshot MergeCurrentView(Snapshot snapshot) {\n        // Independent main view-data adapter: retain A03.3 zoom changes made\n        // between replays without altering the action's structural old/new data.\n        if(snapshot is null)return snapshot!; // Preserve an original failed-completion payload; do not invent one.",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor.Core/GraphEditorDocument.History.cs",
          "member": "Current history root/part registration",
          "sha256": "d4a3f13130e6c9334547ecaf567c5cbf34e122e976166990fa02bb796522411f",
          "start": 50,
          "end": 68,
          "excerpt": "    void RecordEditHistory()\n    {\n        if (configurationHistory is { NeedsRoot: true } session && session.Generation == solutionGeneration)\n        {\n            BeginDocumentHistoryRoot();\n            session.NeedsRoot = false;\n            SetHistoryRecordingForbidden(session.ForbidBuild);\n        }\n        else if (history.CurrentRoot is not { ForbidBuild: true })\n            BeginDocumentHistoryRoot();\n    }\n\n    void BeginDocumentHistoryRoot()\n    {\n        if (!history.BeginRoot()) return;\n        history.RegisterPart(\"document\",Capture,RestoreSnapshot,\n            canRegister:(root,key)=>!root.Parts.Any(part=>part.Key==key));\n    }\n}",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor.Core/DocumentHistoryEngine.cs",
          "member": "Current old-payload admission",
          "sha256": "4f33d5d51a205be0c36e042cd8a25f024e93f0ffce1f81c9ebe29667216953aa",
          "start": 57,
          "end": 72,
          "excerpt": "    public bool RegisterPart(string key, Func<T> capture, Action<T> restore, int priority = 0,\n        Func<DocumentHistoryRoot<T>, string, bool>? canRegister = null)\n    {\n        ArgumentNullException.ThrowIfNull(key);\n        ArgumentNullException.ThrowIfNull(capture);\n        ArgumentNullException.ThrowIfNull(restore);\n        var root = CurrentRoot;\n        if (IsReplaying || lazyLoadingDepth > 0 || root is null || root.ForbidBuild || (canRegister is not null && !canRegister(root, key))) return false;\n        T oldValue = capture();\n        // BuildPart invalidates redo only after a new part passed registration.\n        ReleaseStack(redo);\n        root.Add(new(key, priority, oldValue, capture, restore, releasePayload));\n        return true;\n    }\n\n    public bool Undo() => Replay(isUndo: true);",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
