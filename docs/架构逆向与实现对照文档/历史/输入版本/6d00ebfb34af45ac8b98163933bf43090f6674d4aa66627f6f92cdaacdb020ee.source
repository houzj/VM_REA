          "sha256": "e1464d00357b690eec97a7ed0a8c7fc5c6c14066779bcac65e52c280059784f0",
          "start": 43,
          "end": 73,
          "excerpt": "\tpublic virtual string FullName\n\t{\n\t\tget\n\t\t{\n\t\t\tstring text = \"\";\n\t\t\tVmFrameTreeBase vmFrameTreeBase = this;\n\t\t\twhile (vmFrameTreeBase != null && !string.IsNullOrEmpty(vmFrameTreeBase.Name))\n\t\t\t{\n\t\t\t\tif (vmFrameTreeBase is VmIO)\n\t\t\t\t{\n\t\t\t\t\ttext = ((vmFrameTreeBase.Parent != null) ? $\"({vmFrameTreeBase.UniqueName}).{text}\" : $\"{vmFrameTreeBase.UniqueName}.{text}\");\n\t\t\t\t\tvmFrameTreeBase = (vmFrameTreeBase as VmIO).Root;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\ttext = ((!(vmFrameTreeBase is IVmModule { ModuleType: 25u })) ? $\"{vmFrameTreeBase.UniqueName}.{text}\" : string.Format(\"{0}.{1}\", \"[UserVar]\", text));\n\t\t\t\t\tvmFrameTreeBase = vmFrameTreeBase.Parent as VmFrameTreeBase;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (text.Contains('.'))\n\t\t\t{\n\t\t\t\ttext = text.Remove(text.LastIndexOf('.'));\n\t\t\t}\n\t\t\treturn text;\n\t\t}\n\t}\n\n\tpublic virtual string UniqueGUID { get; }\n\n\tpublic virtual string FullGUID\n\t{",
