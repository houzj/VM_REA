      "id": "HRC01",
      "classification": "independent-implementation",
      "relation": "research: module result history, current-result selection and help",
      "from": "当前FrameworkRunHistory / HistoryGrid",
      "to": "独立流程运行摘要与清理",
      "behavior": "当前HistoryGrid绑定FrameworkRunHistory.Entries；追加每个流程session状态、耗时和当前时间，独立sequence、最多500行，清空同时sequence归0。方案替换ResetFrameworkRunHistory还归零流程/模块时长并算法时长置不可用。此对象存摘要，无SDK buffer、原DataRecord或图像快照；MainWindow XAML虽声明历史/帮助两Tab，当前这组代码未恢复原ModuleDisplayInfoList/HelperContent切换语义。",
      "refs": [
        {
          "path": "src/VisionEditor/MainWindow.FrameworkResultHistory.cs",
          "member": "Current host history binding and reset",
          "sha256": "f1bdb017f951dcbe5d50e80fa586d61c610b9d2ce90658a7ea8843c4e5f734c8",
          "start": 10,
          "end": 34,
          "excerpt": "    void InitializeFrameworkResultHistory()\n    {\n        HistoryGrid.ItemsSource = frameworkRunHistory.Entries;\n        doc.SolutionReplaced += ResetFrameworkRunHistory;\n        ResetFrameworkRunHistory();\n    }\n\n    void RecordFrameworkRunHistory(string procedureId, ExecutionSessionResult session)\n    {\n        var name = doc.Document.Procedures.FirstOrDefault(procedure => procedure.Id == procedureId)?.Name ?? procedureId;\n        frameworkRunHistory.Append(procedureId, name, session.Status,\n            session.Nodes.Sum(record => record.ElapsedMilliseconds), DateTime.Now);\n    }\n\n    void ResetFrameworkRunHistory()\n    {\n        // Independent solution replacement policy for the host's own summary.\n        // The original native/global module cache is not touched by this method.\n        frameworkRunHistory.Clear();\n        ProcessTimeText.Text = \"0.00\";\n        ModuleTimeText.Text = \"0.00\";\n        AlgorithmTimeText.Text = FrameworkResultTiming.Unavailable;\n    }\n\n    void RefreshFrameworkResultTiming()",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor.Core/FrameworkRunHistory.cs",
          "member": "Independent summary data and append",
          "sha256": "59dd728ed5398e4dc1c304340940729ce59d7eeda9e615a2a47690ebef40c5a6",
          "start": 8,
          "end": 43,
          "excerpt": "public sealed class FrameworkRunHistory\n{\n    public const int MaximumRecords = 500;\n    readonly ObservableCollection<FrameworkRunHistoryEntry> entries = new();\n    long sequence;\n\n    public FrameworkRunHistory() => Entries = new(entries);\n    public ReadOnlyObservableCollection<FrameworkRunHistoryEntry> Entries { get; }\n\n    public void Append(string procedureId, string procedureName, SessionStatus status, double elapsedMilliseconds, DateTime completedAt)\n    {\n        ArgumentException.ThrowIfNullOrWhiteSpace(procedureId);\n        ArgumentNullException.ThrowIfNull(procedureName);\n        if (!double.IsFinite(elapsedMilliseconds) || elapsedMilliseconds < 0)\n            throw new ArgumentOutOfRangeException(nameof(elapsedMilliseconds));\n        long next = checked(sequence + 1);\n        var entry = new FrameworkRunHistoryEntry(next, completedAt.ToString(\"yyyy-MM-dd HH:mm:ss:fff\", CultureInfo.InvariantCulture),\n            procedureName + \" · \" + status, procedureId, elapsedMilliseconds);\n        entries.Insert(0, entry);\n        sequence = next;\n        if (entries.Count > MaximumRecords) entries.RemoveAt(MaximumRecords);\n    }\n\n    /// <summary>Only clears this host's summary and sequence, not native result caches.</summary>\n    public void Clear()\n    {\n        entries.Clear();\n        sequence = 0;\n    }\n}\n\npublic sealed record FrameworkRunHistoryEntry(long Seq, string Time, string Data, string ProcedureId, double ElapsedMilliseconds);\n\n/// <summary>Times available from current managed results; algorithm-only time is unavailable.</summary>\npublic sealed record FrameworkResultTiming(double? ProcessMilliseconds, double? ModuleMilliseconds)\n{",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
