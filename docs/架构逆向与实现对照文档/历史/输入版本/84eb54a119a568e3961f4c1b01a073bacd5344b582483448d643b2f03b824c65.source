          "start": 303,
          "end": 329,
          "excerpt": "                <TabItem Name=\"hstTab\" Header=\"{DynamicResource Lang_HstRslt}\" Height=\"40\" FontSize=\"14\" Foreground=\"{DynamicResource Col_DisplayImage_Foreground}\" BorderThickness=\"0\" Style=\"{StaticResource FrequentTab}\">\n                  <DataGrid Name=\"m_DataGrid\" Grid.Row=\"2\" ColumnWidth=\"Auto\" Style=\"{StaticResource ModuleViewDataGridStyle}\" ItemsSource=\"{Binding m_CurrentInfo.ModuleDisplayInfoList, ElementName=us, Mode=OneWay, IsAsync=True}\">\n                    <DataGrid.Columns>\n                      <DataGridTextColumn MinWidth=\"30\" CellStyle=\"{StaticResource dgCellLeftAlignmentStyle}\" Binding=\"{Binding Path=RowIndex}\">\n                        <DataGridColumn.Header>\n                          <TextBlock Text=\"{DynamicResource Lang_ExecuteNum}\" VerticalAlignment=\"Center\" />\n                        </DataGridColumn.Header>\n                      </DataGridTextColumn>\n                      <DataGridTextColumn MinWidth=\"150\" CellStyle=\"{StaticResource dgCellLeftAlignmentStyle}\" Binding=\"{Binding Path=AddTime}\">\n                        <DataGridColumn.Header>\n                          <TextBlock Text=\"{DynamicResource Lang_Time}\" VerticalAlignment=\"Center\" />\n                        </DataGridColumn.Header>\n                      </DataGridTextColumn>\n                      <DataGridTextColumn MinWidth=\"200\" CellStyle=\"{StaticResource dgCellLeftAlignmentStyle}\" Binding=\"{Binding Path=Content}\">\n                        <DataGridColumn.Header>\n                          <TextBlock Text=\"{DynamicResource Lang_ModuData}\" VerticalAlignment=\"Center\" />\n                        </DataGridColumn.Header>\n                      </DataGridTextColumn>\n                    </DataGrid.Columns>\n                  </DataGrid>\n                  <FrameworkElement.ContextMenu>\n                    <vmcontrols:HikContextMenu>\n                      <MenuItem Name=\"Menu_Clear\" Header=\"{DynamicResource Clear}\" Click=\"Menu_Clear_Click\" />\n                      <MenuItem Name=\"Menu_Save\" Header=\"{DynamicResource Save}\" Click=\"Menu_Save_Click\" />\n                    </vmcontrols:HikContextMenu>\n                  </FrameworkElement.ContextMenu>\n                </TabItem>",
          "evidenceType": "local-extracted-resource",
          "binaryIdentity": "not revalidated in this slice"
        },
