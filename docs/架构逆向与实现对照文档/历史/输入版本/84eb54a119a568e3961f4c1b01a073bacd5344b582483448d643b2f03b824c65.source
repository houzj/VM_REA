      "to": "清旧frame、请求代数与owner三维核对",
      "behavior": "RefreshToolDisplay递增toolDisplayRequestGeneration，捕获owner和当前procedure；Current同时要求请求代数相同、IsCurrentExecutionOwner通过且流程ID未变。先向三个presenter Show(null)并折叠，再只对results含节点的provider调用LastDisplay、应用位置订阅；catch仅Current时写本地诊断，提交frame前再核Current。owner核对窗口未关闭、Epoch对象同一、generation相同、SolutionId序数相等、scope对象引用相同；Invalidate在相同SolutionId重开时也使旧stamp失效。单个Interlocked/Volatile读取不构成整个UI/文档/原生内存的原子快照，门禁不能代替native buffer生命周期。",
      "refs": [
        {
          "path": "src/VisionEditor/ToolDisplays.cs",
          "member": "Current pull clear/provider/commit ordering",
          "sha256": "f3ae89186549591a8a025fc8d36d66bc2b5ea959ec3ed293d3e1030bcdd0e656",
          "start": 22,
          "end": 53,
          "excerpt": " void RefreshToolDisplay(NodeDocument? node){\n  long request=++toolDisplayRequestGeneration;\n  var owner=CaptureExecutionOwner();string procedure=doc.CurrentProcedureId;\n  bool Current()=>request==toolDisplayRequestGeneration&&IsCurrentExecutionOwner(owner)&&doc.CurrentProcedureId==procedure;\n  // main's pull-view adapter clears the previous source before asking a new provider.\n  toolDisplayImage.Show(null);toolDisplayRecord.Show(null);toolDisplayList.Show(null);\n  toolDisplayImage.Visibility=toolDisplayRecord.Visibility=toolDisplayList.Visibility=Visibility.Collapsed;\n  Preview.Visibility=PreviewImageName.Visibility=Visibility.Visible;\n  EmptyImage.Visibility=Preview.Source is null?Visibility.Visible:Visibility.Collapsed;\n  var provider=node is null?null:plugins.Find(node.ModuleId) as IToolDisplayProvider;\n  ToolDisplayFrame? frame=null;\n  try{\n   if(provider is not null&&node is not null&&results.ContainsKey(node.Id))frame=provider.LastDisplay(node,doc.BaseDirectory,executionScope.ForProcedure(doc.CurrentProcedureId));\n   if(frame is not null&&node is not null)frame=ToolConfigurationDisplaySubscriptions.ApplyPositions(frame,node,doc.CurrentProcedureId,(source,port)=>results.GetValueOrDefault(source)?.Outputs.GetValueOrDefault(port));\n  }\n  catch(Exception error){if(!Current())return;StatusText.Text=\"结果显示失败：\"+error.Message;} // Independent host diagnostic; not native exception parity.\n  if(!Current())return;\n  toolRecordTab.Visibility=provider is null?Visibility.Collapsed:Visibility.Visible;\n  toolListTab.Visibility=provider is null?Visibility.Collapsed:Visibility.Visible;\n  if(provider is null&&DisplayTabs.SelectedIndex>1)DisplayTabs.SelectedIndex=0;\n  toolDisplayImage.Show(frame);toolDisplayRecord.Show(frame);toolDisplayList.Show(frame);\n  bool overlay=frame is not null&&DisplayTabs.SelectedIndex==0;\n  toolDisplayImage.Visibility=overlay?Visibility.Visible:Visibility.Collapsed;\n  Preview.Visibility=overlay?Visibility.Collapsed:Visibility.Visible;\n  PreviewImageName.Visibility=overlay?Visibility.Collapsed:Visibility.Visible;\n  if(overlay)EmptyImage.Visibility=Visibility.Collapsed;\n  ImagePreviewPane.Visibility=DisplayTabs.SelectedIndex==0?Visibility.Visible:Visibility.Collapsed;\n  ModuleResultsGrid.Visibility=DisplayTabs.SelectedIndex==1?Visibility.Visible:Visibility.Collapsed;\n  toolDisplayRecord.Visibility=provider is not null&&DisplayTabs.SelectedIndex==2?Visibility.Visible:Visibility.Collapsed;\n  toolDisplayList.Visibility=provider is not null&&DisplayTabs.SelectedIndex==3?Visibility.Visible:Visibility.Collapsed;\n  toolDisplayImage.LayoutTransform=new ScaleTransform(previewScale,previewScale);\n }",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor/MainWindow.FrameworkExecutionOwnership.cs",
          "member": "Current owner stamp host adapter",
          "sha256": "5b628d95732f56404fb07fc4eccd7458666ec0015901b66fb3596905d91b0be1",
          "start": 11,
          "end": 18,
          "excerpt": "    ExecutionOwnerStamp CaptureExecutionOwner() => executionOwnerEpoch.Capture(doc.SolutionId,executionScope);\n    bool IsCurrentExecutionOwner(ExecutionOwnerStamp stamp) => !windowClosed &&\n        executionOwnerEpoch.IsCurrent(stamp,doc.SolutionId,executionScope);\n    void DispatchWorkflowCallback(Action callback)\n    {\n        if(windowClosed)return;\n        if(Dispatcher.CheckAccess())callback();\n        else _=Dispatcher.BeginInvoke(callback);",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "src/VisionEditor.Core/ExecutionOwnerEpoch.cs",
          "member": "Current stamp capture and validity predicates",
          "sha256": "3a428fe53f2d23de3988fd363efde08134abab0ffa97ce9a303dcc88a6554bfb",
          "start": 9,
          "end": 30,
          "excerpt": "    public ExecutionOwnerStamp Capture(string solutionId, object scopeOwner)\n    {\n        ArgumentNullException.ThrowIfNull(solutionId);\n        ArgumentNullException.ThrowIfNull(scopeOwner);\n        return new(this, Interlocked.Read(ref generation), solutionId, scopeOwner);\n    }\n\n    public bool IsCurrent(ExecutionOwnerStamp stamp, string solutionId, object scopeOwner) =>\n        Volatile.Read(ref closed) == 0 && ReferenceEquals(stamp.Epoch, this)\n        && stamp.Generation == Interlocked.Read(ref generation)\n        && string.Equals(stamp.SolutionId, solutionId, StringComparison.Ordinal)\n        && ReferenceEquals(stamp.ScopeOwner, scopeOwner);\n\n    /// <summary>Call before replacing or disposing the old execution scope, even for identical document IDs.</summary>\n    public void Invalidate() => Interlocked.Increment(ref generation);\n\n    public void Close()\n    {\n        Interlocked.Exchange(ref closed, 1);\n        Invalidate();\n    }\n}",
          "evidenceType": "current-source",
          "binaryIdentity": "not revalidated in this slice"
        }
      ],
