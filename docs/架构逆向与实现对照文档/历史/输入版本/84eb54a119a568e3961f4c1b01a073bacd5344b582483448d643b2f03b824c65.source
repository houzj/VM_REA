          "sha256": "e165657162322fd6b1ce15758847bed07f8c1e86a637815df8e87fe19439bb88",
          "start": 1078,
          "end": 1115,
          "excerpt": "\tpublic void SetCommonModuleView()\n\t{\n\t\tModuleDisplayDecorator currentInfo = m_CurrentInfo;\n\t\tClearModuleView();\n\t\tSetCommonViewMode();\n\t\tbool flag = (currentInfo.ModuleParams?.GetDisplayList())?.Any((object x) => x is Apps.XmlParser.Object && (x as Apps.XmlParser.Object).Type == \"datalist\") ?? false;\n\t\tCurResultTabItem.Visibility = ((!flag) ? Visibility.Collapsed : Visibility.Visible);\n\t\thstTab.Visibility = Visibility.Visible;\n\t\tm_ResultDataGrid.Visibility = Visibility.Visible;\n\t\tInitSpecialParams();\n\t\tif ((InfoTab.Items[currentInfo.curTabIndex] as TabItem).IsVisible)\n\t\t{\n\t\t\tInfoTab.SelectedIndex = currentInfo.curTabIndex;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tSetFirstVisibleTab();\n\t\t}\n\t\tif (m_CurrentInfo?.DecorateSource is IVmProcedure)\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tDispatcher.BeginInvoke((BeginInvokeDelegate)(() =>\n\t\t{\n\t\t\ttry\n\t\t\t{\n\t\t\t\tRefreshDataListResult(null, needClear: true);\n\t\t\t\tm_CurrentInfo?.RefreshRecordResult();\n\t\t\t}\n\t\t\tcatch (Exception ex)\n\t\t\t{\n\t\t\t\tLogHelper.Error(\"刷新结果列表异常：\" + ex.Message + ex.StackTrace);\n\t\t\t}\n\t\t}), DispatcherPriority.Background);\n\t}\n\n\t/// <summary>\n\t/// 初始化特殊参数控件",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        }
