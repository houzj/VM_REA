<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Group保护跨页分析链</title><style>:root{color-scheme:dark;background:#0b1423;color:#e5eef9;font:15px/1.65 'Microsoft YaHei UI',sans-serif}body{max-width:1700px;margin:auto;padding:24px}a{color:#94ceff}.notice{background:#203048;border-left:4px solid #efba79;padding:15px}.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(340px,1fr);gap:18px}.canvas{overflow:auto;border:1px solid #395471}svg{width:100%;min-width:1000px;display:block}.detail{position:sticky;top:10px;align-self:start;background:#14263c;padding:18px;overflow-wrap:anywhere;max-height:90vh;overflow:auto}button,select{font:inherit;background:#203a54;color:inherit;border:1px solid #6685a0;border-radius:7px;padding:7px;margin:4px}pre{white-space:pre-wrap;font:12px/1.5 Consolas,monospace;overflow-wrap:anywhere}.flow{fill:none;stroke:#eab779;stroke-width:2;cursor:pointer}.flow.unknown{stroke:#ef9bb6;stroke-dasharray:7 5}.flow:hover,.flow.selected{stroke:white;stroke-width:5}.node rect{fill:#1c344e;stroke:#85b9dc}.node text{fill:#e5eef9;font:13px 'Microsoft YaHei UI',sans-serif;pointer-events:none}.node{cursor:pointer}.node:focus rect,.node:hover rect{stroke:white;stroke-width:3}summary{cursor:pointer}@media(max-width:1000px){.layout{grid-template-columns:1fr}.detail{position:static;max-height:none}}</style><a href="entry-inventory.html">← 入口清单</a> · <a href="entry-routing-security.html#edge-E63">界面保护层级</a> · <a href="group-file-storage.html">文件密码层级</a><h1>Group界面保护与文件密码：逐箭头检查</h1><p class="notice">左路是启用界面保护，右路是文件导出。两路没有已证实的密码自动同步箭头。粉色虚线保留宿主、BAML、框架回流、接口接收者和native断点；实线是有限静态关系，也不表示原机已执行。</p><select id="lane" aria-label="选择分析路径"><option value="all">两条路径</option><option value="ui">界面保护</option><option value="file">文件导出</option></select><div class="layout"><section><div class="canvas"><svg id="graph" viewBox="0 0 1400 1460" role="img" aria-label="Group保护与文件密码跨页图"></svg></div><div id="buttons"></div></section><aside id="detail" class="detail" aria-live="polite"></aside></div><p>24节点、24关系仅属此有限分析链，单独计数。修改/取消保护和导入见相邻证据页。原机/浏览器呈现未验收。<a href="group-protection-chain.json">完整节点、关系、条件与证据</a>；主框架实施41/96＝42.71%（32包×3单元），建图增量0。</p><script>const model={"schemaVersion":1,"id":"group-ui-protection-vs-file-password","title":"Group界面保护与文件密码：跨页分析链","scope":"Enable-password and export-file finite routes only; edit/disable/import remain linked evidence views, not silently treated as this graph coverage.","entryCompletenessProved":false,"fullBehaviorClosed":false,"runtimeVerified":false,"currentImplementationCorrespondence":"Not mapped in this bounded chain; existing independent implementation views remain separate, not presumed equivalent or absent.","nodes":[{"id":"root","label":"主界面 / 工作流宿主","detail":"Group上下文实际激活仍未全证","x":700,"y":50,"lane":"common"},{"id":"uiMenu","label":"启用Group保护菜单","detail":"Command绑定声明","x":360,"y":165,"lane":"ui"},{"id":"uiCmd","label":"EnablePasswordCommand","detail":"getter / Execute代码","x":360,"y":275,"lane":"ui"},{"id":"setWin","label":"PasswordSetWindow","detail":"构造并ShowDialog","x":360,"y":385,"lane":"ui"},{"id":"ok","label":"btnOk_Click","detail":"原连接器有挂接代码","x":360,"y":495,"lane":"ui"},{"id":"predicate","label":"CheckPassword(first,repeat)","detail":"原始AND空白门 / 字符串比较","x":360,"y":605,"lane":"ui"},{"id":"result","label":"isPasswordOK=true","detail":"保存Password并Close","x":360,"y":715,"lane":"ui"},{"id":"guard","label":"调用者读IsPasswordOK","detail":"ShowDialog返回后条件","x":360,"y":825,"lane":"ui"},{"id":"writes","label":"按顺序写Group状态","detail":"先密码；再启用","x":360,"y":935,"lane":"ui"},{"id":"password","label":"PasswordA setter","detail":"缓存先变；再写字节","x":220,"y":1045,"lane":"ui"},{"id":"enabled","label":"IsPasswordEnabledA setter","detail":"前一setter正常返回后","x":580,"y":1045,"lane":"ui"},{"id":"userdata","label":"VMModule.UserData","detail":"生命周期 / 历史 / 分支","x":360,"y":1155,"lane":"ui"},{"id":"manager","label":"SDK SetUIParamValue","detail":"普通 / 动态设置","x":360,"y":1265,"lane":"ui"},{"id":"uiNative","label":"状态存储与落盘效果未知","detail":"无native/原机往返证明","x":360,"y":1375,"lane":"ui"},{"id":"inputFail","label":"空白 / 不一致提示","detail":"窗口内不接受本次输入","x":700,"y":605,"lane":"ui"},{"id":"guardFail","label":"不写Group状态","detail":"调用者条件不通过","x":700,"y":825,"lane":"ui"},{"id":"fileMenu","label":"导出Group菜单","detail":"本地 / 远程声明","x":1040,"y":165,"lane":"file"},{"id":"fileCmd","label":"ExportGroupCommandExecute","detail":"参数为路径/null密码","x":1040,"y":275,"lane":"file"},{"id":"iface","label":"IVMGroup.ExportFile","detail":"接口调用点","x":1040,"y":385,"lane":"file"},{"id":"impl","label":"选定IMVSGroup实现","detail":"运行接收者身份待核","x":1040,"y":495,"lane":"file"},{"id":"filePwd","label":"文件密码参数选择","detail":"显式参数 / ModuleFilePassword","x":1040,"y":605,"lane":"file"},{"id":"exportSdk","label":"CollectionManager.ExportGroup","detail":"ID / 固定level=0 / path / pwd","x":1040,"y":715,"lane":"file"},{"id":"fileNative","label":"原生容器与导出效果未知","detail":"托管PInvoke声明已取得","x":1040,"y":825,"lane":"file"},{"id":"fileCache","label":"文件路径/密码缓存","detail":"仅旧ModuleFilePath为空时写","x":1040,"y":935,"lane":"file"}],"edges":[{"id":"C01","from":"root","to":"uiMenu","relation":"host-activation-unknown","condition":null,"behavior":"资源和处理器已取；当前主窗实例到此上下文菜单的完整BAML/DataContext/路由未证明。","classification":"unknown","parents":[],"refs":[],"runtimeExecuted":false,"fullBehaviorClosed":false},{"id":"C02","from":"root","to":"fileMenu","relation":"host-activation-unknown","condition":null,"behavior":"文件菜单声明存在；宿主实际激活与接收对象仍未全证。","classification":"unknown","parents":[],"refs":[],"runtimeExecuted":false,"fullBehaviorClosed":false},{"id":"C03","from":"uiMenu","to":"uiCmd","relation":"binding-declaration","condition":null,"behavior":"资源明确绑定EnablePasswordCommand，getter构造指向对应Execute的委托。声明不是点击投递证明。","classification":"source-confirmed","parents":[{"view":"entry-routing-security","id":"E63","classification":"source-confirmed"}],"refs":[{"path":"analysis/decompiled/VMControls.WPF/base/diagramitemtempl