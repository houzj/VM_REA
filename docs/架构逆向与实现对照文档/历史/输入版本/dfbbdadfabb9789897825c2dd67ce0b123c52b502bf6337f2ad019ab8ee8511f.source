n\t\t{\n\t\t\tHikMessageBox.Show(ex3.Message, MessageIcons.Error);\n\t\t}\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMaster.Exe.Audit/app.config","member":"app.config distinct web/help/demo values","sha256":"9c5dbc6b41d66ec4e902400299808f5a68356fe35438fbc621444b053f4fea9d","start":52,"end":55,"excerpt":"    \u003cadd key=\"OnlineHelp\" value=\"https://www.hikrobotics.com/\" />\n    \u003cadd key=\"VClub\" value=\"https://www.v-club.com/home/\" />\n    \u003cadd key=\"OnlineHelpDoc\" value=\"http://pinfodata.hikvision.com/analysisQR/showQR/4e994cf1\" />\n    \u003cadd key=\"Demo\" value=\"\\Samples\\\" />","evidenceType":"local-extracted-resource","binaryIdentity":"not revalidated in this slice"}],"unknowns":["URL仅作为原配置证据保存，没有联网打开或验证远端内容/当前有效性。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"H04","route":"原版 · 帮助与版本","classification":"source-confirmed","from":"VerInfo → AboutMessageBox构造","to":"版本工具 / 数据源 / 品牌条件","behavior":"菜单新建关于窗；构造如工具存在就启动ToolsOfInternal/VersionInfoTool.exe并WaitForExit(5000)，未在此检查返回布尔再继续生成版本行。数据包含AppData版本、补丁、可选3D、算法和驱动信息；品牌/中性版可见性按源分支处理，不能把关于窗当纯静态文字。","refs":[{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.AppMainWindow/TitleMenueItemData.cs","member":"TitleMenueItemData.VerInfo","sha256":"b1c349c4808c0ce49c45e6fcca2972d370ed5a8f3e96ac51a157a680b42c9187","start":1032,"end":1038,"excerpt":"\tpublic void VerInfo()\n\t{\n\t\t//IL_0001: Unknown result type (might be due to invalid IL or missing references)\n\t\t//IL_0007: Expected Obj, but got Unknown\n\t\tAboutMessageBox val = new AboutMessageBox();\n\t\t((BaseWindow)(object)val).ShowDialog();\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMasterMain/VisionMaster.AppMainWindow/AboutMessageBox.xaml.cs","member":"AboutMessageBox constructor","sha256":"522bd7daa61cc52e0aadf58bb2626a8c3c67b9f12882e5efe41c623d88d7efbe","start":19,"end":92,"excerpt":"\tpublic AboutMessageBox()\n\t{\n\t\tInitializeComponent();\n\t\tAppData appData = AppDataFactory.Instance();\n\t\tShowInTaskbar = false;\n\t\tBitmapImage bitmapImage = new BitmapImage();\n\t\tbitmapImage.BeginInit();\n\t\tbitmapImage.UriSource = new Uri(AppDomain.CurrentDomain.BaseDirectory + \"Resources\\\\about_logo.png\", UriKind.RelativeOrAbsolute);\n\t\tbitmapImage.DecodePixelWidth = 374;\n\t\tbitmapImage.DecodePixelHeight = 80;\n\t\tbitmapImage.EndInit();\n\t\taboutLogoImg.Source = bitmapImage;\n\t\tusing (Process process = new Process())\n\t\t{\n\t\t\tstring text = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, \"ToolsOfInternal\\\\VersionInfoTool.exe\");\n\t\t\tif (File.Exists(text))\n\t\t\t{\n\t\t\t\tstring arguments = ConfigurationHelper.GetConfig(\"ApplicationName\") ?? \"VisionMaster\";\n\t\t\t\tprocess.StartInfo.FileName = text;\n\t\t\t\tprocess.StartInfo.Arguments = arguments;\n\t\t\t\tprocess.StartInfo.CreateNoWindow = true;\n\t\t\t\tprocess.StartInfo.UseShellExecute = false;\n\t\t\t\tprocess.Start();\n\t\t\t\tprocess.WaitForExit(5000);\n\t\t\t}\n\t\t}\n\t\tList\u003cVersionInfo> versionInfoList = new List\u003cVersionInfo>();\n\t\tAddVersionInfo(ref versionInfoList, \"版本信息\", \"VM\");\n\t\tif (CheckAdditionExist.IsExistAddition)\n\t\t{\n\t\t\tVersionInfo versionInfo = new VersionInfo\n\t\t\t{\n\t\t\t\tTitle = AppLocalizationService.GetLang(\"3D版本信息\"),\n\t\t\t\tValue = AppLocalizationService.GetLang(\"Lang_version3D\") + \" Build\" + appData.LastWriteTime\n\t\t\t};\n\t\t\tif (!string.IsNullOrEmpty(versionInfo.Value))\n\t\t\t{\n\t\t\t\tversionInfoList.Add(versionInfo);\n\t\t\t}\n\t\t}\n\t\tAddVersionInfo(ref versionInfoList, \"补丁版本信息\", \"VM_Patch\");\n\t\tAddAlgVersionInfo(ref versionInfoList, \"2D_OperatorVersion\", \"MVDAlgorithmSDK_2D\", \"ReferencedAssemblies\\\\Algorithms\\\\MVDVersionObtain.Net.dll\", \"Lang_2dSDKLoadFail\");\n\t\tAddVersionInfo(ref versionInfoList, \"2D算子补丁版本号\", \"MVDAlgorithmSDK_Patch\");\n\t\tif (CheckAdditionExist.IsExistAddition)\n\t\t{\n\t\t\tAddAlgVersionInfo(ref versionInfoList, \"3D_OperatorVersion\", \"MVDAlgorithmSDK_3D\", \"ReferencedAssemblies\\\\Algorithms\\\\MVDVersionObtain.Net.dll\", \"Get 3DAlogVersion Failed\");\n\t\t}\n\t\tAddAlgVersionInfo(ref versionInfoList, \"DL_OperatorVersion\", \"MVDAlgorithmSDK_DeepLearning\", \"ReferencedAssemblies\\\\Algorithms\\\\MVD_DLAlgorithm.Net.dll\", \"Lang_DLSDKLoadFail\");\n\t\tAddVersionInfo(ref versionInfoList, \"Lang_MVS_Driver_Version\", \"MVS_Drive\");\n\t\tAddVersionInfo(ref versionInfoList, \"MVS_Support_Version\", \"MVS_STD\");\n\t\tversionInfoListBox.ItemsSource = versionInfoList;\n\t\tif (appData.IsUseCustomCopyright)\n\t\t{\n\t\t\ttxtCopyright.Text = \"©\" + appData.CustomCopyright;\n\t\t}\n\t\tif (appData.IsHideCopyright)\n\t\t{\n\t\t\ttxtStatement.Visibility = Visibility.Hidden;\n\t\t\ttxtCopyright.Visibility = Visibility.Hidden;\n\t\t}\n\t\tif (appData.IsHideLogo)\n\t\t{\n\t\t\taboutLogoImg.Visibility = Visibility.Collapsed;\n\t\t}\n\t\tif (appData.IsNeutral)\n\t\t{\n\t\t\ttxtStatement.Visibility = Visibility.Hidden;\n\t\t\ttxtCopyright.Visibility = Visibility.Hidden;\n\t\t}\n\t\telse\n\t\t{\n\t\t\ttxtStatement.Visibility = Visibility.Visible;\n\t\t\ttxtCopyright.Visibility = Visibility.Visible;\n\t\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["工具内部、运行超时/完成与AppData版本来源仍开放；本轮未启动工具。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"H05","route":"原版 · 帮助与版本","classification":"source-confirmed","from":"AddVersionInfo / AddAlgVersionInfo","to":"AppData优先 / 文件版本回退 / @截断","behavior":"普通VM行取AppData.VersionInfo，其余GetVersionInfo；算法为空时从MVDALGO_DEV_ENV与指定DLL路径取FileVersionInfo并Regex提取版本/描述日期。GetBuildDate在@处截断；不是读取当前重建程序集版本。","refs":[{"path":"analysis/decompiled/VisionMasterMain/VisionMaster.AppMainWindow/AboutMessageBox.xaml.cs","member":"AboutMessageBox.AddVersionInfo/AddAlgVersionInfo/GetBuildDate","sha256":"522bd7daa61cc52e0aadf58bb2626a8c3c67b9f12882e5efe41c623d88d7efbe","start":95,"end":137,"excerpt":"\tprivate void AddVersionInfo(ref List\u003cVersionInfo> versionInfoList, string title, string verInfoKey)\n\t{\n\t\tVersionInfo versionInfo = new VersionInfo();\n\t\tversionInfo.Title = AppLocalizationService.GetLang(title);\n\t\tstring text = ((!(verInfoKey == \"VM\")) ? AppDataFactory.Instance().GetVersionInfo(verInfoKey) : AppDataFactory.Instance().VersionInfo);\n\t\tif (!string.IsNullOrEmpty(text))\n\t\t{\n\t\t\tversionInfo.Value = GetBuildDate(text);\n\t\t\tversionInfoList.Add(versionInfo);\n\t\t}\n\t}\n\n\tprivate void AddAlgVersionInfo(ref List\u003cVersionInfo> versionInfoList, string title, string verInfoKey, string dllPath, string errorKey)\n\t{\n\t\tVersionInfo versionInfo = new VersionInfo();\n\t\tversionInfo.Title = AppLocalizationService.GetLang(title);\n\t\tstring text = AppDataFactory.Instance().GetVersionInfo(verInfoKey);\n\t\tif (string.IsNullOrEmpty(text))\n\t\t{\n\t\t\ttry\n\t\t\t{\n\t\t\t\ttext = GetAlgorithmVersionInfo(dllPath);\n\t\t\t}\n\t\t\tcatch\n\t\t\t{\n\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(errorKey));\n\t\t\t}\n\t\t}\n\t\tif (!string.IsNullOrEmpty(text))\n\t\t{\n\t\t\tversionInfo.Value = GetBuildDate(text);\n\t\t\tversionInfoList.Add(versionInfo);\n\t\t}\n\t}\n\n\tprivate string GetBuildDate(string versionValue)\n\t{\n\t\tif (versionValue.IndexOf(\"@\") > -1)\n\t\t{\n\t\t\tversionValue = versionValue.Substring(0, versionValue.IndexOf(\"@\"));\n\t\t}\n\t\treturn versionValue;\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMasterMain/VisionMaster.AppMainWindow/AboutMessageBox.xaml.cs","member":"AboutMessageBox.GetBuildDate","sha256":"522bd7daa61cc52e0aadf58bb2626a8c3c67b9f12882e5efe41c623d88d7efbe","start":130,"end":137,"excerpt":"\tprivate string GetBuildDate(string versionValue)\n\t{\n\t\tif (versionValue.IndexOf(\"@\") > -1)\n\t\t{\n\t\t\tversionValue = versionValue.Substring(0, versionValue.IndexOf(\"@\"));\n\t\t}\n\t\treturn versionValue;\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMasterMain/VisionMaster.AppMainWindow/AboutMessageBox.xaml.cs","member":"AboutMessageBox.GetAlgorithmVersionInfo","sha256":"522bd7daa61cc52e0aadf58bb2626a8c3c67b9f12882e5efe41c623d88d7efbe","start":139,"end":160,"excerpt":"\tprivate string GetAlgorithmVersionInfo(string filePath)\n\t{\n\t\tstring result = \"\";\n\t\tstring environmentVariable = Environment.GetEnvironmentVariable(\"MVDALGO_DEV_ENV\");\n\t\tif (!string.IsNullOrEmpty(environmentVariable))\n\t\t{\n\t\t\tstring text = Path.Combine(environmentVariable, filePath);\n\t\t\tif (File.Exists(text))\n\t\t\t{\n\t\t\t\tFileVersionInfo versionInfo = FileVersionInfo.GetVersionInfo(text);\n\t\t\t\tstring value = Regex.Match(versionInfo.FileVersion, \"\\\\d+.\\\\d+.\\\\d+.\\\\d+\").Value;\n\t\t\t\tstring text2 = Regex.Match(versionInfo.FileDescription, \"\\\\d{4}/\\\\d{2}/\\\\d{2}\").Value.Replace(\"/\", \"\");\n\t\t\t\tif (!string.IsNullOrEmpty(value) && !string.IsNullOrEmpty(text2))\n\t\t\t\t{\n\t\t\t\t\tresult = \"V\" + value + \" Build\" + text2;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn result;\n\t}\n}\n","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["环境、DLL实际版本/格式、完整外部版本工具读写仍未验证。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"S01","route":"原版 · 示例方案","classification":"source-confirmed","from":"OpenSamples","to":"忙状态门 → GuideHelper.OpenSolution → LoadSolution","behavior":"创建/保存/加载时拒绝；否则打开样例选择器，File.Exists(path)才调静态LoadSolution，后者StopRun再调ProjectManager.LoadSolution。返回后还调用CloseGlobalScriptWindow；取消选择不代表这个后续调用被跳过。","refs":[{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.AppMainWindow/TitleMenueItemData.cs","member":"TitleMenueItemData.OpenSamples/LoadSolution","sha256":"b1c349c4808c0ce49c45e6fcca2972d370ed5a8f3e96ac51a157a680b42c9187","start":509,"end":532,"excerpt":"\tpublic void OpenSamples()\n\t{\n\t\tif (!ProjectManager.GetInstance().IsCreating && !((IVmSolution)VmSolution.Instance).IsSaving && !((IVmSolution)VmSolution.Instance).IsLoading)\n\t\t{\n\t\t\tLogHelper.Info(\"OpenSamples\");\n\t\t\tUILogManager.logCreate(\"信息\", \"Lang_OpenExmSol\", true, true);\n\t\t\tstring path = default;\n\t\t\tGuideHelper.OpenSolution(true, ref path);\n\t\t\tif (File.Exists(path))\n\t\t\t{\n\t\t\t\tLoadSolution(path);\n\t\t\t}\n\t\t\tCloseGlobalScriptWindow();\n\t\t}\n\t}\n\n\tpublic static void LoadSolution(string path)\n\t{\n\t\tStopRun();\n\t\tLogHelper.Info(\"OpenSolution\");\n\t\tProjectManager.GetInstance().LoadSolution(path);\n\t}\n\n\tpublic void SaveSolution()","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"S02","route":"原版 · 示例方案","classification":"source-confirmed","from":"GuideHelper.OpenSolution(opendemo)","to":"INI OpenSample / Demo默认目录 / 选择结果与finally","behavior":"flag初始false，仅opendemo且目录存在置true；目录优先INI值，只有null才回退Base+Demo，空字符串不当null。flag时ShowDialog不检查结果，先取FileName并INISet目录、Dispose，再检查空文件名；finally再Dispose。false分支也保留，不按常规文件选择器补行为。","refs":[{"path":"analysis/decompiled/VisionMasterMain/VisionMaster.AppMainWindow/GuideHelper.cs","member":"GuideHelper.OpenSolution","sha256":"275ef68fc4b955884e70821168d534c00cc45aff5237f902513a61157ef45321","start":68,"end":111,"excerpt":"\tpublic static bool OpenSolution(bool opendemo, out string filename)\n\t{\n\t\tbool flag = false;\n\t\tOpenFileDialog openFileDialog = new OpenFileDialog\n\t\t{\n\t\t\tFilter = string.Format($\"{0}|*.{AppFileExtension.Solution}\", opendemo ? AppLocalizationService.GetLang(\"示例方案\") : AppLocalizationService.GetLang(\"方案\"))\n\t\t};\n\t\ttry\n\t\t{\n\t\t\tif (opendemo)\n\t\t\t{\n\t\t\t\tstring text = ConfigurationHelper.INIGetStringValue(\"OpenSample\");\n\t\t\t\tstring path = ((text == null) ? (AppDomain.CurrentDomain.SetupInformation.ApplicationBase + ConfigurationHelper.GetConfig(\"Demo\")) : text);\n\t\t\t\tDirectoryInfo directoryInfo = new DirectoryInfo(path);\n\t\t\t\tif (directoryInfo.Exists)\n\t\t\t\t{\n\t\t\t\t\topenFileDialog.InitialDirectory = directoryInfo.FullName;\n\t\t\t\t\tflag = true;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Not_Installed_Samples\"));\n\t\t\t\t\tflag = false;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (flag)\n\t\t\t{\n\t\t\t\topenFileDialog.ShowDialog();\n\t\t\t\tfilename = openFileDialog.FileName;\n\t\t\t\tConfigurationHelper.INISetStringValue(\"OpenSample\", Path.GetDirectoryName(filename));\n\t\t\t\topenFileDialog.Dispose();\n\t\t\t\tif (string.IsNullOrEmpty(filename))\n\t\t\t\t{\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t\treturn true;\n\t\t\t}\n\t\t\tfilename = \"\";\n\t\t\treturn false;\n\t\t}\n\t\tfinally\n\t\t{\n\t\t\topenFileDialog.Dispose();\n\t\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMaster.Exe.Audit/app.config","member":"app.config Demo","sha256":"9c5dbc6b41d66ec4e902400299808f5a68356fe35438fbc621444b053f4fea9d","start":55,"end":55,"excerpt":"    \u003cadd key=\"Demo\" value=\"\\Samples\\\" />","evidenceType":"local-extracted-resource","binaryIdentity":"not revalidated in this slice"}],"unknowns":["选择器取消路径与INI空目录写入/异常未运行验证；不实际打开原文件或写INI。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"R01","route":"原版 · 最近方案","classification":"source-confirmed","from":"GetRecentlySolutions 动态菜单","to":"FileName / ToolTip路径 → OpenRecentSolution","behavior":"菜单从ProjectManager.RecentlySolutions动态生成，显示FileName，ToolTip保存实际路径；点击取ToolTip。OpenRecentSolution拒绝创建/保存/加载态，StopRun后调LoadSolution并返回其bool。与欢迎页选择命令不同。","refs":[{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.AppMainWindow/TitleMenueItemData.cs","member":"TitleMenueItemData recent commands/factory","sha256":"b1c349c4808c0ce49c45e6fcca2972d370ed5a8f3e96ac51a157a680b42c9187","start":476,"end":504,"excerpt":"\tpublic void OpenRecentlySolution()\n\t{\n\t\tOpenRecentSolution(ToolTip);\n\t}\n\n\tprivate static bool OpenRecentSolution(string path)\n\t{\n\t\tif (ProjectManager.GetInstance().IsCreating || ((IVmSolution)VmSolution.Instance).IsSaving || ((IVmSolution)VmSolution.Instance).IsLoading)\n\t\t{\n\t\t\treturn false;\n\t\t}\n\t\tStopRun();\n\t\tLogHelper.Info(\"OpenRecentSolution path: \" + path);\n\t\tUILogManager.logCreate(\"信息\", AppLocalizationService.GetLang(\"Lang_OpenLastSol\") ?? \"\", false, true);\n\t\treturn ProjectManager.GetInstance().LoadSolution(path);\n\t}\n\n\tpublic static List\u003cItemData> GetRecentlySolutions()\n\t{\n\t\treturn ProjectManager.GetInstance().RecentlySolutions.Select((SolutionItemInfo p) => new TitleMenueItemData\n\t\t{\n\t\t\tname = p.FileName,\n\t\t\tmethodName = \"OpenRecentlySolution\",\n\t\t\tisSolutionPath = true,\n\t\t\ttoolTip = p.SolutionPath\n\t\t}).OfType\u003cItemData>().ToList();\n\t}\n\n\tpublic void RefreshRecentSolution()","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"R02","route":"原版 · 最近方案","classification":"source-confirmed","from":"ProjectManager.GetRecentlySolutions / SolutionItemInfo","to":"应用cfg XML → 缓存 → 99天过滤/排序","behavior":"首次加载ApplicationName.cfg的ArrayOfSolutionItemInfo，root空返回null；之后从缓存移除GeTimeSpan().Days>99，再按LastTime降序复制。时间差取Duration，因此未来时间也按绝对差处理；本getter没有Save，过滤缓存不等于已落盘。","refs":[{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/ProjectManager.cs","member":"ProjectManager.GetRecentlySolutions","sha256":"1ae41a0841dd65f5dfa7461078c370822e61826877c42e299939af1fd47f9370","start":864,"end":880,"excerpt":"\tpublic static List\u003cSolutionItemInfo> GetRecentlySolutions()\n\t{\n\t\tif (_recentlySolutions == null)\n\t\t{\n\t\t\tstring uri = Path.Combine(AppDomain.CurrentDomain.SetupInformation.ApplicationBase, ConfigurationHelper.GetConfig(\"ApplicationName\") + \".cfg\");\n\t\t\tXDocument xDocument = XDocument.Load(uri);\n\t\t\tif (xDocument.Root == null)\n\t\t\t{\n\t\t\t\treturn null;\n\t\t\t}\n\t\t\tXElement xElement = xDocument.Root.Elements().SingleOrDefault((XElement p) => p.Name == \"ArrayOfSolutionItemInfo\");\n\t\t\t_recentlySolutions = ((xElement == null) ? new List\u003cSolutionItemInfo>() : xElement.DeSerialization\u003cList\u003cSolutionItemInfo>>());\n\t\t}\n\t\t_recentlySolutions.RemoveAll((SolutionItemInfo p) => p.GeTimeSpan().Days > 99);\n\t\treturn _recentlySolutions.OrderByDescending((SolutionItemInfo p) => p.LastTime).ToList();\n\t}\n","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/SolutionItemInfo.cs","member":"SolutionItemInfo.GeTimeSpan","sha256":"35c37e2dce6b6f6aef2ead51c3da56552a5877c23a6cfeba62c9ea7ab2b58a87","start":99,"end":102,"excerpt":"\tpublic TimeSpan GeTimeSpan()\n\t{\n\t\treturn new TimeSpan(DateTime.Now.Ticks).Subtract(new TimeSpan(LastTime.Ticks)).Duration();\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["XML反序列化完整合同、时区/时钟变化和读取异常未运行验证。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"R03","route":"原版 · 最近方案","classification":"source-confirmed","from":"UpdateRecentlySolutions / SaveRecentlySolutions","to":"大小写敏感路径匹配 / 单项淘汰 / XML保存","behavior":"更新以原字符串相等找路径，存在只改时间；新增时缓存Count>5仅移除排序结果最后一项，再插入首位，不对超大旧列表反复截断。Save删除旧XML元素再加序列化列表，catch只日志；之后刷新菜单，即使保存失败内存也可能已变。","refs":[{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/ProjectManager.cs","member":"ProjectManager.UpdateRecentlySolutions","sha256":"1ae41a0841dd65f5dfa7461078c370822e61826877c42e299939af1fd47f9370","start":900,"end":927,"excerpt":"\tpublic static void UpdateRecentlySolutions(string solutionpath)\n\t{\n\t\tif (string.IsNullOrEmpty(solutionpath))\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tList\u003cSolutionItemInfo> recentlySolutions = GetRecentlySolutions();\n\t\tSolutionItemInfo solutionItemInfo = recentlySolutions.FirstOrDefault((SolutionItemInfo p) => p.SolutionPath == solutionpath);\n\t\tif (solutionItemInfo != null)\n\t\t{\n\t\t\tsolutionItemInfo.LastTime = DateTime.Now;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tsolutionItemInfo = new SolutionItemInfo\n\t\t\t{\n\t\t\t\tSolutionPath = solutionpath,\n\t\t\t\tLastTime = DateTime.Now\n\t\t\t};\n\t\t\tif (_recentlySolutions.Count > 5)\n\t\t\t{\n\t\t\t\t_recentlySolutions.Remove(recentlySolutions[recentlySolutions.Count - 1]);\n\t\t\t}\n\t\t\t_recentlySolutions.Insert(0, solutionItemInfo);\n\t\t}\n\t\tSaveRecentlySolutions();\n\t\tProgram.MainData.RefreshRecentSolution();\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/ProjectManager.cs","member":"ProjectManager.SaveRecentlySolutions","sha256":"1ae41a0841dd65f5dfa7461078c370822e61826877c42e299939af1fd47f9370","start":881,"end":899,"excerpt":"\tpublic static void SaveRecentlySolutions()\n\t{\n\t\ttry\n\t\t{\n\t\t\tstring uri = Path.Combine(AppDomain.CurrentDomain.SetupInformation.ApplicationBase, ConfigurationHelper.GetConfig(\"ApplicationName\") + \".cfg\");\n\t\t\tXDocument xDocument = XDocument.Load(uri);\n\t\t\tif (xDocument.Root != null)\n\t\t\t{\n\t\t\t\txDocument.Root.Elements().SingleOrDefault((XElement p) => p.Name == \"ArrayOfSolutionItemInfo\")?.Remove();\n\t\t\t\txDocument.Root.Add(GetRecentlySolutions().ToXElement(omitXmlDeclaration: true));\n\t\t\t\tConfigurationHelper.SaveConfig(xDocument);\n\t\t\t}\n\t\t}\n\t\tcatch (Exception ex)\n\t\t{\n\t\t\tLogHelper.Error(\"Save recent solutions error.\" + ex.Message);\n\t\t}\n\t}\n","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["路径规范化、损坏XML/超额缓存和配置写入错误的原机结果仍开放。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"R04","route":"原版 · 最近方案","classification":"source-confirmed","from":"RemoveSolution / RemoveRecentSolution","to":"失败路径选择 → Yes后移除 → 保存/刷新","behavior":"RemoveSolution可从RecentSolution补path，清该字段后检查列表，启动线程再Dispatcher询问；Yes才RemoveRecentSolution。后者按路径字符串相等删全部匹配，Save和Refresh分开，不把磁盘文件删除与最近列表删除混同。","refs":[{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/ProjectManager.cs","member":"ProjectManager.RemoveSolution","sha256":"1ae41a0841dd65f5dfa7461078c370822e61826877c42e299939af1fd47f9370","start":957,"end":990,"excerpt":"\tpublic static bool RemoveSolution(string path, string erroinfo = null)\n\t{\n\t\tif (string.IsNullOrEmpty(path) && RecentSolution != null)\n\t\t{\n\t\t\tpath = RecentSolution.SolutionPath;\n\t\t}\n\t\tRecentSolution = null;\n\t\tif (!ExistRecentlySolution(path))\n\t\t{\n\t\t\treturn false;\n\t\t}\n\t\tstring[] msg = ((!string.IsNullOrEmpty(erroinfo)) ? new string[2]\n\t\t{\n\t\t\terroinfo,\n\t\t\tAppLocalizationService.GetLang(\"Lang_SolRM\")\n\t\t} : new string[1] { AppLocalizationService.GetLang(\"Lang_SolOpenErrtoRM\") });\n\t\tThread thread = new Thread(() =>\n\t\t{\n\t\t\tApplication.Current.Dispatcher.Invoke(() =>\n\t\t\t{\n\t\t\t\tif (HikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_SolOpenErr\"), msg, MessageButtons.YesOrNo, MessageIcons.Error) == DialogResult.Yes)\n\t\t\t\t{\n\t\t\t\t\tRemov