\t\t{\n\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_LangLack\"), MessageIcons.Warning);\n\t\t\t\tLogHelper.Error(\"语言资源缺失\");\n\t\t\t}\n\t\t\ttry\n\t\t\t{\n\t\t\t\tProcessStartInfo processStartInfo = new ProcessStartInfo();\n\t\t\t\tprocessStartInfo.FileName = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, text);\n\t\t\t\tprocessStartInfo.WindowStyle = ProcessWindowStyle.Maximized;\n\t\t\t\tprocessStartInfo.WorkingDirectory = text;\n\t\t\t\tProcess.Start(processStartInfo);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tcatch (Exception)\n\t\t\t{\n\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"Lang_HelpFileLack\"), MessageIcons.Warning);\n\t\t\t\tLogHelper.Error(\"帮助文档缺失\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\t\tstring key = (local ? \"LocalHelp\" : \"OnlineHelp\");\n\t\tstring text2 = ConfigurationHelper.GetConfig(key);\n\t\tif (AppLocalizationService.GetLang(\"Language\") == \"English\")\n\t\t{\n\t\t\ttext2 += \"en\";\n\t\t}\n\t\ttry","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMasterMain/VisionMaster.AppMainWindow/GuideHelper.cs","member":"GuideHelper.GetHelpPathFile","sha256":"275ef68fc4b955884e70821168d534c00cc45aff5237f902513a61157ef45321","start":194,"end":197,"excerpt":"\tpublic static string GetHelpPathFile(bool ifMeu = false)\n\t{\n\t\treturn ConfigurationHelper.GetConfig(ifMeu ? \"HelpDocNeu\" : \"HelpDocStd\");\n\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMaster.Exe.Audit/app.config","member":"app.config help localization keys","sha256":"9c5dbc6b41d66ec4e902400299808f5a68356fe35438fbc621444b053f4fea9d","start":57,"end":58,"excerpt":"    \u003cadd key=\"HelpDocStd\" value=\"help_doc_std\" />\n    \u003cadd key=\"HelpDocNeu\" value=\"help_doc_neu\" />","evidenceType":"local-extracted-resource","binaryIdentity":"not revalidated in this slice"}],"unknowns":["实际资源路径、进程关联