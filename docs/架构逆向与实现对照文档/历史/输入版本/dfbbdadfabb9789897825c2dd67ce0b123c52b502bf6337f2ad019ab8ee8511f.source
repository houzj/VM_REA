\n\t\t\t\t\t\t\tif (!File.Exists(text3))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"升级失败\"), AppLocalizationService.GetLang(infoKey), MessageIcons.Warning);\n\t\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tfilename = text3;\n\t\t\t\t\t\t\tflag3 = true;","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["兼容工具内部、参数分隔/编码、输出管道等待、失败后清理与所有版本格式未知。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"V03","route":"原版 · 加载与迁移侧链","classification":"source-confirmed","from":"迁移输出存在 / filename替换","to":"VmSolution.Load → 当前路径/最近列表","behavior":"输出存在才把filename换新路径并flag3=true；后续登记历史，非IsLoading才VmSolution.Load，异常提示返回。继续更新当前方案路径/名称与最近列表，flag4/flag3决定升级提示或清当前文件名；不能以Task.Start或输出存在证明已加载完成。","refs":[{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/ProjectManager.cs","member":"ProjectManager migrated filename","sha256":"1ae41a0841dd65f5dfa7461078c370822e61826877c42e299939af1fd47f9370","start":713,"end":715,"excerpt":"\t\t\t\t\t\t\tfilename = text3;\n\t\t\t\t\t\t\tflag3 = true;\n\t\t\t\t\t\t}","evidenceType":"local-decompiled-source","binaryIdentity":"not revalidated in this slice"},{"path":"analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster.Project/ProjectManager.cs","member":"ProjectManager load effects","sha256":"1ae41a0841dd65f5dfa7461078c370822e61826877c42e299939af1fd47f9370","start":726,"end":760,"excerpt":"\t\t\t\t\t\t\tif (!((IVmSolution)VmSolution.Instance).IsLoading)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tVmSolution.Load(filename, passWord);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tcatch (VmException vmException2)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tShowMessage.ShowVmExceptionMessage(vmException2);\n\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tcatch (Exception ex)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tHikMessageBox.Show(ex.Message);\n\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t}\n\t\t\t\