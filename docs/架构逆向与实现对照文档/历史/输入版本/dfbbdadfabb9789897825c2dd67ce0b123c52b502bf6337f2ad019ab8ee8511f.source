助文档（在线）\",OpenOnlineHelpDocument),(\"关于\",ShowAbout));","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellHelp.cs","member":"Current online help launch","sha256":"2e814f81fe5554c5d0e079bdbf9855ad8adc294438cf53359be7483e4882da4b","start":9,"end":21,"excerpt":"    const string OnlineHelpDocumentUrl = \"http://pinfodata.hikvision.com/analysisQR/showQR/4e994cf1\";\n\n    // An operation seam lets WPF route tests observe the real menu action without\n    // launching an external browser. Production uses the Windows shell association.\n    Action\u003cstring> onlineHelpLauncher = LaunchOnlineHelp;\n\n    void OpenOnlineHelpDocument() => onlineHelpLauncher(OnlineHelpDocumentUrl);\n\n    static void LaunchOnlineHelp(string url) => Process.Start(new ProcessStartInfo(url)\n    {\n        UseShellExecute = true\n    });\n}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C02","route":"当前 · 独立帮助与版本","classification":"independent-implementation","from":"ShowAbout / ShellAboutWindow","to":"重建程序集版本三行","behavior":"当前创建Owner关于窗，版本来自编辑器、框架和核心程序集Assembly.GetName.Version；本地ui-assets logo存在才显示。不运行原VersionInfoTool，也不冒充AppData/算法驱动版本。","refs":[{"path":"src/VisionEditor/MainWindow.ShellAbout.cs","member":"MainWindow.ShowAbout","sha256":"124f760bee167974ed8655e91360e800988a7b5174718e011aa076388ef85102","start":5,"end":9,"excerpt":"    void ShowAbout()\n    {\n        var window = new ShellAboutWindow { Owner = this };\n        window.ShowDialog();\n    }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/ShellAboutWindow.xaml.cs","member":"ShellAboutWindow version rows","sha256":"e12a17378fab282295234ae83ea7b783a39e9a60c3244dc7493b6e3d489192fb","start":11,"end":26,"excerpt":"    public ShellAboutWindow()\n    {\n        InitializeComponent();\n        VersionInfoList.ItemsSource = new[]\n        {\n            new VersionRow(\"版本信息\", VersionOf(typeof(MainWindow).Assembly)),\n            new VersionRow(\"框架版本\", VersionOf(typeof(VisionFramework.ModuleRegistry).Assembly)),\n            new VersionRow(\"编辑器核心版本\", VersionOf(typeof(VisionEditor.Core.GraphEditorDocument).Assembly))\n        };\n        var logo = System.IO.Path.Combine(AppContext.BaseDirectory, \"ui-assets\", \"logo_vm.png\");\n        if (System.IO.File.Exists(logo)) AboutLogo.Source = new BitmapImage(new Uri(logo));\n    }\n\n    static string VersionOf(Assembly assembly) => assembly.GetName().Version?.ToString() ?? \"未知\";\n}\n","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/ShellAboutWindow.xaml.cs","member":"ShellAboutWindow.VersionOf","sha256":"e12a17378fab282295234ae83ea7b783a39e9a60c3244dc7493b6e3d489192fb","start":24,"end":24,"excerpt":"    static string VersionOf(Assembly assembly) => assembly.GetName().Version?.ToString() ?? \"未知\";","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C03","route":"当前 · 独立示例与最近方案","classification":"independent-implementation","from":"OpenSampleSolution / SampleDirectoryPreference","to":"独立JSON选择器 / 记目录 / 执行与改动门 / doc.Load","behavior":"选择器支持vmx.json/json，目录从用户sample-directory.txt读，IO失败回BaseDirectory；选中后先记目录，再查文件、停止连续标志、拒绝activeRun、确认未保存改动，再doc.Load并更新最近菜单。此独立合同不等于原.sol/INI选择器。","refs":[{"path":"src/VisionEditor/MainWindow.ShellSampleSelection.cs","member":"NativeSampleSolutionPicker.Pick","sha256":"19c1091f37b6327417b5ae834ff10ecfe2533b67ace02088367d3f71f2d0466c","start":14,"end":24,"excerpt":"    public string? Pick(MainWindow owner, string initialDirectory)\n    {\n        var dialog = new OpenFileDialog\n        {\n            Title = \"打开示例方案\",\n            Filter = \"示例方案|*.vmx.json;*.json\",\n            InitialDirectory = initialDirectory,\n            CheckFileExists = true\n        };\n        return dialog.ShowDialog(owner) == true ? dialog.FileName : null;\n    }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellSampleSelection.cs","member":"SampleDirectoryPreference.InitialDirectory/Remember","sha256":"19c1091f37b6327417b5ae834ff10ecfe2533b67ace02088367d3f71f2d0466c","start":33,"end":56,"excerpt":"    internal static string InitialDirectory()\n    {\n        try\n        {\n            if (File.Exists(FilePath))\n            {\n                var saved = File.ReadAllText(FilePath).Trim();\n                if (Directory.Exists(saved)) return saved;\n            }\n        }\n        catch (IOException) { }\n        return AppContext.BaseDirectory;\n    }\n\n    internal static void Remember(string file)\n    {\n        var directory = Path.GetDirectoryName(Path.GetFullPath(file))!;\n        Directory.CreateDirectory(Path.GetDirectoryName(FilePath)!);\n        File.WriteAllText(FilePath, directory);\n    }\n}\n\npublic partial class MainWindow\n{","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellSampleSelection.cs","member":"MainWindow.OpenSampleSolution","sha256":"19c1091f37b6327417b5ae834ff10ecfe2533b67ace02088367d3f71f2d0466c","start":64,"end":77,"excerpt":"    void OpenSampleSolution()\n    {\n        var path = sampleSolutionPicker.Pick(this, SampleDirectoryPreference.InitialDirectory());\n        if (string.IsNullOrWhiteSpace(path)) return;\n        SampleDirectoryPreference.Remember(path);\n        if (!File.Exists(path)) { StatusText.Text = \"示例方案文件不存在\"; return; }\n        // The native OpenSamples delegates to LoadSolution, which stops continuous run.\n        continuousRun = false;\n        if (activeRun is not null) { StatusText.Text = \"请等待当前流程运行结束\"; return; }\n        if (!ConfirmPendingChanges()) return;\n        doc.Load(path);\n        RecentSolutionStore.Update(doc.FilePath!);\n        RefreshRecentSolutionsMenu();\n    }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C04","route":"当前 · 独立示例与最近方案","classification":"independent-implementation","from":"RecentSolutionStore","to":"用户JSON / 缓存 / 时间过滤 / 路径去重与6项限制","behavior":"当前从LocalApplicationData/VisionEditor/recent-solutions.json读，捕获JSON/IO/权限异常返回空；按Duration.Days\u003c=99过滤/排序。Update先GetFullPath，OrdinalIgnoreCase去重后Prepend+Take(6)，与原字符串相等及单项淘汰不同；写失败仅Trace，内存可继续更新。","refs":[{"path":"src/VisionEditor/MainWindow.ShellRecentSolutions.cs","member":"RecentSolutionStore identity/cache","sha256":"c79b0e63c9133f9270763e696596c694a757caf4f4ac1f9b3e589b3bd5e8cdae","start":12,"end":16,"excerpt":"    static string filePath = Path.Combine(\n        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),\n        \"VisionEditor\", \"recent-solutions.json\");\n    static Entry[]? entries;\n","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellRecentSolutions.cs","member":"RecentSolutionStore.Read/Update","sha256":"c79b0e63c9133f9270763e696596c694a757caf4f4ac1f9b3e589b3bd5e8cdae","start":30,"end":62,"excerpt":"    internal static IReadOnlyList\u003cEntry> Read()\n    {\n        if (entries is null)\n        {\n            try\n            {\n                entries = File.Exists(FilePath)\n                    ? JsonSerializer.Deserialize\u003cEntry[]>(File.ReadAllText(FilePath)) ?? [] : [];\n            }\n            catch (JsonException) { return []; }\n            catch (IOException) { return []; }\n            catch (UnauthorizedAccessException) { return []; }\n        }\n        // SolutionItemInfo.GeTimeSpan uses Duration, including future timestamps.\n        var now = DateTime.Now;\n        entries = entries.Where(entry => (now - entry.LastTime).Duration().Days \u003c= 99)\n            .OrderByDescending(entry => entry.LastTime).ToArray();\n        return entries;\n    }\n\n    internal static void Update(string path)\n    {\n        if (string.IsNullOrWhiteSpace(path)) return;\n        var full = System.IO.Path.GetFullPath(path);\n        entries = Read().Where(entry => !string.Equals(entry.Path, full, StringComparison.OrdinalIgnoreCase))\n            .Prepend(new Entry(full, DateTime.Now)).Take(6).ToArray();\n        Persist();\n    }\n\n    internal static void Remove(string path)\n    {\n        entries = Read().Where(entry => !string.Equals(entry.Path, path, StringComparison.OrdinalIgnoreCase)).ToArray();\n        Persist();","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellRecentSolutions.cs","member":"RecentSolutionStore.Remove/Persist","sha256":"c79b0e63c9133f9270763e696596c694a757caf4f4ac1f9b3e589b3bd5e8cdae","start":59,"end":79,"excerpt":"    internal static void Remove(string path)\n    {\n        entries = Read().Where(entry => !string.Equals(entry.Path, path, StringComparison.OrdinalIgnoreCase)).ToArray();\n        Persist();\n    }\n\n    static void Persist()\n    {\n        // ProjectManager publishes its in-memory recent list even if SaveRecentlySolutions fails.\n        try\n        {\n            Directory.CreateDirectory(System.IO.Path.GetDirectoryName(FilePath)!);\n            File.WriteAllText(FilePath, JsonSerializer.Serialize(entries));\n        }\n        catch (IOException ex) { System.Diagnostics.Trace.TraceWarning(\"Save recent solutions: \" + ex.Message); }\n        catch (UnauthorizedAccessException ex) { System.Diagnostics.Trace.TraceWarning(\"Save recent solutions: \" + ex.Message); }\n    }\n}\n\npublic partial class MainWindow\n{","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"C05","route":"当前 · 独立示例与最近方案","classification":"independent-implementation","from":"当前最近菜单SubmenuOpened / Click","to":"刷新 → 执行/改动门 → 缺失询问或doc.Load","behavior":"每次展开重建条目；点击Safe包装OpenRecentSolution，先清连续标志、拒绝activeRun、确认改动，再文件缺失询问删除最近记录，否则doc.Load并Update/Refresh。没有用原ToolTip反射或欢迎页临时选择。","refs":[{"path":"src/VisionEditor/MainWindow.ShellRecentSolutions.cs","member":"MainWindow recent menu setup/refresh","sha256":"c79b0e63c9133f9270763e696596c694a757caf4f4ac1f9b3e589b3bd5e8cdae","start":82,"end":107,"excerpt":"    void InitializeRecentSolutionsMenu(MenuItem fileMenu)\n    {\n        recentSolutionsMenu = new MenuItem { Header = \"最近打开\" };\n        recentSolutionsMenu.SubmenuOpened += (_, _) => RefreshRecentSolutionsMenu();\n        fileMenu.Items.Add(recentSolutionsMenu);\n        RefreshRecentSolutionsMenu();\n    }\n\n    void RefreshRecentSolutionsMenu()\n    {\n        if (recentSolutionsMenu is null) return;\n        recentSolutionsMenu.Items.Clear();\n        foreach (var entry in RecentSolutionStore.Read())\n        {\n            var item = new MenuItem { Header = System.IO.Path.GetFileNameWithoutExtension(entry.Path), ToolTip = entry.Path, Tag = entry.Path,\n                Style = (System.Windows.Style)FindResource(\"ShellFileMenuItem\") };\n            item.Click += (_, _) => Safe(() => OpenRecentSolution(entry.Path));\n            recentSolutionsMenu.Items.Add(item);\n        }\n        recentSolutionsMenu.IsEnabled = recentSolutionsMenu.Items.Count > 0;\n    }\n\n    void OpenRecentSolution(string path)\n    {\n        continuousRun = false;\n        if (activeRun is not null) { StatusText.Text = \"请等待当前流程运行结束\"; return; }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.ShellRecentSolutions.cs","member":"MainWindow.OpenRecentSolution","sha256":"c79b0e63c9133f9270763e696596c694a757caf4f4ac1f9b3e589b3bd5e8cdae","start":104,"end":122,"excerpt":"    void OpenRecentSolution(string path)\n    {\n        continuousRun = false;\n        if (activeRun is not null) { StatusText.Text = \"请等待当前流程运行结束\"; return; }\n        if (!ConfirmPendingChanges()) return;\n        if (!File.Exists(path))\n        {\n            if (MessageBox.Show(this, \"方案文件不存在。是否从最近打开中移除？\", \"打开方案\",\n                    MessageBoxButton.YesNo, MessageBoxImage.Question) == MessageBoxResult.Yes)\n                RecentSolutionStore.Remove(path);\n            RefreshRecentSolutionsMenu();\n            return;\n        }\n        doc.Load(path);\n        RecentSolutionStore.Update(path);\n        RefreshRecentSolutionsMenu();\n    }\n}\n","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":[],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"U01","route":"未闭合 · 完整入口与运行","classification":"unknown","from":"菜单/欢迎页/升级任务/外部关联","to":"全部模式、输入路由与当前实现对应","behavior":"这组入口已细化，不证明全部帮助资源/进程/文件关联、欢迎页关闭后选择消费、升级工具内部或当前原生兼容已经恢复。","refs":[],"unknowns":["兼容工具Main/方案调度原CIL已在compatibility-tool细化；具体转换助手、主程序生成闭包CIL、真实BAML及受控副本验证仍开放。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}},{"id":"U02","route":"未闭合 · 资源与原生效果","classification":"unknown","from":"静态路径、配置和文件存在","to":"帮助有效性 / 迁移/加载/保存完整行为","behavior":"配置值和File.Exists只是分支证据，不验证网站、帮助安装、版本工具输出、转换正确性或原.sol往返。当前JSON存储不标为原生迁移实现。","refs":[],"unknowns":["浏览器本页呈现仍未验收；原SDK、硬件、配置写入、进程操作和网站访问未执行。"],"verification":{"method":"static resource, body and call-site inspection","runtimeExecuted":false,"nativeEquivalent":false}}],"hierarchy":{"title":"主界面","kind":"ui-root","organization":"independent-reading-organizatio