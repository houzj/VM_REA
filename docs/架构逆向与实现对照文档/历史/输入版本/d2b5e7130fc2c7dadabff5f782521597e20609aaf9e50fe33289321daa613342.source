          "start": 151,
          "end": 192,
          "excerpt": "\tpublic void AddTrigger(object obj)\n\t{\n\t\tbool flag = obj.ToString() == \"0\";\n\t\tComTriggerItem comTriggerItem;\n\t\tif (flag)\n\t\t{\n\t\t\tif (CommEventTriggerA.Count >= MaxTriEventItemCount)\n\t\t\t{\n\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"最多添加\") + \" :\" + MaxTriEventItemCount, MessageButtons.Normal, MessageIcons.Warning);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tcomTriggerItem = new GlobalTriggerEventItem(this);\n\t\t\tcomTriggerItem.Index = CommEventTriggerA.Count + 1;\n\t\t\tWeakEventManager<GlobalTriggerEventItem, PropertyChangedEventArgs>.AddHandler((GlobalTriggerEventItem)comTriggerItem, \"PropertyChanged\", ValueChanged);\n\t\t}\n\t\telse\n\t\t{\n\t\t\tif (CommStrTriggerA.Count >= MaxTriStrItemCount)\n\t\t\t{\n\t\t\t\tHikMessageBox.Show(AppLocalizationService.GetLang(\"最多添加\") + \" :\" + MaxTriStrItemCount, MessageButtons.Normal, MessageIcons.Warning);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tcomTriggerItem = new GlobalTriggerStrItem(this);\n\t\t\tcomTriggerItem.Index = CommStrTriggerA.Count + 1;\n\t\t\tWeakEventManager<GlobalTriggerStrItem, PropertyChangedEventArgs>.AddHandler((GlobalTriggerStrItem)comTriggerItem, \"PropertyChanged\", ValueChanged);\n\t\t}\n\t\tcomTriggerItem.IsEventTrigger = flag;\n\t\tif (SetTriggerItem(comTriggerItem, ActionType.Add) == 0)\n\t\t{\n\t\t\tif (flag)\n\t\t\t{\n\t\t\t\tCommEventTriggerA.Add(comTriggerItem);\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tCommStrTriggerA.Add(comTriggerItem);\n\t\t\t}\n\t\t}\n\t}\n\n\tprivate void ValueChanged(object sender, PropertyChangedEventArgs e)\n\t{",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
