  "entries": [
    {
      "id": "EA01",
      "group": "通信回调换方案",
      "classification": "source-confirmed",
      "from": "MainWindowData构造 → InitComTrigger",
      "to": "静态事件订阅 + IsShowSaveNotice快照",
      "behavior": "构造在CheckIsNeutral后调用InitComTrigger；后者将实例回调挂到VmSolution.OnCommunicationRecvCallBackEvent，随后把IsShowSaveNotice配置读入字段。该字段是这里的快照，不是每包通信都重读。Program.InitMainWindow新建MainWindowData后才PreLoad。",
      "refs": [
        {
          "path": "analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster/Program.cs",
          "member": "Program.InitMainWindow",
          "sha256": "e9f3671cbf1b65559f855974b2f6c9e45dea434cfa3f89e3b29c2f9824b0ced6",
          "start": 159,
          "end": 168,
          "excerpt": "\tpublic static void InitMainWindow()\n\t{\n\t\tMainData = new MainWindowData();\n\t\tMainData.PreLoad();\n\t\tLogHelper.Info(\"InitServer\");\n\t\tServerManager.Instance.InitServer(TitleMenueItemData.GetToolFunctionSources);\n\t\tNameValueItem.logManager = (ILogManager)LogUIBridge.GetInstance();\n\t}\n\n\tpublic static void ReInitData()",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster/MainWindowData.cs",
          "member": "MainWindowData constructor",
          "sha256": "aa7a20533b81452cd58fbd22e121273b3a109ce21b0841fc0d9e4d081939f1e5",
          "start": 469,
          "end": 493,
          "excerpt": "\tpublic MainWindowData()\n\t{\n\t\tLogHelper.Info(\"MainWindowData-------begin\");\n\t\tVmSolution.RestoreDefaultDisplay += VmSolution_RestoreDisplay;\n\t\tVmSolution.OnSolutionLoadEndCallBack += VmSolution_LoadEnd;\n\t\tVmSolution.OnSolutionLoadBeginCallBack += VmSolution_LoadBegin;\n\t\tVmSolution.OnGlobalScriptReportCallBack += VmSolution_OnGlobalScriptReportCallBack;\n\t\tVmSolution.OnExecuteAfterLoad += VmSolution_OnExecuteAfterLoad;\n\t\tVmSolution.OnReportModuleData += VmSolution_OnReportModuleData;\n\t\tVmSolution.OnProxyCrashNoticeCallBack += VmSolution_OnProxyCrashNotice;\n\t\tVmSolution.OnServerStatusCallBack += VmSolution_OnServerStatusCallBack;\n\t\tVmSolution.OnProcedureUpgradeBeginCallBack += VmSolution_OnSolutionUpgradeBeginCallBack;\n\t\tVmSolution.OnProcedureUpgradeEndCallBack += VmSolution_OnSolutionUpgradeEndCallBack;\n\t\tVmSolution.OnGroupUpgradeBeginCallBack += VmSolution_OnSolutionUpgradeBeginCallBack;\n\t\tVmSolution.OnGroupUpgradeEndCallBack += VmSolution_OnSolutionUpgradeEndCallBack;\n\t\tVmSolution.OnProcessImportEndCallBack += VmSolution_OnProcessImportEndCallBack;\n\t\tVmSolution.Instance.PropertyChanged += SourcePropertyChanged;\n\t\tLogHelper.Info(\"MainWindowData-------事件注册完毕\");\n\t\tappData = AppDataFactory.Instance(true);\n\t\tCheckIsNeutral();\n\t\tInitComTrigger();\n\t\tLogHelper.Info(\"MainWindowData-------end\");\n\t}\n\n\tprivate void VmSolution_OnExecuteAfterLoad(object sender, ObjectEventArgs args)",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
        {
          "path": "analysis/decompiled/VisionMaster.Exe.Audit/VisionMaster/MainWindowData.cs",
          "member": "MainWindowData.InitComTrigger",
          "sha256": "aa7a20533b81452cd58fbd22e121273b3a109ce21b0841fc0d9e4d081939f1e5",
          "start": 1241,
          "end": 1246,
          "excerpt": "\tprivate void InitComTrigger()\n\t{\n\t\tVmSolution.OnCommunicationRecvCallBackEvent += VmSolution_OnCommunicationRecvCallBackEvent;\n\t\tisShowSaveNotice = ConfigurationHelper.GetConfig(\"IsShowSaveNotice\");\n\t}\n",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        }
      ],
      "unknowns": [
        "原件9个选定成员身份见独立证据；具体实例数、重新初始化和订阅激活次数未运行验证。"
      ],
