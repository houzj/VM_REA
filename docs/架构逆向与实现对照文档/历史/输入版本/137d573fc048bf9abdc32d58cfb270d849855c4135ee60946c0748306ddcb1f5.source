          "start": 197,
          "end": 217,
          "excerpt": "\tpublic bool SaveSolution(string strPath, string strPassWord = null, Task afterSaveTask = null)\n\t{\n\t\tif (!VmSolution.Instance.IsHasPassword && strPassWord == null)\n\t\t{\n\t\t\tstrPassWord = \"\";\n\t\t}\n\t\tApplication.Current.Dispatcher.Invoke(() =>\n\t\t{\n\t\t\tSaveCalibUserData();\n\t\t});\n\t\tif (VmSolution.Export(strPath, strPassWord))\n\t\t{\n\t\t\tProgram.MainData.OnPropertyChanged(\"SolutionPath\");\n\t\t\tProgram.MainData.OnPropertyChanged(\"SolutionName\");\n\t\t\tafterSaveTask?.Start();\n\t\t\tstrCurrentSolutionFileName = strPath;\n\t\t\treturn true;\n\t\t}\n\t\treturn false;\n\t}\n",
          "evidenceType": "local-decompiled-source",
          "binaryIdentity": "not revalidated in this slice"
        },
