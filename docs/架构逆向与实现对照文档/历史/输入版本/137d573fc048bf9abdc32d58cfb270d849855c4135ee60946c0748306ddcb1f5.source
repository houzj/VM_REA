{
  "schemaVersion": 1,
  "id": "solution-open-branches",
  "title": "主界面打开方案：分支与任务/配置回流",
  "scope": "原版打开方案的有限静态分支。密码窗非true路径、取消、保存交付、Task启动与配置调用分别追踪；不穷尽加载委托/原生内部路径。",
  "entryCompletenessProved": false,
  "fullBehaviorClosed": false,
  "runtimeVerified": false,
  "nodes": [
    {
      "id": "root",
      "label": "主界面",
      "detail": "实际事件投递仍未验证",
      "x": 600,
      "y": 60
    },
    {
      "id": "menu",
      "label": "打开方案菜单",
      "detail": "methodName=OpenSolution",
      "x": 600,
      "y": 180
    },
    {
      "id": "handler",
      "label": "OpenSolution包装",
      "detail": "创建/保存/加载忙状态门",
      "x": 600,
      "y": 300
    },
    {
      "id": "busy",
      "label": "忙状态直接返回",
      "detail": "无选择器 / 无加载任务",
      "x": 150,
      "y": 300
    },
    {
      "id": "choose",
      "label": "LoadSolution选择路径",
      "detail": "提供路径 / 普通 / 远程",
      "x": 600,
      "y": 420
    },
    {
      "id": "cancel",
      "label": "选择器取消",
      "detail": "返回true；未启动加载",
      "x": 1050,
      "y": 420
    },
    {
      "id": "format",
      "label": "CheckSolution格式门",
      "detail": "nValidFormat / Check异常",
      "x": 600,
      "y": 540
    },
    {
      "id": "fail",
      "label": "格式/检查失败",
      "detail": "所选分支返回false",
      "x": 150,
      "y": 540
    },
    {
      "id": "pwd",
      "label": "密码参数门",
      "detail": "nHasPwd / solPassWord",
      "x": 600,
      "y": 660
    },
    {
      "id": "bad",
      "label": "显式密码错误",
      "detail": "throw VmException",
      "x": 150,
      "y": 660
    },
    {
      "id": "dialog",
      "label": "Decryption.ShowDialog",
      "detail": "nullable bool返回",
      "x": 600,
      "y": 780
    },
    {
      "id": "result",
      "label": "密码窗结果",
      "detail": "true或非true",
      "x": 600,
      "y": 900
    },
    {
      "id": "task",
      "label": "构造加载Task",
      "detail": "构造不等于启动",
      "x": 600,
      "y": 1020
    },
    {
      "id": "prompts",
      "label": "切换 / 保存门",
      "detail": "Modules / 来源 / 提示条件",
      "x": 600,
      "y": 1140
    },
    {
      "id": "reject",
      "label": "拒绝切换 / 取消保存",
      "detail": "返回true；跳过配置调用",
      "x": 150,
      "y": 1140
    },
    {
      "id": "save",
      "label": "交SaveSolution(task)",
      "detail": "本层忽略保存返回bool",
      "x": 150,
      "y": 1260
    },
    {
      "id": "start",
      "label": "Task.Start",
      "detail": "任务已交付 ≠ 已加载",
      "x": 600,
      "y": 1260
    },
    {
      "id": "worker",
      "label": "加载Task后台体",
      "detail": "版本/历史/迁移等条件",
      "x": 600,
      "y": 1380
    },
    {
      "id": "load",
      "label": "VmSolution.Load调用",
      "detail": "条件满足才执行",
      "x": 600,
      "y": 1500
    },
    {
      "id": "native",
      "label": "native完成仍未知",
      "detail": "实际回调 / 实例状态未证",
      "x": 600,
      "y": 1620
    },
    {
      "id": "config",
      "label": "自动加载配置门",
      "detail": "调用点在任务门外",
      "x": 1050,
      "y": 1260
    },
    {
      "id": "write",
      "label": "SolPath / SolPassword",
      "detail": "满足偏好门才SetAutoLoadSol",
      "x": 1050,
      "y": 1380
    },
    {
      "id": "returned",
      "label": "正常返回true",
      "detail": "不作为加载完成凭据",
      "x": 1050,
      "y": 1500
    }
  ],
