(function client(model){
  const make=(tag,text)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;};
  function proof(host,r){const d=make('details');d.append(make('summary',r.member||r.path),make('pre',r.path+':'+r.start+'–'+r.end+'\nSHA256 '+r.sha256+'\n'+r.excerpt));host.append(d);}
  function showStep(id){
   const s=model.steps.find(s=>s.id===id);if(!s)return;const x=s.explain,host=document.getElementById('data-step-detail'),columns=make('div');columns.className='dd-stage-columns';host.replaceChildren(make('h3',s.title+' · '+s.summary),make('p',s.detail),columns);
   const plain=make('article'),technical=make('article');plain.className='dd-business';technical.className='dd-technical';columns.append(plain,technical);
   for(const [key,title]of [['what','这一步做什么？'],['who','谁给谁？'],['chain','一眼看懂传递方向'],['copy','传的是副本，还是共用对象？'],['cache','哪里保留，什么时候更新？'],['release','谁释放，释放到哪一步？']]){plain.append(make('h4',title));const p=make('p',x[key]);if(key==='chain')p.className='dd-mini-chain';plain.append(p);}
   plain.append(make('h4','用同一个工具场景理解'),make('p','讲解示例，非本轮运行实测；只用于说明下方源码已确认的分支。'));const example=make('p',x.example);example.className='dd-example';const risk=make('p','最容易误解：'+x.risk);risk.className='dd-gap';plain.append(example,risk);
   technical.append(make('h4','逐层看实现与证据'));const boundary=make('p',x.boundary);boundary.className='dd-gap';technical.append(boundary);
   const types=make('details');types.append(make('summary','第1层 · 具体类型、字段与用途'));for(const id of x.types){const t=model.structures.find(t=>t.id===id);types.append(make('h4',t.title),make('p',t.classification+' · '+t.meaning),make('pre',t.fields.join('\n')),make('p','边界：'+t.limits));for(const r of t.refs)proof(types,r);}technical.append(types);
   const selected=[...s.facts.map(id=>model.lifecycle.facts.find(f=>f.id===id)),...(s.toolFacts||[]).map(id=>model.toolFacts.find(f=>f.id===id))];
   const transfer=make('details');transfer.append(make('summary','第2层 · 实际传递、缓存和释放'));for(const classification of ['source-confirmed','independent-implementation','unknown']){const group=selected.filter(f=>f.classification===classification);if(!group.length)continue;transfer.append(make('h4',classification==='source-confirmed'?'原版已确认的相关链路':classification==='independent-implementation'?'当前独立实现的实际链路':'尚未确认的链路'));for(const f of group){const d=make('details');d.append(make('summary',f.id+' · '+f.from+' → '+f.to),make('p',f.classification+' · '+f.behavior));for(const [k,label]of [['representation','数据与复制'],['cache','缓存与失效'],['release','释放边界']])d.append(make('p',label+'：'+f[k]));for(const u of f.unknowns)d.append(make('p','待核：'+u));transfer.append(d);}}technical.append(transfer);
   const sources=make('details');sources.append(make('summary','第3层 · 原版与当前源码原文 / 身份 / 未知'));for(const f of selected){const d=make('details');d.append(make('summary',f.id+' · '+f.classification+' · '+f.from));for(const r of f.refs)proof(d,r);for(const u of f.unknowns)d.append(make('p','未闭合：'+u));sources.append(d);}technical.append(sources);
   document.querySelectorAll('[data-data-step]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.dataStep===id)));
  }
  function track(id){document.querySelectorAll('[data-data-track-panel]').forEach(p=>p.hidden=p.dataset.dataTrackPanel!==id);document.querySelectorAll('[data-data-track]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.dataTrack===id)));}
  function tab(id){document.querySelectorAll('.tabs button').forEach(b=>b.classList.toggle('active',b.dataset.tab===id));document.querySelectorAll('.view').forEach(p=>p.classList.toggle('active',p.id===id));}
  for(const b of document.querySelectorAll('[data-data-step]'))b.addEventListener('click',()=>{showStep(b.dataset.dataStep);history.replaceState(null,'','#data-design/'+b.dataset.dataStep);});for(const b of document.querySelectorAll('[data-data-track]'))b.addEventListener('click',()=>track(b.dataset.dataTrack));
  for(const b of document.querySelectorAll('.tabs button'))b.addEventListener('click',()=>{tab(b.dataset.tab);if(b.dataset.tab==='data-design')history.replaceState(null,'','#data-design');else if(location.hash.startsWith('#data-design'))history.replaceState(null,'','#'+b.dataset.tab);});
  function revealFact(id){if(!model.factIds.includes(id))return false;const target=document.querySelector('[data-pipeline-fact="'+id+'"], [data-parameter-fact="'+id+'"], [data-evidence-fact="'+id+'"]');if(!target)return false;for(let n=target;n;n=n.parentElement){if(n.tagName==='DETAILS')n.open=true;if(n.dataset?.dataTrackPanel)track(n.dataset.dataTrackPanel);}target.scrollIntoView?.({block:'start'});return true;}
  function restore(){if(location.hash==='#data-design'||location.hash.startsWith('#data-design/')){tab('data-design');if(location.hash.startsWith('#data-design/domain/')){const id=location.hash.split('/')[2];if(model.dataDomainIds.includes(id)){const target=document.querySelector('[data-data-domain="'+id+'"]');for(let n=target;n;n=n.parentElement)if(n.tagName==='DETAILS')n.open=true;target?.scrollIntoView?.({block:'start'});}}else if(location.hash.startsWith('#data-design/fact/'))revealFact(location.hash.split('/')[2]);else if(location.hash.startsWith('#data-design/global-variable-execution/')){const id=location.hash.split('/')[2];if(/^GEX[0-9]{2}$/.test(id)){const target=document.querySelector('[data-global-execution-fact="'+id+'"]');for(let n=target;n;n=n.parentElement)if(n.tagName==='DETAILS')n.open=true;target?.scrollIntoView?.({block:'start'});}}else if(['#data-design/image-pipeline','#data-design/parameter-pipeline','#data-design/nonimage-pipeline','#data-design/variable-exit-matrix','#data-design/group-data-pipeline','#data-design/configuration-data-pipeline','#data-design/global-variable-analysis','#data-design/global-variable-execution'].includes(location.hash))document.getElementById(location.hash.split('/')[1])?.scrollIntoView?.({block:'start'});else if(location.hash.startsWith('#data-design/'))showStep(location.hash.slice(13));}else if(location.hash.startsWith('#tool/')||location.hash.startsWith('#entry/')||location.hash.startsWith('#menu-entry/')||location.hash.startsWith('#menu-deferred/'))tab('overview');}
  addEventListener('hashchange',restore);showStep('configure');track('parameters');restore();
 })({"dataDomainIds":["F-01","F-02","F-03","F-04","F-05","F-06","F-07","F-08","F-09","F-10","F-11","F-12","F-13","F-14","F-15","F-16","F-17","F-18","F-19","F-20","F-21","F-22","F-23"],"domainData":{"path":"domain-data-panel.json","domains":23,"complete":false},"factIds":["IS01","IS02","IS03","IS04","IS05","IS06","IS07","IS08","IS09","IS10","TD01","TD02","TD03","TD04","TD05","TD06","TD07","TD08","TD09","OD01","OD02","OD03","OD04","OD05","OD06","OD07","ON01","ON02","ON03","ON04","RB01","RB02","RB03","RB04","RB05","RB06","RB07","RS01","RS02","RS03","RS04","RS05","NP01","NP02","NP03","NC01","NC02","NC03","NC04","NC05","IF01","IF02","IF03","IF04","IF05","RC01","RC02","RC03","RC04","NB01","NB02","NB03","NB04","NM01","NM02","NM03","NM04","PB01","PB02","PB03","PB04","RQ01","RQ02","RQ03","RQ04","MF01","MF02","MF03","MF04","WL01","WL02","WL03","WL04","WL05","CR01","CR02","CR03","CR04","CR05","CR06","MR01","MR02","MR03","SN01","SN02","SN03","SN04","CSR01","CSR02","CSR03","CSR04","OR01","OR02","OR03","OR04","OR05","OR06","OR07","OR08","DI04","DI05","DI07","DI08","DI09","DR01","DR02","DR03","IU01","IU02","SP01","SP02","SP03","SP04","SP05","PS01","PS02","PS03","PS04","CP01","CP02","CP03","CP04","CP05","CP06","VD01","VD02","VD03","VD04","VD05","VD06","VD07","VD08","VN01","VN02","VN03","VN04","VN05","VS01","VS02","VS03","VS04","VZ01","VZ02","VZ03","VZ04","VZ05","VZ06","VZ07","VX01","VX02","VX03","VX04","VX05","VX06","VP01","VP02","VP03","VP04","VP05","VP06","VB01","VB02","VB03","VB04","CD01","CD02","CD03","CD04","CD05","CD06","CD07","CD08","OG01","OG02","OG03","OG04","OG05","OG06","OG07","CG01","CG02","CG03","CG04","CG05","CG06","CG07","CG08","CG09","CG10","OP01","OP02","OP03","OP04","OP05","OP06","PST01","PST02","PST03","PST04","PST05","HP01","HP02","HP03","HP04","IB01","IB02","IB03","IB04","IB05","IB06","IB07","IB09","IB08","DP01","DP02","DP03","DP04","DI01","DI02","DI03","DI06","DR04","DR05","DR06"],"configurationPipeline":{"path":"configuration-data-pipeline.json","facts":15,"complete":false},"groupPipeline":{"path":"group-data-pipeline.json","facts":17,"complete":false},"nonimagePipeline":{"path":"nonimage-data-pipeline.json","facts":48,"complete":false},"schemaVersion":1,"title":"数据类型与数据流","organization":"讲解顺序是独立分析组织，不是一条已证明覆盖所有模式的原版调用链。","complete":false,"browserRendered":false,"parameterPipeline":{"path":"parameter-data-pipeline.json","facts":15,"complete":false},"imagePipeline":{"path":"image-data-pipeline.json","stages":5,"facts":119,"fullOriginalChainClosed":false},"steps":[{"id":"configure","title":"① 配置","summary":"保存“要做什么”","detail":"方案文档保存节点、参数、ROI与订阅关系。开始运行时，当前执行器为参数等配置建立本轮副本；配置不是运行结果。","facts":["DP04","DP01"],"explain":{"what":"先记下工具要怎么做，以及输入到哪里取。参数、ROI和绑定关系属于配置；它们还不是本次计算结果。","who":"界面编辑 → 方案/节点文档；运行开始时，执行器再取本轮配置。","chain":"方案 → 流程 → 节点 → 参数 / ROI / 输入绑定","copy":"当前执行器克隆参数JSON和ROI等配置。绑定只记录数据来源；它不把图像像素装进配置。","cache":"保存的配置与跨轮工具状态分开。修改一个参数，不意味着所有图像缓存都已清空。","release":"删除配置、清运行状态和释放被结果持有的图像是不同动作。","example":"以缓存图像为例：把“缓存数量”设为2，是配置一个整数输入；绑定“输入图像”，是指明向哪个上游端口取图。这里尚未复制图像。","risk":"不要把“数据来源地址”当作数据本身，也不要把原版ModuleParam的写入链套成当前JSON模型。","types":["document","reference","subscribe","publish"],"extraFacts":["DP01"],"boundary":"原版参数写入与当前设计配置是相关问题的两组证据，不是一一同构对象。"},"toolFacts":[]},{"id":"resolve","title":"② 取值","summary":"按连线和订阅找输入","detail":"先区分“从哪里取”与“这次取到什么”。当前输入端口按连接/订阅解析；原版VmIO的关联与执行计数另列，不能当成同一个对象模型。","facts":["DP02"],"explain":{"what":"为这一次执行找齐实际输入：连线、订阅、常量，以及需要读取的上游结果。","who":"当前执行器 / 配置自执行宿主 → 成功的上游记录或常量 → 本节点输入字典。","chain":"来源定义 + 上游可用结果 → 按端口取值 → 本轮输入","copy":"当前连接取值可复用同一个PortValue和图像引用；构造输入字典本身不复制像素。原版VmIO则另有RelateIO与执行计数门。","cache":"配置自执行捕获上游结果视图，直接取已有结果，不重新执行上游。找不到可用值时不能用另一张图偷偷补上。","release":"这一层的字典只是一个持有者；它退出后，上游记录或缓存仍可能持有图像。","example":"缓存图像执行时，从已成功运行的上游结果读取InputImage。RefreshFlag没绑定时按1处理，BufferCount没绑定时按15处理；有绑定则读取本轮端口值。","risk":"“绑定还存在”不代表这一轮一定有值；类型、基数、来源状态与作用域都要核对。","types":["reference","value","vmio"],"toolFacts":["IB01","IB09"],"boundary":"原版VmIO取值与当前输入解析分别展示；本页不把两套对象混为一个实例链。"},"toolFacts":["IB01","IB09"]},{"id":"execute","title":"③ 执行","summary":"工具产生图像与数值","detail":"当前工具通过执行上下文接收输入和参数，返回ModuleResult。工具运行器对象、跨轮状态及输出图像是三种不同寿命。","facts":["DR04","DR01"],"explain":{"what":"工具收到本轮参数和输入，执行处理，并返回状态与输出。","who":"当前GraphExecutor → 工具运行体 → ModuleResult；跨轮状态由scope或工具实例另外持有。","chain":"本轮输入 / 参数 → 工具处理 → 状态 + 图像 / 数值输出","copy":"具体工具决定是否复制。当前缓存图像会在刷新时复制输入像素；这不能推成所有工具都做深复制。","cache":"缓存图像只有RefreshFlag等于1才入队、裁剪；其它刷新值保持旧队列，即使数量变小也不裁剪。","release":"单轮运行器结束，不等于跨轮状态和输出图像一起销毁。","example":"用A、B、C表示连续到来的三张图，数量为2且每次刷新：工具依次复制并入队；第三次后队列只保留B、C。数量0也会先复制再移除。","risk":"数量非法、缺图、取消和复制失败各有分支；不能把“开始执行”当作“成功发布”。","types":["value","result"],"toolFacts":["IB02","IB03"],"extraFacts":["DR01"],"boundary":"原缓存图像所选五体与接口/映射清理已另由NB/NM展开；仍不把RefreshResult当作算法实现，也不把当前快照模型套给原版。"},"toolFacts":["IB02","IB03"]},{"id":"retain","title":"④ 保留结果","summary":"结果记录与缓存分开","detail":"结果记录用于这一轮及后续消费；缓存可跨轮保留。以当前缓存图像工具为例，入队时复制像素，发布时只包装同一缓存图像引用。","facts":["DR03","DI05"],"toolFacts":["IB03","IB04","IB05"],"explain":{"what":"把这轮工具结果留下来供下游读取；同时区分工具自己的跨轮缓存。","who":"ModuleResult → 框架检查 → NodeRunRecord / 会话结果 → 下游；工具FIFO是另一份持有关系。","chain":"工具返回 → 校验与失败过滤 → 本轮记录 → 下游取值","copy":"当前缓存图像发布时PortValue包装队列中的同一图像。框架复制结果字典，不因此再复制像素。","cache":"队列淘汰的旧图，仍可能被旧NodeRunRecord保留。工具缓存、配置结果和整轮结果不是同一个容器。","release":"从一个容器移除引用，不保证其它结果或界面已放手；要追最后一个持有者。","example":"队列保留B、C时，上一次结果记录仍可能引用A。另一个关键区别是：插件失败返回的ModuStatus/耗时，会因当前框架失败过滤而不进入本轮输出记录。","risk":"只看插件返回字典，会漏掉框架过滤；只看缓存数量，会低估仍被结果持有的图像。","types":["result","value"],"extraFacts":["DR03","DI05"],"boundary":"原版显示数据中心持有对象的方式与当前结果记录分列；不存在已证明的统一结果信封。"}},{"id":"present","title":"⑤ 显示","summary":"通过准入再交给界面","detail":"图像、数值结果和显示载荷各有消费入口。当前主窗先清显示，再在结果、provider和所有者/请求代次满足条件时呈现；不是每个图像输出都会自动生成通用显示帧。","facts":["DR06","DR03"],"explain":{"what":"把结果变成用户看到的图像、文字、几何和表格；这些是不同的显示载荷。","who":"结果 / provider → 图像预览、通用显示帧与结果表的各自入口。","chain":"可用结果 + 当前所有者 / 请求代次 → 对应显示入口 → 界面","copy":"显示帧、位图和算法图像不能按名称当成同一个对象。清一个面板也不会自动清所有生产者缓存。","cache":"当前主窗检查结果和provider身份后才呈现；旧请求或已切换的节点不应绕过准入。","release":"清显示引用只是显示层动作；还要核provider、历史和结果记录是否继续持有。","example":"缓存图像提供15个图像输出槽，和通用图文显示帧是不同能力。工具有Image输出，不代表主窗必然生成含文字和几何的ToolDisplayFrame。","risk":"“同一轮的底图、文字、图形是否一致”必须沿实际消费者核对，不能从一个输出端口推断全部显示链。","types":["display","result"],"extraFacts":["DR03"],"boundary":"原版数据存储对象与当前主窗呈现门分别取证，原生渲染/像素寿命仍有未闭合分支。"},"toolFacts":[]},{"id":"release","title":"⑥ 失效与释放","summary":"各持有者分别退出","detail":"关闭编辑器、移除节点、关闭方案和淘汰历史不是同一个动作。移除一个引用不代表仍被结果或显示持有的像素立即释放。","facts":["DR05","DI03","DR02"],"toolFacts":["IB06","IB09"],"explain":{"what":"先识别谁仍在使用数据，再分别撤销发布资格、移除状态、解除固定或关闭原生资源。","who":"工具窗口、节点scope、方案root、结果记录、显示与原生容器，各自承担对应收尾。","chain":"停止 / 关闭请求 → 执行与读者退出 → 移除持有 / 对应释放","copy":"托管像素数组靠可达性决定回收；原版固定句柄、内存映射和查询容器另有释放动作，不能混用一个Dispose解释。","cache":"当前普通配置窗关闭后阻止过期结果写回，但不等于取消方案级token或清工具FIFO。","release":"方案root关闭会取消，并等租约归零后清状态和释放其拥有的可释放资源；这仍不证明外部历史像素已全部归还。","example":"关闭缓存图像编辑器，下一次执行仍可能读到该节点缓存。移除节点或关闭方案才走对应状态退役；旧结果如果仍引用图像，像素不会因队列移除立即消失。","risk":"停止、算法返回、窗口关闭、回调排空和最终释放是多个时点。原生最后读者未闭合时，必须保留未知。","types":["value","result","display"],"extraFacts":["DI03","DR02"],"boundary":"原版ImageBaseData解除GC固定不等于释放外部指针；Query容器释放也不能代证每个载荷或重复释放安全。"}}],"typeDesign":{"classification":"independent-implementation","families":[{"title":"普通值","types":["Number","Integer","Boolean","Text"],"plain":"数值、整数、开关、文本，例如测量值、数量、启用状态和名称。"},{"title":"图像","types":["GrayImage","RgbImage","Image"],"plain":"灰度、彩色或通用图像载体；还要核宽高、格式、步长与像素所有权。"},{"title":"几何与标定","types":["Components","Circle","Region","Fixture","Point","Calibration"],"plain":"组件、圆、区域、姿态/坐标变换、点与标定数据；不能当作一串无类型数字随意连接。"},{"title":"多值","types":["NumberArray"],"plain":"NumberArray是数值向量类型；Cardinality的Scalar/Array另表一个端口承载单个值还是多个同类值。两者不是同一维度。"}],"refs":[{"path":"src/VisionFramework/Contracts.cs","member":"当前数据类型与端口转换","sha256":"c31843c84f48a91264409edc33ff0fd4a870169c222fa255df4764deea24a269","start":4,"end":13,"excerpt":"public enum DataKind { GrayImage, Number, Integer, Boolean, Text, Components, Circle, Region, Fixture, Point, RgbImage, Image, NumberArray, Calibration }\npublic static class DataKinds {\n public static bool IsImage(DataKind kind)=>kind is DataKind.GrayImage or DataKind.RgbImage or DataKind.Image;\n public static bool CanFlow(DataKind source,DataKind target)=>source==target||source==DataKind.Number&&target==DataKind.NumberArray||source==DataKind.Image&&IsImage(target)||target==DataKind.Image&&IsImage(source);\n public static bool CanFlow(DataKind source,PortDescriptor target)=>CanFlow(source,target.Kind)||target.AcceptInteger&&source==DataKind.Integer&&target.Kind is DataKind.Number or DataKind.NumberArray;\n public static PortValue Coerce(PortValue value,DataKind target)=>value.Kind==DataKind.Number&&target==DataKind.NumberArray?PortValue.Numbers([value.As\u003cdouble>()]):CanFlow(value.Kind,target)?value:throw new InvalidDataException(\"Value type mismatch.\");\n public static PortValue Coerce(PortValue value,PortDescriptor target)=>PortTypes.DeferredReadAccepts(target,value.Kind)?value:target.AcceptInteger&&value.Kind==DataKind.Integer?target.Kind switch{DataKind.Number=>PortValue.Number((float)value.As\u003clong>()),DataKind.NumberArray=>PortValue.Numbers([(float)value.As\u003clong>()]),_=>throw new InvalidDataException(\"Invalid integer promotion target.\")}:Coerce(value,target.Kind);\n}\npublic enum ParameterKind { Number, Integer, Boolean, Text }\npublic sealed record PortDescriptor(string Name,DataKind Kind,bool Required=true,bool AcceptInteger=false){public ValueCardinality Cardinality{get;init;}=ValueCardinality.Scalar;public bool SupportsDeferredNumericRead{get;init;}public bool SupportsDeferredIntegerRead{get;init;}public bool SupportsDeferredTextRead{get;init;}public bool CanSubscribe{get;init;}=true;}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/PortArrays.cs","member":"当前端口基数维度","sha256":"148b9683f56d1b5ba0b31cc266299aaadd2ce911a10e34f4c9c752861b88a200","start":4,"end":4,"excerpt":"public enum ValueCardinality { Scalar, Array }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}]},"lifecycle":{"schemaVersio