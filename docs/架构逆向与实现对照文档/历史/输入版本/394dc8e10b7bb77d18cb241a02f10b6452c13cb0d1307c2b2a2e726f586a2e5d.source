path":"src/VisionFramework/WorkflowRunContext.cs","member":"WorkflowRunContext.Complete","sha256":"d00f29701f640028040e0f2c3d1ac11246ffb500945246c3424e435741241247","start":37,"end":45,"excerpt":" public ExecutionSessionResult Complete(ExecutionSessionResult session)\n {\n  var output=new Dictionary\u003cstring,PortValue>(StringComparer.Ordinal);var errors=new List\u003cstring>();\n  foreach(var spec in procedure.Configuration.Outputs){try{if(spec.NodeId is null)throw new InvalidDataException(\"Unbound workflow output: \"+spec.Name);var value=Node(spec.NodeId,spec.Port!);if(value.Kind!=spec.Kind&&!(spec.Kind==DataKind.Image&&DataKinds.IsImage(value.Kind)))throw new InvalidDataException(\"type mismatch\");output.Add(spec.Name,value);}catch(InvalidDataException e){errors.Add(spec.Name+\": \"+e.Message);}}\n  var displays=new Dictionary\u003cstring,IReadOnlyList\u003cPortValue>>(StringComparer.Ordinal);var displayErrors=new List\u003cstring>();foreach(var spec in procedure.Configuration.Displays){try{if(spec.NodeId is null)throw new InvalidDataException(\"Unbound display: \"+spec.Name);displays.Add(spec.Name,Array.AsReadOnly(new[]{Node(spec.NodeId,spec.Port!)}));}catch(InvalidDataException e){displayErrors.Add(e.Message);}}\n  return session with{WorkflowDisplays=new ReadOnlyDictionary\u003cstring,IReadOnlyList\u003cPortValue>>(displays),DisplayErrors=displayErrors.AsReadOnly(),Status=errors.Count>0&&session.Status==SessionStatus.Success?SessionStatus.Failed:session.Status,WorkflowInputs=new ReadOnlyDictionary\u003cstring,PortValue>(new Dictionary\u003cstring,PortValue>(arguments,StringComparer.Ordinal)),WorkflowOutputs=new ReadOnlyDictionary\u003cstring,PortValue>(output),LocalVariables=new ReadOnlyDictionary\u003cstring,PortValue>(variables.ToDictionary(v=>procedure.Configuration.Variables.Single(i=>i.Id==v.Key).Name,v=>v.Value,StringComparer.Ordinal)),OutputErrors=errors.AsReadOnly()};\n\n }\n}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}]},{"key":"execution-storage:M06","href":"execution-storage.html#edge-M06","classification":"independent-implementation","from":"RunCore → FrameworkCallbackQueue.PublishModuleResult","to":"同步保存结果 → Enqueue显示动作 → 宿主Dispatcher","behavior":"RunCore传入显示Action和值为StoreWorkflowCallResults/RecordWorkflowRun/RecordFrameworkRunHistory的同步Action。PublishModuleResult先同步Action再Enqueue(value)，WorkStatus版本在hasExecuteCount时反向先Enqueue再同步。cacheEnabled默认false，Enqueue在锁外直接dispatch；MainWindow的DispatchWorkflowCallback已在UI线程则直接调用，否则BeginInvoke。因而模块路径先提交结果再显示；同步Action抛错则未Enqueue，直接dispatch抛错可在同步提交之后向调用者传播，不保证回滚。","unknowns":["当前Action载荷不是原native callback结果结构；hasExecuteCount、订阅者异常和默认不开缓存不能外推全部原回调路径。"],"refs":[{"path":"src/VisionFramework/FrameworkCallbackQueue.cs","member":"Current cache default, enqueue and publication order","sha256":"af27ece2a43db6473a9199a5e31221e900557805f2a036420b299ba143ad9a82","start":19,"end":59,"excerpt":" bool cacheEnabled;\n long dropped;\n readonly List\u003cException> dispatchErrors=[];\n public FrameworkCallbackQueue(Action\u003cT> dispatch,int capacity=10000)\n {\n  ArgumentNullException.ThrowIfNull(dispatch);ArgumentOutOfRangeException.ThrowIfNegativeOrZero(capacity);\n  this.dispatch=dispatch;receive=new T[capacity];send=new T[capacity];\n  worker=new Thread(Work){IsBackground=true,Priority=ThreadPriority.BelowNormal,Name=\"VisionFramework callback queue\"};worker.Start();\n }\n public bool CacheEnabled{get{lock(gate)return cacheEnabled;}set{lock(gate)cacheEnabled=value;}}\n public int Capacity{get{lock(gate)return receive.Length;}}\n public int PendingCount{get{lock(gate)return receiveCount;}}\n public long DroppedCount{get{lock(gate)return dropped;}}\n public bool IsClosed{get{lock(gate)return !alive;}}\n public IReadOnlyList\u003cException> DispatchErrors{get{lock(gate)return dispatchErrors.ToArray();}}\n public CallbackEnqueueResult Enqueue(T value)\n {\n  lock(gate){\n   if(cacheEnabled){\n    if(receiveCount==receive.Length){dropped++;return CallbackEnqueueResult.Overflow;}\n    receive[receiveCount++]=value;return CallbackEnqueueResult.Queued;\n   }\n  }\n  dispatch(value);return CallbackEnqueueResult.Dispatched;\n }\n // As in the original, expansion discards queued receives. Call before active dispatch.\n public void ExpandCapacity(int newLength)\n {\n  lock(gate){if(newLength\u003c=receive.Length)return;receive=new T[newLength];send=new T[newLength];receiveCount=0;}\n }\n public void PublishWorkStatus(T value,Action synchronousResult,bool hasExecuteCount=true)\n {\n  ArgumentNullException.ThrowIfNull(synchronousResult);\n  if(hasExecuteCount)Enqueue(value);\n  synchronousResult();\n }\n public void PublishModuleResult(T value,Action synchronousResult)\n {\n  ArgumentNullException.ThrowIfNull(synchronousResult);synchronousResult();Enqueue(value);\n }\n public void Close(){lock(gate)alive=false;}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/WorkflowExecution.cs","member":"Current module result actions and owner gate","sha256":"62dfe19e6836de7c116f3c89a6c17521d64b252d14dd137116987aadc9a666d4","start":47,"end":63,"excerpt":"   WorkflowCallbacks.PublishModuleResult(\n    () => {\n      if(!IsCurrentExecutionOwner(owner))return;\n      if(doc.HasCurrentProcedure&&doc.RootProcedureId(doc.CurrentProcedureId)==procedureId){RestoreWorkflowResults();ProcessTimeText.Text=elapsed.ToString(\"F2\");StatusText.Text=\"流程完成：\"+session.Status+(session.OutputErrors.Count>0?\" · \"+string.Join(\"；\",session.OutputErrors):\"\");StatusIcon.Source=Asset(session.Nodes.All(r=>r.Status is NodeRunStatus.Success or NodeRunStatus.NoMatch or NodeRunStatus.Skipped)?\"bottombar_run.png\":\"bottombar_abnormal.png\");RefreshRight();}\n      if(workflowOverview)RenderWorkflowOverview();\n      if(configurationProcedureId==procedureId)workflowConfigurationWindow?.RefreshResults();\n    },\n    () => {\n      StoreWorkflowCallResults(procedureId,session);RecordWorkflowRun(procedureId,elapsed);\n      if(!windowClosed)RecordFrameworkRunHistory(procedureId,session);\n    });\n   return session.Status==SessionStatus.Success&&session.Nodes.All(r=>r.Status is NodeRunStatus.Success or NodeRunStatus.Skipped);\n  }\n  catch(OperationCanceledException){if(IsCurrentExecutionOwner(owner))StatusText.Text=\"运行已停止\";}\n  catch(Exception e){if(IsCurrentExecutionOwner(owner))StatusText.Text=\"运行失败：\"+e.Message;}\n  return false;\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionEditor/MainWindow.FrameworkExecutionOwnership.cs","member":"Current lazy queue and UI dispatcher","sha256":"5b628d95732f56404fb07fc4eccd7458666ec0015901b66fb3596905d91b0be1","start":9,"end":21,"excerpt":"    FrameworkCallbackQueue\u003cAction>? workflowCallbacks;\n    FrameworkCallbackQueue\u003cAction> WorkflowCallbacks => workflowCallbacks ??= new FrameworkCallbackQueue\u003cAction>(DispatchWorkflowCallback);\n    ExecutionOwnerStamp CaptureExecutionOwner() => executionOwnerEpoch.Capture(doc.SolutionId,executionScope);\n    bool IsCurrentExecutionOwner(ExecutionOwnerStamp stamp) => !windowClosed &&\n        executionOwnerEpoch.IsCurrent(stamp,doc.SolutionId,executionScope);\n    void DispatchWorkflowCallback(Action callback)\n    {\n        if(windowClosed)return;\n        if(Dispatcher.CheckAccess())callback();\n        else _=Dispatcher.BeginInvoke(callback);\n    }\n}\n","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}]},{"key":"results-roi:C02","href":"results-roi.html#edge-C02","classification":"independent-implementation","from":"ToolDisplayFrame → 三presenter","to":"按Tab显示图像/记录/列表","behavior":"同frame交图像、记录、列表；overlay需frame且图像Tab；其余按provider和SelectedIndex控制显示，图像presenter用previewScale。不是原ImageViewBox多层渲染合同。","unknowns":[],"refs":[{"path":"src/VisionEditor/ToolDisplays.cs","member":"Current display frame publication","sha256":"f3ae89186549591a8a025fc8d36d66bc2b5ea959ec3ed293d3e1030bcdd0e656","start":42,"end":54,"excerpt":"  toolDisplayImage.Show(frame);toolDisplayRecord.Show(frame);toolDisplayList.Show(frame);\n  bool overlay=frame is not null&&DisplayTabs.SelectedIndex==0;\n  toolDisplayImage.Visibility=overlay?Visibility.Visible:Visibility.Collapsed;\n  Preview.Visibility=overlay?Visibility.Collapsed:Visibility.Visible;\n  PreviewImageName.Visibility=overlay?Visibility.Collapsed:Visibility.Visible;\n  if(overlay)EmptyImage.Visibility=Visibility.Collapsed;\n  ImagePreviewPane.Visibility=DisplayTabs.SelectedIndex==0?Visibility.Visible:Visibility.Collapsed;\n  ModuleResultsGrid.Visibility=DisplayTabs.SelectedIndex==1?Visibility.Visible:Visibility.Collapsed;\n  toolDisplayRecord.Visibility=provider is not null&&DisplayTabs.SelectedIndex==2?Visibility.Visible:Visibility.Collapsed;\n  toolDisplayList.Visibility=provider is not null&&DisplayTabs.SelectedIndex==3?Visibility.Visible:Visibility.Collapsed;\n  toolDisplayImage.LayoutTransform=new ScaleTransform(previewScale,previewScale);\n }\n}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}]}]},{"id":"store","title":"当前实现：文档副本到持久化","meaning":"保存文档路径；不表示会把全部运行图像或历史结果写入文件。","steps":[{"key":"execution-storage:J02","href":"execution-storage.html#edge-J02","classification":"independent-implementation","from":"GraphEditorDocument.Save","to":"SolutionStore.Save","behavior":"PrepareSave 接收文档副本，随后 Rebase 并落盘；返回后才替换 document、基目录、路径、Dirty、Revision 并发 Changed。","unknowns":["PrepareSave / Rebase 的插件私有资源及历史一致性不由这一方法证明。"],"refs":[{"path":"src/VisionEditor.Core/GraphEditorDocument.cs","member":"GraphEditorDocument.Save","sha256":"4a44a59c96449a286eac7162e42a0b42dd012669f49e5aa810e1ce131799b558","start":68,"end":75,"excerpt":"    public void Save(string path) {\n        string full = Path.GetFullPath(path), directory = Path.GetDirectoryName(full)!;\n        var prepared=PrepareSave?.Invoke(Copy(document),BaseDirectory)??document;\n        var rebased = Rebase(prepared, BaseDirectory, directory);\n        SolutionStore.Save(full, rebased); // Commit editor state only after an atomic successful write.\n        document = rebased; BaseDirectory = directory; FilePath = full; IsDirty = false; Revision++; Changed?.Invoke();\n    }\n    public void SelectProcedure(string id) { if (!document.Procedures.Any(p => p.Id == id)) throw new KeyNotFoundException(id); if(CurrentProcedureId == id)return; CurrentProcedureId = id; Changed?.Invoke(); }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}]},{"key":"execution-storage:J03","href":"execution-storage.html#edge-J03","classification":"independent-implementation","from":"SolutionStore.Save","to":"临时文件 → Flush(true) → File.Move","behavior":"先校验/序列化、限制 32MiB、检查重复键；同目录独占新临时文件写入和 Flush(true)，Move(overwrite:true)，finally 清临时文件。","unknowns":["不证明断电、跨卷、native 保存事务或全部插件资产兼容。"],"refs":[{"path":"src/VisionFramework/SolutionStore.cs","member":"SolutionStore.Save","sha256":"533f7dfd5314570ef1ca97c41ed0dce44b926953135b2b286133b52fe5f50365","start":17,"end":25,"excerpt":"    public static void Save(string path,SolutionDocument solution) {\n        ValidateStructure(solution);byte[] json=JsonSerializer.SerializeToUtf8Bytes(solution,Options);if(json.Length>MaximumBytes)throw new InvalidDataException(\"Solution exceeds size limit.\");\n        // Opaque plugin payloads can contain duplicate members. Reject the same\n        // serialized shape as Load before creating directories or replacing a file.\n        using(var parsed=JsonDocument.Parse(json))RejectDuplicateProperties(parsed.RootElement);\n        string full=Path.GetFullPath(path),directory=Path.GetDirectoryName(full)!;Directory.CreateDirectory(directory);string temp=Path.Combine(directory,\".\"+Path.GetFileName(full)+\".\"+Guid.NewGuid().ToString(\"N\")+\".tmp\");\n        try{using(var output=new FileStream(temp,FileMode.CreateNew,FileAccess.Write,FileShare.None)){output.Write(json);output.Flush(true);}File.Move(temp,full,overwrite:true);}finally{if(File.Exists(temp))File.Delete(temp);}\n    }\n    public static void ValidateStructure(SolutionDocument solution){","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}]}]}],"toolFacts":[{"id":"IB01","classification":"independent-implementation","from":"ImageBufferWindow.Link / 整数提交、订阅","to":"GraphExecutor nodeInputs → Runtime.Read","behavior":"窗口把图像、RefreshFlag、BufferCount作为输入端口处理。整数文本提交调用SetInputInteger，订阅按钮先Commit再PickSubscription。运行体从c.Inputs取整数，默认数量15、刷新1，不从c.Parameters取这两个值；checked long→int越界不在插件内捕获，由外层执行器记ModuleException。界面配置和运行读取不能合并成普通算法参数字典。","representation":"输入字典内PortValue由GraphExecutor连接/订阅解析；此工具Describe的算法参数数组为空。","cache":"整数默认仅在对应输入键缺席时使用；刷新标志只认等于1。","release":"本段无图像分配/释放。","refs":[{"path":"src/VisionPlugins.ImageSource/ImageBufferWindow.cs","member":"void Commit()","sha256":"ecdd987200d4356ff8adef9ee959af9a3d921406f1e965bedbe02f4acd2a5ef2","start":24,"end":24,"excerpt":"  void Commit(){if(text.IsReadOnly||text.Text==applied)return;string current=text.Text.Trim();if(current.Length==0){context.SetInputInteger?.Invoke(port,null);text.Text=\"\";}else if(int.TryParse(current,System.Globalization.NumberStyles.Integer,System.Globalization.CultureInfo.InvariantCulture,out int value)){context.SetInputInteger?.Invoke(port,value);text.Text=value.ToString(System.Globalization.CultureInfo.InvariantCulture);}else text.Text=applied;applied=text.Text;}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionPlugins.ImageSource/ImageBufferWindow.cs","member":"var button=new W.Button{Name=\"Subscribe\"","sha256":"ecdd987200d4356ff8adef9ee959af9a3d921406f1e965bedbe02f4acd2a5ef2","start":26,"end":26,"excerpt":"  var button=new W.Button{Name=\"Subscribe\"+port,Height=29,Width=28,HorizontalAlignment=System.Windows.HorizontalAlignment.Right,Background=Brushes.Transparent,BorderThickness=new Thickness(0),Padding=new Thickness(4),ToolTip=\"订阅参数\"};button.Content=kind==DataKind.Image?new W.TextBlock{Text=\"▾\",Foreground=Brush(\"#CDB9A9\"),HorizontalAlignment=System.Windows.HorizontalAlignment.Right}:new W.Image{Source=new BitmapImage(new Uri(\"pack://application:,,,/VisionPlugins.ImageSource;component/Resources/ic_btn_link_normal.png\")),Width=18,Height=18};button.Click+=(_,_)=>{Commit();context.PickSubscription?.Invoke(this,port,false,kind);text.Text=context.SubscriptionLabel?.Invoke(port,false)??\"\";applied=text.Text;};field.Children.Add(button);W.Grid.SetColumn(field,1);row.Children.Add(field);return row;","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"public ModuleDescriptor Descriptor{get;}","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":13,"end":14,"excerpt":" public ModuleDescriptor Descriptor{get;}=new(Id,\"1.0.0\",\"缓存图像\",[new(\"InputImage\",DataKind.Image,false),new(\"RefreshFlag\",DataKind.Integer,false),new(\"BufferCount\",DataKind.Integer,false)],\n  Enumerable.Range(0,15).SelectMany(i=>new[]{new PortDescriptor($\"OutImage{i}Image\",DataKind.Image,false),new($\"OutImage{i}Width\",DataKind.Integer,false),new($\"OutImage{i}Height\",DataKind.Integer,false),new($\"OutImage{i}PixelFormat\",DataKind.Integer,false)}).Concat(new[]{new PortDescriptor(\"ModuStatus\",DataKind.Integer),new(\"ModuRunTime\",DataKind.Number)}).ToArray(),[]);","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"int Read(string name,int value)","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":26,"end":27,"excerpt":"   int Read(string name,int value)=>c.Inputs.TryGetValue(name,out var p)?checked((int)p.As\u003clong>()):value;\n   int count=Read(\"BufferCount\",15),flag=Read(\"RefreshFlag\",1);","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/GraphExecutor.cs","member":"nodeInputs[c.ToPort]=v;","sha256":"6fed55fe29e547248cab05a36072e690b76eb9668609f0318b795c24d7628f9c","start":24,"end":24,"excerpt":"    nodeInputs[c.ToPort]=v;","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["当前订阅弹层的完整外观、原版动态输入设置器逐分支尚未在本专项闭合。"]},{"id":"IB02","classification":"independent-implementation","from":"数量/刷新门与节点状态","to":"State.Images FIFO变更","behavior":"count\u003c0或>15在GetState之前返回错误；合法数量后取得状态并加锁，再检查取消。只有flag==1才读取InputImage、复制并裁剪。flag为0、-1、2或其它非1值时保留队列，数量变小也不裁剪。flag==1且缺图时不改既有队列。","representation":"Queue\u003cIImageData>按最旧到最新保存；数量0仍先复制入队，然后出队至空。","cache":"GetState按scope或fallback选择持久状态；不是每次CreateRuntime建立新队列。","release":"裁剪仅Dequeue引用，无像素Dispose/清零调用。","refs":[{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"sealed class State","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":15,"end":15,"excerpt":" sealed class State {public readonly object Gate=new();public readonly Queue\u003cIImageData> Images=new();}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"if(count is \u003c0 or >15)","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":29,"end":37,"excerpt":"   if(count is \u003c0 or >15){code=0xe000031c;error=\"InvalidBufferCount\";}\n   else {var state=owner.GetState(c);lock(state.Gate){\n    token.ThrowIfCancellationRequested();\n    if(flag==1){\n     if(!c.Inputs.TryGetValue(\"InputImage\",out var input)){code=0xe0000510;error=\"InputImageMissing\";}\n     else {var image=input.As\u003cIImageData>();IImageData copy=image switch{GrayImage=>new GrayImage(image.Width,image.Height,image.Pixels),RgbImage=>new RgbImage(image.Width,image.Height,image.Pixels),RawImage=>new RawImage(image.Width,image.Height,image.Format,image.Pixels,image.Stride),_=>throw new ArgumentException(\"Unsupported image format.\")};state.Images.Enqueue(copy);while(state.Images.Count>count)state.Images.Dequeue();}\n    }\n    if(code==0){int i=0;foreach(var image in state.Images){string prefix=$\"OutImage{i++}\";output[prefix+\"Image\"]=PortValue.Image(image);output[prefix+\"Width\"]=PortValue.Integer(image.Width);output[prefix+\"Height\"]=PortValue.Integer(image.Height);output[prefix+\"PixelFormat\"]=PortValue.Integer((int)image.Format);}}\n   }}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["原所选分配/关闭callee已由NM01–NM04续证；完整池分支、竞争与异常安全仍未闭合，本段只确认当前实现分支。"]},{"id":"IB03","classification":"independent-implementation","from":"本轮输入图像","to":"独立拥有的缓存图像","behavior":"刷新时仅支持GrayImage、RgbImage、RawImage三个具体类型，分别调用构造器复制；其它IImageData实现抛ArgumentException。三种构造器均data.ToArray，因此入队图像和上游图像不是同一对象或同一数组。Gray/Rgb校验精确载荷长度，Raw保留格式、stride及全部非空载荷；此处不调用预览格式转换。","representation":"缓存复制尺寸、格式和像素；Raw不解码、不按width*height截断。","cache":"复制后Enqueue，再按count裁剪；count0的临时副本也经历分配。","release":"托管数组由引用可达性决定回收；非确定时刻释放。","refs":[{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"else {var image=input.As\u003cIImageData>();","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":34,"end":34,"excerpt":"     else {var image=input.As\u003cIImageData>();IImageData copy=image switch{GrayImage=>new GrayImage(image.Width,image.Height,image.Pixels),RgbImage=>new RgbImage(image.Width,image.Height,image.Pixels),RawImage=>new RawImage(image.Width,image.Height,image.Format,image.Pixels,image.Stride),_=>throw new ArgumentException(\"Unsupported image format.\")};state.Images.Enqueue(copy);while(state.Images.Count>count)state.Images.Dequeue();}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionData/ImageGeometry.cs","member":"public GrayImage(","sha256":"0c169c1fe86eb8048fc6b7329d425088c32d2a690535c05962e5276d9907882d","start":18,"end":23,"excerpt":"    public GrayImage(int width, int height, ReadOnlySpan\u003cbyte> data)\n    {\n        if (width \u003c= 0 || height \u003c= 0) throw new ArgumentOutOfRangeException(nameof(width));\n        if (data.Length != checked(width * height)) throw new ArgumentException(\"Pixel count must equal width * height.\", nameof(data));\n        Width = width; Height = height; pixels = data.ToArray();\n    }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionData/ColorImage.cs","member":"public RgbImage(","sha256":"8f2d913e0bfa11edc4c6dd04eef83031b09265a34cc92fac04ca5970c40ba4b6","start":18,"end":22,"excerpt":" public RgbImage(int width,int height,ReadOnlySpan\u003cbyte> data){\n  if(width\u003c=0||height\u003c=0)throw new ArgumentOutOfRangeException(nameof(width));\n  if(data.Length!=checked(width*height*3))throw new ArgumentException(\"RGB24 data must contain width * height * 3 bytes.\",nameof(data));\n  Width=width;Height=height;pixels=data.ToArray();\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionData/RawImage.cs","member":"public RawImage(","sha256":"e380f1abb06c6f49a8584d37ea8acfd22300ef87fbf66f503c20f3aa0f6f6342","start":12,"end":15,"excerpt":" public RawImage(int width,int height,ImagePixelFormat format,ReadOnlySpan\u003cbyte> data,int stride=0){\n  if(width\u003c=0||height\u003c=0||stride\u003c0||data.IsEmpty)throw new ArgumentOutOfRangeException(nameof(width));\n  Width=width;Height=height;Format=format;Stride=stride;pixels=data.ToArray();\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["不模拟损坏原生指针、任意外部IImageData或内存不足后的原版行为；不声称原生CopyImage位等价。"]},{"id":"IB04","classification":"independent-implementation","from":"FIFO槽位","to":"ModuleResult → GraphExecutor记录 → 下游","behavior":"成功时从队首枚举并发布OutImage0Image等键，PortValue.Image仅包装同一缓存图像对象。暂停刷新重复运行可让不同ModuleResult持有相同图像；主流程成功路径只复制输出字典并包只读视图，不复制像素。下游nodeInputs接收同一个PortValue。因此一次入队的深复制不能解释为每层都深复制。","representation":"