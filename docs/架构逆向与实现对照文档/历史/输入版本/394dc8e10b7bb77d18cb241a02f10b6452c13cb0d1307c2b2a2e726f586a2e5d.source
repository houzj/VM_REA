ToArray(),Configuration=procedure.Configuration.Snapshot()};","evidenceType":"current-source","binaryIdentity":"Current independent implementation, not an original runtime layout."},{"path":"src/VisionFramework/GraphExecutor.cs","member":"Binding resolution","sha256":"6fed55fe29e547248cab05a36072e690b76eb9668609f0318b795c24d7628f9c","start":30,"end":30,"excerpt":"   try{foreach(var binding in p.Configuration.Subscriptions.Where(b=>b.NodeId==id)){PortValue value;if(!binding.IsParameter&&d.Inputs.Single(port=>port.Name==binding.Target) is {} deferred&&(deferred.SupportsDeferredNumericRead||deferred.SupportsDeferredIntegerRead||deferred.SupportsDeferredTextRead)){numericIndices.Add(binding.Target,binding.Source.ArrayIndex);try{value=workflow.Resolve(binding.Source with{ArrayIndex=null});}catch(InvalidDataException)when(workflow.CanDeferNumericRead(binding.Source)){continue;}}else value=workflow.Resolve(binding.Source);if(binding.IsParameter)parameters[binding.Target]=WorkflowSubscriptions.Parameter(d.Parameters.Single(p=>p.Name==binding.Target),value);else nodeInputs[binding.Target]=value;}}catch(Exception ex)when(ex is InvalidDataException or OverflowException){Record(NodeRunStatus.Failed,code:\"SubscriptionUnavailable\",message:ex.Message);continue;}","evidenceType":"current-source","binaryIdentity":"Current independent implementation, not an original runtime layout."},{"path":"src/VisionFramework/ModuleExecutionScope.Parameters.cs","member":"Applied parameter cache","sha256":"ec53ae0a59eff823eaf5f7db488fb9db11f8e33d9763fc9a817704f6d99275e3","start":9,"end":11,"excerpt":" public void RememberExecutionParameters(string module,string node,IReadOnlyDictionary\u003cstring,JsonElement> seed,IReadOnlyDictionary\u003cstring,JsonElement> applied){var state=Parameters(module,node);lock(state.Gate){state.Seed=seed.ToDictionary(p=>p.Key,p=>p.Value.Clone());state.Values=applied.ToDictionary(p=>p.Key,p=>p.Value.Clone());}}\n public IReadOnlyDictionary\u003cstring,JsonElement>? ReadEffectiveParameters(string module,string node,IReadOnlyDictionary\u003cstring,JsonElement> current){var state=Parameters(module,node);lock(state.Gate){if(state.Values is null)return null;var result=state.Values.ToDictionary(p=>p.Key,p=>p.Value.Clone());foreach(var pair in current)if(state.Seed is null||!state.Seed.TryGetValue(pair.Key,out var old)||old.GetRawText()!=pair.Value.GetRawText())result[pair.Key]=pair.Value.Clone();return result;}}\n public void RememberConfigurationParameters(string module,string node,IReadOnlyDictionary\u003cstring,JsonElement> before,IReadOnlyDictionary\u003cstring,JsonElement> after,bool reset=false){var state=Parameters(module,node);lock(state.Gate){if(state.Values is null&&!reset)return;state.Seed??=before.ToDictionary(p=>p.Key,p=>p.Value.Clone());state.Values??=new();foreach(var pair in after)if(reset||!before.TryGetValue(pair.Key,out var old)||old.GetRawText()!=pair.Value.GetRawText()){state.Seed[pair.Key]=pair.Value.Clone();state.Values[pair.Key]=pair.Value.Clone();}}}","evidenceType":"current-source","binaryIdentity":"Current independent implementation, not an original runtime layout."}],"unknowns":["每个工具私有参数状态和配置取消行为须随具体插件确认；此处不证明原版动态参数一致。"],"stages":{"sourceRecovery":"current independent source","runtimeCorroboration":"not-executed","wholeFeatureClosure":"not-established"}},{"id":"DI01","topic":"image","classification":"source-confirmed","from":"SDK ImageBaseData.ImageData / ImageDataPtr","to":"byte[]与借用指针双向访问","representation":"SetByte / SetIntPtr / SetSharedMem / UnSet；GCHandle pin","cache":"指针读byte[]时分配DataLen并Marshal.Copy；byte[]读指针时pin","release":"setter先Free旧pin；未在这里释放外部IntPtr","behavior":"ImageData setter保留传入数组引用并置SetByte；ImageDataPtr getter在SetByte时pin该数组并返回地址，随后置UnSet。反向getter在SetIntPtr时复制到新数组并置UnSet，但保留旧指针字段。两个表示不等于自动同步的不可变副本；不能据已有byte[]认定旧指针仍有效。","refs":[{"path":"docs/architecture-recovery/data-lifecycle-cil.json","member":"VM.PlatformSDKCS.ImageBaseData::get_ImageData","sha256":"b8fe9b3787451ebb018a383fc5e822a32349