elease();}if(release)Release();}}\n bool TryRelease(){if(!closing||!cancellationComplete||leases!=0||releaseStarted)return false;releaseStarted=true;return true;}\n void Exit(){bool release;lock(gate){leases--;release=TryRelease();}if(release)Release();}\n void Release(){object[] values;lock(gate){values=states.Values.Concat(ownedServices).Distinct(ReferenceEqualityComparer.Instance).ToArray();states.Clear();effectiveParameters.Clear();services.Clear();ownedServices.Clear();}foreach(var value in values)if(value is IDisposable disposable)try{disposable.Dispose();}catch(Exception error){RecordCleanupFailure(\"resource\",value,error);}try{stopping.Dispose();}catch(Exception error){RecordCleanupFailure(\"token\",stopping,error);}}\n sealed class Lease(ModuleExecutionScope scope):IDisposable {ModuleExecutionScope? owner=scope;public void Dispose()=>Interlocked.Exchange(ref owner,null)?.Exit();}","evidenceType":"current-source","binaryIdentity":"Current independent implementation, not an original runtime layout."},{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"Node state removal","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":41,"end":41,"excerpt":" public void RemoveNode(string module,string node){var root=Root;object? value;lock(root.gate){root.effectiveParameters.Remove((ProcedureId,module,node));if(!root.states.Remove((ProcedureId,module,node),out value))return;}if(value is IDisposable disposable)disposable.Dispose();}","evidenceType":"current-source","binaryIdentity":"Current independent implementation, not an original runtime layout."},{"path":"src/VisionFramework/GraphExecutor.cs","member":"Execution lease","sha256":"6fed55fe29e547248cab05a36072e690b76eb9668609f0318b795c24d7628f9c","start":7,"end":7,"excerpt":"  using var scopeLease=scope?.Enter();","evidenceType":"current-source","binaryIdentity":"Current independent implementation, not an original runtime layout."}],"unknowns":["跨窗口/provider仍持有的输出引用和节点删除时活租约与s