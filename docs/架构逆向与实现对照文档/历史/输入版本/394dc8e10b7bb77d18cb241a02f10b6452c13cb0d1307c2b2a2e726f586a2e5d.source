lt.Status==ModuleStatus.NoMatch?NodeRunStatus.NoMatch:NodeRunStatus.Success,new ReadOnlyDictionary\u003cstring,PortValue>(result.Outputs.ToDictionary(x=>x.Key,x=>x.Value)),result.ErrorCode,result.Message,result.NativeErrorCode);","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/GraphExecutor.cs","member":"nodeInputs[c.ToPort]=v;","sha256":"6fed55fe29e547248cab05a36072e690b76eb9668609f0318b795c24d7628f9c","start":24,"end":24,"excerpt":"    nodeInputs[c.ToPort]=v;","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["显示位图、历史容器及所有外部消费者的最终引用释放时点尚未逐一闭合；不能由只读字典保证对象生命周期短。"]},{"id":"IB05","classification":"independent-implementation","from":"失败ModuleResult中的状态/耗时","to":"主流程失败NodeRunRecord空输出","behavior":"插件正常错误返回仍填ModuStatus与ModuRunTime，并设置NativeErrorCode，但未设置PreserveFailedOutputs；其默认bool为false。GraphExecutor在此分支先Record失败再continue，未把result.Outputs传给Record，Record默认Empty。因此插件直接调用可读到的失败状态/耗时，在主流程记录与下游端口中被丢弃；保留的是失败码和诊断字段。插件构造输出与主框架最终发布必须分别陈述。","representation":"失败结果与失败记录是两个不同边界；不能仅查插件返回字典判断主窗可读字段。","cache":"缺图/非法数量不清已有缓存；失败这一轮不重发缓存图像。","release":"既有缓存仍可在后续合法暂停刷新中发布；失败不等于清缓存。","refs":[{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"output[\"ModuStatus\"]","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":38,"end":39,"excerpt":"   output[\"ModuStatus\"]=PortValue.Integer(code==0?1:0);output[\"ModuRunTime\"]=PortValue.Number(clock.Elapsed.TotalMilliseconds);\n   return ValueTask.FromResult(new ModuleResult(code==0?ModuleStatus.Success:ModuleStatus.Failed,output,error){NativeErrorCode=code});","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/Contracts.cs","member":"public sealed record ModuleResult(","sha256":"c31843c84f48a91264409edc33ff0fd4a870169c222fa255df4764deea24a269","start":55,"end":55,"excerpt":"public sealed record ModuleResult(ModuleStatus Status,IReadOnlyDictionary\u003cstring,PortValue> Outputs,string? ErrorCode=null,string? Message=null){public ModuleContinuation Continuation{get;init;}public IReadOnlyList\u003cstring>? SelectedExecutionSuccessors{get;init;}public uint? NativeErrorCode{get;init;}public ModuleDescriptor? UpdatedDescriptor{get;init;}public bool PreserveFailedOutputs{get;init;}}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/GraphExecutor.cs","member":"void Record(NodeRunStatus","sha256":"6fed55fe29e547248cab05a36072e690b76eb9668609f0318b795c24d7628f9c","start":15,"end":15,"excerpt":"   void Record(NodeRunStatus s,IReadOnlyDictionary\u003cstring,PortValue>? outputs=null,string? code=null,string? message=null,uint? nativeCode=null){records[id]=new(id,s,outputs??Empty(),sw.Elapsed.TotalMilliseconds,code,message){NativeErrorCode=nativeCode};workflow.Update(id);Report(id,s,message);}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/GraphExecutor.cs","member":"if(result.Status==ModuleStatus.Failed&&!result.PreserveFailedOutputs)","sha256":"6fed55fe29e547248cab05a36072e690b76eb9668609f0318b795c24d7628f9c","start":36,"end":36,"excerpt":"   if(cancellationToken.IsCancellationRequested){Record(NodeRunStatus.Cancelled,code:\"Cancelled\");continue;}if(timeout.IsCancellationRequested){Record(NodeRunStatus.TimedOut,code:\"Timeout\",message:\"Cooperative module timeout\");continue;}if(error is not null){Record(NodeRunStatus.Failed,code:\"ModuleException\",message:error.Message);continue;}if(result is null){Record(NodeRunStatus.Failed,code:\"InvalidResult\");continue;}if(!Enum.IsDefined(result.Status)){Record(NodeRunStatus.Failed,code:\"InvalidResult\",message:\"Unknown module status\");continue;}if(result.Status==ModuleStatus.Failed&&!result.PreserveFailedOutputs){Record(NodeRunStatus.Failed,code:result.ErrorCode??\"ModuleFailed\",message:result.Message,nativeCode:result.NativeErrorCode);continue;}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["旧IMAGE-BUFFER文档中“失败发布状态0”只可直接用于插件返回边界，不能据此断言当前主流程保留该端口；本轮记录差异，不修改产品。","普通配置自执行已另由IB09核实相同过滤；另一ToolDebugSession路径在此不合并作同一入口。"]},{"id":"IB06","classification":"independent-implementation","from":"插件实例 / scope / 节点","to":"缓存持有与RemoveNode、关闭释放","behavior":"scope.State的实际键是(ProcedureId,module,node)，状态属于方案root；无scope时fallback键为规范化BaseDirectory加node，保留于插件实例。Runtime只保留owner且不实现Dispose，不随单轮运行器结束清队列。Reset只从fallback移除指定node，并不移除scope状态。RemoveNode移除状态后只对IDisposable调用Dispose，缓存State不实现该接口。根scope关闭先取消，待租约归零后清状态字典；该State也不会执行逐帧Dispose。","representation":"State.Queue是独立持有者；scope和fallback两条路径不可混用Reset解释。","cache":"RetainProcedureNodes通过RemoveNode清除不再存在的状态键。","release":"移除缓存引用依靠托管GC；旧ModuleResult仍可持图，不能称立即归还全部像素内存。","refs":[{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"State GetState(","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":17,"end":17,"excerpt":" State GetState(ModuleExecutionContext c){if(c.Scope is {} scope)return scope.State(Id,c.NodeId,()=>new State());lock(gate){string key=Path.GetFullPath(c.BaseDirectory)+\"|\"+c.NodeId;if(!fallback.TryGetValue(key,out var state))fallback[key]=state=new();return state;}}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"public void Reset(","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":18,"end":18,"excerpt":" public void Reset(string nodeId){lock(gate)foreach(string key in fallback.Keys.Where(k=>k.EndsWith(\"|\"+nodeId,StringComparison.Ordinal)).ToArray())fallback.Remove(key);}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionPlugins.ImageSource/ImageBufferPlugin.cs","member":"sealed class Runtime(","sha256":"04f02a36f7a9589987ac342e7dab9aaf54125fa4a2fc16af96a05ea4589e2130","start":22,"end":22,"excerpt":" sealed class Runtime(ImageBufferPlugin owner):IModule {","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"public T State\u003cT>","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":33,"end":35,"excerpt":" public T State\u003cT>(string module,string node,Func\u003cT> create)where T:class {\n  var root=Root;lock(root.gate){ObjectDisposedException.ThrowIf(root.closing,this);var key=(ProcedureId,module,node);if(!root.states.TryGetValue(key,out var value))root.states.Add(key,value=create());return (T)value;}\n }","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"public void RemoveNode(","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":41,"end":41,"excerpt":" public void RemoveNode(string module,string node){var root=Root;object? value;lock(root.gate){root.effectiveParameters.Remove((ProcedureId,module,node));if(!root.states.Remove((ProcedureId,module,node),out value))return;}if(value is IDisposable disposable)disposable.Dispose();}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"},{"path":"src/VisionFramework/ModuleExecutionScope.cs","member":"void Release(){","sha256":"fe6b2880402886f3a3e40e8a1bb93b5e180c17364899f1c520b0c587daed2b1b","start":48,"end":48,"excerpt":" void Release(){object[] values;lock(gate){values=states.Values.Concat(ownedServices).Distinct(ReferenceEqualityComparer.Instance).ToArray();states.Clear();effectiveParameters.Clear();services.Clear();ownedServices.Clear();}foreach(var value in values)if(value is IDisposable disposable)try{disposable.Dispose();}catch(Exception error){RecordCleanupFailure(\"resource\",value,error);}try{stopping.Dispose();}catch(Exception error){RecordCleanupFailure(\"token\",stopping,error);}}","evidenceType":"current-source","binaryIdentity":"not revalidated in this slice"}],"unknowns":["未证明所有历史、UI位图、订阅外部持有者同时清空；实际峰值和回收时刻需独立内存观测。"]},{"id":"IB07","classification":"independent-implementation","from":"工具窗口执行/连续/关闭","to":"停止下一轮与缓存生命周期","behavior":"专用窗口Run传入克隆的Node.Parameters，但缓存输入实际仍由宿主提供。连续按钮在每轮await Execute之后再判断continuous/closed；Closed只设置closed=true、continuous=false。窗口本身没有调用插件Reset、scope.RemoveNode或对在飞context.Run发出取消。因此关闭编辑器不等于清缓存或证明正在执行的本轮已经中断。","representation":"窗口参数快照、输入端口和状态队列分属不同持有者。","cache":"关闭只阻止本窗口循环启动后续轮；队列仍按scope/fallback持有。","release":"窗口关闭处理未出现像素Dispose或状态移除。","refs":[{"path":"src/VisionPlugins.ImageSource/ImageBufferWindow.cs","member":"var rows=new W.StackPanel","sha256":"ecdd987200d4356ff8adef9ee959af9a3d921406f1e965bedbe02f4acd2a5ef2","start":16,"end":16,"excerpt":"  var rows=new W.StackPanel{Margin=new Thickness(32,18,34,14)};rows.Children.Add(Header(\"图像输入\"));rows.Children.Add(Link(\"输入源\",\"InputImage\",DataKind.Image));rows.Children.Add(new W.Border{Height=1,Background=Brush(\"#D7D7D7\"),Margin=new Thickness(0,5,0,16)});rows.Children.Add(Header(\"缓存设置\"));rows.Children.Add(Link(\"缓存使能\",\"RefreshFlag\",DataKind.Integer));rows.Children.Add(Link(\"缓存数量\",\"BufferCount\",DataKind.Integer));W.Grid.SetRow(rows,1);root.Children.Add(rows);var commands=new W.StackPanel{Orientation=W.Orientation.Horizontal,HorizontalAlignment=System.Windows.HorizontalAlignment.Right,Margin=new Thickness(0,3,16,3)};loop.Click+=async(_,_)=>{if(continuous){continuous=false;loop.Content=\"连续执行\";return;}if(running)return;continuous=true;loop.Content=\"停止\";do{await Execute();if(continuous&&!closed)await Task.Delay(1);}while(continuous&&!closed);loop.Content=\"连续执行\";once.IsEnabled=true;};once.Click+=async(_,_)=>await Execute();commands.Children.Add(loop);commands.Children.Add(once);var confirm=new W.Button{Name=\"ConfirmBuffer\",Content=\"确定\",Width=66,Height=25,Margin=new Thickness(3,0,0,0)};confirm.Click+=(_,_)=>Close();commands.Children.Add(confirm);W.Grid.SetRow(commands,2