'use strict';
// HOME-NAV-COMPACT-01: navigation only. Maintenance is a separate document.
const esc=x=>String(x??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('"','&quot;');
function render({entries,categories}){
 const link=(id,label,cls='')=>{const item=entries.find(e=>e.id===id);if(!item)throw Error('Missing home entry '+id);return '<a class="'+cls+'" href="'+esc(item.path)+'">'+esc(label||item.label)+'</a>';};
 const card=(href,label)=>'<a href="'+esc(href)+'">'+esc(label)+'</a>';
 const docs=[['主题/全景架构.html','全景架构'],['主题/执行与状态.html','执行与状态'],['数据/index.html','数据与Owner'],['数据/group-data-pipeline.html','Group／子程序'],['数据/global-variable-analysis.html','全局变量'],['清单/专题索引.html','全部专题']];
 const main='<section data-scene-panel="main" class="home-scene"><h2>主界面位置示意</h2><p class="home-caption">导航示意，非运行截图；点击区域查看分析正文。</p><div class="home-map"><a class="home-menu" href="入口/菜单与工具栏.html">菜单栏 · 文件／设置／工具／系统／帮助</a><div class="home-toolbar">'+link('run','单次运行')+link('continuous','全部连续')+link('tabcontinuous','Tab连续')+link('stop','停止')+link('save','保存')+'</div><div class="home-workflow-tabs">'+link('tabs','流程Tab／切换')+link('tabonce','Tab单次')+'</div><div class="home-map-body"><div class="home-toolbox"><a href="工具/index.html">工具箱</a>'+link('catalog','分类／拖入')+link('camera','相机')+link('communication','通信')+'</div><div class="home-canvas">'+link('node','流程画布／节点操作')+link('links','连线与数据路径')+link('group','Group／子程序')+link('viewport','视口／小地图')+'</div><div class="home-display">'+link('preview','图像／预览')+link('result','结果树／结果表')+link('variables','变量')+'</div></div><div class="home-status">'+link('status','状态栏')+link('close','关闭／切方案')+'</div></div></section>';
 const tools='<section data-scene-panel="tools" class="home-scene" hidden><h2>工具窗口</h2><p class="home-caption">按分类进入完整工具目录，再查看具体工具的参数、执行与证据。</p><div class="home-category-list">'+categories.map(c=>card('工具/index.html?category='+encodeURIComponent(c.id),c.label)).join('')+'</div><p class="home-tool-all"><a href="工具/index.html">全部工具／搜索 →</a></p></section>';
 const results='<section data-scene-panel="results" class="home-scene" hidden><h2>运行与结果</h2><p class="home-caption">从执行入口到结果持有、显示与退出边界。</p><div class="home-result-list">'+[['主题/执行与状态.html','执行与状态'],['数据/parameter-pipeline.html','参数与快照'],['数据/image-pipeline.html','图像数据流'],['数据/nonimage-pipeline.html','普通数据'],['数据/图像与参数持有关系.html','图像／参数持有'],['数据/Group逐轮保留与退役.html','Group保留／退役'],['数据/global-variable-analysis.html','全局变量'],['数据/retirement-operation-map.html','停止／关闭／释放']].map(([href,label])=>card(href,label)).join('')+'</div></section>';
 return '<!doctype html><html lang="zh-CN" data-site-prefix="" data-page-kind="home" data-route-host="true" data-home-compact="true"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>架构逆向与实现对照文档</title><link rel="stylesheet" href="公共资源/site.css"><link rel="stylesheet" href="公共资源/home.css"></head><body><a class="site-skip" href="#main-content">跳到导航</a><header class="home-header"><h1>架构逆向与实现对照文档</h1><nav aria-label="首页导航"><a href="清单/专题索引.html">专题索引</a><a href="清单/首页维护.html">维护／验收</a></nav><p id="route-message" role="status" hidden></p></header><main id="main-content" class="home-main"><div class="site-scene-tabs" role="tablist" aria-label="界面场景"><button data-scene="main" role="tab" aria-selected="true">主界面</button><button data-scene="tools" role="tab" aria-selected="false">工具窗口</button><button data-scene="results" role="tab" aria-selected="false">运行与结果</button></div><div class="home-workspace"><div class="home-scene-area">'+main+tools+results+'</div><aside class="home-related"><h2>界面入口</h2><div class="home-entry-list">'+entries.map(e=>card(e.path,e.label)).join('')+'</div><h2>相关文档</h2><div class="home-doc-list">'+docs.map(([href,label])=>card(href,label)).join('')+'</div></aside></div></main><footer class="home-footer"><a href="清单/首页维护.html">维护目标、验收交付与批次记录</a><span id="document-delivery" data-moved-target="清单/首页维护.html#document-delivery"></span></footer><script src="公共资源/routes.js"></script><script src="公共资源/site.js"></script></body></html>';
}
function collect(manifest,toolHtml){const decode=s=>s.replaceAll('&amp;','&').replaceAll('&quot;','"').replaceAll('&lt;','<');return {entries:manifest.pages.filter(p=>/^入口\/[a-z]+\.html$/.test(p.path)).map(p=>({id:p.path.split('/').pop().slice(0,-5),path:p.path,label:p.title})),categories:[.../<select data-tool-category>([\s\S]*?)<\/select>/.exec(toolHtml)[1].matchAll(/<option value="([^"]+)">([\s\S]*?)<\/option>/g)].map(m=>({id:decode(m[1]),label:decode(m[2])}))};}
function maintenance(original){const delivery=/<section id="document-delivery"[\s\S]*?<\/section>/.exec(original)?.[0]||'<section id="document-delivery"><h2>交付与验收</h2><p><a href="清单/最终交付.html">最终交付与未验项</a></p></section>';const moved=delivery.replace(/href="(?![a-z]+:|#)([^"]+)"/gi,'href="../$1"');return '<!doctype html><html lang="zh-CN" data-site-prefix="../" data-page-kind="maintenance"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>首页维护、验收与交付</title><link rel="stylesheet" href="../公共资源/site.css"></head><body><header class="site-header"><a href="../index.html">← 返回界面导航</a><h1>首页维护、验收与交付</h1></header><main id="main-content" class="site-main"><p>文档按界面入口组织；原版事实、当前独立实现、拟议设计与未知分列。导航示意不代表软件运行截图。维护目标、验收和批次记录在此集中保留。</p>'+moved+'<h2>维护记录</h2><ul><li><a href="最终交付.html">最终交付、兼容接入与未验项</a></li><li><a href="目标验收.json">固定批次与目标状态</a></li><li><a href="兼容交接.json">跨角色交接</a></li><li><a href="HOME-NAV-COMPACT-01.json">HOME-NAV-COMPACT-01：首页紧凑修正记录</a></li></ul><p>既有封存及审计结论保留为对应版本记录；本次只修首页，不提高大目标或产品实施进度。</p></main><script src="../公共资源/site.js"></script></body></html>';}
module.exports={render,collect,maintenance};
