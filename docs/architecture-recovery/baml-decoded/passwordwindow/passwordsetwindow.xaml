<?xml version="1.0" encoding="utf-8"?>
<controls:BaseWindow x:Class="PasswordWindowUI.PasswordSetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:VM.Controls;assembly=VM.Controls" xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" xmlns:Lang="clr-namespace:Apps.Localization;assembly=Apps.Localization" x:Name="passwordSetWindow" Height="206" Width="370" Title="{DynamicResource Lang_SetScriptPassword}" MinButtonVisibility="Collapsed" MaxButtonVisibility="Collapsed" FontSize="14" FontFamily="微软雅黑" xmlns:passwordwindowui="clr-namespace:PasswordWindowUI;assembly=PasswordWindowUI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ResourceDictionary.xaml" />
        <x:StaticExtension Member="Lang:LocalizationResourceDictionary.Instance" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#F2F3F5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="33" />
    </Grid.RowDefinitions>
    <Grid VerticalAlignment="Center" Margin="0,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="40" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Text="{DynamicResource Lang_SetScriptPassword}" Foreground="#666666" Margin="{Binding TxtWidth, ElementName=passwordSetWindow}" />
      <Grid Column="1" Row="0">
        <PasswordBox Name="passwordBox" Margin="20,0,0,0" Width="182" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource textCodeBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
          <UIElement.CommandBindings>
            <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
          </UIElement.CommandBindings>
        </PasswordBox>
        <TextBox Name="tbPassword" Margin="20,0,0,0" Width="182" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource textBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding ElementName=passwordBox, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" TextChanged="TextChanged" />
      </Grid>
      <ToggleButton Grid.Column="2" Grid.Row="0" Style="{StaticResource eyeToggleButton}" Margin="-70,0,10,0" IsChecked="{Binding ElementName=passwordSetWindow, Path=IfShowPassword, Mode=TwoWay}" />
      <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Text="{DynamicResource 确认密码}" Foreground="#666666" Margin="{Binding TxtWidth, ElementName=passwordSetWindow}" />
      <Grid Column="1" Row="1">
        <PasswordBox Name="passwordBoxRepeat" Margin="20,10,0,0" Width="182" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource textCodeBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown">
          <UIElement.CommandBindings>
            <input:CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute" />
          </UIElement.CommandBindings>
        </PasswordBox>
        <TextBox Name="tbPasswordRepeat" Margin="20,10,0,0" Width="182" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource textBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding ElementName=passwordBoxRepeat, Path=Password, Mode=TwoWay}" PreviewTextInput="tb_PreviewTextInput" PreviewKeyDown="text_PreviewKeyDown" TextChanged="TextChanged" />
      </Grid>
      <ToggleButton Grid.Column="2" Grid.Row="1" Style="{StaticResource eyeToggleButton}" Margin="-70,10,10,0" IsChecked="{Binding ElementName=passwordSetWindow, Path=IfShowPasswordRepeat, Mode=TwoWay}" />
      <Grid Column="1" Row="2" Margin="10,0,0,0">
        <TextBlock Name="txtPasswordError" Text="{DynamicResource Lang_InputInconsistent}" Foreground="#FFFF0000" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBlock Name="txtPasswordNull" Text="{DynamicResource Lang_InputIsNull}" Foreground="#FFFF0000" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="#E4E5E7" BorderThickness="1" BorderBrush="#C8C4C1">
      <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
        <Button Name="btnOk" Height="24" Width="66" VerticalAlignment="Center" Content="{DynamicResource Confirm}" Margin="10,0,0,0" Style="{StaticResource BottomButtonStyle}" Click="btnOk_Click" />
      </StackPanel>
    </Border>
  </Grid>
</controls:BaseWindow>